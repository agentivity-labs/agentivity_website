{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/((?!services/work/[^/]+/mockup).*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' https://www.googletagmanager.com https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; media-src 'self'; connect-src 'self' https://agentivity-accounts-service.fly.dev https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com; frame-src 'self' https://challenges.cloudflare.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        }
      ]
    },
    {
      "source": "/services/work/:slug/mockup(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self' data: blob: https://cdn.jsdelivr.net; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; upgrade-insecure-requests"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/docs/studio/home{/}?",
      "destination": "/docs/studio/find-your-way-in-the-studio/#the-home-page",
      "permanent": true
    },
    {
      "source": "/docs/studio/agents-list{/}?",
      "destination": "/docs/studio/lists-of-agents-teams-and-workflows/",
      "permanent": true
    },
    {
      "source": "/docs/studio/workflows-list{/}?",
      "destination": "/docs/studio/lists-of-agents-teams-and-workflows/#the-list-of-workflows",
      "permanent": true
    },
    {
      "source": "/docs/studio/settings{/}?",
      "destination": "/docs/studio/settings-theme-and-controls/",
      "permanent": true
    },
    {
      "source": "/docs/studio/status-bar-and-theme{/}?",
      "destination": "/docs/studio/settings-theme-and-controls/#the-status-bar",
      "permanent": true
    },
    {
      "source": "/fr/docs/studio/home{/}?",
      "destination": "/fr/docs/studio/find-your-way-in-the-studio/#the-home-page",
      "permanent": true
    },
    {
      "source": "/fr/docs/studio/agents-list{/}?",
      "destination": "/fr/docs/studio/lists-of-agents-teams-and-workflows/",
      "permanent": true
    },
    {
      "source": "/fr/docs/studio/workflows-list{/}?",
      "destination": "/fr/docs/studio/lists-of-agents-teams-and-workflows/#the-list-of-workflows",
      "permanent": true
    },
    {
      "source": "/fr/docs/studio/settings{/}?",
      "destination": "/fr/docs/studio/settings-theme-and-controls/",
      "permanent": true
    },
    {
      "source": "/fr/docs/studio/status-bar-and-theme{/}?",
      "destination": "/fr/docs/studio/settings-theme-and-controls/#the-status-bar",
      "permanent": true
    },
    {
      "source": "/:path((?!api(?:/|$))(?!.*\\.)(?!.*/$).+)",
      "destination": "/:path/",
      "permanent": true
    }
  ]
}
