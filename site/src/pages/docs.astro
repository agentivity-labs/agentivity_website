---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const lang = 'en';
---
<Base
  title="Docs — Coming Soon | Agentivity"
  description="Agentivity documentation is on its way. In the meantime, explore the GitHub repo or join the community on Discord."
>
  <Nav lang={lang} />

  <section class="s-black docs-section">
    <div class="docs-bg" aria-hidden="true"></div>
    <div class="wrap docs-inner">

      <div class="docs-icon" aria-hidden="true">
        <svg viewBox="0 0 64 64" fill="none" width="56" height="56">
          <rect x="10" y="8" width="44" height="48" rx="4" stroke="rgba(0,207,255,.2)" stroke-width="1.5"/>
          <rect x="10" y="8" width="44" height="48" rx="4" stroke="url(#doc-grad)" stroke-width="1.5" stroke-dasharray="176" stroke-dashoffset="176" class="docs-rect-anim"/>
          <line x1="20" y1="22" x2="44" y2="22" stroke="var(--cyan)" stroke-width="1.5" stroke-linecap="round" class="docs-line-1"/>
          <line x1="20" y1="30" x2="44" y2="30" stroke="rgba(0,207,255,.4)" stroke-width="1.5" stroke-linecap="round" class="docs-line-2"/>
          <line x1="20" y1="38" x2="36" y2="38" stroke="rgba(0,207,255,.25)" stroke-width="1.5" stroke-linecap="round" class="docs-line-3"/>
          <defs>
            <linearGradient id="doc-grad" x1="10" y1="8" x2="54" y2="56" gradientUnits="userSpaceOnUse">
              <stop offset="0%" stop-color="var(--cyan)"/>
              <stop offset="100%" stop-color="var(--violet-l)"/>
            </linearGradient>
          </defs>
        </svg>
      </div>

      <span class="eyebrow" style="color:var(--cyan)">Documentation</span>
      <h1 class="h1 docs-h1">Coming soon.</h1>
      <p class="docs-sub">
        We're writing the docs as we finalise the product.<br class="br-md"/>
        They'll live here — or on GitHub, we'll see.
      </p>

      <div class="docs-options">

        <a href="https://github.com/agentivity-labs/agentivity" target="_blank" rel="noopener noreferrer" class="docs-option">
          <div class="docs-opt-icon">
            <svg viewBox="0 0 24 24" fill="currentColor" width="20" height="20"><path d="M12 .3a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2c-3.3.7-4-1.6-4-1.6-.6-1.4-1.4-1.8-1.4-1.8-1-.7.1-.7.1-.7 1.2 0 1.8 1.2 1.8 1.2 1 1.8 2.8 1.3 3.5 1 0-.8.4-1.3.7-1.6-2.7-.3-5.5-1.3-5.5-5.9 0-1.3.5-2.4 1.2-3.2 0-.4-.5-1.6.2-3.2 0 0 1-.3 3.3 1.2a11.5 11.5 0 0 1 6 0c2.3-1.5 3.3-1.2 3.3-1.2.7 1.6.2 2.8.1 3.2.8.8 1.2 1.9 1.2 3.2 0 4.6-2.8 5.6-5.5 5.9.5.4.9 1 .9 2.2v3.3c0 .3.2.7.8.6A12 12 0 0 0 12 .3"/></svg>
          </div>
          <div>
            <strong>GitHub repo</strong>
            <span>README, install guide, and open issues</span>
          </div>
          <span class="docs-opt-arrow">→</span>
        </a>

        <a href="/how-it-works" class="docs-option">
          <div class="docs-opt-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="20" height="20"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
          </div>
          <div>
            <strong>How it works</strong>
            <span>Visual walkthrough of the platform</span>
          </div>
          <span class="docs-opt-arrow">→</span>
        </a>

        <a href="/pricing#waitlist" class="docs-option">
          <div class="docs-opt-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="20" height="20"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9M13.73 21a2 2 0 0 1-3.46 0"/></svg>
          </div>
          <div>
            <strong>Get notified</strong>
            <span>Join the waitlist — we'll tell you when docs ship</span>
          </div>
          <span class="docs-opt-arrow">→</span>
        </a>

      </div>

    </div>
  </section>

  <Footer lang={lang} />
</Base>

<style>
.docs-section {
  min-height: 100vh;
  display: flex;
  align-items: center;
  padding: 80px 0 100px;
  position: relative;
  overflow: hidden;
}
.docs-bg {
  position: absolute; inset: 0; pointer-events: none;
  background:
    radial-gradient(ellipse 50% 55% at 50% 5%, rgba(0,207,255,.08) 0%, transparent 60%),
    radial-gradient(ellipse 35% 40% at 85% 85%, rgba(109,0,245,.07) 0%, transparent 60%);
}
.docs-inner {
  position: relative; z-index: 1;
  display: flex; flex-direction: column; align-items: center;
  text-align: center;
}

/* Animated icon */
.docs-icon { margin-bottom: 28px; }
.docs-rect-anim { animation: rect-fill 1s cubic-bezier(.4,0,.2,1) .2s forwards; }
.docs-line-1 { stroke-dasharray: 24; stroke-dashoffset: 24; animation: line-in .3s ease .9s forwards; }
.docs-line-2 { stroke-dasharray: 24; stroke-dashoffset: 24; animation: line-in .3s ease 1.05s forwards; }
.docs-line-3 { stroke-dasharray: 16; stroke-dashoffset: 16; animation: line-in .3s ease 1.2s forwards; }
@keyframes rect-fill { to { stroke-dashoffset: 0; } }
@keyframes line-in   { to { stroke-dashoffset: 0; } }

.docs-h1 {
  font-size: clamp(48px, 8vw, 96px);
  margin: 12px 0 20px;
  color: #fff;
  letter-spacing: -.05em;
}
.docs-sub {
  font-size: clamp(16px, 1.4vw, 18px);
  color: rgba(255,255,255,.4);
  line-height: 1.75;
  max-width: 44ch;
  margin-bottom: 48px;
}
.br-md { display: none; }
@media (min-width: 640px) { .br-md { display: initial; } }

/* Options */
.docs-options {
  display: flex; flex-direction: column; gap: 2px;
  width: 100%; max-width: 520px;
  text-align: left;
}
.docs-option {
  display: flex; align-items: center; gap: 16px;
  padding: 18px 20px;
  border-radius: var(--r-lg);
  border: 1px solid rgba(255,255,255,.06);
  background: rgba(255,255,255,.02);
  text-decoration: none;
  transition: background .15s, border-color .15s;
}
.docs-option:hover {
  background: rgba(255,255,255,.05);
  border-color: rgba(255,255,255,.1);
}
.docs-opt-icon {
  width: 40px; height: 40px; flex-shrink: 0;
  border-radius: var(--r-lg);
  background: rgba(0,207,255,.08);
  border: 1px solid rgba(0,207,255,.15);
  color: var(--cyan);
  display: flex; align-items: center; justify-content: center;
}
.docs-option strong {
  display: block;
  font-size: 14px; font-weight: 600; color: #fff;
  margin-bottom: 2px;
}
.docs-option span span,
.docs-option > div > span {
  display: block;
  font-size: 12px; color: rgba(255,255,255,.35);
}
.docs-opt-arrow {
  margin-left: auto; flex-shrink: 0;
  font-size: 16px; color: rgba(255,255,255,.2);
  transition: color .15s, transform .15s;
}
.docs-option:hover .docs-opt-arrow {
  color: rgba(255,255,255,.5);
  transform: translateX(3px);
}
</style>
