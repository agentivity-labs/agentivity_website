---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const lang = 'en';

const colors = [
  { name: 'Red',    cssVar: '--red',      hex: '#FF0A30', dark: false, label: 'Primary · CTAs · Accents' },
  { name: 'Violet', cssVar: '--violet',   hex: '#6D00F5', dark: false, label: 'Secondary · Links · Tags' },
  { name: 'Mint',   cssVar: '--mint',     hex: '#00C896', dark: false, label: 'Synergi · Success' },
  { name: 'Cyan',   cssVar: '--cyan',     hex: '#00CFFF', dark: false, label: 'Topologies · Info' },
  { name: 'Navy',   cssVar: '--navy',     hex: '#0D1B35', dark: true,  label: 'Section backgrounds' },
  { name: 'Black',  cssVar: '--black',    hex: '#0A0F1E', dark: true,  label: 'Hero · Dark sections' },
  { name: 'Pearl',  cssVar: '--pearl',    hex: '#F0F2FF', dark: false, label: 'Light section backgrounds' },
  { name: 'White',  cssVar: '--white',    hex: '#FFFFFF', dark: false, label: 'Base background' },
];
---
<Base
  title="Brand Kit — Agentivity"
  description="Agentivity brand guidelines — logos, colours, typography and usage rules.">

<Nav lang={lang} />

<div class="brand-page">

  <!-- HEADER -->
  <section class="brand-hero s-black dots">
    <div class="blob" style="width:500px;height:500px;background:rgba(109,0,245,.15);top:-160px;left:-100px"></div>
    <div class="wrap">
      <span class="eyebrow" style="color:var(--violet)">Brand Kit</span>
      <h1 class="h1" style="margin-top:16px;color:#fff">
        Build with <span class="u-red">Agentivity.</span><br />
        <span class="grad-text">Look the part.</span>
      </h1>
      <p style="color:rgba(255,255,255,.65);font-size:clamp(16px,1.4vw,19px);max-width:44ch;margin-top:20px;line-height:1.7">
        Guidelines for using the Agentivity brand — logos, colours, typography and the rules that keep everything consistent.
      </p>
    </div>
  </section>

  <!-- LOGO -->
  <section class="brand-section s-white" id="logo">
    <div class="wrap">
      <h2 class="brand-h2">Logo</h2>
      <p class="brand-sub">Use the wordmark on its own. Never distort, recolour, or add effects. Maintain clear space equal to the height of the "A" on all sides.</p>
      <div class="logo-grid">
        <div class="logo-swatch dark">
          <img src="/agentivity-wordmark-white.svg" alt="Agentivity wordmark white" />
          <span>White — on dark backgrounds</span>
        </div>
        <div class="logo-swatch light">
          <img src="/agentivity-wordmark-dark.svg" alt="Agentivity wordmark dark" onerror="this.style.opacity='.25'" />
          <span>Dark — on light backgrounds</span>
        </div>
        <div class="logo-swatch violet-bg">
          <img src="/agentivity-wordmark-white.svg" alt="Agentivity wordmark on violet" />
          <span>White — on brand colour</span>
        </div>
      </div>
      <div class="brand-rule">
        <div class="brand-do">
          <strong>✓ Do</strong>
          <ul>
            <li>Use the official SVG files</li>
            <li>Maintain proportions — never stretch</li>
            <li>Use on solid, contrasting backgrounds</li>
            <li>Allow generous clear space</li>
          </ul>
        </div>
        <div class="brand-dont">
          <strong>✗ Don't</strong>
          <ul>
            <li>Recolour the logo</li>
            <li>Add drop shadows, outlines or gradients</li>
            <li>Place on busy or low-contrast backgrounds</li>
            <li>Use at sizes below 120px wide</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- COLOURS -->
  <section class="brand-section s-pearl" id="colours">
    <div class="wrap">
      <h2 class="brand-h2">Colour System</h2>
      <p class="brand-sub">Our palette is electric and intentional. Each colour has a defined role — don't swap them arbitrarily.</p>
      <div class="colour-grid">
        {colors.map(c => (
          <div class="colour-swatch" style={`background:${c.hex}`}>
            <div class="colour-info" style={c.dark ? 'color:rgba(255,255,255,.9)' : 'color:rgba(0,0,0,.8)'}>
              <strong>{c.name}</strong>
              <code>{c.hex}</code>
              <span class="colour-var">{c.cssVar}</span>
              <span class="colour-label">{c.label}</span>
            </div>
          </div>
        ))}
      </div>
      <div class="gradient-swatch">
        <div class="grad-bar"></div>
        <div class="grad-info">
          <strong>Brand Gradient</strong>
          <code>linear-gradient(135deg, #FF0A30 0%, #6D00F5 100%)</code>
          <span>Used on key numbers, highlights and accents. Never on large backgrounds.</span>
        </div>
      </div>
    </div>
  </section>

  <!-- TYPOGRAPHY -->
  <section class="brand-section s-white" id="typography">
    <div class="wrap">
      <h2 class="brand-h2">Typography</h2>
      <p class="brand-sub">Two typefaces only. Inter for everything human. JetBrains Mono for everything technical.</p>
      <div class="type-grid">
        <div class="type-card">
          <div class="type-sample" style="font-family:'Inter',sans-serif;font-weight:900;font-size:clamp(40px,6vw,72px);letter-spacing:-.05em;line-height:1">
            Inter
          </div>
          <div class="type-details">
            <strong>Inter</strong>
            <p>Headings, body copy, UI labels. Weights used: 900 (display), 800 (h1–h2), 700 (h3, buttons), 400 (body).</p>
            <a href="https://fonts.google.com/specimen/Inter" target="_blank" rel="noopener noreferrer">Google Fonts ↗</a>
          </div>
        </div>
        <div class="type-card">
          <div class="type-sample" style="font-family:'JetBrains Mono',monospace;font-weight:700;font-size:clamp(24px,3vw,40px);letter-spacing:.05em;line-height:1.3;color:var(--violet)">
            JetBrains<br/>Mono
          </div>
          <div class="type-details">
            <strong>JetBrains Mono</strong>
            <p>Eyebrows, labels, code, badges, metadata. Always uppercase for eyebrows. Weights: 700 (labels), 400 (code).</p>
            <a href="https://fonts.google.com/specimen/JetBrains+Mono" target="_blank" rel="noopener noreferrer">Google Fonts ↗</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- TONE OF VOICE -->
  <section class="brand-section s-black dots" id="voice">
    <div class="blob" style="width:400px;height:400px;background:rgba(109,0,245,.1);bottom:-100px;right:0"></div>
    <div class="wrap">
      <h2 class="brand-h2" style="color:#fff">Tone of Voice</h2>
      <p class="brand-sub" style="color:rgba(255,255,255,.6)">How Agentivity sounds — confident, human, direct. No jargon. No hype.</p>
      <div class="voice-grid">
        <div class="voice-card">
          <strong>Direct</strong>
          <p>Say exactly what you mean. No padding, no weasel words. Short sentences win.</p>
          <div class="voice-ex good">✓ "Your agents work while you sleep."</div>
          <div class="voice-ex bad">✗ "Leverage the power of AI-driven autonomous agent orchestration."</div>
        </div>
        <div class="voice-card">
          <strong>Human</strong>
          <p>Write like a smart colleague, not a press release. Use "you", not "the user".</p>
          <div class="voice-ex good">✓ "You set the rules. Your team delivers."</div>
          <div class="voice-ex bad">✗ "Users can configure agent parameters to optimise workflow outputs."</div>
        </div>
        <div class="voice-card">
          <strong>Confident</strong>
          <p>We believe in this product. No hedging. State what Agentivity does, not what it "might" do.</p>
          <div class="voice-ex good">✓ "15+ hours saved per week."</div>
          <div class="voice-ex bad">✗ "Potentially saving you significant amounts of time."</div>
        </div>
        <div class="voice-card">
          <strong>Unpretentious</strong>
          <p>No hype, no buzzwords. Business people are busy — respect their time.</p>
          <div class="voice-ex good">✓ "Build your AI team. No code."</div>
          <div class="voice-ex bad">✗ "Revolutionising the paradigm of next-generation agentic intelligence."</div>
        </div>
      </div>
    </div>
  </section>

  <!-- DOWNLOADS -->
  <section class="brand-section s-pearl" id="downloads">
    <div class="wrap">
      <h2 class="brand-h2">Downloads</h2>
      <p class="brand-sub">Official assets for press, partnerships and integrations. All files are provided in SVG format.</p>
      <div class="dl-grid">
        <div class="dl-card">
          <div class="dl-preview dark"><img src="/agentivity-wordmark-white.svg" alt="Wordmark white" /></div>
          <div class="dl-info">
            <strong>Wordmark — White</strong>
            <span>SVG · For dark backgrounds</span>
            <a href="/agentivity-wordmark-white.svg" download class="btn btn-black">Download SVG</a>
          </div>
        </div>
        <div class="dl-card">
          <div class="dl-preview light"><img src="/agentivity-wordmark-dark.svg" alt="Wordmark dark" onerror="this.style.opacity='.2'" /></div>
          <div class="dl-info">
            <strong>Wordmark — Dark</strong>
            <span>SVG · For light backgrounds</span>
            <a href="/agentivity-wordmark-dark.svg" download class="btn btn-black">Download SVG</a>
          </div>
        </div>
      </div>
      <p style="font-size:13px;color:var(--ink-3);margin-top:32px">
        For press enquiries or partnership assets, contact <a href="mailto:hello@agentivity.io" style="color:var(--violet)">hello@agentivity.io</a>
      </p>
    </div>
  </section>

</div>

<Footer lang={lang} />

<style>
.brand-page{}
.brand-hero{padding:100px 0 80px;position:relative;overflow:hidden}
.brand-section{padding:80px 0}
.brand-h2{font-size:clamp(26px,3.5vw,40px);font-weight:800;letter-spacing:-.04em;margin-bottom:12px}
.brand-sub{font-size:clamp(15px,1.3vw,17px);color:var(--ink-2);max-width:52ch;margin-bottom:40px;line-height:1.7}

/* logo */
.logo-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-bottom:40px}
.logo-swatch{border-radius:var(--r-xl);padding:40px 32px;display:flex;flex-direction:column;gap:16px;
  align-items:center;justify-content:center;min-height:160px}
.logo-swatch img{max-width:200px;max-height:40px;object-fit:contain}
.logo-swatch span{font-size:12px;font-family:"JetBrains Mono",monospace;letter-spacing:.06em;text-transform:uppercase;opacity:.6}
.logo-swatch.dark{background:var(--black);color:#fff}
.logo-swatch.light{background:#fff;border:1px solid var(--line);color:var(--ink-2)}
.logo-swatch.violet-bg{background:var(--violet);color:#fff}
.brand-rule{display:grid;grid-template-columns:1fr 1fr;gap:24px}
.brand-do,.brand-dont{padding:24px 28px;border-radius:var(--r-xl)}
.brand-do{background:rgba(0,200,150,.07);border:1px solid rgba(0,200,150,.2)}
.brand-dont{background:rgba(255,10,48,.05);border:1px solid rgba(255,10,48,.2)}
.brand-do strong{color:#007a5e;font-size:14px;font-weight:700;display:block;margin-bottom:12px}
.brand-dont strong{color:var(--red);font-size:14px;font-weight:700;display:block;margin-bottom:12px}
.brand-do ul,.brand-dont ul{display:flex;flex-direction:column;gap:8px;margin:0;padding:0;list-style:none}
.brand-do li,.brand-dont li{font-size:14px;color:var(--ink-2);line-height:1.5}

/* colours */
.colour-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-bottom:24px}
.colour-swatch{border-radius:var(--r-xl);padding:24px 20px;min-height:140px;display:flex;flex-direction:column;justify-content:flex-end;
  border:1px solid rgba(0,0,0,.06)}
.colour-info{display:flex;flex-direction:column;gap:3px}
.colour-info strong{font-size:15px;font-weight:800}
.colour-info code{font-family:"JetBrains Mono",monospace;font-size:12px;opacity:.75}
.colour-var{font-family:"JetBrains Mono",monospace;font-size:10px;opacity:.55;letter-spacing:.04em}
.colour-label{font-size:11px;opacity:.65;margin-top:2px}
.gradient-swatch{display:flex;gap:24px;align-items:center;background:#fff;border:1px solid var(--line);
  border-radius:var(--r-xl);padding:24px 28px;margin-top:4px}
.grad-bar{width:120px;height:80px;flex-shrink:0;border-radius:var(--r-lg);
  background:linear-gradient(135deg,#FF0A30 0%,#6D00F5 100%)}
.grad-info{display:flex;flex-direction:column;gap:6px}
.grad-info strong{font-size:15px;font-weight:700}
.grad-info code{font-family:"JetBrains Mono",monospace;font-size:12px;color:var(--ink-2)}
.grad-info span{font-size:13px;color:var(--ink-3)}

/* typography */
.type-grid{display:grid;grid-template-columns:1fr 1fr;gap:24px}
.type-card{border:1px solid var(--line);border-radius:var(--r-xl);padding:36px 32px;display:flex;flex-direction:column;gap:20px}
.type-details strong{font-size:16px;font-weight:700;display:block;margin-bottom:8px}
.type-details p{font-size:14px;color:var(--ink-2);line-height:1.65}
.type-details a{font-size:13px;color:var(--violet);font-weight:600}

/* tone of voice */
.voice-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:20px}
.voice-card{background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.08);
  border-radius:var(--r-xl);padding:28px 24px}
.voice-card strong{display:block;font-size:16px;font-weight:800;color:#fff;margin-bottom:10px}
.voice-card p{font-size:14px;color:rgba(255,255,255,.6);line-height:1.65;margin-bottom:16px}
.voice-ex{font-size:13px;padding:10px 14px;border-radius:var(--r-md);margin-bottom:8px;line-height:1.5}
.voice-ex.good{background:rgba(0,200,150,.1);color:rgba(255,255,255,.8);border-left:3px solid var(--mint)}
.voice-ex.bad{background:rgba(255,10,48,.08);color:rgba(255,255,255,.5);border-left:3px solid rgba(255,10,48,.4);text-decoration:line-through;text-decoration-color:rgba(255,10,48,.4)}

/* downloads */
.dl-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:20px}
.dl-card{border:1px solid var(--line);border-radius:var(--r-xl);overflow:hidden;display:flex;flex-direction:column}
.dl-preview{display:flex;align-items:center;justify-content:center;padding:40px;min-height:140px}
.dl-preview img{max-width:180px;max-height:36px;object-fit:contain}
.dl-preview.dark{background:var(--black)}
.dl-preview.light{background:#fff}
.dl-info{padding:20px 24px;display:flex;flex-direction:column;gap:6px;border-top:1px solid var(--line)}
.dl-info strong{font-size:15px;font-weight:700}
.dl-info span{font-size:13px;color:var(--ink-3);margin-bottom:8px}

@media(max-width:900px){
  .logo-grid,.colour-grid,.type-grid,.voice-grid,.dl-grid,.brand-rule{grid-template-columns:1fr 1fr}
}
@media(max-width:600px){
  .logo-grid,.colour-grid,.type-grid,.voice-grid,.dl-grid,.brand-rule{grid-template-columns:1fr}
}
</style>

</Base>
