---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const lang = 'en';

const schema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Agentivity Professional Services",
  "provider": { "@type": "Organization", "name": "Agentivity" },
  "description": "End-to-end AI services: agent team development, IT transformation, AI architecture, custom model training, workshops and integration.",
  "serviceType": ["AI Consulting", "Custom AI Development", "AI Training", "IT Transformation"]
};

interface Service {
  id: string;
  icon: string;
  eyebrow: string;
  title: string;
  body: string;
  deliverables: string[];
  accent: string;
}

const services: Service[] = [
  {
    id: "agent-teams",
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="28" height="28"><circle cx="9" cy="7" r="3"/><circle cx="17" cy="7" r="3"/><path d="M3 21v-2a4 4 0 0 1 4-4h4a4 4 0 0 1 4 4v2"/><path d="M19 11v6m-3-3h6"/></svg>`,
    eyebrow: "Service 01",
    title: "Agent Team Development",
    body: "We design, build, and deploy custom multi-agent teams tailored to your workflows. From a Finance Analyst team that produces reports in 4 minutes, to an HR pipeline that screens 200 CVs overnight — we deliver production-ready agent teams on Agentivity.",
    deliverables: [
      "Requirements workshop & workflow mapping",
      "Agent design: roles, prompts, tools, topology",
      "Build & test on your infrastructure",
      "Documentation + handover session",
      "30-day post-launch support",
    ],
    accent: "var(--mint)",
  },
  {
    id: "it-transformation",
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="28" height="28"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>`,
    eyebrow: "Service 02",
    title: "IT Transformation",
    body: "We help organisations migrate from manual, fragmented processes to AI-orchestrated operations. That means auditing your current stack, identifying where agent teams create the highest value, and delivering a phased roadmap — from first pilot to org-wide deployment.",
    deliverables: [
      "AI readiness audit (people, processes, data)",
      "Prioritised opportunity matrix",
      "Pilot team delivery (1 high-impact workflow)",
      "Phased rollout plan across departments",
      "KPI definition & measurement framework",
    ],
    accent: "var(--cyan)",
  },
  {
    id: "ai-architecture",
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="28" height="28"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><path d="M17.5 17.5m-2 0a2 2 0 1 0 4 0 2 2 0 0 0-4 0"/><path d="M10 6.5h4M6.5 10v4M17.5 10v3.5"/></svg>`,
    eyebrow: "Service 03",
    title: "AI Architecture & Strategy",
    body: "Before you build, you need the right design. We architect your AI stack end-to-end: model selection (open vs proprietary), topology choice (Sequential, Group Chat, Concurrent), data flows, memory strategy, security boundaries, and cost optimisation. No lock-in, no over-engineering.",
    deliverables: [
      "AI stack design document",
      "Model & provider recommendations",
      "Agent topology design per use case",
      "Data privacy & compliance mapping",
      "Cost model & BYOK strategy",
    ],
    accent: "var(--violet-l)",
  },
  {
    id: "custom-models",
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="28" height="28"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/></svg>`,
    eyebrow: "Service 04",
    title: "Custom Model Training",
    body: "General-purpose LLMs aren't always enough. We fine-tune and train specialised models on your domain data — legal, medical, financial, technical — so your agents perform with the precision of an expert, not a generalist. Smaller, faster, cheaper, and deeply adapted to your vocabulary and processes.",
    deliverables: [
      "Dataset audit & curation",
      "Base model selection (open-weight or proprietary)",
      "Supervised fine-tuning (SFT) or RLHF pipeline",
      "Evaluation benchmarks on your domain",
      "Deployment on your infrastructure (BYOK-compatible)",
    ],
    accent: "var(--red)",
  },
  {
    id: "integration",
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="28" height="28"><path d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01"/></svg>`,
    eyebrow: "Service 05",
    title: "Integration & Deployment",
    body: "Agentivity doesn't live in a vacuum. We connect your agent teams to your existing stack — CRMs, ERPs, data warehouses, internal APIs, Slack, email — so your agents act on real data and deliver results where your team already works. Docker, on-premise, or private cloud.",
    deliverables: [
      "Connector development (REST, webhooks, internal APIs)",
      "Auth & secrets management",
      "On-premise or private cloud deployment",
      "CI/CD pipeline for agent team updates",
      "Monitoring & alerting setup",
    ],
    accent: "var(--cyan)",
  },
  {
    id: "workshops",
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="28" height="28"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/></svg>`,
    eyebrow: "Service 06",
    title: "Workshops & Team Training",
    body: "We teach your team to build, maintain, and scale agent teams themselves. Half-day to two-day formats, hands-on with Agentivity. From non-technical stakeholders learning to compose agents visually, to developers going deep on prompt engineering, topologies, and custom tooling.",
    deliverables: [
      "Tailored curriculum for your team level",
      "Hands-on sessions on Agentivity canvas",
      "Prompt engineering best practices",
      "Team topology design exercises",
      "Workshop materials + recorded sessions",
    ],
    accent: "var(--mint)",
  },
];
---
<Base
  title="Agentivity Services — AI Development, Architecture & Custom Model Training"
  description="End-to-end AI professional services: agent team development, IT transformation, AI architecture, custom model training, integration, and team workshops."
  schema={schema}
>
  <Nav lang={lang} />

  <!-- HERO -->
  <section class="s-black svc-hero">
    <div class="svc-hero-bg" aria-hidden="true"></div>
    <div class="wrap svc-hero-inner">
      <span class="eyebrow" style="color:var(--violet-l)">Professional Services</span>
      <h1 class="h1 svc-h1">
        We build the<br /><span class="grad-text">AI team you need.</span>
      </h1>
      <p class="svc-sub">
        Agentivity is the platform. We're the team that makes it work for your organisation —
        from first agent to full AI transformation.
      </p>
      <div class="svc-hero-stats">
        <div class="svc-stat">
          <span class="svc-stat-num">6</span>
          <span class="svc-stat-label">Service lines</span>
        </div>
        <div class="svc-stat-divider" aria-hidden="true"></div>
        <div class="svc-stat">
          <span class="svc-stat-num">End&#8209;to&#8209;end</span>
          <span class="svc-stat-label">From audit to deployment</span>
        </div>
        <div class="svc-stat-divider" aria-hidden="true"></div>
        <div class="svc-stat">
          <span class="svc-stat-num">BYOK</span>
          <span class="svc-stat-label">Your infra, your data</span>
        </div>
      </div>
      <a href="#contact" class="btn btn-primary lg svc-hero-cta">Talk to us →</a>
    </div>
  </section>

  <!-- SERVICES -->
  <section class="s-navy svc-list-section">
    <div class="wrap">
      {services.map((s, i) => (
        <div class={`svc-item ${i % 2 === 1 ? 'svc-item--alt' : ''}`} id={s.id}>
          <div class="svc-item-header">
            <div class="svc-item-icon" style={`--c:${s.accent}`} set:html={s.icon}></div>
            <div>
              <span class="svc-item-eyebrow">{s.eyebrow}</span>
              <h2 class="svc-item-title">{s.title}</h2>
            </div>
          </div>
          <div class="svc-item-body">
            <p class="svc-item-desc">{s.body}</p>
            <div class="svc-deliverables">
              <p class="svc-deliv-label">What you get</p>
              <ul class="svc-deliv-list">
                {s.deliverables.map(d => (
                  <li class="svc-deliv-item">
                    <span class="svc-deliv-dot" style={`background:${s.accent}`}></span>
                    {d}
                  </li>
                ))}
              </ul>
            </div>
          </div>
          <div class="svc-item-cta">
            <a href="#contact" class="btn btn-ghost">Enquire →</a>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- HOW WE WORK -->
  <section class="s-pearl svc-process-section">
    <div class="wrap">
      <span class="eyebrow" style="color:var(--violet)">How we work</span>
      <h2 class="h2 svc-process-title">From discovery to delivery.</h2>
      <p class="svc-process-sub">Every engagement follows the same rigorous process — no black boxes, no lock-in.</p>

      <div class="svc-process-steps">

        <div class="svc-step">
          <div class="svc-step-num">01</div>
          <h3 class="svc-step-title">Discovery</h3>
          <p class="svc-step-body">We map your workflows, data, and team. We identify where AI agents create real leverage — not where they're just interesting.</p>
        </div>

        <div class="svc-step-arrow" aria-hidden="true">→</div>

        <div class="svc-step">
          <div class="svc-step-num">02</div>
          <h3 class="svc-step-title">Design</h3>
          <p class="svc-step-body">We architect the agent team: roles, tools, prompts, topology, and data flows. You review and approve before a single line is written.</p>
        </div>

        <div class="svc-step-arrow" aria-hidden="true">→</div>

        <div class="svc-step">
          <div class="svc-step-num">03</div>
          <h3 class="svc-step-title">Build</h3>
          <p class="svc-step-body">We build on Agentivity, iterate fast, and test against real scenarios from your domain. Weekly demos, full transparency.</p>
        </div>

        <div class="svc-step-arrow" aria-hidden="true">→</div>

        <div class="svc-step">
          <div class="svc-step-num">04</div>
          <h3 class="svc-step-title">Deploy & Transfer</h3>
          <p class="svc-step-body">We deploy on your infrastructure, train your team, hand over documentation, and stay available for 30 days post-launch.</p>
        </div>

      </div>
    </div>
  </section>

  <!-- ENGAGEMENT MODELS -->
  <section class="s-black svc-engage-section">
    <div class="wrap">
      <h2 class="h2 svc-engage-title" style="color:#fff">Engagement models</h2>
      <p class="svc-engage-sub">Choose the format that fits your project and budget.</p>

      <div class="svc-engage-grid">

        <div class="svc-engage-card">
          <h3 class="svc-engage-name">Fixed scope</h3>
          <p class="svc-engage-desc">Defined deliverable, fixed price. Best for agent team builds and specific integrations where the scope is clear.</p>
          <ul class="svc-engage-list">
            <li>Clear specification upfront</li>
            <li>Milestone-based payment</li>
            <li>Full IP transfer on delivery</li>
          </ul>
        </div>

        <div class="svc-engage-card svc-engage-card--featured">
          <div class="svc-engage-badge">Most common</div>
          <h3 class="svc-engage-name">Retainer</h3>
          <p class="svc-engage-desc">Ongoing partnership — a fixed block of hours per month. Best for teams that want to iterate, expand, and evolve their AI capabilities continuously.</p>
          <ul class="svc-engage-list">
            <li>Dedicated team capacity</li>
            <li>Priority response</li>
            <li>Monthly review & planning</li>
          </ul>
        </div>

        <div class="svc-engage-card">
          <h3 class="svc-engage-name">Workshop</h3>
          <p class="svc-engage-desc">Half-day to two-day intensive. Best for teams that want to learn to build with Agentivity themselves and get expert guidance on their specific use cases.</p>
          <ul class="svc-engage-list">
            <li>In-person or remote</li>
            <li>Custom curriculum</li>
            <li>Hands-on exercises</li>
          </ul>
        </div>

      </div>
    </div>
  </section>

  <!-- CONTACT -->
  <section class="s-violet svc-contact" id="contact">
    <div class="svc-contact-glow" aria-hidden="true"></div>
    <div class="wrap svc-contact-inner">

      <div class="svc-contact-text">
        <h2 class="h2 svc-contact-h2">
          Let's talk about<br /><span class="grad-text">your project.</span>
        </h2>
        <p class="svc-contact-sub">
          Tell us what you're trying to build. We'll come back with a concrete proposal within 48 hours.
        </p>
        <div class="svc-contact-reassurances">
          <p class="svc-reassure"><span class="svc-reassure-dot" style="--c:var(--mint)"></span>No obligation</p>
          <p class="svc-reassure"><span class="svc-reassure-dot" style="--c:var(--cyan)"></span>Response in 48h</p>
          <p class="svc-reassure"><span class="svc-reassure-dot" style="--c:var(--violet-l)"></span>NDA available on request</p>
        </div>
      </div>

      <div class="svc-form-wrap">
        <form
          method="POST"
          action={`https://formspree.io/f/${import.meta.env.PUBLIC_FORMSPREE_SERVICES ?? 'YOUR_FORM_ID'}`}
          class="svc-form"
        >
          <input type="hidden" name="_next" value="https://agentivity.io/thank-you" />
          <input type="hidden" name="_gotcha" style="display:none" />

          <div class="svc-form-row">
            <div class="svc-field">
              <label class="svc-label" for="svc-name">Name</label>
              <input type="text" id="svc-name" name="name" placeholder="Your name" required class="svc-input" />
            </div>
            <div class="svc-field">
              <label class="svc-label" for="svc-email">Email</label>
              <input type="email" id="svc-email" name="email" placeholder="your@company.com" required class="svc-input" />
            </div>
          </div>

          <div class="svc-field">
            <label class="svc-label" for="svc-service">Service of interest</label>
            <select id="svc-service" name="service" class="svc-input svc-select">
              <option value="" disabled selected>Select a service…</option>
              <option value="agent-teams">Agent Team Development</option>
              <option value="it-transformation">IT Transformation</option>
              <option value="ai-architecture">AI Architecture &amp; Strategy</option>
              <option value="custom-models">Custom Model Training</option>
              <option value="integration">Integration &amp; Deployment</option>
              <option value="workshops">Workshops &amp; Training</option>
              <option value="other">Other / Not sure yet</option>
            </select>
          </div>

          <div class="svc-field">
            <label class="svc-label" for="svc-message">Tell us about your project</label>
            <textarea id="svc-message" name="message" placeholder="What are you trying to automate or build? What's the current pain? Any constraints (infra, budget, timeline)?" rows="5" class="svc-input svc-textarea"></textarea>
          </div>

          <button type="submit" class="btn btn-primary lg svc-submit">Send enquiry →</button>

          <p class="svc-form-note">
            <svg viewBox="0 0 20 20" fill="currentColor" width="12" height="12" style="opacity:.4"><path fill-rule="evenodd" d="M5 9V7a5 5 0 0 1 10 0v2a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2zm8-2v2H7V7a3 3 0 0 1 6 0z" clip-rule="evenodd"/></svg>
            Your information stays confidential and is never shared.
          </p>
        </form>
      </div>

    </div>
  </section>

  <Footer lang={lang} />

</Base>

<style>
/* ═══ HERO ═══ */
.svc-hero { padding: 120px 0 80px; position: relative; overflow: hidden; }
.svc-hero-bg {
  position: absolute; inset: 0; pointer-events: none;
  background:
    radial-gradient(ellipse 55% 60% at 70% 20%, rgba(109,0,245,.12) 0%, transparent 60%),
    radial-gradient(ellipse 40% 50% at 20% 80%, rgba(0,200,150,.06) 0%, transparent 60%);
}
.svc-hero-inner { position: relative; z-index: 1; max-width: 720px; }
.svc-h1 { font-size: clamp(48px, 8vw, 96px); margin: 16px 0 24px; letter-spacing: -.05em; line-height: 1.05; }
.svc-sub { font-size: clamp(16px, 1.4vw, 18px); color: rgba(255,255,255,.5); line-height: 1.75; max-width: 52ch; margin-bottom: 40px; }

.svc-hero-stats {
  display: flex; align-items: center; gap: 32px; flex-wrap: wrap;
  margin-bottom: 40px;
}
.svc-stat-divider { width: 1px; height: 36px; background: rgba(255,255,255,.1); }
.svc-stat-num { display: block; font-size: 22px; font-weight: 800; color: #fff; letter-spacing: -.03em; line-height: 1.1; }
.svc-stat-label { display: block; font-size: 12px; color: rgba(255,255,255,.35); margin-top: 2px; }
.svc-hero-cta { align-self: flex-start; }

/* ═══ SERVICE LIST ═══ */
.svc-list-section { padding: 80px 0; }

.svc-item {
  display: grid;
  grid-template-columns: 280px 1fr auto;
  gap: 48px;
  align-items: start;
  padding: 48px 0;
  border-bottom: 1px solid rgba(255,255,255,.06);
}
.svc-item:first-child { border-top: 1px solid rgba(255,255,255,.06); }
@media (max-width: 900px) {
  .svc-item { grid-template-columns: 1fr; gap: 24px; }
}

.svc-item-header { display: flex; align-items: flex-start; gap: 16px; }
.svc-item-icon {
  width: 52px; height: 52px; flex-shrink: 0;
  border-radius: var(--r-lg);
  background: color-mix(in srgb, var(--c) 12%, rgba(13,27,53,1));
  border: 1px solid color-mix(in srgb, var(--c) 25%, transparent);
  display: flex; align-items: center; justify-content: center;
  color: var(--c);
  margin-top: 2px;
}
.svc-item-eyebrow { font-size: 11px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: rgba(255,255,255,.25); display: block; margin-bottom: 6px; }
.svc-item-title { font-size: clamp(18px, 2vw, 24px); font-weight: 800; color: #fff; letter-spacing: -.03em; line-height: 1.2; }

.svc-item-body { display: flex; flex-direction: column; gap: 28px; }
.svc-item-desc { font-size: 15px; color: rgba(255,255,255,.5); line-height: 1.8; }

.svc-deliverables {}
.svc-deliv-label { font-size: 11px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: rgba(255,255,255,.25); margin-bottom: 12px; }
.svc-deliv-list { list-style: none; display: flex; flex-direction: column; gap: 8px; }
.svc-deliv-item { display: flex; align-items: center; gap: 10px; font-size: 13px; color: rgba(255,255,255,.55); line-height: 1.4; }
.svc-deliv-dot { width: 6px; height: 6px; border-radius: 50%; flex-shrink: 0; opacity: .8; }

.svc-item-cta { padding-top: 4px; }

/* ═══ PROCESS ═══ */
.svc-process-section { padding: 96px 0; }
.svc-process-title { font-size: clamp(28px, 3.5vw, 48px); color: var(--ink); margin: 12px 0 16px; }
.svc-process-sub { font-size: 16px; color: var(--ink-2); margin-bottom: 56px; max-width: 44ch; }

.svc-process-steps {
  display: grid;
  grid-template-columns: 1fr auto 1fr auto 1fr auto 1fr;
  gap: 0;
  align-items: start;
}
@media (max-width: 860px) {
  .svc-process-steps { grid-template-columns: 1fr; }
  .svc-step-arrow { display: none; }
}

.svc-step { padding: 0 24px 0 0; }
.svc-step-num {
  font-size: clamp(36px, 4vw, 52px);
  font-weight: 900;
  color: color-mix(in srgb, var(--violet) 20%, var(--pearl));
  letter-spacing: -.05em;
  line-height: 1;
  margin-bottom: 16px;
}
.svc-step-title { font-size: 17px; font-weight: 700; color: var(--ink); margin-bottom: 10px; }
.svc-step-body { font-size: 14px; color: var(--ink-2); line-height: 1.7; }
.svc-step-arrow {
  font-size: 20px;
  color: color-mix(in srgb, var(--violet) 30%, var(--pearl));
  align-self: center;
  padding: 0 8px;
  margin-top: -24px;
}

/* ═══ ENGAGEMENT MODELS ═══ */
.svc-engage-section { padding: 80px 0; }
.svc-engage-title { margin-bottom: 12px; }
.svc-engage-sub { font-size: 16px; color: rgba(255,255,255,.4); margin-bottom: 48px; }
.svc-engage-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
@media (max-width: 760px) { .svc-engage-grid { grid-template-columns: 1fr; } }

.svc-engage-card {
  padding: 32px;
  border-radius: var(--r-xl);
  border: 1px solid rgba(255,255,255,.07);
  background: rgba(255,255,255,.03);
  display: flex; flex-direction: column; gap: 16px;
}
.svc-engage-card--featured {
  border-color: rgba(139,47,248,.3);
  background: rgba(109,0,245,.08);
  position: relative;
}
.svc-engage-badge {
  position: absolute; top: -12px; left: 24px;
  background: var(--violet); color: #fff;
  font-size: 10px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase;
  padding: 4px 12px; border-radius: 999px;
}
.svc-engage-name { font-size: 18px; font-weight: 800; color: #fff; letter-spacing: -.03em; }
.svc-engage-desc { font-size: 13px; color: rgba(255,255,255,.45); line-height: 1.75; flex: 1; }
.svc-engage-list { list-style: none; display: flex; flex-direction: column; gap: 8px; }
.svc-engage-list li {
  font-size: 13px; color: rgba(255,255,255,.5);
  padding-left: 16px; position: relative; line-height: 1.4;
}
.svc-engage-list li::before { content: '–'; position: absolute; left: 0; color: rgba(255,255,255,.2); }
.svc-engage-card--featured .svc-engage-list li { color: rgba(255,255,255,.7); }

/* ═══ CONTACT ═══ */
.svc-contact { padding: 100px 0; position: relative; overflow: hidden; }
.svc-contact-glow {
  position: absolute; inset: 0; pointer-events: none;
  background:
    radial-gradient(ellipse 60% 70% at 20% 110%, rgba(255,10,48,.15) 0%, transparent 65%),
    radial-gradient(ellipse 45% 55% at 85% -5%, rgba(0,207,255,.1) 0%, transparent 55%);
}
.svc-contact-inner {
  position: relative; z-index: 1;
  display: grid; grid-template-columns: 1fr 1.4fr; gap: 80px; align-items: start;
}
@media (max-width: 820px) { .svc-contact-inner { grid-template-columns: 1fr; gap: 48px; } }

.svc-contact-h2 { font-size: clamp(32px, 5vw, 60px); color: #fff; margin-bottom: 16px; }
