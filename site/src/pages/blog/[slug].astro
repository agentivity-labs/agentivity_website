---
// One blog article. The articles are Markdown files in src/content/blog; the texts around them come from the "blog_page" block.
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import GitHubIcon from '../../components/GitHubIcon.astro';
import type { Lang } from '../../i18n/utils';
import { useTranslations } from '../../i18n/utils';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id.replace(/\.(md|mdx)$/, '') },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const slug = (id: string) => id.replace(/\.(md|mdx)$/, '');

const lang = (post.data.lang ?? 'en') as Lang;
const t = useTranslations(lang);
const p = t.blog_page;
const formatDate = (date: Date) => date.toLocaleDateString(lang === 'fr' ? 'fr-FR' : 'en-US', { year: 'numeric', month: 'long', day: 'numeric' });

const related = (await getCollection('blog'))
  .filter((other) => other.data.lang !== 'fr' && !other.data.draft)
  .filter((other) => other.id !== post.id && other.data.tags.some((tag) => post.data.tags.includes(tag)))
  .slice(0, 3);

const posting = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.pubDate.toISOString(),
  author: { '@type': 'Organization', name: post.data.author },
  publisher: { '@type': 'Organization', name: 'Agentivity', url: 'https://www.agentivity.io' },
  url: 'https://www.agentivity.io/blog/' + slug(post.id),
};
const faq = post.data.faq;
const schema = faq.length === 0 ? posting : [posting, {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((item) => ({ '@type': 'Question', name: item.q, acceptedAnswer: { '@type': 'Answer', text: item.a } })),
}];
---
<Base title={post.data.title + ' | Agentivity'} description={post.data.description} schema={schema} lang={lang} look="editorial">

<SiteHeader lang={lang} />

<main class="ed-page">

  <header class="ed-wrap bp-hero">
    <a class="bp-back" href="/blog">{p.back}</a>
    <p class="bp-meta">
      <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
      {post.data.tags.map((tag) => <span class="bp-tag">{tag}</span>)}
    </p>
    <h1>{post.data.title}</h1>
    <p class="bp-desc">{post.data.description}</p>
    <p class="bp-author">{post.data.author}</p>
  </header>

  <div class="ed-wrap bp-layout">
    <article class="bp-prose">
      <Content />
      {faq.length > 0 && (
        <section class="bp-faq">
          <h2>{p.faq_title}</h2>
          {faq.map((item) => (
            <details>
              <summary>{item.q}</summary>
              <p>{item.a}</p>
            </details>
          ))}
        </section>
      )}
    </article>
    <aside class="bp-aside">
      <p class="bp-aside-label">{p.aside.label}</p>
      <p>{p.aside.body}</p>
      <a class="ed-btn ed-btn--sm ed-btn--navy" href={p.aside.how_href}>{p.aside.how}</a>
      <a class="bp-aside-github" href={t.site.github_href} target="_blank" rel="noopener noreferrer"><GitHubIcon />{t.site.github}</a>
    </aside>
  </div>

  {related.length > 0 && (
    <section class="ed-band--mist">
      <div class="ed-wrap ed-sec">
        <h2 class="ed-h2 ed-h2--md bp-related-title">{p.keep_reading}</h2>
        <ul class="bp-related">
          {related.map((other) => (
            <li>
              <a href={'/blog/' + slug(other.id)}>
                <time datetime={other.data.pubDate.toISOString()}>{formatDate(other.data.pubDate)}</time>
                <strong>{other.data.title}</strong>
                <span>{p.read}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

</main>

<SiteFooter lang={lang} />

</Base>

<style>
/* ---------- header ---------- */
.bp-hero { display: flex; flex-direction: column; align-items: flex-start; gap: 20px; padding-block: clamp(40px, 5vw, 72px) clamp(32px, 4vw, 48px); }
.bp-back { font-size: 15.5px; font-weight: 600; color: var(--ed-ink-2); }
.bp-back::before { content: "← "; }
.bp-back:hover { color: var(--ed-ink); }
.bp-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 12px; font-size: 14.5px; font-weight: 600; color: var(--ed-ink-3); }
.bp-tag { padding: 3px 10px; border-radius: 999px; background: var(--ed-mist); font-size: 12.5px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; color: var(--ed-ink); }
.bp-hero h1 { font-family: var(--ed-serif); font-size: clamp(38px, 5.2vw, 72px); line-height: 1.02; letter-spacing: -.015em; text-wrap: balance; max-width: 18em; }
.bp-desc { font-size: clamp(19px, 1.8vw, 23px); line-height: 1.5; color: var(--ed-ink-2); max-width: 36em; }
.bp-author { font-size: 15px; font-weight: 600; color: var(--ed-ink-3); }

/* ---------- article and aside ---------- */
.bp-layout { display: grid; grid-template-columns: minmax(0, 1fr) 300px; gap: clamp(32px, 5vw, 80px); align-items: start; padding-bottom: clamp(64px, 8vw, 112px); }
.bp-prose { max-width: 44em; padding-top: clamp(28px, 3vw, 40px); border-top: 2px solid var(--ed-ink); font-size: 19px; line-height: 1.7; color: var(--ed-ink-2); }
.bp-prose :global(h2) { margin: 56px 0 16px; font-family: var(--ed-serif); font-size: clamp(30px, 3.2vw, 42px); line-height: 1.08; color: var(--ed-ink); }
.bp-prose :global(h3) { margin: 36px 0 10px; font-size: 22px; font-weight: 700; line-height: 1.25; color: var(--ed-ink); }
.bp-prose :global(p) { margin-bottom: 20px; }
.bp-prose :global(strong) { font-weight: 700; color: var(--ed-ink); }
.bp-prose :global(a) { font-weight: 600; color: var(--ed-ink); text-decoration: underline; text-decoration-thickness: 1.5px; text-underline-offset: 3px; }
.bp-prose :global(a:hover) { opacity: .7; }
.bp-prose :global(ul), .bp-prose :global(ol) { margin: 0 0 20px; padding-left: 24px; display: flex; flex-direction: column; gap: 8px; }
.bp-prose :global(ul) { list-style: disc; }
.bp-prose :global(ol) { list-style: decimal; }
.bp-prose :global(code) { font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; font-size: .86em; background: var(--ed-mist); border-radius: 6px; padding: 2px 6px; color: var(--ed-ink); }
.bp-prose :global(pre) { margin: 24px 0; padding: 20px 24px; border-radius: 16px; background: var(--ed-navy); color: #fff; overflow-x: auto; font-size: 14.5px; line-height: 1.65; }
.bp-prose :global(pre code) { background: none; padding: 0; color: inherit; font-size: inherit; }
.bp-prose :global(blockquote) { margin: 28px 0; padding-left: 20px; border-left: 3px solid var(--ed-yellow); font-family: var(--ed-serif); font-style: italic; font-size: 24px; line-height: 1.35; color: var(--ed-ink); }
.bp-prose :global(hr) { margin: 48px 0; border: 0; border-top: 1px solid var(--ed-line-2); }
.bp-prose :global(table) { width: 100%; margin: 24px 0; border-collapse: collapse; font-size: 16px; }
.bp-prose :global(th) { text-align: left; padding: 10px 14px; font-size: 12.5px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; color: var(--ed-ink); border-bottom: 2px solid var(--ed-ink); }
.bp-prose :global(td) { padding: 12px 14px; border-bottom: 1px solid var(--ed-line-2); vertical-align: top; }
.bp-prose :global(img) { max-width: 100%; height: auto; border-radius: 16px; }
.bp-prose :global(figure) { margin: 32px 0; }
.bp-prose :global(video) { display: block; width: 100%; height: auto; border-radius: 16px; border: 1px solid var(--ed-line-2); background: var(--ed-mist); }
.bp-prose :global(figcaption) { margin-top: 10px; font-size: 14.5px; line-height: 1.5; color: var(--ed-ink-3); }

.bp-faq { margin-top: 56px; }
.bp-faq h2 { margin: 0 0 16px; font-family: var(--ed-serif); font-size: clamp(30px, 3.2vw, 42px); line-height: 1.08; color: var(--ed-ink); }
.bp-faq details { border-bottom: 1px solid var(--ed-line-2); }
.bp-faq details:first-of-type { border-top: 2px solid var(--ed-ink); }
.bp-faq summary { list-style: none; cursor: pointer; display: flex; align-items: center; justify-content: space-between; gap: 20px; padding-block: 18px; font-size: 19px; font-weight: 700; color: var(--ed-ink); }
.bp-faq summary::-webkit-details-marker { display: none; }
.bp-faq summary::after { content: "+"; flex: none; font-family: var(--ed-serif); font-size: 32px; line-height: 1; font-weight: 400; }
.bp-faq details[open] summary::after { content: "–"; }
.bp-faq details p { margin: 0; padding-bottom: 20px; }

.bp-aside { position: sticky; top: 104px; display: flex; flex-direction: column; align-items: flex-start; gap: 14px; padding: 24px; border-radius: 22px; background: var(--ed-mist); font-size: 16.5px; color: var(--ed-ink-2); }
.bp-aside-label { font-size: 12.5px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; color: var(--ed-ink); }
.bp-aside-github { display: inline-flex; align-items: center; gap: 8px; min-height: 44px; font-size: 16px; font-weight: 600; color: var(--ed-ink); border-bottom: 1.5px solid currentColor; }
.bp-aside-github :global(svg) { width: 18px; height: 18px; }

/* ---------- keep reading ---------- */
.bp-related-title { margin-bottom: clamp(24px, 3vw, 36px); }
.bp-related { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(320px, 100%), 1fr)); gap: 16px; }
.bp-related a { display: flex; flex-direction: column; gap: 12px; height: 100%; background: #fff; border-radius: 22px; padding: 24px; color: var(--ed-ink-2); font-size: 15px; }
.bp-related time { font-size: 14px; font-weight: 600; color: var(--ed-ink-3); }
.bp-related strong { flex: 1; font-family: var(--ed-serif); font-weight: 400; font-size: 26px; line-height: 1.12; color: var(--ed-ink); }
.bp-related span { align-self: flex-start; font-weight: 700; color: var(--ed-ink); border-bottom: 1.5px solid currentColor; }

@media (max-width: 900px) {
  .bp-layout { grid-template-columns: minmax(0, 1fr); }
  .bp-aside { position: static; }
  .bp-prose { font-size: 18px; }
}
</style>
