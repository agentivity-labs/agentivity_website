---
// The English blog articles: src/content/blog/<slug>.md, served at /blog/<slug>.
import { getCollection } from 'astro:content';
import BlogArticlePage from '../../components/BlogArticlePage.astro';
import { blogSlug, isLang } from '../../lib/blog';

export async function getStaticPaths() {
  const posts = await getCollection('blog', (post) => !post.data.draft && isLang(post, 'en'));
  return posts.map((post) => ({ params: { slug: blogSlug(post.id) }, props: { post } }));
}
const { post } = Astro.props;
---
<BlogArticlePage post={post} />
