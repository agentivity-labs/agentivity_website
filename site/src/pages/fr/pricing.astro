---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import WaitlistForm from '../../components/WaitlistForm.astro';

const lang = 'fr';

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Offer",
    "name": "Gratuit — Auto-hébergé",
    "price": "0",
    "priceCurrency": "USD",
    "description": "Open source, Docker, agents et équipes illimités. Apporte ta propre clé API."
  },
  {
    "@context": "https://schema.org",
    "@type": "Offer",
    "name": "Enterprise",
    "description": "SSO, RBAC, journaux d'audit, gestion budgétaire, white-label, support dédié."
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      { "@type": "Question", "name": "Le plan Gratuit est-il vraiment gratuit ?", "acceptedAnswer": { "@type": "Answer", "text": "Oui. Open source, auto-hébergé, sans limite dans le temps. Tu as besoin de Docker et de ta propre clé API. C'est tout." } },
      { "@type": "Question", "name": "C'est quoi Docker ?", "acceptedAnswer": { "@type": "Answer", "text": "Un outil qui fait tourner Agentivity sur ta machine ou ton serveur en une seule commande. Guide complet dans la documentation." } },
      { "@type": "Question", "name": "Ai-je besoin d'une clé API ?", "acceptedAnswer": { "@type": "Answer", "text": "Oui — pour tous les plans. Tu connectes ta propre clé Anthropic, OpenAI ou tout fournisseur compatible. Nous ne touchons jamais à tes tokens et ne majorons pas ton usage." } },
      { "@type": "Question", "name": "Quand les plans cloud seront-ils disponibles ?", "acceptedAnswer": { "@type": "Answer", "text": "Nous y travaillons. Rejoins la liste d'attente — tu seras notifié en premier et auras accès aux tarifs de lancement." } },
      { "@type": "Question", "name": "Puis-je utiliser Agentivity en marque blanche pour mes clients ?", "acceptedAnswer": { "@type": "Answer", "text": "Oui — le plan Enterprise inclut des options white-label. Tu construis sur Agentivity, tu livres sous ta marque." } },
      { "@type": "Question", "name": "Quelle est la différence entre Gratuit et Enterprise ?", "acceptedAnswer": { "@type": "Answer", "text": "Gratuit est auto-hébergé, soutenu par la communauté, et nécessite Docker. Enterprise ajoute SSO, journaux d'audit, option on-premise, white-label, SLA et support dédié — conçu pour les organisations avec des exigences de conformité et de gouvernance." } }
    ]
  }
];
---
<Base
  title="Tarifs Agentivity — Gratuit Open Source, Cloud & Enterprise"
  description="Commence gratuitement avec Docker — agents illimités, sans limite de temps. Plans cloud à venir. Enterprise : SSO, journaux d'audit, white-label. Apporte ta propre clé API."
  schema={schema}
>
  <Nav lang={lang} />

  <!-- ══════════════════════════════════════════════════════
       HERO
  ══════════════════════════════════════════════════════ -->
  <section class="s-black pr-hero">
    <div class="pr-hero-bg" aria-hidden="true"></div>
    <div class="wrap pr-hero-inner">
      <span class="eyebrow" style="color:var(--mint)">Tarifs</span>
      <h1 class="h1 pr-h1">Simple, transparent,<br /><span class="grad-text">sans surprise.</span></h1>
      <p class="pr-sub">
        Open source au cœur — auto-héberge gratuitement, pour toujours.<br class="br-md" />
        Le cloud quand tu en as besoin. Tes clés API, toujours.
      </p>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════════════
       PRICING CARDS
  ══════════════════════════════════════════════════════ -->
  <section class="s-navy pr-cards-section">
    <div class="wrap">

      <!-- ── Disponible maintenant ── -->
      <div class="pr-tier-label">
        <span class="pr-tier-badge pr-tier-badge--live">
          <span class="live-dot"></span>Disponible maintenant
        </span>
      </div>

      <div class="pr-free-card">
        <div class="pr-free-left">
          <div class="pr-free-price">
            <span class="pr-price-num">0 €</span>
            <span class="pr-price-note">pour toujours · auto-hébergé</span>
          </div>
          <h2 class="pr-plan-name">Gratuit</h2>
          <p class="pr-plan-tag">Auto-hébergé. Contrôle total.</p>
          <p class="pr-free-desc">
            La plateforme d'agents IA auto-hébergée la plus flexible — gratuite, pour toujours, sans plafond d'usage.
            Ton infrastructure, tes données, tes règles.
          </p>
          <div class="pr-free-ctas">
            <a href="https://github.com/agentivity-labs/agentivity" target="_blank" rel="noopener noreferrer" class="btn btn-primary lg">
              <svg viewBox="0 0 24 24" fill="currentColor" width="18" height="18"><path d="M12 .3a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2c-3.3.7-4-1.6-4-1.6-.6-1.4-1.4-1.8-1.4-1.8-1-.7.1-.7.1-.7 1.2 0 1.8 1.2 1.8 1.2 1 1.8 2.8 1.3 3.5 1 0-.8.4-1.3.7-1.6-2.7-.3-5.5-1.3-5.5-5.9 0-1.3.5-2.4 1.2-3.2 0-.4-.5-1.6.2-3.2 0 0 1-.3 3.3 1.2a11.5 11.5 0 0 1 6 0c2.3-1.5 3.3-1.2 3.3-1.2.7 1.6.2 2.8.1 3.2.8.8 1.2 1.9 1.2 3.2 0 4.6-2.8 5.6-5.5 5.9.5.4.9 1 .9 2.2v3.3c0 .3.2.7.8.6A12 12 0 0 0 12 .3"/></svg>
              Étoiler sur GitHub
            </a>
            <a href="/fr/how-it-works" class="btn btn-ghost">Comment ça marche</a>
          </div>
          <p class="pr-free-note">
            Pas encore sur Docker ? La version cloud arrive —
            <a href="#liste-attente" class="pr-note-link">rejoins la liste →</a>
          </p>
        </div>

        <div class="pr-free-right">
          <ul class="pr-features">
            <li class="pr-feature">
              <span class="pr-feat-check" style="color:var(--mint)">✓</span>
              <div>
                <span class="pr-feat-name">Agents &amp; équipes illimités</span>
                <span class="pr-feat-desc">Aucun plafond sur ce que tu construis</span>
              </div>
            </li>
            <li class="pr-feature">
              <span class="pr-feat-check" style="color:var(--mint)">✓</span>
              <div>
                <span class="pr-feat-name">Toutes les topologies</span>
                <span class="pr-feat-desc">Séquentiel · Group Chat · Concurrent</span>
              </div>
            </li>
            <li class="pr-feature">
              <span class="pr-feat-check" style="color:var(--mint)">✓</span>
              <div>
                <span class="pr-feat-name">Bibliothèque de templates Synergi</span>
                <span class="pr-feat-desc">Équipes préconstruites, prêtes à personnaliser</span>
              </div>
            </li>
            <li class="pr-feature">
              <span class="pr-feat-check" style="color:var(--mint)">✓</span>
              <div>
                <span class="pr-feat-name">Apporte ta propre clé API</span>
                <span class="pr-feat-desc">Anthropic · OpenAI · tout fournisseur compatible</span>
              </div>
            </li>
            <li class="pr-feature">
              <span class="pr-feat-check" style="color:var(--mint)">✓</span>
              <div>
                <span class="pr-feat-name">Support communautaire</span>
                <span class="pr-feat-desc">Discord · GitHub Issues</span>
              </div>
            </li>
            <li class="pr-feature">
              <span class="pr-feat-check" style="color:var(--mint)">✓</span>
              <div>
                <span class="pr-feat-name">Open source · Licence Sustainable Use</span>
                <span class="pr-feat-desc">Audite le code. Lance-le n'importe où.</span>
              </div>
            </li>
          </ul>
        </div>
      </div>

      <!-- ── Bientôt disponible ── -->
      <div class="pr-tier-label" style="margin-top:56px">
        <span class="pr-tier-badge">
          🔜 Plans cloud — bientôt disponibles
        </span>
      </div>

      <div class="pr-cloud-grid">

        <!-- Personal -->
        <div class="pr-card">
          <div class="pr-card-top">
            <h3 class="pr-card-name">Personnel</h3>
            <p class="pr-card-tag">Hébergé dans le cloud. Sans installation.</p>
          </div>
          <ul class="pr-card-features">
            <li>Tout ce qu'inclut Gratuit</li>
            <li>Hébergé dans le cloud — pas besoin de Docker</li>
            <li>Espace de travail unique</li>
            <li>Support par email</li>
          </ul>
          <a href="#liste-attente" class="btn btn-ghost pr-card-btn">Rejoindre la liste</a>
          <p class="pr-card-note">En premier, tarif de lancement.</p>
        </div>

        <!-- Pro — highlighted -->
        <div class="pr-card pr-card--pro">
          <div class="pr-popular-badge">Le plus populaire</div>
          <div class="pr-card-top">
            <h3 class="pr-card-name">Pro</h3>
            <p class="pr-card-tag">Plus de puissance. Même simplicité.</p>
          </div>
          <ul class="pr-card-features">
            <li>Tout ce qu'inclut Personnel</li>
            <li>Plus d'agents · Plus d'exécutions</li>
            <li>Analytiques avancées</li>
            <li>Support prioritaire</li>
          </ul>
          <a href="#liste-attente" class="btn btn-primary pr-card-btn">Rejoindre la liste</a>
          <p class="pr-card-note">En premier, tarif de lancement.</p>
        </div>

        <!-- Business -->
        <div class="pr-card">
          <div class="pr-card-top">
            <h3 class="pr-card-name">Business</h3>
            <p class="pr-card-tag">Conçu pour les équipes.</p>
          </div>
          <ul class="pr-card-features">
            <li>Tout ce qu'inclut Pro</li>
            <li>Espaces de travail multiples</li>
            <li>Gestion d'équipe &amp; collaboration</li>
            <li>Suivi d'usage par espace de travail</li>
          </ul>
          <a href="#liste-attente" class="btn btn-ghost pr-card-btn">Rejoindre la liste</a>
          <p class="pr-card-note">En premier, tarif de lancement.</p>
        </div>

        <!-- Enterprise -->
        <div class="pr-card pr-card--enterprise">
          <div class="pr-card-top">
            <h3 class="pr-card-name">Enterprise</h3>
            <p class="pr-card-tag">Niveau entreprise. Ton infra ou la nôtre.</p>
          </div>
          <ul class="pr-card-features">
            <li>Tout ce qu'inclut Business</li>
            <li>SSO / SAML · Option on-premise</li>
            <li>Journaux d'audit · Gestion budgétaire</li>
            <li>White-label — vends sous ta marque</li>
            <li>Support dédié · SLA</li>
          </ul>
          <a href="mailto:hello@agentivity.io" class="btn btn-ghost pr-card-btn">Nous contacter</a>
          <p class="pr-card-note">Besoin d'onboarding ? Nous animons des sessions pour équipes et agences.</p>
        </div>

      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════════════
       BYOK — Apporte ta propre clé
  ══════════════════════════════════════════════════════ -->
  <section class="s-pearl byok-section">
    <div class="wrap byok-wrap">
      <div class="byok-intro">
        <span class="eyebrow" style="color:var(--violet)">BYOK — Apporte ta propre clé</span>
        <h2 class="h2 byok-h2">Tu contrôles tes<br />clés API. Toujours.</h2>
        <p class="byok-body">
          Agentivity ne fournit pas de tokens LLM et ne majore pas les prix. Connecte ta propre clé — et paye ton fournisseur directement.
          Compatible avec tout fournisseur OpenAI-compatible, pas seulement Anthropic et OpenAI.
        </p>
      </div>

      <div class="byok-pillars">

        <div class="byok-pillar">
          <div class="byok-icon" style="--c:var(--mint)">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="24" height="24">
              <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/>
            </svg>
          </div>
          <h3 class="byok-pillar-title">Tes données</h3>
          <p class="byok-pillar-body">Tes prompts, tes sorties, tes configurations d'agents ne transitent jamais par notre infrastructure. Tout reste entre toi et ton fournisseur LLM.</p>
        </div>

        <div class="byok-pillar">
          <div class="byok-icon" style="--c:var(--cyan)">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="24" height="24">
              <circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/>
            </svg>
          </div>
          <h3 class="byok-pillar-title">Tes coûts</h3>
          <p class="byok-pillar-body">On ne s'interpose pas entre toi et le token. Pas de majoration, pas de frais cachés. Tu sais exactement ce que tu dépenses — parce que tu paies le fournisseur directement.</p>
        </div>

        <div class="byok-pillar">
          <div class="byok-icon" style="--c:var(--violet-l)">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="24" height="24">
              <rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/>
            </svg>
          </div>
          <h3 class="byok-pillar-title">Ton contrôle</h3>
          <p class="byok-pillar-body">Anthropic, OpenAI, Mistral, ou tout endpoint compatible OpenAI y compris les modèles locaux. Change de fournisseur, tourne les clés, pose des limites — sans demander la permission.</p>
        </div>

      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════════════
       LICENCE
  ══════════════════════════════════════════════════════ -->
  <section class="s-navy licence-section">
    <div class="wrap licence-wrap">
      <div class="licence-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="32" height="32">
          <path d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0 1 12 2.944a11.955 11.955 0 0 1-8.618 3.04A12.02 12.02 0 0 0 3 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
        </svg>
      </div>
      <div class="licence-text">
        <h2 class="h3 licence-title">Un mot sur notre licence.</h2>
        <p class="licence-body">
          Agentivity est disponible en source ouverte sous la licence Agentivity Sustainable Use.
          Le code est public et auditable. Gratuit pour un usage personnel et commercial interne.
        </p>
        <p class="licence-body">
          Une seule limite : tu ne peux pas l'utiliser pour créer une plateforme concurrente. C'est tout.
        </p>
        <a href="https://github.com/agentivity-labs/agentivity/blob/main/LICENCE.md" target="_blank" rel="noopener noreferrer" class="licence-link">
          Lire la licence complète →
        </a>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════════════
       FAQ
  ══════════════════════════════════════════════════════ -->
  <section class="s-black faq-section">
    <div class="wrap faq-wrap">
      <h2 class="h2" style="color:#fff;margin-bottom:48px">Questions fréquentes</h2>

      <div class="faq-list">

        <details class="faq-item" open>
          <summary class="faq-q">Le plan Gratuit est-il vraiment gratuit ?</summary>
          <div class="faq-a">Oui. Open source, auto-hébergé, sans limite dans le temps. Tu as besoin de Docker et de ta propre clé API. C'est tout. Pas de carte de crédit, pas de période d'essai, pas de "plan gratuit" avec des plafonds artificiels.</div>
        </details>

        <details class="faq-item">
          <summary class="faq-q">C'est quoi Docker ?</summary>
          <div class="faq-a">
            Un outil qui fait tourner Agentivity sur ta machine ou ton serveur en une seule commande. Guide complet dans la
            <a href="/fr/docs" class="faq-link">documentation →</a>
          </div>
        </details>

        <details class="faq-item">
          <summary class="faq-q">Ai-je besoin d'une clé API ?</summary>
          <div class="faq-a">Oui — pour tous les plans. Tu connectes ta propre clé Anthropic, OpenAI ou tout fournisseur compatible. Nous ne touchons jamais à tes tokens et ne majorons pas ton usage. <a href="/fr/docs" class="faq-link">Comment obtenir une clé API →</a></div>
        </details>

        <details class="faq-item">
          <summary class="faq-q">Quand les plans cloud seront-ils disponibles ?</summary>
          <div class="faq-a">Nous y travaillons. Rejoins la liste d'attente ci-dessous — tu seras notifié en premier et auras accès aux tarifs de lancement avant leur publication.</div>
        </details>

        <details class="faq-item">
          <summary class="faq-q">Puis-je utiliser Agentivity en marque blanche pour mes clients ?</summary>
          <div class="faq-a">Oui — le plan Enterprise inclut des options white-label. Tu construis sur Agentivity, tu livres sous ta marque. <a href="mailto:hello@agentivity.io" class="faq-link">Nous contacter →</a></div>
        </details>

        <details class="faq-item">
          <summary class="faq-q">Quelle est la différence entre Gratuit et Enterprise ?</summary>
          <div class="faq-a">Gratuit est auto-hébergé, soutenu par la communauté, et nécessite Docker. Enterprise ajoute SSO, journaux d'audit, option on-premise, white-label, SLA et support dédié — conçu pour les organisations avec des exigences de conformité et de gouvernance.</div>
        </details>

      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════════════
       CTA — Formulaire liste d'attente
  ══════════════════════════════════════════════════════ -->
  <section class="s-violet pr-cta" id="liste-attente">
    <div class="pr-cta-glow" aria-hidden="true"></div>
    <div class="wrap pr-cta-inner">

      <div class="pr-cta-text">
        <h2 class="h2 pr-cta-h2">
          Le cloud<br /><span class="grad-text">arrive.</span>
        </h2>
        <p class="pr-cta-sub">
          Rejoins la liste — en premier, tarif de lancement, zéro spam.
        </p>
        <p class="pr-cta-note">On ne t'écrit que quand ça compte.</p>
      </div>

      <div class="pr-form-wrap">
        <div class="pr-form">
          <WaitlistForm lang={lang} informal />

          <p class="pr-form-note">
            <svg viewBox="0 0 20 20" fill="currentColor" width="12" height="12" style="opacity:.4"><path fill-rule="evenodd" d="M5 9V7a5 5 0 0 1 10 0v2a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2zm8-2v2H7V7a3 3 0 0 1 6 0z" clip-rule="evenodd"/></svg>
            Pas de spam. Juste les mises à jour importantes. Désabonnement à tout moment.
          </p>
        </div>

        <div class="pr-social-proof">
          <div class="pr-sp-avatars">
            <div class="sp-av" style="--c:var(--mint)">A</div>
            <div class="sp-av" style="--c:var(--cyan)">J</div>
            <div class="sp-av" style="--c:var(--red)">M</div>
            <div class="sp-av" style="--c:var(--violet-l)">+</div>
          </div>
          <p class="pr-sp-text">Rejoins les premiers builders déjà sur la liste</p>
        </div>
      </div>

    </div>
  </section>

  <Footer lang={lang} />

</Base>

<script>
  // FAQ accordion
  document.querySelectorAll<HTMLDetailsElement>('.faq-item').forEach(detail => {
    detail.addEventListener('toggle', () => {
      if (detail.open) {
        document.querySelectorAll<HTMLDetailsElement>('.faq-item').forEach(other => {
          if (other !== detail) other.open = false;
        });
      }
    });
  });
</script>

<style>
/* ════════════════════════════════════════════════════
   HERO
════════════════════════════════════════════════════ */
.pr-hero {
  padding: 120px 0 72px;
  position: relative;
  overflow: hidden;
}
.pr-hero-bg {
  position: absolute;
  inset: 0;
  background: radial-gradient(ellipse 60% 60% at 50% 0%, rgba(109,0,245,.12) 0%, transparent 70%);
  pointer-events: none;
}
.pr-hero-inner {
  position: relative;
  z-index: 1;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.pr-h1 {
  font-size: clamp(48px, 8vw, 100px);
  margin-top: 20px;
}
.pr-sub {
  margin-top: 20px;
  font-size: clamp(16px, 1.4vw, 18px);
  color: rgba(255,255,255,.45);
  line-height: 1.7;
  max-width: 50ch;
}
.br-md { display: none; }
@media (min-width: 640px) { .br-md { display: initial; } }

/* ════════════════════════════════════════════════════
   PRICING CARDS SECTION
════════════════════════════════════════════════════ */
.pr-cards-section { padding: 72px 0 96px; }

.pr-tier-label { margin-bottom: 20px; }
.pr-tier-badge {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  font-size: 12px;
  font-weight: 700;
  letter-spacing: .08em;
  text-transform: uppercase;
  color: rgba(255,255,255,.4);
  padding: 6px 14px;
  border-radius: 999px;
  border: 1px solid rgba(255,255,255,.1);
  background: rgba(255,255,255,.04);
}
.pr-tier-badge--live { color: var(--mint); border-color: rgba(0,200,150,.25); background: rgba(0,200,150,.07); }
.live-dot {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: var(--mint);
  box-shadow: 0 0 6px var(--mint);
  animation: pulse 2s ease-in-out infinite;
}
@keyframes pulse {
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: .6; transform: scale(.85); }
}

/* Free card — large, confident */
.pr-free-card {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 0;
  border-radius: var(--r-xl);
  border: 1px solid rgba(0,200,150,.2);
  background: rgba(0,200,150,.04);
  overflow: hidden;
}
@media (max-width: 820px) { .pr-free-card { grid-template-columns: 1fr; } }

.pr-free-left {
  padding: 48px;
  border-right: 1px solid rgba(0,200,150,.12);
  display: flex;
  flex-direction: column;
}
@media (max-width: 820px) {
  .pr-free-left { border-right: none; border-bottom: 1px solid rgba(0,200,150,.12); }
}
.pr-free-right {
  padding: 48px;
}
@media (max-width: 600px) {
  .pr-free-left, .pr-free-right { padding: 28px 24px; }
}

.pr-free-price {
  display: flex;
  align-items: baseline;
  gap: 12px;
  margin-bottom: 16px;
}
.pr-price-num {
  font-size: clamp(40px, 5vw, 60px);
  font-weight: 900;
  color: var(--mint);
  letter-spacing: -.05em;
