---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';

const lang = 'fr';

const schema = {
  "@context": "https://schema.org",
  "@type": "HowTo",
  "name": "Comment créer une équipe d'agents IA avec Agentivity",
  "description": "Place des agents sur un canvas visuel, choisis une topologie d'équipe, et lance. Sans écrire de code.",
  "step": [
    { "@type": "HowToStep", "name": "Composer", "text": "Place les agents sur ton canvas. Donne à chacun un rôle, des outils et des instructions." },
    { "@type": "HowToStep", "name": "Structurer", "text": "Choisis la topologie de l'équipe — séquentielle, group chat ou concurrente." },
    { "@type": "HowToStep", "name": "Lancer", "text": "Lance ton équipe. Les agents collaborent et livrent automatiquement." }
  ]
};
---
<Base
  title="Comment fonctionne Agentivity — Créer des équipes d'agents IA sans code"
  description="Place des agents sur un canvas visuel, choisis une topologie d'équipe, et lance. Sans écrire de code. Découvrez comment Agentivity combine étapes agentiques et déterministes dans un seul flux."
  schema={schema}
>
  <Nav lang={lang} />

  <!-- ══════════════════════════════════════════════════════
       HERO
  ══════════════════════════════════════════════════════ -->
  <section class="hero-wrap">
    <div class="hero-bg" aria-hidden="true">
      <div class="bg-node bg-node-1"></div>
      <div class="bg-node bg-node-2"></div>
      <div class="bg-node bg-node-3"></div>
      <div class="bg-conn bg-conn-1"></div>
      <div class="bg-conn bg-conn-2"></div>
      <div class="bg-glow"></div>
    </div>

    <div class="wrap hero-inner">
      <div class="hero-label">
        <span class="eyebrow" style="color:var(--red)">Comment ça marche</span>
      </div>
      <h1 class="hero-h1">
        Tu n'écris pas de code.<br />
        <span class="grad-text">Tu construis une équipe.</span>
      </h1>
      <p class="hero-sub">
        Place des agents sur un canvas. Donne-leur des rôles, des outils, des instructions.
        Choisis comment ils collaborent. Lance.
      </p>
      <div class="hero-steps">
        <div class="hs-item">
          <span class="hs-n">01</span>
          <span class="hs-t">Composer les agents</span>
        </div>
        <svg width="40" height="2" aria-hidden="true"><line x1="0" y1="1" x2="40" y2="1" stroke="rgba(255,255,255,.15)" stroke-width="1.5" stroke-dasharray="4 3"/></svg>
        <div class="hs-item">
          <span class="hs-n">02</span>
          <span class="hs-t">Structurer l'équipe</span>
        </div>
        <svg width="40" height="2" aria-hidden="true"><line x1="0" y1="1" x2="40" y2="1" stroke="rgba(255,255,255,.15)" stroke-width="1.5" stroke-dasharray="4 3"/></svg>
        <div class="hs-item">
          <span class="hs-n">03</span>
          <span class="hs-t">Lancer &amp; livrer</span>
        </div>
      </div>
    </div>

    <div class="hero-deco" aria-hidden="true">Pensez à une équipe finance.</div>
  </section>

  <!-- ══════════════════════════════════════════════════════
       METAPHORE
  ══════════════════════════════════════════════════════ -->
  <section class="s-pearl metaphor-section">
    <div class="wrap">
      <div class="metaphor-quote">
        <div class="mq-line"></div>
        <blockquote>
          Un agent trouve les données, un autre les analyse, un troisième rédige le rapport.
          Ils travaillent en séquence, se transmettent les résultats — et toi, tu reçois le livrable, pas le processus.
        </blockquote>
        <p class="mq-attr">C'est Agentivity. <strong style="color:var(--ink)">Tu composes l'équipe. Ils gèrent le reste.</strong></p>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════════════
       STICKY SCROLL — Canvas · Agents · Équipes
  ══════════════════════════════════════════════════════ -->
  <section class="s-navy sticky-section">
    <div class="wrap sticky-wrap">

      <div class="sticky-steps">

        <div class="sticky-step" data-step="0">
          <div class="ss-num">01</div>
          <h2 class="h2" style="color:#fff">Le Canvas</h2>
          <p class="ss-body">
            Ton espace de travail visuel. Place les agents dessus, choisis comment ils sont structurés —
            vois toute l'équipe d'un coup d'œil. Qui fait quoi, dans quel ordre, ce qu'ils produisent.
          </p>
          <ul class="ss-list">
            <li>Placement des agents par glisser-déposer</li>
            <li>Sélection visuelle de la topologie</li>
            <li>Vue d'ensemble de l'équipe en temps réel</li>
          </ul>
        </div>

        <div class="sticky-step" data-step="1">
          <div class="ss-num">02</div>
          <h2 class="h2" style="color:#fff">Les Agents</h2>
          <p class="ss-body">
            Chaque agent a un rôle, un ensemble d'outils et des instructions que tu définis.
            Un Agent de Recherche parcourt le web. Un Agent d'Analyse lit les résultats.
            Un Agent Rédacteur rédige le rapport.
          </p>
          <div class="ss-callout">
            <span class="ss-callout-label">Low-code, pas no-code</span>
            Configurer un agent demande de la rigueur — un rôle clair, des instructions précises,
            les bons outils. Les builders adorent ça.
          </div>
        </div>

        <div class="sticky-step" data-step="2">
          <div class="ss-num">03</div>
          <h2 class="h2" style="color:#fff">Équipes &amp; Topologies</h2>
          <p class="ss-body">
            Choisis la structure de ton équipe. Chaque topologie définit comment les agents interagissent,
            se transmettent l'information et produisent des résultats ensemble.
          </p>
          <p class="ss-example">
            <strong style="color:var(--cyan)">Exemple équipe Finance —</strong>
            <span style="color:rgba(255,255,255,.5)">Agent Recherche → Agent Analyse → Agent Rapport → ta boîte mail.</span>
          </p>
        </div>

      </div>

      <!-- Panneau sticky droit -->
      <div class="sticky-media">
        <div class="sm-frame">

          <!-- Panneau 0 : Canvas -->
          <div class="sm-panel sm-panel--canvas active" data-panel="0">
            <div class="smp-header">
              <span class="smp-dot" style="background:#FF5F57"></span>
              <span class="smp-dot" style="background:#FEBC2E"></span>
              <span class="smp-dot" style="background:#28C840"></span>
              <span class="smp-title">Team Studio</span>
            </div>
            <div class="smp-canvas">
              <div class="smc-node smc-n1">
                <div class="smc-avatar" style="background:var(--cyan)">R</div>
                <span>Recherche</span>
              </div>
              <svg class="smc-svg" viewBox="0 0 260 180" xmlns="http://www.w3.org/2000/svg">
                <defs>
                  <linearGradient id="g1" x1="0%" y1="0%" x2="100%" y2="0%">
                    <stop offset="0%" stop-color="var(--cyan)" stop-opacity=".4"/>
                    <stop offset="100%" stop-color="var(--violet)" stop-opacity=".4"/>
                  </linearGradient>
                  <linearGradient id="g2" x1="0%" y1="0%" x2="100%" y2="0%">
                    <stop offset="0%" stop-color="var(--violet)" stop-opacity=".4"/>
                    <stop offset="100%" stop-color="var(--red)" stop-opacity=".4"/>
                  </linearGradient>
                </defs>
                <path d="M60 40 Q130 40 130 90" stroke="url(#g1)" stroke-width="1.5" fill="none" stroke-dasharray="5 3"/>
                <path d="M130 90 Q130 140 200 140" stroke="url(#g2)" stroke-width="1.5" fill="none" stroke-dasharray="5 3"/>
              </svg>
              <div class="smc-node smc-n2">
                <div class="smc-avatar" style="background:var(--violet)">A</div>
                <span>Analyse</span>
              </div>
              <div class="smc-node smc-n3">
                <div class="smc-avatar" style="background:var(--red)">R</div>
                <span>Rédacteur</span>
              </div>
              <div class="smc-badge">Séquentiel</div>
            </div>
          </div>

          <!-- Panneau 1 : Config agent -->
          <div class="sm-panel sm-panel--agent" data-panel="1">
            <div class="smp-header">
              <span class="smp-dot" style="background:#FF5F57"></span>
              <span class="smp-dot" style="background:#FEBC2E"></span>
              <span class="smp-dot" style="background:#28C840"></span>
              <span class="smp-title">Agent Studio — Agent de Recherche</span>
            </div>
            <div class="smp-agent">
              <div class="spa-top">
                <div class="spa-icon">🔍</div>
                <div>
                  <div class="spa-name">Agent de Recherche</div>
                  <div class="spa-model">gpt-4o · web_search, résumé</div>
                </div>
              </div>
              <div class="spa-field">
                <div class="spa-label">Rôle</div>
                <div class="spa-val">Trouve les 5 actualités concurrentes de la semaine. Résume chacune en 3 points clés.</div>
              </div>
              <div class="spa-field">
                <div class="spa-label">Outils</div>
                <div class="spa-tags">
                  <span class="spa-tag" style="color:var(--cyan);border-color:rgba(0,207,255,.3);background:rgba(0,207,255,.08)">Recherche web</span>
                  <span class="spa-tag" style="color:var(--violet-l);border-color:rgba(109,0,245,.3);background:rgba(109,0,245,.08)">Résumé</span>
                </div>
              </div>
              <div class="spa-field">
                <div class="spa-label">Rapporte à</div>
                <div class="spa-val" style="color:var(--violet-l)">Agent d'Analyse →</div>
              </div>
              <div class="spa-field">
                <div class="spa-label">Modèle</div>
                <div class="spa-val" style="font-family:'JetBrains Mono',monospace;font-size:12px;color:var(--cyan)">gpt-4o</div>
              </div>
            </div>
          </div>

          <!-- Panneau 2 : Topologies -->
          <div class="sm-panel sm-panel--topo" data-panel="2">
            <div class="smp-header">
              <span class="smp-dot" style="background:#FF5F57"></span>
              <span class="smp-dot" style="background:#FEBC2E"></span>
              <span class="smp-dot" style="background:#28C840"></span>
              <span class="smp-title">Choisir la topologie</span>
            </div>
            <div class="smp-topos">
              <div class="spt-item spt-active">
                <div class="spt-badge" style="color:var(--cyan)">Séquentiel</div>
                <div class="spt-flow">
                  <span class="spt-node">A</span>
                  <span class="spt-arr">→</span>
                  <span class="spt-node">B</span>
                  <span class="spt-arr">→</span>
                  <span class="spt-node">C</span>
                </div>
              </div>
              <div class="spt-item">
                <div class="spt-badge" style="color:var(--violet-l)">Group Chat</div>
                <div class="spt-flow">
                  <span class="spt-node spt-mgr">M</span>
                  <span class="spt-arr">↔</span>
                  <span class="spt-node">A</span>
                  <span class="spt-arr">↔</span>
                  <span class="spt-node">B</span>
                </div>
              </div>
              <div class="spt-item">
                <div class="spt-badge" style="color:var(--mint)">Concurrent</div>
                <div class="spt-flow">
                  <div style="display:flex;flex-direction:column;gap:4px">
                    <span class="spt-node">A</span>
                    <span class="spt-node">B</span>
                  </div>
                  <span class="spt-arr">→</span>
                  <span class="spt-node spt-merge">✓</span>
                </div>
              </div>
            </div>
          </div>

        </div>
      </div>

    </div>
  </section>

  <!-- ══════════════════════════════════════════════════════
       BENTO GRID — Agentique + Déterministe
  ══════════════════════════════════════════════════════ -->
  <section class="s-violet bento-section">
    <div class="wrap">
      <div class="bento-header">
        <span class="eyebrow" style="color:var(--red)">Workflow Studio</span>
        <h2 class="h2" style="color:#fff;margin-top:16px">
          Agentique et déterministe —<br />dans un seul flux.
        </h2>
      </div>

      <div class="bento-grid">

        <div class="bento-cell bento-a">
          <p class="bc-body">
            Certaines étapes nécessitent de l'<strong style="color:#fff">intelligence</strong> — rechercher, analyser, décider.
            D'autres nécessitent de la <strong style="color:#fff">précision</strong> — envoyer, journaliser, publier, déclencher.
            Agentivity gère les deux.
          </p>
          <p class="bc-caption">La plupart des outils font l'un ou l'autre.</p>
          <div class="bc-badge">
            <span style="color:var(--violet-l)">Agentique</span>
            <span style="color:rgba(255,255,255,.2)">+</span>
            <span style="color:var(--mint)">Déterministe</span>
          </div>
        </div>

        <div class="bento-cell bento-b">
          <div class="timeline">
            <div class="tl-line"></div>
            <div class="tl-item">
              <div class="tl-dot tl-dot--trigger"></div>
              <div class="tl-content">
                <span class="tl-label">Déclencheur</span>
                <span class="tl-name">Nouveau collaborateur signé</span>
              </div>
            </div>
            <div class="tl-item">
              <div class="tl-dot tl-dot--agent"></div>
              <div class="tl-content">
                <span class="tl-label tl-label--agent">Agentique · Group Chat</span>
                <span class="tl-name">Équipe RH</span>
                <span class="tl-sub">Docs d'onboarding, brouillon d'accueil</span>
              </div>
            </div>
            <div class="tl-item">
              <div class="tl-dot tl-dot--deter"></div>
              <div class="tl-content">
                <span class="tl-label tl-label--deter">Déterministe</span>
                <span class="tl-name">✉ Envoyer l'email de bienvenue</span>
              </div>
            </div>
            <div class="tl-item">
              <div class="tl-dot tl-dot--agent"></div>
              <div class="tl-content">
                <span class="tl-label tl-label--agent">Agentique · Séquentiel</span>
                <span class="tl-name">Équipe Budget &amp; Achats</span>
                <span class="tl-sub">Demande d'équipement, résumé de validation</span>
              </div>
            </div>
            <div class="tl-item">
              <div class="tl-dot tl-dot--deter"></div>
              <div class="tl-content">
                <span class="tl-label tl-label--deter">Déterministe</span>
                <span class="tl-name">📋 Créer le bon de commande</span>
              </div>
            </div>
            <div class="tl-item">
              <div class="tl-dot tl-dot--done"></div>
              <div class="tl-content">
                <span class="tl-name" style="color:var(--mint)">✓ Collaborateur pleinement intégré</span>
              </div>
            </div>
          </div>
        </div>

        <div class="bento-cell bento-c">
          <div class="bc-stat">
            <span class="bc-stat-n grad-text">2</span>
            <span class="bc-stat-l">modes,<br />un seul flux</span>
          </div>
        </div>

        <div class="bento-cell bento-d">
          <div class="bc-legend">
            <div class="bcl-item">
              <div class="bcl-dot" style="background:var(--violet)"></div>
              <div>
                <div class="bcl-name">Agentique</div>
                <div class="bcl-desc">L'IA décide, s'adapte, juge</div>
              </div>
            </div>
            <div class="bcl-item">
              <div class="bcl-dot" style="background:var(--mint)"></div>
              <div>
                <div class="bcl-name">Déterministe</div>
                <div class="bcl-desc">Étapes exactes, à chaque fois</div>
              </div>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════════════
       SYNERGI
  ══════════════════════════════════════════════════════ -->
  <section class="s-black synergi-section">
    <div class="wrap synergi-wrap">
    <div class="ss-left">
      <span class="eyebrow" style="color:var(--mint)">Synergi</span>
      <h2 class="h2" style="color:#fff;margin-top:20px">
        Démarre plus vite.<br />Ne repars pas<br />de zéro.
      </h2>
      <p class="ss-body-text">
        Équipes prêtes pour la finance, les RH, le marketing, et plus encore.
        Choisis un template, personnalise les instructions, lance.
      </p>
      <a href="https://synergi.agentivity.io" target="_blank" rel="noopener noreferrer" class="btn btn-primary" style="margin-top:36px">
        Explorer Synergi →
      </a>
    </div>
    <div class="ss-right">
      <div class="synergi-grid">
        <div class="sg-card sg-card--featured">
          <span class="sg-emoji">💹</span>
          <div>
            <div class="sg-name">Équipe Finance</div>
            <div class="sg-meta">3 agents · Séquentiel</div>
          </div>
          <span class="sg-new">Populaire</span>
        </div>
        <div class="sg-card">
          <span class="sg-emoji">👥</span>
          <div>
            <div class="sg-name">Équipe RH</div>
            <div class="sg-meta">4 agents · Group Chat</div>
          </div>
        </div>
        <div class="sg-card">
          <span class="sg-emoji">📣</span>
          <div>
            <div class="sg-name">Équipe Marketing</div>
            <div class="sg-meta">3 agents · Séquentiel</div>
          </div>
        </div>
        <div class="sg-card">
          <span class="sg-emoji">🔍</span>
          <div>
            <div class="sg-name">Assistant de Recherche</div>
            <div class="sg-meta">2 agents · Séquentiel</div>
          </div>
        </div>
        <div class="sg-card">
          <span class="sg-emoji">⚖️</span>
          <div>
            <div class="sg-name">Revue Juridique</div>
            <div class="sg-meta">3 agents · Handoff</div>
          </div>
        </div>
        <div class="sg-card">
          <span class="sg-emoji">🛒</span>
          <div>
            <div class="sg-name">Prospection Commerciale</div>
            <div class="sg-meta">3 agents · Concurrent</div>
          </div>
        </div>
        <div class="sg-card sg-card--more">
          <span style="font-size:24px;opacity:.4">+</span>
          <div class="sg-name" style="opacity:.5">Plus de templates</div>
        </div>
      </div>
    </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════════════
       BUILDER VS UTILISATEUR
  ══════════════════════════════════════════════════════ -->
  <section class="s-navy mag-section">
    <div class="wrap">
      <h2 class="h2" style="color:#fff;margin-bottom:52px">Qui fait quoi ?</h2>
      <div class="mag-grid">

        <div class="mag-card mag-card--builder">
          <div class="mag-deco-num">B</div>
          <div class="role-badge" style="background:rgba(255,10,48,.12);color:var(--red);border-color:rgba(255,10,48,.25)">Constructeur</div>
          <h3 class="h3" style="color:#fff;margin-top:20px;margin-bottom:12px">
            Configure les agents,<br />construit les équipes,<br />connecte les outils.
          </h3>
          <p class="mag-desc">
            Requiert de la clarté, pas du Python. C'est du low-code — tu définis les rôles,
            rédiges les instructions, choisis les outils. Peut-on créer des agents IA sans Python ? Oui.
          </p>
          <ul class="mag-list">
            <li>Spécialistes IA &amp; consultants</li>
            <li>Responsables ops &amp; fondateurs techniques</li>
            <li>Quiconque sait rédiger un brief clair</li>
          </ul>
        </div>

        <div class="mag-right">
          <div class="mag-card mag-card--user">
            <div class="role-badge" style="background:rgba(109,0,245,.12);color:var(--violet-l);border-color:rgba(109,0,245,.25)">Utilisateur</div>
            <h3 class="h3" style="color:#fff;margin-top:16px;margin-bottom:10px">
              Utilise les équipes construites par un Constructeur.
            </h3>
            <p class="mag-desc-sm">
              Lance, interagit, lit les résultats. Vraiment no-code.
            </p>
            <ul class="mag-list-sm">
              <li>Managers &amp; dirigeants</li>
              <li>Solopreneurs</li>
              <li>Quiconque a un process à automatiser</li>
            </ul>
          </div>
          <div class="mag-quote-card">
            <p class="mag-quote">"Les deux à la fois ? <strong style="color:#fff">Commence comme Constructeur.</strong>"</p>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════════════
       CTA
  ══════════════════════════════════════════════════════ -->
  <section class="cta-banner s-cta-violet" id="cta">
    <div class="cta-bg" aria-hidden="true"></div>
    <div class="wrap cta-inner">
      <h2 class="h2 cta-h2">
        Prêt à construire<br />
        <span class="grad-text">ta première équipe ?</span>
      </h2>
      <p class="cta-sub">
        Open source &amp; gratuit en self-hosted. Version cloud bientôt disponible.
      </p>
      <div class="cta-btns">
        <a href="https://github.com/agentivity-labs/agentivity" target="_blank" rel="noopener noreferrer" class="btn btn-ghost lg">
          <svg viewBox="0 0 24 24" fill="currentColor" width="18" height="18"><path d="M12 .3a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2c-3.3.7-4-1.6-4-1.6-.6-1.4-1.4-1.8-1.4-1.8-1-.7.1-.7.1-.7 1.2 0 1.8 1.2 1.8 1.2 1 1.8 2.8 1.3 3.5 1 0-.8.4-1.3.7-1.6-2.7-.3-5.5-1.3-5.5-5.9 0-1.3.5-2.4 1.2-3.2 0-.4-.5-1.6.2-3.2 0 0 1-.3 3.3 1.2a11.5 11.5 0 0 1 6 0c2.3-1.5 3.3-1.2 3.3-1.2.7 1.6.2 2.8.1 3.2.8.8 1.2 1.9 1.2 3.2 0 4.6-2.8 5.6-5.5 5.9.5.4.9 1 .9 2.2v3.3c0 .3.2.7.8.6A12 12 0 0 0 12 .3"/></svg>
          ⭐ GitHub
        </a>
        <a href="/fr/#cta" class="btn btn-primary lg">Rejoindre la liste</a>
      </div>
      <div style="margin-top:28px">
        <a href="/fr/use-cases" class="link-arrow" style="color:rgba(255,255,255,.4);font-size:14px">
          Voir les cas d'usage
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16"><path d="M5 12h14m-7-7 7 7-7 7"/></svg>
        </a>
      </div>
    </div>
  </section>

  <Footer lang={lang} />
</Base>

<script>
  const steps = document.querySelectorAll<HTMLElement>('.sticky-step');
  const panels = document.querySelectorAll<HTMLElement>('.sm-panel');

  if (steps.length && panels.length) {
    const activate = (index: number) => {
      panels.forEach((p, i) => p.classList.toggle('active', i === index));
      steps.forEach((s, i) => s.classList.toggle('ss-active', i === index));
    };

    activate(0);

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(e => {
        if (e.isIntersecting) {
          const i = parseInt((e.target as HTMLElement).dataset.step || '0', 10);
          activate(i);
        }
      });
    }, { threshold: 0.55, rootMargin: '-10% 0px -10% 0px' });

    steps.forEach(s => observer.observe(s));
  }
</script>

