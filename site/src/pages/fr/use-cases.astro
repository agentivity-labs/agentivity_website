<script>
  const tabs = document.querySelectorAll<HTMLElement>('.uc-tab');
  const panels = document.querySelectorAll<HTMLElement>('.uc-panel');

  if (tabs.length && panels.length) {
    const activate = (id: string) => {
      tabs.forEach(t => t.classList.toggle('uc-tab--active', t.dataset.case === id));
    };
    activate(panels[0]?.dataset.case || '');

    const obs = new IntersectionObserver(entries => {
      entries.forEach(e => {
        if (e.isIntersecting) activate((e.target as HTMLElement).dataset.case || '');
      });
    }, { threshold: 0.3, rootMargin: '-10% 0px -50% 0px' });

    panels.forEach(p => obs.observe(p));
  }

  document.querySelectorAll<HTMLDetailsElement>('.faq-item').forEach(detail => {
    detail.addEventListener('toggle', () => {
      if (detail.open) {
        document.querySelectorAll<HTMLDetailsElement>('.faq-item').forEach(other => {
          if (other !== detail) other.open = false;
        });
      }
    });
  });
</script>

