---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';

const lang = 'fr';

const schema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": "Cas d'usage des agents IA pour les entreprises",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Équipe Finance", "description": "Équipe séquentielle de 6 agents qui automatise la veille concurrentielle, la modélisation financière et les briefings dirigeants." },
    { "@type": "ListItem", "position": 2, "name": "Équipe RH", "description": "Équipe séquentielle de 7 agents qui rédige les fiches de poste, filtre les candidatures et prépare les dossiers d'entretien." },
    { "@type": "ListItem", "position": 3, "name": "Équipe Marketing", "description": "Équipe group chat de 6 agents qui livre un plan de contenu hebdomadaire avec premiers brouillons, prêt à publier." },
    { "@type": "ListItem", "position": 4, "name": "Équipe Assistant Personnel", "description": "Équipe séquentielle de 5 agents qui prépare un brief quotidien chaque matin à 7h." }
  ]
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    { "@type": "Question", "name": "Faut-il des compétences techniques pour utiliser ces équipes ?", "acceptedAnswer": { "@type": "Answer", "text": "Si vous utilisez un template Synergi pré-construit, non. Vous personnalisez les instructions en langage naturel et lancez. Construire de zéro demande plus de soin — voir Comment ça marche." } },
    { "@type": "Question", "name": "L'IA peut-elle filtrer les candidatures automatiquement ?", "acceptedAnswer": { "@type": "Answer", "text": "Oui. L'équipe RH utilise un Agent de Tri pour lire les candidatures, les comparer à vos critères et faire remonter les meilleurs profils avec des résumés et des angles d'entretien suggérés." } },
    { "@type": "Question", "name": "Comment automatiser mon rapport hebdomadaire ?", "acceptedAnswer": { "@type": "Answer", "text": "L'équipe Finance exécute un pipeline séquentiel de 6 agents chaque lundi. Chaque agent passe le relais au suivant — collecte de données, analyse de sentiment, modélisation, détection des risques, rédaction, formatage. Le rapport arrive dans votre boîte mail, sourcé et prêt à partager." } }
  ]
};

interface Agent {
  name: string;
  role: string;
  tools?: string;
  parallel?: boolean;
}

interface UseCase {
  id: string;
  emoji: string;
  label: string;
  h2: string;
  subtitle: string;
  topology: string;
  topologyNote: string;
  agents: Agent[];
  before: string;
  after: string;
  stat: string;
  statLabel: string;
  story: string[];
  deliverable: string;
  accentColor: string;
}

const cases: UseCase[] = [
  {
    id: 'finance',
    emoji: '💹',
    label: 'Finance',
    h2: 'Équipe Finance',
    subtitle: 'Des données brutes au briefing dirigeant — la nuit, chaque lundi.',
    topology: 'Séquentiel',
    topologyNote: 'Chaque agent passe son output au suivant. Aucune intervention requise.',
    agents: [
      { name: 'Collecteur de données marché', role: 'Scrape les prix concurrents, actualités et bilans financiers en temps réel.', tools: 'web_search · scraper' },
      { name: 'Analyste de sentiment', role: 'Lit les mentions sociales, communiqués de presse et tonalité des news. Signale ce qui compte.', tools: 'summarise · classify' },
      { name: 'Modélisateur financier', role: 'Construit des tableaux comparatifs : marges, effectifs, positionnement produit.', tools: 'code_exec · spreadsheet' },
      { name: 'Évaluateur des risques', role: 'Détecte les anomalies, signaux réglementaires et risques marché. Ajoute un score de risque.', tools: 'analyse · flag' },
      { name: 'Rédacteur de rapport', role: 'Synthétise tout en un brief dirigeant clair avec sections et encadrés.', tools: 'write · format' },
      { name: 'Formateur email', role: 'Emballe le rapport, ajoute la charte graphique et envoie à votre liste de distribution.', tools: 'email · schedule' },
    ],
    before: 'Lundi matin : 3 heures de recherche manuelle, copier-coller, mise en forme.',
    after: 'Lundi matin : un briefing dans la boîte mail. Elle le lit avec son café.',
    stat: '8h',
    statLabel: '→ 4 min',
    story: [
      'Sarah dirige un cabinet comptable de 12 personnes. Elle passait ses lundis matin à collecter les actualités concurrentes, formater les mises à jour, préparer les briefs pour les réunions clients.',
      'Maintenant son équipe Finance tourne à 5h du matin pendant qu\'elle dort. À 7h, un briefing concurrentiel sourcé et scoré est dans sa boîte mail — formaté, brandé, prêt à partager. Ses clients pensent qu\'elle a un département de recherche.'
    ],
    deliverable: 'Un briefing concurrentiel hebdomadaire. Sourcé, scoré, formaté. Prêt à partager.',
    accentColor: 'var(--mint)',
  },
  {
    id: 'hr',
    emoji: '👥',
    label: 'RH',
    h2: 'Équipe RH',
    subtitle: 'Des critères du poste à la shortlist prête pour l\'entretien — automatiquement.',
    topology: 'Séquentiel',
    topologyNote: '7 agents spécialisés. Chacun fait une chose, parfaitement.',
    agents: [
      { name: 'Rédacteur de fiche de poste', role: 'Transforme vos critères en une offre d\'emploi soignée et optimisée SEO.', tools: 'write · optimise' },
      { name: 'Publicateur job boards', role: 'Publie simultanément sur LinkedIn, Indeed et votre page carrière.', tools: 'api · publish' },
      { name: 'Parseur de candidatures', role: 'Extrait les données structurées de chaque CV : compétences, expérience, lacunes, signaux d\'alerte.', tools: 'parse · extract' },
      { name: 'Évaluateur de compétences', role: 'Score chaque candidature par rapport à vos critères. Retourne un score d\'adéquation de 0 à 100.', tools: 'classify · score' },
      { name: 'Évaluateur fit culturel', role: 'Analyse le style d\'écriture, les signaux de valeurs et les patterns de communication.', tools: 'analyse · classify' },
      { name: 'Générateur de questions d\'entretien', role: 'Rédige 8 questions d\'entretien personnalisées par candidat shortlisté.', tools: 'write · personalise' },
      { name: 'Formateur de shortlist', role: 'Emballe les 3 meilleurs profils en un PDF propre : score, résumé, questions, lien CV.', tools: 'format · export' },
    ],
    before: 'Mardi : publie un poste. Passe 3 jours à lire des CV.',
    after: 'Mercredi matin : 3 dossiers d\'entretien prêts. Terminé en 20 minutes.',
    stat: '40 CV',
    statLabel: 'triés la nuit',
    story: [
      'Marcus a publié un poste de développeur senior un mardi. Le mercredi matin, son équipe RH avait trié 40 candidatures et remonté 3 profils shortlistés.',
      'Chaque profil était accompagné d\'un score d\'adéquation, d\'une évaluation du fit culturel et de 8 questions d\'entretien personnalisées. Il a passé 20 minutes à revoir. Pas 3 jours.'
    ],
    deliverable: '3 candidats shortlistés. Score, résumé, questions d\'entretien personnalisées. Prêts à appeler.',
    accentColor: 'var(--cyan)',
  },
  {
    id: 'marketing',
    emoji: '📣',
    label: 'Marketing',
    h2: 'Équipe Marketing',
    subtitle: 'Une semaine de contenu complète — recherchée, rédigée, optimisée. Chaque vendredi.',
    topology: 'Group Chat',
    topologyNote: 'Les agents collaborent en parallèle, puis convergent vers un output final.',
    agents: [
      { name: 'Chasseur de tendances', role: 'Scanne les news du secteur, les réseaux, Google Trends et le contenu concurrent de la semaine.', tools: 'web_search · monitor', parallel: true },
      { name: 'Analyste concurrent', role: 'Suit ce que les concurrents ont publié cette semaine et ce qui a le mieux performé.', tools: 'scraper · analyse', parallel: true },
      { name: 'Chercheur audience', role: 'Récupère les données d\'engagement et le sentiment des commentaires sur vos propres canaux.', tools: 'api · classify', parallel: true },
      { name: 'Stratège contenu', role: 'Reçoit les trois rapports. Choisit 5 angles de contenu alignés avec le positionnement de marque.', tools: 'synthesise · plan' },
      { name: 'Rédacteur', role: 'Rédige un premier brouillon complet pour chaque angle : titre, corps, accroche, CTA.', tools: 'write · draft' },
      { name: 'Optimiseur SEO', role: 'Ajoute les mots-clés cibles, meta descriptions et suggestions de liens internes à chaque brouillon.', tools: 'optimise · keyword' },
    ],
    before: 'Vendredi : "sur quoi on écrit cette semaine ?"',
    after: 'Vendredi : 5 brouillons dans le dossier, prêts à choisir et éditer.',
    stat: '0',
    statLabel: 'page blanche le lundi',
    story: [
      'Chaque vendredi, l\'équipe Marketing livre 5 idées de contenu — chacune avec une source, un angle concurrentiel, un premier brouillon et des métadonnées SEO. La responsable contenu en choisit deux, édite légèrement, planifie pour la semaine.',
      'Aucune page blanche. Aucun "sur quoi on écrit ?" Juste des décisions.'
    ],
    deliverable: 'Un plan de contenu hebdomadaire avec premiers brouillons, optimisés SEO. 15 minutes d\'édition, pas 3 heures de rédaction.',
    accentColor: 'var(--red)',
  },
  {
    id: 'assistant',
    emoji: '🌅',
    label: 'Personnel',
    h2: 'Équipe Assistant Personnel',
    subtitle: 'Un brief. Chaque matin. Avant que tu n\'ouvres ton ordi.',
    topology: 'Séquentiel',
    topologyNote: 'Tourne la nuit. Livré à 7h, chaque jour.',
    agents: [
      { name: 'Moniteur d\'actualités', role: 'Scanne tes flux sectoriels, newsletters et sources sauvegardées pour les développements nocturnes.', tools: 'web_search · filter' },
      { name: 'Résumeur d\'emails', role: 'Lit ta boîte mail. Signale ce qui nécessite une réponse, ce qui peut attendre, ce qu\'il faut ignorer.', tools: 'email · classify' },
      { name: 'Analyste agenda', role: 'Mappe ta journée : réunions, temps de préparation nécessaire, déplacements, conflits.', tools: 'calendar · plan' },
      { name: 'Classeur de priorités', role: 'Croise les actualités, emails et agenda. Remonte les 3 choses qui nécessitent une action aujourd\'hui.', tools: 'analyse · rank' },
      { name: 'Rédacteur de brief', role: 'Formate tout en un brief matinal propre et scannable. Un seul lecture, image complète.', tools: 'write · format' },
    ],
    before: 'Matins : 45 minutes à se mettre à jour avant de pouvoir commencer.',
    after: 'Matins : 3 minutes de lecture, puis tu commences.',
    stat: '7h',
    statLabel: 'brief prêt chaque jour',
    story: [
      'Chaque matin à 7h, le brief est prêt. Ce qui s\'est passé la nuit, ce qui est signalé dans ta boîte mail, ce qui est à l\'agenda, ce que l\'équipe a accompli pendant que tu dormais.',
      'Une seule lecture. Image complète. Commence la journée à pleine vitesse.'
    ],
    deliverable: 'Un brief quotidien — ce qui s\'est passé, ce qui vient, ce qui a besoin de toi aujourd\'hui.',
    accentColor: 'var(--violet-l)',
  }
];

const industries = [
  'Juridique', 'Finance', 'RH', 'Marketing', 'Commercial',
  'Opérations', 'Support client', 'Recherche', 'Conformité', 'Logistique',
  'Immobilier', 'Santé', 'Éducation', 'Recrutement', 'RP & Comm',
  'Produit', 'Ingénierie', 'Achats', 'Comptabilité', 'E-commerce',
];
---
<Base
  title="Cas d'usage agents IA — Finance, RH & Marketing | Agentivity"
  description="Découvrez comment les PME utilisent Agentivity pour automatiser les briefings concurrentiels, filtrer les candidatures et piloter des équipes marketing la nuit. Équipes réelles, résultats concrets."
  schema={[schema, faqSchema]}
>
  <Nav lang={lang} />

  <!-- HERO -->
  <section class="s-black uc-hero">
    <div class="hero-grid-bg" aria-hidden="true"></div>
    <div class="wrap uc-hero-inner">
      <span class="eyebrow" style="color:var(--mint)">Cas d'usage</span>
      <h1 class="h1 uc-h1">
        Que fera<br /><span class="grad-text">ton équipe ?</span>
      </h1>
      <p class="uc-sub">
        Équipes IA pour les entreprises — finance, RH, marketing, et bien plus.<br class="br-md" />
        Des workflows réels. Des agents spécialisés. Des résultats concrets.
      </p>
    </div>
  </section>

  <!-- INTRO -->
  <section class="s-pearl intro-section">
    <div class="wrap intro-wrap">

      <div class="intro-text">
        <h2 class="h2 intro-h2">
          N'importe quelle équipe.<br />N'importe quel workflow.<br /><span style="color:var(--violet)">Pour n'importe quel secteur.</span>
        </h2>
        <p class="intro-body">
          Tu n'es pas limité aux templates. Chaque entreprise a des workflows qui ne devraient pas nécessiter un humain — des étapes répétitives, chronophages, basées sur des règles qui se produisent chaque jour, semaine ou mois.
        </p>
        <p class="intro-body">
          Agentivity te permet de construire exactement l'équipe dont tu as besoin. Une équipe de 2 agents ou de 20. Des passages de relais séquentiels ou une collaboration parallèle. Lancée à la demande, sur un planning, ou déclenchée par un événement.
        </p>
        <div class="intro-pills">
          <div class="intro-pill" style="--c:var(--mint)">
            <svg viewBox="0 0 20 20" fill="currentColor" width="14" height="14"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
            Agents illimités par équipe
          </div>
          <div class="intro-pill" style="--c:var(--cyan)">
            <svg viewBox="0 0 20 20" fill="currentColor" width="14" height="14"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
            Séquentiel, concurrent ou group chat
          </div>
          <div class="intro-pill" style="--c:var(--violet-l)">
            <svg viewBox="0 0 20 20" fill="currentColor" width="14" height="14"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
            N'importe quel déclencheur — planning, webhook, manuel
          </div>
          <div class="intro-pill" style="--c:var(--red)">
            <svg viewBox="0 0 20 20" fill="currentColor" width="14" height="14"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
            Sans écrire une ligne de code
          </div>
        </div>
      </div>

      <div class="intro-industries">
        <p class="intro-ind-label">Fonctionne pour tous les secteurs</p>
        <div class="ind-grid">
          {industries.map((ind, i) => (
            <span class="ind-tag" style={`animation-delay:${i * 0.04}s`}>{ind}</span>
          ))}
          <span class="ind-tag ind-tag--more">+ tout le reste</span>
        </div>
        <p class="intro-ind-note">
          Pas sûr de ce que tu veux construire ?
          <a href="https://synergi.agentivity.io" target="_blank" rel="noopener noreferrer" class="intro-link">Explorer les templates Synergi →</a>
        </p>
      </div>

    </div>
  </section>

  <!-- CAS D'USAGE -->
  <section class="s-black uc-section">
    <div class="wrap uc-layout">

      <aside class="uc-nav" aria-label="Navigation cas d'usage">
        <p class="uc-nav-label">Exemples</p>
        {cases.map((c, i) => (
          <a href={`#case-${c.id}`} class="uc-tab" data-case={c.id} style={`--accent:${c.accentColor}`}>
            <span class="uc-tab-num">{String(i + 1).padStart(2, '0')}</span>
            <span class="uc-tab-icon">{c.emoji}</span>
            <span class="uc-tab-label">{c.label}</span>
          </a>
        ))}
        <div class="uc-nav-divider"></div>
        <a href="https://synergi.agentivity.io" class="uc-nav-synergi" target="_blank" rel="noopener noreferrer">
          Tous les templates Synergi →
        </a>
      </aside>

      <div class="uc-panels">
        {cases.map((c) => (
          <article class="uc-panel" id={`case-${c.id}`} data-case={c.id}>

            <div class="ucp-top">
              <div class="ucp-stat-block" style={`--ac:${c.accentColor}`}>
                <div class="ucp-stat">{c.stat}</div>
                <div class="ucp-stat-label">{c.statLabel}</div>
              </div>
              <div class="ucp-head">
                <div class="ucp-topology">
                  <span class="topo-dot" style={`background:${c.accentColor}`}></span>
                  Topologie {c.topology}
                </div>
                <h2 class="h2 ucp-h2">{c.h2}</h2>
                <p class="ucp-subtitle">{c.subtitle}</p>
              </div>
            </div>

            <div class="ucp-contrast">
              <div class="ucp-before">
                <span class="ucp-contrast-label">Avant</span>
                <p>{c.before}</p>
              </div>
              <div class="ucp-arrow-sep">→</div>
              <div class="ucp-after" style={`--ac:${c.accentColor}`}>
                <span class="ucp-contrast-label">Après</span>
                <p>{c.after}</p>
              </div>
            </div>

            <div class="ucp-pipeline" style={`--ac:${c.accentColor}`}>
              <div class="ucp-pipeline-header">
                <span class="ucp-pipeline-title">
                  {c.agents.length} agents spécialisés · {c.topologyNote}
                </span>
              </div>
              <div class="ucp-steps">
                {c.agents.map((agent, i) => (
                  <div class={`ucp-step${agent.parallel ? ' ucp-step--parallel' : ''}`} style={`--delay:${i * 0.08}s`}>
                    <div class="ucp-step-connector">
                      <div class="ucp-step-dot"></div>
                      {i < c.agents.length - 1 && <div class="ucp-step-line"></div>}
                    </div>
                    <div class="ucp-step-body">
                      <div class="ucp-step-head">
                        <span class="ucp-step-name">{agent.name}</span>
                        {agent.parallel && <span class="ucp-parallel-badge">parallèle</span>}
                        {agent.tools && <span class="ucp-step-tools">{agent.tools}</span>}
                      </div>
                      <p class="ucp-step-desc">{agent.role}</p>
                    </div>
                  </div>
                ))}
              </div>
            </div>

            <div class="ucp-story">
              {c.story.map(p => <p>{p}</p>)}
            </div>

            <div class="ucp-deliverable" style={`--ac:${c.accentColor}`}>
              <div class="ucp-del-label">
                <svg viewBox="0 0 20 20" fill="currentColor" width="14" height="14">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                </svg>
                Tu reçois
              </div>
              <blockquote class="ucp-del-text">{c.deliverable}</blockquote>
            </div>

            <div class="ucp-ctas">
              <a href="/fr/#cta" class="btn btn-primary">Rejoindre la liste</a>
              <a href="https://synergi.agentivity.io" target="_blank" rel="noopener noreferrer" class="ucp-link">
                Explorer dans Synergi
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><path d="M5 12h14m-7-7 7 7-7 7"/></svg>
              </a>
            </div>

          </article>
        ))}
      </div>

    </div>
  </section>

  <!-- TÉMOIGNAGES -->
  <section class="s-navy testi-section">
    <div class="wrap">
      <span class="eyebrow" style="color:var(--cyan);margin-bottom:48px;display:inline-flex">Premiers retours</span>
      <div class="testi-grid">

        <figure class="testi-card">
          <div class="testi-stars">★★★★★</div>
          <blockquote class="testi-quote">
            "J'ai mis en place une équipe Finance en une après-midi. Le lundi suivant, le briefing était là.
            Je l'utilise chaque semaine depuis."
          </blockquote>
          <figcaption class="testi-author">
            <div class="testi-avatar" style="--c:var(--mint)">A</div>
            <div>
              <div class="testi-name">Alex R.</div>
              <div class="testi-role">Consultant financier indépendant</div>
            </div>
          </figcaption>
        </figure>

        <figure class="testi-card">
          <div class="testi-stars">★★★★★</div>
          <blockquote class="testi-quote">
            "Nous sommes une équipe de 8. J'ai construit une équipe RH sur Agentivity et elle gère notre
            premier tour de tri. On ne parle qu'aux candidats qui en valent la peine."
          </blockquote>
          <figcaption class="testi-author">
            <div class="testi-avatar" style="--c:var(--cyan)">J</div>
            <div>
              <div class="testi-name">Julie M.</div>
              <div class="testi-role">Responsable opérations, entreprise tech de 45 personnes</div>
            </div>
          </figcaption>
        </figure>

      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="s-black faq-section">
    <div class="wrap faq-wrap">
      <h2 class="h2" style="color:#fff;margin-bottom:8px">Questions fréquentes</h2>
      <p class="faq-intro">Utilisé par des consultants, responsables opérations et dirigeants de PME pour automatiser le travail qui ne devrait pas nécessiter un humain.</p>

      <div class="faq-list">
        <details class="faq-item" open>
          <summary class="faq-q">Faut-il des compétences techniques pour utiliser ces équipes ?</summary>
          <div class="faq-a">
            Si tu utilises un template Synergi pré-construit, non. Tu personnalises les instructions en langage naturel et tu lances.
            Construire de zéro demande plus de soin — voir <a href="/fr/how-it-works" class="faq-link">Comment ça marche →</a>
          </div>
        </details>
        <details class="faq-item">
          <summary class="faq-q">L'IA peut-elle filtrer les candidatures automatiquement ?</summary>
          <div class="faq-a">
            Oui. L'équipe RH utilise un pipeline de 7 agents : parsing des CV, scoring des compétences, évaluation du fit culturel et génération de questions d'entretien — tout ça avant que tu ouvres ton ordinateur.
          </div>
        </details>
        <details class="faq-item">
          <summary class="faq-q">Comment automatiser mon rapport hebdomadaire ?</summary>
          <div class="faq-a">
            L'équipe Finance exécute un pipeline séquentiel de 6 agents chaque lundi à 5h. Chaque agent passe le relais au suivant — collecte de données, analyse de sentiment, modélisation, détection des risques, rédaction, formatage. Le rapport arrive dans ta boîte mail, sourcé et prêt à partager.
          </div>
        </details>
      </div>
    </div>
  </section>

  <!-- CTA FINAL -->
  <section class="s-violet uc-cta" id="uc-cta">
    <div class="uc-cta-glow" aria-hidden="true"></div>
    <div class="wrap uc-cta-inner">
      <h2 class="h2 uc-cta-h2">
        Ton équipe<br /><span class="grad-text">t'attend.</span>
      </h2>
      <p class="uc-cta-sub">
        La version cloud arrive. Rejoins la liste — tu seras parmi les premiers, au tarif de lancement.
      </p>
      <div class="uc-cta-btns">
