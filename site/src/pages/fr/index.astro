  'Mailchimp':  `<svg viewBox="0 0 24 24" fill="currentColor"><path d="M21.432 10.56c.024-.214.04-.43.04-.65 0-3.48-2.82-6.3-6.3-6.3-1.61 0-3.077.607-4.187 1.597C10.51 4.496 9.534 4.2 8.5 4.2c-2.318 0-4.2 1.882-4.2 4.2 0 .11.005.218.013.326C2.798 9.35 2 10.536 2 11.9c0 2.098 1.702 3.8 3.8 3.8h12.4c2.098 0 3.8-1.702 3.8-3.8 0-.48-.09-.94-.254-1.36l-.314.02z"/></svg>`,
};

function integChip(app: any): string {
  const name = String(app.name);
  const icon = INTEG_ICONS[name] || `<svg viewBox="0 0 24 24" fill="currentColor"><text x="12" y="17" text-anchor="middle" font-size="13" font-weight="800" font-family="Inter,sans-serif">${name[0]}</text></svg>`;
  return '<span class="i-chip">'
    + '<span class="i-icon">' + icon + '</span>'
    + '<span class="i-name">' + name + '</span>'
    + '</span>';
}
function integTrack(apps: any[]): string {
  const chips = apps.map(integChip).join('');
  return chips + chips;
}
const integRows = (t.workflow_studio.integrations as any[][]).map((row, i) => ({
  html: integTrack(row),
  dir: i % 2 === 0 ? 'l' : 'r',
}));

// Pre-render bullet lists
function bulletList(points: any[]): string {
  let h = '<ul class="profile-points">';
  for (const p of points) {
    h += '<li><span class="bullet-dot"></span>' + String(p) + '</li>';
  }
  h += '</ul>';
  return h;
}
const archPoints = bulletList(t.profiles.architect.points as any[]);
const operPoints = bulletList(t.profiles.operator.points as any[]);

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "SoftwareApplication",
      "name": "Agentivity",
      "applicationCategory": "BusinessApplication",
      "operatingSystem": "Web, Cloud",
      "offers": { "@type": "Offer", "price": "0", "priceCurrency": "EUR", "description": "Plan open source gratuit" },
      "url": "https://agentivity.io/fr/",
      "description": t.meta.description
    },
    {
      "@type": "Organization",
      "name": "Agentivity",
      "url": "https://agentivity.io",
      "logo": "https://agentivity.io/agentivity-wordmark-white.svg"
    }
  ]
};
---
<Base title={t.meta.title} description={t.meta.description} lang="fr" schema={schema}>

<Nav lang={lang} />

<!-- HERO -->
<section class="s-black hero dots" id="top">
  <div class="blob" style="width:560px;height:560px;background:rgba(109,0,245,.13);top:-160px;left:-120px"></div>
  <div class="blob" style="width:420px;height:420px;background:rgba(255,10,48,.08);bottom:-200px;right:4%"></div>
  <div class="wrap sec-inner">
    <div class="hero-grid">
      <div class="hero-copy">
        <span class="pill dot reveal" style="color:var(--cyan)">{t.hero.pill}</span>
        <h1 class="h1 reveal" data-d="1">
          {t.hero.h1_line1} <span class="u-red">{t.hero.h1_accent}</span><br />
          <span class="grad-text">{t.hero.h1_line2}</span>
        </h1>
        <p class="sub reveal" data-d="2">{t.hero.subhead}</p>
        <div class="hero-cta reveal" data-d="3">
          <a class="btn btn-primary lg" href="https://github.com/agentivity-labs/agentivity" target="_blank" rel="noopener noreferrer">
            <svg viewBox="0 0 24 24" fill="currentColor" width="16" height="16"><path d="M12 .3a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2c-3.3.7-4-1.6-4-1.6-.6-1.4-1.4-1.8-1.4-1.8-1-.7.1-.7.1-.7 1.2 0 1.8 1.2 1.8 1.2 1 1.8 2.8 1.3 3.5 1 0-.8.4-1.3.7-1.6-2.7-.3-5.5-1.3-5.5-5.9 0-1.3.5-2.4 1.2-3.2 0-.4-.5-1.6.2-3.2 0 0 1-.3 3.3 1.2a11.5 11.5 0 0 1 6 0c2.3-1.5 3.3-1.2 3.3-1.2.7 1.6.2 2.8.1 3.2.8.8 1.2 1.9 1.2 3.2 0 4.6-2.8 5.6-5.5 5.9.5.4.9 1 .9 2.2v3.3c0 .3.2.7.8.6A12 12 0 0 0 12 .3"/></svg>
            {t.hero.cta_primary}
          </a>
          <a class="btn btn-ghost lg" href="#cta">{t.hero.cta_secondary}</a>
        </div>
        <div class="hero-micro reveal" data-d="4">{t.hero.micro}</div>
      </div>
      <div class="hero-visual reveal" data-d="2">
        <div class="app-win">
          <div class="topbar">
            <span class="dot" style="background:#FF5F57"></span>
            <span class="dot" style="background:#FEBC2E"></span>
            <span class="dot" style="background:#28C840"></span>
            <span class="t">Team Studio — Équipe Finance</span>
            <span class="live">running</span>
          </div>
          <div class="team-stage" data-team-stage></div>
        </div>
      </div>
    </div>

    <div class="stats reveal">
      {stats.map((stat: any) => (
        <div class="stat">
          <div class="n"><Fragment set:html={stat.html} /></div>
          <div class="l">{stat.label}</div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- TICKER -->
<div class="ticker" aria-hidden="true">
  <div class="ticker-track">
    {[...t.ticker, ...t.ticker].map((item: string) => (
      <span class="it">{item}</span>
    ))}
  </div>
</div>

<!-- HOW IT WORKS -->
<section class="s-navy dots pad-y" id="how">
  <div class="wrap sec-inner">
    <div class="how-head">
      <div>
        <span class="eyebrow reveal" style="color:var(--red)">{t.how.eyebrow}</span>
        <h2 class="h2 reveal" data-d="1" style="margin-top:18px;max-width:15ch">
          {t.how.h2} <span class="u-red">{t.how.h2_accent}</span>
        </h2>
      </div>
      <a class="link-arrow reveal" data-d="2" href="/fr/how-it-works" style="padding-bottom:8px;color:#fff">
        {t.how.link}
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="17" height="17"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
      </a>
    </div>
    <div class="steps">
      {t.how.steps.map((step, i) => (
        <div class="step reveal" data-d={i > 0 ? String(i) : undefined}>
          <span class="accent"></span>
          <div class="num">{step.num}</div>
          <h3 class="h3">{step.title}</h3>
          <p>{step.body}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- THREE STUDIOS -->
<section class="s-white pad-y" id="studios">
  <div class="wrap">
    <div class="sec-head reveal">
      <span class="eyebrow" style="color:var(--violet)">{t.studios.eyebrow}</span>
      <h2 class="h2">{t.studios.h2} <span class="hl">{t.studios.h2_accent}</span></h2>
      <p style="max-width:50ch">{t.studios.sub}</p>
    </div>
    <div class="studios-grid">
      {t.studios.cards.map((card, i) => (
        <div class:list={['studio-card', 'reveal', i === 1 ? 'studio-featured' : '']} data-d={i > 0 ? String(i) : undefined}>
          <div class="studio-icon">
            {i === 0 && <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="4" y="7" width="16" height="12" rx="2"/><path d="M9 7V4h6v3M9 13h.01M15 13h.01"/></svg>}
            {i === 1 && <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="9" cy="8" r="3"/><circle cx="17" cy="10" r="2.4"/><path d="M3 20c0-3 2.7-5 6-5s6 2 6 5M15.5 20c0-1.8.6-3 2-3.6"/></svg>}
            {i === 2 && <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M5 12h14M12 5l7 7-7 7"/><circle cx="5" cy="12" r="2"/></svg>}
          </div>
          <span class="studio-tag">{card.tag}</span>
          <h3 class="h3">{card.title}</h3>
          <p>{card.body}</p>
          <span class="studio-badge">{card.badge}</span>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- TOPOLOGIES -->
<section class="s-black dots pad-y" id="topologies">
  <div class="blob" style="width:500px;height:500px;background:rgba(109,0,245,.1);top:-100px;right:-80px"></div>
  <div class="wrap">
    <div class="topo-section-head reveal">
      <div>
        <span class="eyebrow" style="color:var(--cyan)">{t.topologies.eyebrow}</span>
        <h2 class="h2 reveal" data-d="1" style="margin-top:18px;color:#fff">
          {t.topologies.h2} <span class="u-red">{t.topologies.h2_accent}</span>
        </h2>
        <p class="reveal" data-d="2" style="color:rgba(255,255,255,.65);font-size:clamp(16px,1.3vw,18px);max-width:48ch;margin-top:16px;line-height:1.7">{t.topologies.sub}</p>
      </div>
      <div class="topo-diff reveal" data-d="2">
        <span class="diff-pill">{t.topologies.diff}</span>
      </div>
    </div>
    <div class="topo-items-grid">
      {topoItems.map((item: any, i: number) => (
        <div class="topo-item reveal" data-d={i > 0 ? String(Math.min(i, 3)) : undefined}>
          <div class="topo-item-dot" style={"background:" + item.color}></div>
          <div>
            <div class="topo-item-head">
              <strong style={"color:" + item.color}>{item.name}</strong>
              <span class="topo-item-tag">{item.tag}</span>
            </div>
            <p>{item.body}</p>
          </div>
        </div>
      ))}
    </div>
    <div class="canvas-shot-wide reveal" data-d="2">
      <div class="topbar">
        <span class="dot" style="background:#FF5F57"></span>
        <span class="dot" style="background:#FEBC2E"></span>
        <span class="dot" style="background:#28C840"></span>
        <span class="t">{t.canvas.screenshot_label}</span>
      </div>
      <img src="/team-canvas.png" alt={t.canvas.screenshot_alt} />
      <div class="ov">
        <span class="pill" style="background:#fff;color:var(--ink);border-color:var(--line);box-shadow:var(--sh-card)">{t.canvas.badge_agents}</span>
        <span class="pill" style="background:var(--violet);color:#fff;border-color:transparent;box-shadow:var(--sh-card)">{t.canvas.badge_topo}</span>
      </div>
    </div>
  </div>
</section>

<!-- WORKFLOW STUDIO -->
<section class="s-navy dots pad-y" id="workflow-studio">
  <div class="blob" style="width:480px;height:480px;background:rgba(255,10,48,.06);bottom:-120px;right:-60px"></div>
  <div class="wrap">
    <div class="wf-layout">
      <div class="wf-copy">
        <span class="eyebrow reveal" style="color:var(--red)">{t.workflow_studio.eyebrow}</span>
        <h2 class="h2 reveal" data-d="1" style="color:#fff;margin-top:18px">
          {t.workflow_studio.h2}<br /><span class="u-red">{t.workflow_studio.h2_accent}</span>
        </h2>
        <p class="reveal" data-d="2" style="color:rgba(255,255,255,.7);font-size:clamp(15px,1.2vw,17px);max-width:44ch;margin-top:18px;line-height:1.75">{t.workflow_studio.sub}</p>
        <div class="wf-why reveal" data-d="3">
          <span class="wf-why-label">{t.workflow_studio.why}</span>
        </div>
        <div class="wf-points reveal" data-d="3">
          <Fragment set:html={workflowPoints} />
        </div>
        <a class="link-arrow reveal" data-d="4" href="/fr/docs" style="color:rgba(255,255,255,.7);margin-top:8px">
          {t.workflow_studio.link}
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="17" height="17"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
      </div>
      <div class="wf-screen reveal" data-d="2">
        <div class="flow-frame">
          <div class="topbar">
            <span class="dot" style="background:#FF5F57"></span>
            <span class="dot" style="background:#FEBC2E"></span>
            <span class="dot" style="background:#28C840"></span>
            <span class="t">{t.workflow_studio.screenshot_label}</span>
          </div>
          <div class="scroller">
            <div class="flow-veil"></div>
            <img src="/studio-canvas.png" alt="Agentivity Workflow Studio — pipeline de contenu SEO déterministe" />
          </div>
        </div>
      </div>
    </div>
    <!-- integrations band -->
    <div class="wf-integ">
      <p class="wf-integ-label">{t.workflow_studio.integrations_label}</p>
      <div class="integ-band">
        {integRows.map((row: any) => (
          <div class="integ-row-wrap">
            <div class:list={['integ-track', 'dir-' + row.dir]}>
              <Fragment set:html={row.html} />
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<!-- USE CASES -->
<section class="s-red pad-y" id="usecases">
  <div class="blob" style="width:480px;height:480px;background:rgba(204,10,38,.5);bottom:-160px;left:8%"></div>
  <div class="wrap sec-inner">
    <div class="sec-head">
      <span class="eyebrow reveal" style="color:rgba(255,255,255,.65)">{t.usecases.eyebrow}</span>
      <h2 class="h2 reveal" data-d="1" style="color:#fff">{t.usecases.h2}</h2>
      <p class="reveal" data-d="2" style="color:rgba(255,255,255,.85);font-size:clamp(17px,1.5vw,20px)">{t.usecases.subhead}</p>
    </div>
    <div class="uc-grid">
      {t.usecases.cards.map((card, i) => (
        <article class:list={['uc-card', 'reveal', i === 0 ? 'big' : '']} data-d={i > 0 ? String(i) : undefined}>
          <span class="idx">{card.idx}</span>
          <h3>{card.title}</h3>
          <div class="uc-agents">
            {card.agents.map((agent, j) => (
              <span class="chip"><span class="d" style={"background:" + card.colors[j]}></span>{agent}</span>
            ))}
          </div>
          <p class="uc-quote">{card.quote}</p>
        </article>
      ))}
    </div>
    <div class="uc-foot reveal">
      <a class="btn btn-white" href="/fr/use-cases">
        {t.usecases.cta}
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
      </a>
    </div>
  </div>
</section>

<!-- PROFILES -->
<section class="s-pearl pad-y" id="profiles">
  <div class="wrap">
    <div class="sec-head reveal">
