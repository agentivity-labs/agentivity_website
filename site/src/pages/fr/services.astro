---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';

const lang = 'fr';

const schema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Agentivity Services Professionnels",
  "provider": { "@type": "Organization", "name": "Agentivity" },
  "description": "Services IA complets : développement d'équipes d'agents, transformation IT, architecture IA, entraînement de modèles sur mesure, ateliers et intégration.",
  "serviceType": ["Conseil IA", "Développement IA sur mesure", "Formation IA", "Transformation IT"]
};

interface Service {
  id: string;
  icon: string;
  eyebrow: string;
  title: string;
  body: string;
  deliverables: string[];
  accent: string;
}

const services: Service[] = [
  {
    id: "agent-teams",
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="28" height="28"><circle cx="9" cy="7" r="3"/><circle cx="17" cy="7" r="3"/><path d="M3 21v-2a4 4 0 0 1 4-4h4a4 4 0 0 1 4 4v2"/><path d="M19 11v6m-3-3h6"/></svg>`,
    eyebrow: "Service 01",
    title: "Développement d'équipes d'agents",
    body: "Nous concevons, construisons et déployons des équipes d'agents multi-agents sur mesure adaptées à tes workflows. D'une équipe Analyste Finance qui produit des rapports en 4 minutes, à un pipeline RH qui trie 200 CV du jour au lendemain — nous livrons des équipes d'agents prêtes pour la production sur Agentivity.",
    deliverables: [
      "Atelier de cadrage & cartographie des workflows",
      "Conception des agents : rôles, prompts, outils, topologie",
      "Construction & tests sur ton infrastructure",
      "Documentation + session de transfert de compétences",
      "Support 30 jours post-lancement",
    ],
    accent: "var(--mint)",
  },
  {
    id: "it-transformation",
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="28" height="28"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>`,
    eyebrow: "Service 02",
    title: "Transformation IT",
    body: "Nous aidons les organisations à migrer de processus manuels et fragmentés vers des opérations orchestrées par IA. Cela signifie auditer ta stack actuelle, identifier où les équipes d'agents créent le plus de valeur, et livrer une feuille de route par phases — du premier pilote au déploiement à l'échelle de l'organisation.",
    deliverables: [
      "Audit de maturité IA (personnes, processus, données)",
      "Matrice des opportunités priorisées",
      "Livraison de l'équipe pilote (1 workflow à fort impact)",
      "Plan de déploiement par phases entre les départements",
      "Définition des KPIs & cadre de mesure",
    ],
    accent: "var(--cyan)",
  },
  {
    id: "ai-architecture",
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="28" height="28"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><path d="M17.5 17.5m-2 0a2 2 0 1 0 4 0 2 2 0 0 0-4 0"/><path d="M10 6.5h4M6.5 10v4M17.5 10v3.5"/></svg>`,
    eyebrow: "Service 03",
    title: "Architecture IA & Stratégie",
    body: "Avant de construire, il faut la bonne conception. Nous architecturons ta stack IA de bout en bout : sélection des modèles (open vs propriétaire), choix de topologie (Séquentiel, Group Chat, Concurrent), flux de données, stratégie mémoire, périmètre de sécurité et optimisation des coûts. Sans dépendance, sans sur-ingénierie.",
    deliverables: [
      "Document de conception de la stack IA",
      "Recommandations de modèles & fournisseurs",
      "Conception de topologie d'agents par cas d'usage",
      "Cartographie confidentialité des données & conformité",
      "Modèle de coûts & stratégie BYOK",
    ],
    accent: "var(--violet-l)",
  },
  {
    id: "custom-models",
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="28" height="28"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/></svg>`,
    eyebrow: "Service 04",
    title: "Entraînement de modèles sur mesure",
    body: "Les LLMs généralistes ne suffisent pas toujours. Nous fine-tunons et entraînons des modèles spécialisés sur tes données métier — juridique, médical, financier, technique — pour que tes agents performent avec la précision d'un expert, pas d'un généraliste. Plus petits, plus rapides, moins coûteux, et profondément adaptés à ton vocabulaire et tes processus.",
    deliverables: [
      "Audit & curation du dataset",
      "Sélection du modèle de base (open-weight ou propriétaire)",
      "Pipeline de fine-tuning supervisé (SFT) ou RLHF",
      "Benchmarks d'évaluation sur ton domaine métier",
      "Déploiement sur ton infrastructure (compatible BYOK)",
    ],
    accent: "var(--red)",
  },
  {
    id: "integration",
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="28" height="28"><path d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01"/></svg>`,
    eyebrow: "Service 05",
    title: "Intégration & Déploiement",
    body: "Agentivity ne vit pas en vase clos. Nous connectons tes équipes d'agents à ta stack existante — CRM, ERP, entrepôts de données, APIs internes, Slack, email — pour que tes agents agissent sur des données réelles et livrent des résultats là où ton équipe travaille déjà. Docker, on-premise ou cloud privé.",
    deliverables: [
      "Développement de connecteurs (REST, webhooks, APIs internes)",
      "Gestion des authentifications & secrets",
      "Déploiement on-premise ou cloud privé",
      "Pipeline CI/CD pour les mises à jour des équipes d'agents",
      "Mise en place du monitoring & des alertes",
    ],
    accent: "var(--cyan)",
  },
  {
    id: "workshops",
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="28" height="28"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/></svg>`,
    eyebrow: "Service 06",
    title: "Ateliers & Formation des équipes",
    body: "Nous formons ton équipe à construire, maintenir et faire évoluer des équipes d'agents par elle-même. Formats de demi-journée à deux jours, en pratique sur Agentivity. Des parties prenantes non-techniques apprenant à composer des agents visuellement, aux développeurs approfondissant le prompt engineering, les topologies et les outils custom.",
    deliverables: [
      "Curriculum sur mesure adapté au niveau de ton équipe",
      "Sessions pratiques sur le canvas Agentivity",
      "Meilleures pratiques de prompt engineering",
      "Exercices de conception de topologie d'équipe",
      "Supports d'atelier + sessions enregistrées",
    ],
    accent: "var(--mint)",
  },
];
---
<Base
  title="Services Agentivity — Développement IA, Architecture & Entraînement de modèles"
  description="Services professionnels IA complets : développement d'équipes d'agents, transformation IT, architecture IA, entraînement de modèles sur mesure, intégration et ateliers."
  lang="fr"
  schema={schema}
>
  <Nav lang={lang} />

  <!-- HERO -->
  <section class="s-black svc-hero">
    <div class="svc-hero-bg" aria-hidden="true"></div>
    <div class="wrap svc-hero-inner">
      <span class="eyebrow" style="color:var(--violet-l)">Services Professionnels</span>
      <h1 class="h1 svc-h1">
        Nous construisons<br /><span class="grad-text">l'équipe IA qu'il te faut.</span>
      </h1>
      <p class="svc-sub">
        Agentivity est la plateforme. Nous sommes l'équipe qui la fait fonctionner pour ton organisation —
        du premier agent à la transformation IA complète.
      </p>
      <div class="svc-hero-stats">
        <div class="svc-stat">
          <span class="svc-stat-num">6</span>
          <span class="svc-stat-label">Lignes de service</span>
        </div>
        <div class="svc-stat-divider" aria-hidden="true"></div>
        <div class="svc-stat">
          <span class="svc-stat-num">End&#8209;to&#8209;end</span>
          <span class="svc-stat-label">De l'audit au déploiement</span>
        </div>
        <div class="svc-stat-divider" aria-hidden="true"></div>
        <div class="svc-stat">
          <span class="svc-stat-num">BYOK</span>
          <span class="svc-stat-label">Ton infra, tes données</span>
        </div>
      </div>
      <a href="#contact" class="btn btn-primary lg svc-hero-cta">Nous contacter →</a>
    </div>
  </section>

  <!-- SERVICES -->
  <section class="s-navy svc-list-section">
    <div class="wrap">
      {services.map((s, i) => (
        <div class={`svc-item ${i % 2 === 1 ? 'svc-item--alt' : ''}`} id={s.id}>
          <div class="svc-item-header">
            <div class="svc-item-icon" style={`--c:${s.accent}`} set:html={s.icon}></div>
            <div>
              <span class="svc-item-eyebrow">{s.eyebrow}</span>
              <h2 class="svc-item-title">{s.title}</h2>
            </div>
          </div>
          <div class="svc-item-body">
            <p class="svc-item-desc">{s.body}</p>
            <div class="svc-deliverables">
              <p class="svc-deliv-label">Ce que tu reçois</p>
              <ul class="svc-deliv-list">
                {s.deliverables.map(d => (
                  <li class="svc-deliv-item">
                    <span class="svc-deliv-dot" style={`background:${s.accent}`}></span>
                    {d}
                  </li>
                ))}
              </ul>
            </div>
          </div>
          <div class="svc-item-cta">
            <a href="#contact" class="btn btn-ghost">Nous contacter →</a>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- HOW WE WORK -->
  <section class="s-pearl svc-process-section">
    <div class="wrap">
      <span class="eyebrow" style="color:var(--violet)">Notre méthode</span>
      <h2 class="h2 svc-process-title">De la découverte à la livraison.</h2>
      <p class="svc-process-sub">Chaque engagement suit le même processus rigoureux — sans boîte noire, sans dépendance.</p>
      <div class="svc-process-steps">
        <div class="svc-step">
          <div class="svc-step-num">01</div>
          <h3 class="svc-step-title">Découverte</h3>
          <p class="svc-step-body">On cartographie tes workflows, tes données et ton équipe. On identifie où les agents IA créent un vrai levier — pas juste où ils sont intéressants.</p>
        </div>
        <div class="svc-step-arrow" aria-hidden="true">→</div>
        <div class="svc-step">
          <div class="svc-step-num">02</div>
          <h3 class="svc-step-title">Conception</h3>
          <p class="svc-step-body">On architecture l'équipe d'agents : rôles, outils, prompts, topologie et flux de données. Tu révises et valides avant qu'une seule ligne soit écrite.</p>
        </div>
        <div class="svc-step-arrow" aria-hidden="true">→</div>
        <div class="svc-step">
          <div class="svc-step-num">03</div>
          <h3 class="svc-step-title">Construction</h3>
          <p class="svc-step-body">On construit sur Agentivity, on itère vite, on teste sur des scénarios réels de ton domaine. Démos hebdomadaires, transparence totale.</p>
        </div>
        <div class="svc-step-arrow" aria-hidden="true">→</div>
        <div class="svc-step">
          <div class="svc-step-num">04</div>
          <h3 class="svc-step-title">Déploiement & Transfert</h3>
          <p class="svc-step-body">On déploie sur ton infrastructure, on forme ton équipe, on livre la documentation, et on reste disponible 30 jours après le lancement.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ENGAGEMENT MODELS -->
  <section class="s-black svc-engage-section">
    <div class="wrap">
      <h2 class="h2 svc-engage-title" style="color:#fff">Modèles d'engagement</h2>
      <p class="svc-engage-sub">Choisis le format qui correspond à ton projet et ton budget.</p>
      <div class="svc-engage-grid">
        <div class="svc-engage-card">
          <h3 class="svc-engage-name">Périmètre fixe</h3>
          <p class="svc-engage-desc">Livrable défini, prix fixe. Idéal pour les constructions d'équipes d'agents et les intégrations spécifiques où le périmètre est clair.</p>
          <ul class="svc-engage-list">
            <li>Spécification claire en amont</li>
            <li>Paiement par jalons</li>
            <li>Transfert complet de propriété intellectuelle à la livraison</li>
          </ul>
        </div>
        <div class="svc-engage-card svc-engage-card--featured">
          <div class="svc-engage-badge">Le plus courant</div>
          <h3 class="svc-engage-name">Retainer</h3>
          <p class="svc-engage-desc">Partenariat continu — un volume fixe d'heures par mois. Idéal pour les équipes qui veulent itérer, étendre et faire évoluer leurs capacités IA en continu.</p>
          <ul class="svc-engage-list">
            <li>Capacité d'équipe dédiée</li>
            <li>Réponse prioritaire</li>
            <li>Revue & planification mensuelle</li>
          </ul>
        </div>
        <div class="svc-engage-card">
          <h3 class="svc-engage-name">Atelier</h3>
          <p class="svc-engage-desc">Intensif de demi-journée à deux jours. Idéal pour les équipes qui veulent apprendre à builder avec Agentivity elles-mêmes.</p>
          <ul class="svc-engage-list">
            <li>En présentiel ou à distance</li>
            <li>Curriculum sur mesure</li>
            <li>Exercices pratiques</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- CONTACT -->
  <section class="s-violet svc-contact" id="contact">
    <div class="svc-contact-glow" aria-hidden="true"></div>
    <div class="wrap svc-contact-inner">
      <div class="svc-contact-text">
        <h2 class="h2 svc-contact-h2">
          Parlons de<br /><span class="grad-text">ton projet.</span>
        </h2>
        <p class="svc-contact-sub">
          Dis-nous ce que tu veux construire. On revient avec une proposition concrète dans les 48 heures.
        </p>
        <div class="svc-contact-reassurances">
          <p class="svc-reassure"><span class="svc-reassure-dot" style="--c:var(--mint)"></span>Sans engagement</p>
          <p class="svc-reassure"><span class="svc-reassure-dot" style="--c:var(--cyan)"></span>Réponse en 48h</p>
          <p class="svc-reassure"><span class="svc-reassure-dot" style="--c:var(--violet-l)"></span>NDA disponible sur demande</p>
        </div>
      </div>
      <div class="svc-form-wrap">
        <form
          method="POST"
          action={`https://formspree.io/f/${import.meta.env.PUBLIC_FORMSPREE_SERVICES ?? 'YOUR_FORM_ID'}`}
          class="svc-form"
        >
          <input type="hidden" name="_next" value="https://agentivity.io/fr/merci" />
          <input type="hidden" name="_gotcha" style="display:none" />

          <div class="svc-form-row">
            <div class="svc-field">
              <label class="svc-label" for="svc-name">Nom</label>
              <input type="text" id="svc-name" name="name" placeholder="Ton nom" required class="svc-input" />
            </div>
            <div class="svc-field">
              <label class="svc-label" for="svc-email">Email</label>
              <input type="email" id="svc-email" name="email" placeholder="ton@entreprise.com" required class="svc-input" />
            </div>
          </div>

          <div class="svc-field">
            <label class="svc-label" for="svc-service">Service qui t'intéresse</label>
            <select id="svc-service" name="service" class="svc-input svc-select">
              <option value="" disabled selected>Sélectionne un service…</option>
              <option value="agent-teams">Développement d'équipes d'agents</option>
              <option value="it-transformation">Transformation IT</option>
              <option value="ai-architecture">Architecture IA &amp; Stratégie</option>
              <option value="custom-models">Entraînement de modèles sur mesure</option>
              <option value="integration">Intégration &amp; Déploiement</option>
              <option value="workshops">Ateliers &amp; Formation</option>
              <option value="other">Autre / Pas encore sûr</option>
            </select>
          </div>

          <div class="svc-field">
            <label class="svc-label" for="svc-message">Parle-nous de ton projet</label>
            <textarea id="svc-message" name="message" placeholder="Qu'est-ce que tu cherches à automatiser ou construire ? Quel est le problème actuel ? Des contraintes (infra, budget, délais) ?" rows="5" class="svc-input svc-textarea"></textarea>
          </div>

          <button type="submit" class="btn btn-primary lg svc-submit">Envoyer la demande →</button>

          <p class="svc-form-note">
            <svg viewBox="0 0 20 20" fill="currentColor" width="12" height="12" style="opacity:.4"><path fill-rule="evenodd" d="M5 9V7a5 5 0 0 1 10 0v2a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2zm8-2v2H7V7a3 3 0 0 1 6 0z" clip-rule="evenodd"/></svg>
            Tes informations restent confidentielles et ne sont jamais partagées.
          </p>
        </form>
      </div>
    </div>
  </section>

  <Footer lang={lang} />
</Base>

<style>
.svc-hero { padding: 120px 0 80px; position: relative; overflow: hidden; }
.svc-hero-bg { position: absolute; inset: 0; pointer-events: none; background: radial-gradient(ellipse 55% 60% at 70% 20%, rgba(109,0,245,.12) 0%, transparent 60%), radial-gradient(ellipse 40% 50% at 20% 80%, rgba(0,200,150,.06) 0%, transparent 60%); }
.svc-hero-inner { position: relative; z-index: 1; max-width: 720px; }
.svc-h1 { font-size: clamp(48px, 8vw, 96px); margin: 16px 0 24px; letter-spacing: -.05em; line-height: 1.05; }
.svc-sub { font-size: clamp(16px, 1.4vw, 18px); color: rgba(255,255,255,.5); line-height: 1.75; max-width: 52ch; margin-bottom: 40px; }
.svc-hero-stats { display: flex; align-items: center; gap: 32px; flex-wrap: wrap; margin-bottom: 40px; }
.svc-stat-divider { width: 1px; height: 36px; background: rgba(255,255,255,.1); }
.svc-stat-num { display: block; font-size: 22px; font-weight: 800; color: #fff; letter-spacing: -.03em; line-height: 1.1; }
.svc-stat-label { display: block; font-size: 12px; color: rgba(255,255,255,.35); margin-top: 2px; }
.svc-list-section { padding: 80px 0; }
.svc-item { display: grid; grid-template-columns: 280px 1fr auto; gap: 48px; align-items: start; padding: 48px 0; border-bottom: 1px solid rgba(255,255,255,.06); }
.svc-item:first-child { border-top: 1px solid rgba(255,255,255,.06); }
@media (max-width: 900px) { .svc-item { grid-template-columns: 1fr; gap: 24px; } }
.svc-item-header { display: flex; align-items: flex-start; gap: 16px; }
.svc-item-icon { width: 52px; height: 52px; flex-shrink: 0; border-radius: var(--r-lg); background: color-mix(in srgb, var(--c) 12%, rgba(13,27,53,1)); border: 1px solid color-mix(in srgb, var(--c) 25%, transparent); display: flex; align-items: center; justify-content: center; color: var(--c); margin-top: 2px; }
.svc-item-eyebrow { font-size: 11px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: rgba(255,255,255,.25); display: block; margin-bottom: 6px; }
.svc-item-title { font-size: clamp(18px, 2vw, 24px); font-weight: 800; color: #fff; letter-spacing: -.03em; line-height: 1.2; }
.svc-item-body { display: flex; flex-direction: column; gap: 28px; }
.svc-item-desc { font-size: 15px; color: rgba(255,255,255,.5); line-height: 1.8; }
.svc-deliv-label { font-size: 11px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: rgba(255,255,255,.25); margin-bottom: 12px; }
.svc-deliv-list { list-style: none; display: flex; flex-direction: column; gap: 8px; }
.svc-deliv-item { display: flex; align-items: center; gap: 10px; font-size: 13px; color: rgba(255,255,255,.55); line-height: 1.4; }
.svc-deliv-dot { width: 6px; height: 6px; border-radius: 50%; flex-shrink: 0; opacity: .8; }
.svc-process-section { padding: 96px 0; }
.svc-process-title { font-size: clamp(28px, 3.5vw, 48px); color: var(--ink); margin: 12px 0 16px; }
.svc-process-sub { font-size: 16px; color: var(--ink-2); margin-bottom: 56px; max-width: 44ch; }
.svc-process-steps { display: grid; grid-template-columns: 1fr auto 1fr auto 1fr auto 1fr; gap: 0; align-items: start; }
@media (max-width: 860px) { .svc-process-steps { grid-template-columns: 1fr; } .svc-step-arrow { display: none; } }
.svc-step { padding: 0 24px 0 0; }
.svc-step-num { font-size: clamp(36px, 4vw, 52px); font-weight: 900; color: color-mix(in srgb, var(--violet) 20%, var(--pearl)); letter-spacing: -.05em; line-height: 1; margin-bottom: 16px; }
.svc-step-title { font-size: 17px; font-weight: 700; color: var(--ink); margin-bottom: 10px; }
.svc-step-body { font-size: 14px; color: var(--ink-2); line-height: 1.7; }
.svc-step-arrow { font-size: 20px; color: color-mix(in srgb, var(--violet) 30%, var(--pearl)); align-self: center; padding: 0 8px; margin-top: -24px; }
.svc-engage-section { padding: 80px 0; }
.svc-engage-title { margin-bottom: 12px; }
.svc-engage-sub { font-size: 16px; color: rgba(255,255,255,.4); margin-bottom: 48px; }
.svc-engage-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
@media (max-width: 760px) { .svc-engage-grid { grid-template-columns: 1fr; } }
.svc-engage-card { padding: 32px; border-radius: var(--r-xl); border: 1px solid rgba(255,255,255,.07); background: rgba(255,255,255,.03); display: flex; flex-direction: column; gap: 16px; }
.svc-engage-card--featured { border-color: rgba(139,47,248,.3); background: rgba(109,0,245,.08); position: relative; }
.svc-engage-badge { position: absolute; top: -12px; left: 24px; background: var(--violet); color: #fff; font-size: 10px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; padding: 4px 12px; border-radius: 999px; }
.svc-engage-name { font-size: 18px; font-weight: 800; color: #fff; letter-spacing: -.03em; }
