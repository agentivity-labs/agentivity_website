---
import Base from '../../layouts/Base.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';

const lang = 'en';

const schema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "Agentivity vs Make — AI Agent Teams, Workflow Editor & Prompt Studio vs SaaS Automation",
  "description": "Make automates SaaS scenarios. Agentivity adds Agent Studio, Team Studio, multi-agent topologies and Prompt Studio on top of its workflow editor. Self-hosted and free. Honest comparison."
};

type Status = 'yes' | 'partial' | 'no';
interface Row { feature: string; ag: Status; make: Status; note?: string; }

const rows: Row[] = [
  { feature: "Workflow editor",              ag: "yes",     make: "yes",     },
  { feature: "AI agent support",             ag: "yes",     make: "partial", note: "Make has AI modules (OpenAI, Claude) — single LLM call per module" },
  { feature: "Multi-agent teams",            ag: "yes",     make: "no",      },
  { feature: "Team topologies",              ag: "yes",     make: "no",      note: "Sequential · Group Chat · Concurrent" },
  { feature: "Agent Studio",                 ag: "yes",     make: "no",      },
  { feature: "Team Studio",                  ag: "yes",     make: "no",      },
  { feature: "Prompt Studio",                ag: "yes",     make: "no",      },
  { feature: "Synergi template library",     ag: "yes",     make: "partial", note: "Make has 1,500+ scenario templates — not agent/team templates" },
  { feature: "Self-hostable",                ag: "yes",     make: "no",      note: "Make is cloud-only — your data lives on their servers" },
  { feature: "Open source",                  ag: "yes",     make: "no",      },
  { feature: "Free tier (unlimited)",        ag: "yes",     make: "partial", note: "Make free = 1,000 ops/month · Agentivity free = unlimited, self-hosted" },
  { feature: "Bring your own API key",       ag: "yes",     make: "partial", note: "Make requires their HTTP module — not native BYOK" },
  { feature: "1,500+ SaaS integrations",    ag: "no",      make: "yes",     note: "Make's main strength" },
  { feature: "Per-operation billing",        ag: "no",      make: "yes",     note: "Make bills per operation — costs scale with usage" },
  { feature: "Data stays on your infra",     ag: "yes",     make: "no",      },
  { feature: "Low-code",                     ag: "yes",     make: "yes",     },
];
---
<Base look="editorial"
  title="Agentivity vs Make — AI Agent Teams & Workflow Editor vs SaaS Automation"
  description="Make is great for automating SaaS tools. Agentivity adds Agent Studio, Team Studio, multi-agent topologies and a Prompt Studio — self-hosted and free, no operation caps. Honest comparison."
  schema={schema}
>
  <SiteHeader lang={lang} />
<main class="ed-page cmp-page">

  <!-- HERO -->
  <section class="s-black cmp-hero">
    <div class="cmp-hero-bg" aria-hidden="true"></div>
    <div class="wrap cmp-hero-inner">
      <span class="eyebrow" style="color:var(--red)">Compare</span>
      <h1 class="h1 cmp-h1">
        Agentivity<br />
        <span class="cmp-vs-word">vs</span>
        <span class="cmp-vs-name">Make</span>
      </h1>
      <p class="cmp-sub">
        Make connects your SaaS tools in visual scenarios — 1,500+ integrations, per-operation billing, cloud-only.
        Agentivity gives you a <strong>workflow editor</strong>, an <strong>Agent Studio</strong>, a <strong>Team Studio</strong>,
        and a <strong>Prompt Studio</strong> — self-hosted, free, no operation counter.
      </p>
      <div class="cmp-hero-pills">
        <span class="cmp-pill" style="--c:var(--mint)">Both have workflow editors</span>
        <span class="cmp-pill" style="--c:var(--mint)">Agentivity is free &amp; self-hosted</span>
        <span class="cmp-pill" style="--c:var(--red)">Make = cloud-only, usage-billed</span>
      </div>
    </div>
  </section>

  <!-- VERDICT -->
  <section class="s-navy cmp-verdict-section">
    <div class="wrap">
      <h2 class="h3 cmp-section-title">Pick the right tool</h2>
      <div class="cmp-verdict-grid">
        <div class="cmp-verdict-card cmp-verdict-card--them">
          <h3 class="cmp-verdict-name">Make is a better fit if…</h3>
          <ul class="cmp-verdict-list">
            <li>You need 1,500+ native integrations with SaaS tools out of the box</li>
            <li>Your workflow connects Slack, Notion, HubSpot, Google Sheets, etc.</li>
            <li>Cloud hosting is fine — data privacy is not a requirement</li>
            <li>AI is a small module inside a larger automation, not the core</li>
          </ul>
        </div>
        <div class="cmp-verdict-card cmp-verdict-card--us">
          <div class="cmp-verdict-badge">Agentivity</div>
          <h3 class="cmp-verdict-name">Agentivity is a better fit if…</h3>
          <ul class="cmp-verdict-list">
            <li>You want AI agents with roles, tools, and memory — not generic LLM calls</li>
            <li>Data privacy matters — nothing leaves your server</li>
            <li>You want unlimited scale with no per-operation billing</li>
            <li>AI orchestration — not SaaS glue — is the product</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- COMPARISON GRID -->
  <section class="s-black cmp-table-section">
    <div class="wrap">
      <h2 class="h2 cmp-section-title" style="color:#fff">Feature by feature</h2>
      <div class="cmp-table-wrap">
        <table class="cmp-table">
          <thead>
            <tr>
              <th class="cmp-th-feature">Feature</th>
              <th class="cmp-th-ag">Agentivity</th>
              <th class="cmp-th-them">Make</th>
            </tr>
          </thead>
          <tbody>
            {rows.map((row, i) => (
              <tr class={i % 2 === 0 ? 'cmp-row-even' : ''}>
                <td class="cmp-td-feature">
                  <span class="cmp-feat-name">{row.feature}</span>
                  {row.note && <span class="cmp-td-note">{row.note}</span>}
                </td>
                <td class="cmp-td-ag">
                  <span class={`cmp-badge cmp-badge--${row.ag}`}>
                    {row.ag === 'yes' ? 'Yes' : row.ag === 'partial' ? 'Partial' : 'No'}
                  </span>
                </td>
                <td class="cmp-td-them">
                  <span class={`cmp-badge cmp-badge--${row.make}`}>
                    {row.make === 'yes' ? 'Yes' : row.make === 'partial' ? 'Partial' : 'No'}
                  </span>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
        <p class="cmp-table-legend">
          <span class="cmp-badge cmp-badge--yes">Yes</span> Supported &nbsp;
          <span class="cmp-badge cmp-badge--partial">Partial</span> Partial / basic &nbsp;
          <span class="cmp-badge cmp-badge--no">No</span> Not supported
        </p>
      </div>
    </div>
  </section>

  <!-- WHAT AGENTIVITY ADDS -->
  <section class="s-navy cmp-deep-section">
    <div class="wrap">
      <h2 class="h2 cmp-section-title" style="color:#fff;margin-bottom:8px">What Agentivity adds on top</h2>
      <p class="cmp-deep-intro">Both have a workflow editor. Agentivity layers three additional studios that Make doesn't have.</p>

      <div class="cmp-studios">

        <div class="cmp-studio-card">
          <div class="cmp-studio-header">
            <div class="cmp-studio-dot" style="--c:var(--mint)"></div>
            <h3 class="cmp-studio-name">Agent Studio</h3>
          </div>
          <p class="cmp-studio-body">
            Design each agent individually: name, role, system prompt, tool set (web search, code execution, APIs), and memory scope. In Make, an AI module is a single LLM call with no concept of identity, role, or specialisation.
          </p>
        </div>

        <div class="cmp-studio-card">
          <div class="cmp-studio-header">
            <div class="cmp-studio-dot" style="--c:var(--cyan)"></div>
            <h3 class="cmp-studio-name">Team Studio &amp; Topologies</h3>
          </div>
          <p class="cmp-studio-body">
            Compose agents into teams and choose a collaboration topology:
            <strong>Sequential</strong> (hand-off chain),
            <strong>Group Chat</strong> (agents reason together),
            or <strong>Concurrent</strong> (parallel execution + synthesis).
            Make has no equivalent — its modules run in order, independently.
          </p>
        </div>

        <div class="cmp-studio-card">
          <div class="cmp-studio-header">
            <div class="cmp-studio-dot" style="--c:var(--violet-l)"></div>
            <h3 class="cmp-studio-name">Prompt Studio</h3>
          </div>
          <p class="cmp-studio-body">
            A dedicated environment to write, version, and iterate on system prompts — per agent. Compare outputs across prompt versions, refine agent behaviour, and maintain a library of tested prompts. Make has no prompt management layer.
          </p>
        </div>

        <div class="cmp-studio-card">
          <div class="cmp-studio-header">
            <div class="cmp-studio-dot" style="--c:var(--red)"></div>
            <h3 class="cmp-studio-name">Self-hosted &amp; free, forever</h3>
          </div>
          <p class="cmp-studio-body">
            Make is cloud-only and bills per operation. Agentivity runs on your infrastructure — Docker, your server, your rules. No operation counter, no monthly bill, no data leaving your network. Your only cost is the LLM tokens you pay directly to your provider.
          </p>
        </div>

      </div>
    </div>
  </section>

  <!-- HONEST CAVEAT -->
  <section class="s-black cmp-caveat-section">
    <div class="wrap cmp-caveat-wrap">
      <div class="cmp-honest-box">
        <span class="cmp-honest-label">Honest caveat</span>
        <p class="cmp-honest-text">
          If you need deep SaaS integrations — Slack, HubSpot, Google Workspace, Notion — Make's 1,500+ connectors are hard to beat without custom dev. Agentivity ships the tools agents need (web search, code execution, APIs), not a universal SaaS connector. Many teams use both: Make to trigger and pipe data, Agentivity to do the reasoning.
        </p>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="s-violet cmp-cta">
    <div class="wrap cmp-cta-inner">
      <h2 class="h2 cmp-cta-h2">AI that reasons.<br /><span class="grad-text">Free. On your infra.</span></h2>
      <p class="cmp-cta-sub">Low-code. Self-hosted. Open source. No operation counter.</p>
      <div class="cmp-cta-btns">
        <a href="https://github.com/agentivity-labs/agentivity" target="_blank" rel="noopener noreferrer" class="btn btn-primary lg">Star on GitHub</a>
        <a href="/how-it-works" class="btn btn-ghost">See how it works →</a>
      </div>
    </div>
  </section>

  </main>
<SiteFooter lang={lang} />
</Base>
