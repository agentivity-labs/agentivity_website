---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';

const lang = 'en';

const schema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "Agentivity vs Dify — Multi-Agent Teams, Team Topologies & Workflow Editor vs LLM App Platform",
  "description": "Both have agents and workflows. Agentivity adds multi-agent team topologies, Team Studio, and Prompt Studio. Dify is stronger on RAG and app publishing. Honest comparison."
};

type Status = 'yes' | 'partial' | 'no';
interface Row { feature: string; ag: Status; dify: Status; note?: string; }

const rows: Row[] = [
  { feature: "Workflow editor",              ag: "yes",     dify: "yes",     },
  { feature: "AI agent support",             ag: "yes",     dify: "yes",     },
  { feature: "Multi-agent teams",            ag: "yes",     dify: "partial", note: "Dify supports agent nodes in workflows — not full team topologies" },
  { feature: "Team topologies",              ag: "yes",     dify: "no",      note: "Sequential · Group Chat · Concurrent" },
  { feature: "Agent Studio",                 ag: "yes",     dify: "partial", note: "Dify has agent config — Agentivity adds role, hierarchy & memory" },
  { feature: "Team Studio",                  ag: "yes",     dify: "no",      },
  { feature: "Prompt Studio",                ag: "yes",     dify: "yes",     },
  { feature: "Synergi template library",     ag: "yes",     dify: "yes",     },
  { feature: "RAG / Knowledge base",         ag: "partial", dify: "yes",     note: "Dify's strength — native vector store & document ingestion" },
  { feature: "App publishing (API/embed)",   ag: "no",      dify: "yes",     note: "Dify lets you ship chatbots as embeddable apps" },
  { feature: "Bring your own API key",       ag: "yes",     dify: "yes",     },
  { feature: "Self-hostable",                ag: "yes",     dify: "yes",     },
  { feature: "Open source",                  ag: "yes",     dify: "yes",     },
  { feature: "Low-code",                     ag: "yes",     dify: "yes",     },
  { feature: "Parallel agent execution",     ag: "yes",     dify: "no",      },
  { feature: "Agent memory & hierarchy",     ag: "yes",     dify: "no",      },
];
---
<Base
  title="Agentivity vs Dify — Multi-Agent Teams & Topologies vs LLM App Platform"
  description="Both have workflows and agent support. Agentivity adds Team Studio, multi-agent topologies and concurrent execution. Dify leads on RAG and app publishing. Honest comparison."
  schema={schema}
>
  <Nav lang={lang} />

  <!-- HERO -->
  <section class="s-black cmp-hero">
    <div class="cmp-hero-bg" aria-hidden="true"></div>
    <div class="wrap cmp-hero-inner">
      <span class="eyebrow" style="color:var(--mint)">Compare</span>
      <h1 class="h1 cmp-h1">
        Agentivity<br />
        <span class="cmp-vs-word">vs</span>
        <span class="cmp-vs-name">Dify</span>
      </h1>
      <p class="cmp-sub">
        Both have workflows, agents, a prompt studio, and a template library.
        The split is clear: Dify excels at <strong>RAG pipelines and app publishing</strong>.
        Agentivity excels at <strong>multi-agent team orchestration</strong> — Group Chat, Concurrent, and hierarchical agent teams.
      </p>
      <div class="cmp-hero-pills">
        <span class="cmp-pill" style="--c:var(--mint)">Both have agents &amp; workflows</span>
        <span class="cmp-pill" style="--c:var(--mint)">Both open source &amp; self-hostable</span>
        <span class="cmp-pill" style="--c:var(--cyan)">Agentivity = team topologies</span>
      </div>
    </div>
  </section>

  <!-- VERDICT -->
  <section class="s-navy cmp-verdict-section">
    <div class="wrap">
      <h2 class="h3 cmp-section-title">Pick the right tool</h2>
      <div class="cmp-verdict-grid">
        <div class="cmp-verdict-card cmp-verdict-card--them">
          <h3 class="cmp-verdict-name">Dify is a better fit if…</h3>
          <ul class="cmp-verdict-list">
            <li>You need native RAG — vector search, document ingestion, knowledge bases</li>
            <li>You want to publish an LLM app as an embeddable chatbot or API</li>
            <li>A single agent per task is enough for your workflow</li>
            <li>Your team is building customer-facing AI products</li>
          </ul>
        </div>
        <div class="cmp-verdict-card cmp-verdict-card--us">
          <div class="cmp-verdict-badge">Agentivity</div>
          <h3 class="cmp-verdict-name">Agentivity is a better fit if…</h3>
          <ul class="cmp-verdict-list">
            <li>You want multiple agents working as a team — with roles and hierarchy</li>
            <li>You need Group Chat (agents reasoning together) or Concurrent (parallel) topologies</li>
            <li>Each agent should have its own tools, memory, and specialisation</li>
            <li>AI orchestration — not app publishing — is your goal</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- COMPARISON GRID -->
  <section class="s-black cmp-table-section">
    <div class="wrap">
      <h2 class="h2 cmp-section-title" style="color:#fff">Feature by feature</h2>
      <div class="cmp-table-wrap">
        <table class="cmp-table">
          <thead>
            <tr>
              <th class="cmp-th-feature">Feature</th>
              <th class="cmp-th-ag">Agentivity</th>
              <th class="cmp-th-them">Dify</th>
            </tr>
          </thead>
          <tbody>
            {rows.map((row, i) => (
              <tr class={i % 2 === 0 ? 'cmp-row-even' : ''}>
                <td class="cmp-td-feature">
                  <span class="cmp-feat-name">{row.feature}</span>
                  {row.note && <span class="cmp-td-note">{row.note}</span>}
                </td>
                <td class="cmp-td-ag">
                  <span class={`cmp-badge cmp-badge--${row.ag}`}>
                    {row.ag === 'yes' ? 'Yes' : row.ag === 'partial' ? 'Partial' : 'No'}
                  </span>
                </td>
                <td class="cmp-td-them">
                  <span class={`cmp-badge cmp-badge--${row.dify}`}>
                    {row.dify === 'yes' ? 'Yes' : row.dify === 'partial' ? 'Partial' : 'No'}
                  </span>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
        <p class="cmp-table-legend">
          <span class="cmp-badge cmp-badge--yes">Yes</span> Supported &nbsp;
          <span class="cmp-badge cmp-badge--partial">Partial</span> Partial / basic &nbsp;
          <span class="cmp-badge cmp-badge--no">No</span> Not supported
        </p>
      </div>
    </div>
  </section>

  <!-- WHERE THEY DIVERGE -->
  <section class="s-navy cmp-deep-section">
    <div class="wrap">
      <h2 class="h2 cmp-section-title" style="color:#fff;margin-bottom:8px">Where the two tools diverge</h2>
      <p class="cmp-deep-intro">Both tools overlap on workflows, agents, and prompts. Here's where they go in different directions.</p>

      <div class="cmp-studios">

        <div class="cmp-studio-card">
          <div class="cmp-studio-header">
            <div class="cmp-studio-dot" style="--c:var(--mint)"></div>
            <h3 class="cmp-studio-name">Team Studio &amp; Topologies</h3>
          </div>
          <p class="cmp-studio-body">
            Agentivity's unique layer: compose agents into teams and choose how they collaborate.
            <strong>Sequential</strong> — classic hand-off chain.
            <strong>Group Chat</strong> — agents reason and debate together.
            <strong>Concurrent</strong> — agents run in parallel, a synthesiser merges results.
            Dify has no equivalent.
          </p>
        </div>

        <div class="cmp-studio-card">
          <div class="cmp-studio-header">
            <div class="cmp-studio-dot" style="--c:var(--cyan)"></div>
            <h3 class="cmp-studio-name">Agent hierarchy &amp; memory</h3>
          </div>
          <p class="cmp-studio-body">
            In Agentivity, agents have reporting relationships — a Writer reports to an Editor, a Researcher feeds an Analyst. Each agent can hold its own memory scope. Dify's agents are peers in a workflow, with no concept of team hierarchy.
          </p>
        </div>

        <div class="cmp-studio-card cmp-studio-card--them">
          <div class="cmp-studio-header">
            <div class="cmp-studio-dot" style="--c:var(--violet-l)"></div>
            <h3 class="cmp-studio-name">RAG &amp; Knowledge base — Dify leads</h3>
          </div>
          <p class="cmp-studio-body">
            Dify's native knowledge base is excellent — upload documents, chunk them, embed them, and query with hybrid search. Agentivity can call external retrieval tools but doesn't ship a native vector store. If RAG is core to your product, Dify is the better choice.
          </p>
        </div>

        <div class="cmp-studio-card cmp-studio-card--them">
          <div class="cmp-studio-header">
            <div class="cmp-studio-dot" style="--c:var(--red)"></div>
            <h3 class="cmp-studio-name">App publishing — Dify leads</h3>
          </div>
          <p class="cmp-studio-body">
            Dify lets you ship your agent as an embeddable chatbot widget, a REST API, or a shareable link. Agentivity is built to run teams internally — not to publish end-user apps. If you're building a customer-facing product, Dify has a head start.
          </p>
        </div>

      </div>

      <div class="cmp-honest-box">
        <span class="cmp-honest-label">Honest take</span>
        <p class="cmp-honest-text">
          These tools are complementary more than competitive. Some teams use Dify to build the RAG knowledge layer and Agentivity to orchestrate the agents that query it. The right choice depends on whether your core need is <em>app publishing</em> (Dify) or <em>agent team orchestration</em> (Agentivity).
        </p>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="s-violet cmp-cta">
    <div class="wrap cmp-cta-inner">
      <h2 class="h2 cmp-cta-h2">Agent teams.<br /><span class="grad-text">Not solo agents.</span></h2>
      <p class="cmp-cta-sub">Low-code. Self-hosted. Open source. Running in minutes.</p>
      <div class="cmp-cta-btns">
        <a href="https://github.com/agentivity-labs/agentivity" target="_blank" rel="noopener noreferrer" class="btn btn-primary lg">Star on GitHub</a>
        <a href="/how-it-works" class="btn btn-ghost">See how it works →</a>
      </div>
    </div>
  </section>

  <Footer lang={lang} />
</Base>

<style>
.cmp-hero { padding: 120px 0 80px; position: relative; overflow: hidden; }
.cmp-hero-bg {
  position: absolute; inset: 0; pointer-events: none;
  background: radial-gradient(ellipse 50% 60% at 15% 50%, rgba(0,200,150,.07) 0%, transparent 60%),
              radial-gradient(ellipse 40% 50% at 85% 30%, rgba(0,207,255,.06) 0%, transparent 60%);
}
.cmp-hero-inner { position: relative; z-index: 1; }
.cmp-h1 { font-size: clamp(48px, 8vw, 96px); line-height: 1.05; margin: 16px 0 24px; letter-spacing: -.05em; }
.cmp-vs-word { display: block; font-size: .45em; color: rgba(255,255,255,.2); font-weight: 400; letter-spacing: 0; }
.cmp-vs-name { color: var(--mint); }
.cmp-sub { font-size: clamp(15px, 1.3vw, 17px); color: rgba(255,255,255,.5); line-height: 1.75; max-width: 58ch; margin-bottom: 32px; }
.cmp-sub strong { color: rgba(255,255,255,.85); font-weight: 600; }
.cmp-hero-pills { display: flex; gap: 10px; flex-wrap: wrap; }
.cmp-pill { font-size: 12px; font-weight: 700; letter-spacing: .06em; padding: 6px 14px; border-radius: 999px; border: 1px solid color-mix(in srgb, var(--c) 30%, transparent); background: color-mix(in srgb, var(--c) 8%, transparent); color: var(--c); }

.cmp-verdict-section { padding: 80px 0; }
.cmp-section-title { margin-bottom: 32px; }
.cmp-verdict-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
@media (max-width: 700px) { .cmp-verdict-grid { grid-template-columns: 1fr; } }
.cmp-verdict-card { padding: 32px; border-radius: var(--r-xl); border: 1px solid rgba(255,255,255,.07); background: rgba(255,255,255,.03); }
.cmp-verdict-card--us { border-color: rgba(139,47,248,.3); background: rgba(109,0,245,.07); position: relative; }
.cmp-verdict-badge { position: absolute; top: -12px; left: 24px; background: var(--violet); color: #fff; font-size: 10px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; padding: 4px 12px; border-radius: 999px; }
.cmp-verdict-name { font-size: 15px; font-weight: 700; color: #fff; margin-bottom: 16px; }
.cmp-verdict-list { list-style: none; display: flex; flex-direction: column; gap: 10px; }
.cmp-verdict-list li { font-size: 13px; color: rgba(255,255,255,.5); padding-left: 16px; position: relative; line-height: 1.55; }
.cmp-verdict-list li::before { content: '–'; position: absolute; left: 0; color: rgba(255,255,255,.2); }
.cmp-verdict-card--us .cmp-verdict-list li { color: rgba(255,255,255,.72); }
.cmp-verdict-card--us .cmp-verdict-list li::before { color: var(--violet-l); }

.cmp-table-section { padding: 80px 0; }
.cmp-table-wrap { margin-top: 32px; overflow-x: auto; }
.cmp-table { width: 100%; border-collapse: collapse; }
.cmp-table th, .cmp-table td { padding: 13px 20px; border-bottom: 1px solid rgba(255,255,255,.06); vertical-align: middle; }
.cmp-th-feature { font-size: 11px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: rgba(255,255,255,.3); width: 52%; text-align: left; }
.cmp-th-ag { font-size: 13px; font-weight: 800; color: #fff; background: rgba(109,0,245,.15); border-bottom: 2px solid rgba(139,47,248,.4) !important; width: 24%; text-align: center; }
.cmp-th-them { font-size: 13px; font-weight: 700; color: rgba(255,255,255,.4); width: 24%; text-align: center; }
.cmp-td-feature { text-align: left; }
.cmp-feat-name { display: block; font-size: 13px; color: rgba(255,255,255,.65); line-height: 1.4; }
.cmp-td-note { display: block; font-size: 11px; color: rgba(255,255,255,.28); margin-top: 3px; font-style: italic; line-height: 1.4; }
.cmp-td-ag { background: rgba(109,0,245,.06); text-align: center; }
.cmp-td-them { text-align: center; }
.cmp-row-even td { background: rgba(255,255,255,.02); }
.cmp-row-even .cmp-td-ag { background: rgba(109,0,245,.09); }

.cmp-badge { display: inline-block; font-size: 11px; font-weight: 700; letter-spacing: .04em; padding: 3px 10px; border-radius: 999px; white-space: nowrap; }
.cmp-badge--yes { background: rgba(0,200,150,.15); color: var(--mint); border: 1px solid rgba(0,200,150,.3); }
.cmp-badge--partial { background: rgba(0,207,255,.1); color: var(--cyan); border: 1px solid rgba(0,207,255,.25); opacity: .9; }
.cmp-badge--no { background: rgba(255,10,48,.1); color: var(--red); border: 1px solid rgba(255,10,48,.25); opacity: .85; }
.cmp-table-legend { margin-top: 16px; font-size: 12px; color: rgba(255,255,255,.3); display: flex; gap: 16px; align-items: center; flex-wrap: wrap; }

.cmp-deep-section { padding: 80px 0; }
.cmp-deep-intro { font-size: 16px; color: rgba(255,255,255,.45); margin-bottom: 40px; max-width: 56ch; }
.cmp-studios { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 40px; }
@media (max-width: 720px) { .cmp-studios { grid-template-columns: 1fr; } }
.cmp-studio-card { padding: 28px 32px; border-radius: var(--r-xl); border: 1px solid rgba(255,255,255,.07); background: rgba(255,255,255,.025); }
.cmp-studio-card--them { border-color: rgba(255,255,255,.04); background: rgba(255,255,255,.015); }
.cmp-studio-header { display: flex; align-items: center; gap: 12px; margin-bottom: 12px; }
.cmp-studio-dot { width: 10px; height: 10px; border-radius: 50%; background: var(--c); box-shadow: 0 0 8px var(--c); flex-shrink: 0; }
.cmp-studio-name { font-size: 15px; font-weight: 700; color: #fff; letter-spacing: -.02em; }
.cmp-studio-card--them .cmp-studio-name { color: rgba(255,255,255,.5); }
.cmp-studio-body { font-size: 13px; color: rgba(255,255,255,.45); line-height: 1.75; }
.cmp-studio-card--them .cmp-studio-body { color: rgba(255,255,255,.32); }
.cmp-studio-body strong { color: rgba(255,255,255,.8); font-weight: 600; }

.cmp-honest-box { padding: 20px 24px; border-radius: var(--r-lg); border: 1px solid rgba(255,207,0,.15); background: rgba(255,207,0,.05); display: flex; gap: 16px; align-items: flex-start; }
.cmp-honest-label { flex-shrink: 0; font-size: 10px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: rgba(255,207,0,.7); padding: 3px 8px; border-radius: 4px; border: 1px solid rgba(255,207,0,.25); background: rgba(255,207,0,.08); margin-top: 2px; white-space: nowrap; }
.cmp-honest-text { font-size: 13px; color: rgba(255,255,255,.4); line-height: 1.7; }
.cmp-honest-text em { font-style: italic; color: rgba(255,255,255,.6); }

.cmp-cta { padding: 100px 0; }
.cmp-cta-inner { text-align: center; display: flex; flex-direction: column; align-items: center; gap: 16px; }
.cmp-cta-h2 { font-size: clamp(36px, 5vw, 64px); color: #fff; }
.cmp-cta-sub { font-size: 17px; color: rgba(255,255,255,.4); }
.cmp-cta-btns { display: flex; gap: 12px; flex-wrap: wrap; justify-content: center; margin-top: 8px; }
</style>
