---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const lang = 'en';
---
<Base
  title="404 — Page not found | Agentivity"
  description="This page doesn't exist. Maybe it moved, maybe it never existed."
  noindex={true}
>
  <Nav lang={lang} />

  <section class="s-black e404-section">
    <div class="e404-bg" aria-hidden="true"></div>
    <div class="wrap e404-inner">

      <div class="e404-code" aria-hidden="true">404</div>
      <span class="eyebrow" style="color:var(--red)">Page not found</span>
      <h1 class="h1 e404-h1">This agent<br />got lost.</h1>
      <p class="e404-sub">
        The page you're looking for doesn't exist — or it moved.<br class="br-md" />
        Let's get you back on track.
      </p>

      <div class="e404-links">
        <a href="/" class="btn btn-primary lg">Back to home</a>
        <a href="/how-it-works" class="btn btn-ghost">How it works →</a>
      </div>

      <div class="e404-nav">
        <a href="/use-cases" class="e404-link">Use cases</a>
        <span class="e404-dot" aria-hidden="true">·</span>
        <a href="/pricing" class="e404-link">Pricing</a>
        <span class="e404-dot" aria-hidden="true">·</span>
        <a href="/services" class="e404-link">Services</a>
        <span class="e404-dot" aria-hidden="true">·</span>
        <a href="/docs" class="e404-link">Docs</a>
      </div>

    </div>
  </section>

  <Footer lang={lang} />
</Base>

<style>
.e404-section {
  min-height: 100vh; display: flex; align-items: center;
  padding: 80px 0 100px; position: relative; overflow: hidden;
}
.e404-bg {
  position: absolute; inset: 0; pointer-events: none;
  background: radial-gradient(ellipse 55% 55% at 50% 40%, rgba(255,10,48,.07) 0%, transparent 65%);
}
.e404-inner {
  position: relative; z-index: 1;
  display: flex; flex-direction: column; align-items: center; text-align: center;
}
.e404-code {
  font-size: clamp(120px, 20vw, 220px);
  font-weight: 900;
  letter-spacing: -.08em;
  line-height: 1;
  color: transparent;
  -webkit-text-stroke: 1px rgba(255,10,48,.15);
  margin-bottom: -20px;
  user-select: none;
}
.e404-h1 { font-size: clamp(40px, 7vw, 80px); margin: 16px 0 20px; color: #fff; }
.e404-sub {
  font-size: clamp(15px, 1.3vw, 17px);
  color: rgba(255,255,255,.4);
  line-height: 1.75;
  max-width: 44ch;
  margin-bottom: 40px;
}
.br-md { display: none; }
@media (min-width: 640px) { .br-md { display: initial; } }
.e404-links { display: flex; gap: 12px; flex-wrap: wrap; justify-content: center; margin-bottom: 48px; }
.e404-nav { display: flex; gap: 12px; align-items: center; flex-wrap: wrap; justify-content: center; }
.e404-link { font-size: 13px; color: rgba(255,255,255,.3); text-decoration: underline; text-underline-offset: 3px; transition: color .15s; }
.e404-link:hover { color: rgba(255,255,255,.6); }
.e404-dot { color: rgba(255,255,255,.15); }
</style>
