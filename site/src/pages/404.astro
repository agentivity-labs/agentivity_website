---
// Page not found. A static site has one 404 page for both languages, so it stays in English.
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

const lang = 'en';
const links = [
  { label: 'Use cases', href: '/use-cases' },
  { label: 'Pricing', href: '/pricing' },
  { label: 'Blog', href: '/blog' },
  { label: 'Services', href: '/services' },
];
---
<Base title="Page not found | Agentivity" description="This page does not exist, or it has moved." lang={lang} noindex={true} look="editorial">

<SiteHeader lang={lang} />

<main class="ed-page">
  <section class="ed-wrap nf">
    <p class="nf-code" aria-hidden="true">404</p>
    <p class="ed-eyebrow">Page not found</p>
    <h1>This page <em class="ed-mark">got lost.</em></h1>
    <p class="nf-sub">It does not exist, or it has moved. Here is the way back.</p>
    <div class="nf-actions">
      <a class="ed-btn ed-btn--navy" href="/">Back to home</a>
      <a class="ed-btn ed-btn--line" href="/how-it-works">See how it works</a>
    </div>
    <ul class="nf-links">
      {links.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
    </ul>
  </section>
</main>

<SiteFooter lang={lang} />

</Base>

<style>
.nf { display: flex; flex-direction: column; align-items: center; gap: 22px; text-align: center; padding-block: clamp(56px, 8vw, 112px) clamp(72px, 9vw, 128px); }
.nf-code { font-family: var(--ed-serif); font-size: clamp(120px, 20vw, 260px); line-height: .85; color: var(--ed-mist); -webkit-text-stroke: 2px var(--ed-ink); }
.nf h1 { font-family: var(--ed-serif); font-size: clamp(42px, 6vw, 88px); line-height: 1; letter-spacing: -.02em; }
.nf-sub { font-size: clamp(18px, 1.6vw, 21px); color: var(--ed-ink-2); }
.nf-actions { display: flex; flex-wrap: wrap; gap: 14px 16px; justify-content: center; margin-top: 6px; }
.nf-links { display: flex; flex-wrap: wrap; justify-content: center; gap: 8px 28px; margin-top: 14px; }
.nf-links a { display: inline-flex; align-items: center; min-height: 44px; font-size: 16.5px; font-weight: 600; color: var(--ed-ink); border-bottom: 1.5px solid currentColor; }
.nf-links a:hover { opacity: .7; }
</style>
