          </div>
        </div>
        <div class="sg-card">
          <span class="sg-emoji">📣</span>
          <div>
            <div class="sg-name">Marketing Team</div>
            <div class="sg-meta">3 agents · Sequential</div>
          </div>
        </div>
        <div class="sg-card">
          <span class="sg-emoji">🔍</span>
          <div>
            <div class="sg-name">Research Assistant</div>
            <div class="sg-meta">2 agents · Sequential</div>
          </div>
        </div>
        <div class="sg-card">
          <span class="sg-emoji">⚖️</span>
          <div>
            <div class="sg-name">Legal Review</div>
            <div class="sg-meta">3 agents · Handoff</div>
          </div>
        </div>
        <div class="sg-card">
          <span class="sg-emoji">🛒</span>
          <div>
            <div class="sg-name">Sales Prospecting</div>
            <div class="sg-meta">3 agents · Concurrent</div>
          </div>
        </div>
        <div class="sg-card sg-card--more">
          <span style="font-size:24px;opacity:.4">+</span>
          <div class="sg-name" style="opacity:.5">More templates</div>
        </div>
