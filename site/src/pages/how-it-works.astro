          </div>
        </div>

        <!-- Cell B — timeline flow -->
        <div class="bento-cell bento-b">
          <div class="timeline">
            <div class="tl-line"></div>
            <div class="tl-item">
              <div class="tl-dot tl-dot--trigger"></div>
              <div class="tl-content">
                <span class="tl-label">Trigger</span>
                <span class="tl-name">New hire signed contract</span>
              </div>
            </div>
            <div class="tl-item">
              <div class="tl-dot tl-dot--agent"></div>
              <div class="tl-content">
                <span class="tl-label tl-label--agent">Agentic · Group Chat</span>
                <span class="tl-name">HR Team</span>
                <span class="tl-sub">Onboarding docs, welcome draft</span>
              </div>
            </div>
            <div class="tl-item">
              <div class="tl-dot tl-dot--deter"></div>
              <div class="tl-content">
                <span class="tl-label tl-label--deter">Deterministic</span>
                <span class="tl-name">✉ Send welcome email</span>
              </div>
            </div>
            <div class="tl-item">
              <div class="tl-dot tl-dot--agent"></div>
              <div class="tl-content">
                <span class="tl-label tl-label--agent">Agentic · Sequential</span>
                <span class="tl-name">Budget &amp; Procurement Team</span>
                <span class="tl-sub">Equipment request, approval summary</span>
              </div>
            </div>
            <div class="tl-item">
              <div class="tl-dot tl-dot--deter"></div>
              <div class="tl-content">
                <span class="tl-label tl-label--deter">Deterministic</span>
                <span class="tl-name">📋 Create PO in system</span>
              </div>
            </div>
            <div class="tl-item">
              <div class="tl-dot tl-dot--done"></div>
              <div class="tl-content">
                <span class="tl-name" style="color:var(--mint)">✓ Employee fully onboarded</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Cell C — stat -->
        <div class="bento-cell bento-c">
          <div class="bc-stat">
            <span class="bc-stat-n grad-text">2</span>
            <span class="bc-stat-l">modes,<br />one flow</span>
          </div>
        </div>

        <!-- Cell D — legend -->
        <div class="bento-cell bento-d">
          <div class="bc-legend">
            <div class="bcl-item">
              <div class="bcl-dot" style="background:var(--violet)"></div>
              <div>
                <div class="bcl-name">Agentic</div>
                <div class="bcl-desc">AI decides, adapts, judges</div>
              </div>
            </div>
            <div class="bcl-item">
              <div class="bcl-dot" style="background:var(--mint)"></div>
              <div>
                <div class="bcl-name">Deterministic</div>
                <div class="bcl-desc">Exact steps, every time</div>
              </div>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════════════
       SYNERGI — two-panel within wrap
  ══════════════════════════════════════════════════════ -->
  <section class="s-black synergi-section">
    <div class="wrap synergi-wrap">
    <div class="ss-left">
      <span class="eyebrow" style="color:var(--mint)">Synergi</span>
      <h2 class="h2" style="color:#fff;margin-top:20px">
