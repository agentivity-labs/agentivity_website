    </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════════════
       BUILDER VS USER — asymmetric magazine layout
  ══════════════════════════════════════════════════════ -->
  <section class="s-navy mag-section">
    <div class="wrap">
      <h2 class="h2" style="color:#fff;margin-bottom:52px">Who does what?</h2>
      <div class="mag-grid">

        <!-- Large left card -->
