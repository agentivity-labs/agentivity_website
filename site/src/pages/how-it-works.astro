        <a href="/use-cases" class="link-arrow" style="color:rgba(255,255,255,.4);font-size:14px">
          See use cases
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16"><path d="M5 12h14m-7-7 7 7-7 7"/></svg>
