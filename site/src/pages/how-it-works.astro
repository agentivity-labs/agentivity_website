---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const lang = 'en';

const schema = {
  "@context": "https://schema.org",
  "@type": "HowTo",
  "name": "How to build an AI agent team with Agentivity",
  "description": "Place agents on a visual canvas, choose a team topology, and run. No code required.",
  "step": [
    { "@type": "HowToStep", "name": "Compose", "text": "Place agents on your canvas. Give each one a role, tools, and instructions." },
    { "@type": "HowToStep", "name": "Structure", "text": "Choose your team topology — sequential, group chat, or concurrent." },
    { "@type": "HowToStep", "name": "Run", "text": "Launch your team. They collaborate and deliver automatically." }
  ]
};
---
<Base
  title="How Agentivity Works — Build AI Agent Teams Without Code"
  description="Place agents on a visual canvas, choose a team topology, and run. No code required. See how Agentivity combines agentic and deterministic steps in one flow."
  schema={schema}
>
  <Nav lang={lang} />

  <!-- ══════════════════════════════════════════════════════
       HERO — full-bleed, oversized type, floating nodes
  ══════════════════════════════════════════════════════ -->
  <section class="hero-wrap">
    <!-- Background floating nodes decoration -->
    <div class="hero-bg" aria-hidden="true">
      <div class="bg-node bg-node-1"></div>
      <div class="bg-node bg-node-2"></div>
      <div class="bg-node bg-node-3"></div>
      <div class="bg-conn bg-conn-1"></div>
      <div class="bg-conn bg-conn-2"></div>
      <div class="bg-glow"></div>
    </div>

    <div class="wrap hero-inner">
      <div class="hero-label">
        <span class="eyebrow" style="color:var(--red)">How it works</span>
      </div>
      <h1 class="hero-h1">
        You don't write code.<br />
        <span class="grad-text">You build a team.</span>
      </h1>
      <p class="hero-sub">
        Place agents on a canvas. Give them roles, tools, instructions.
        Choose how they collaborate. Hit run.
      </p>
      <div class="hero-steps">
        <div class="hs-item">
          <span class="hs-n">01</span>
          <span class="hs-t">Compose agents</span>
        </div>
        <svg width="40" height="2" aria-hidden="true"><line x1="0" y1="1" x2="40" y2="1" stroke="rgba(255,255,255,.15)" stroke-width="1.5" stroke-dasharray="4 3"/></svg>
        <div class="hs-item">
          <span class="hs-n">02</span>
          <span class="hs-t">Structure the team</span>
        </div>
        <svg width="40" height="2" aria-hidden="true"><line x1="0" y1="1" x2="40" y2="1" stroke="rgba(255,255,255,.15)" stroke-width="1.5" stroke-dasharray="4 3"/></svg>
        <div class="hs-item">
          <span class="hs-n">03</span>
          <span class="hs-t">Run &amp; deliver</span>
        </div>
      </div>
    </div>

    <!-- Big decorative step numbers -->
    <div class="hero-deco" aria-hidden="true">Think of a finance team.</div>
  </section>

  <!-- ══════════════════════════════════════════════════════
       METAPHOR — wide centered pull quote
  ══════════════════════════════════════════════════════ -->
  <section class="s-pearl metaphor-section">
    <div class="wrap">
      <div class="metaphor-quote">
        <div class="mq-line"></div>
        <blockquote>
          One agent finds the data, one analyses it, one writes the report.
          They work in sequence, pass results along — and you receive the output, not the process.
        </blockquote>
        <p class="mq-attr">That's Agentivity. <strong style="color:var(--ink)">You compose the team. They handle the rest.</strong></p>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════════════
       STICKY SCROLL — Canvas · Agents · Teams
  ══════════════════════════════════════════════════════ -->
  <section class="s-navy sticky-section">
    <div class="wrap sticky-wrap">

      <!-- Left: scrolling text steps -->
      <div class="sticky-steps">

        <div class="sticky-step" data-step="0">
          <div class="ss-num">01</div>
          <h2 class="h2" style="color:#fff">The Canvas</h2>
          <p class="ss-body">
            Your visual workspace. Place agents on it, choose how they're structured —
            see the whole team at a glance. Who does what, in what order, what they produce.
          </p>
          <ul class="ss-list">
            <li>Drag-and-drop agent placement</li>
            <li>Visual topology selection</li>
            <li>Real-time team overview</li>
          </ul>
        </div>

        <div class="sticky-step" data-step="1">
          <div class="ss-num">02</div>
          <h2 class="h2" style="color:#fff">Agents</h2>
          <p class="ss-body">
            Each agent has a role, a set of tools, and instructions you define.
            A Research Agent searches the web. An Analysis Agent reads the findings.
            A Writer Agent drafts the report.
          </p>
          <div class="ss-callout">
            <span class="ss-callout-label">Low-code, not no-code</span>
            Configuring an agent takes care — a clear role, precise instructions,
            the right tools. Builders love it.
          </div>
        </div>

        <div class="sticky-step" data-step="2">
          <div class="ss-num">03</div>
          <h2 class="h2" style="color:#fff">Teams &amp; Topologies</h2>
          <p class="ss-body">
            Choose your team structure. Each topology defines how agents interact,
            pass information, and produce results together.
          </p>
          <p class="ss-example">
            <strong style="color:var(--cyan)">Finance team example —</strong>
            <span style="color:rgba(255,255,255,.5)">Research Agent → Analysis Agent → Report Agent → your inbox.</span>
          </p>
        </div>

      </div>

      <!-- Right: sticky mockup panel -->
      <div class="sticky-media">
        <div class="sm-frame">

          <!-- Panel 0: Canvas -->
          <div class="sm-panel sm-panel--canvas active" data-panel="0">
            <div class="smp-header">
              <span class="smp-dot" style="background:#FF5F57"></span>
              <span class="smp-dot" style="background:#FEBC2E"></span>
              <span class="smp-dot" style="background:#28C840"></span>
              <span class="smp-title">Team Studio</span>
            </div>
            <div class="smp-canvas">
              <div class="smc-node smc-n1">
                <div class="smc-avatar" style="background:var(--cyan)">R</div>
                <span>Research</span>
              </div>
              <svg class="smc-svg" viewBox="0 0 260 180" xmlns="http://www.w3.org/2000/svg">
                <defs>
                  <linearGradient id="g1" x1="0%" y1="0%" x2="100%" y2="0%">
                    <stop offset="0%" stop-color="var(--cyan)" stop-opacity=".4"/>
                    <stop offset="100%" stop-color="var(--violet)" stop-opacity=".4"/>
                  </linearGradient>
                  <linearGradient id="g2" x1="0%" y1="0%" x2="100%" y2="0%">
                    <stop offset="0%" stop-color="var(--violet)" stop-opacity=".4"/>
                    <stop offset="100%" stop-color="var(--red)" stop-opacity=".4"/>
                  </linearGradient>
                </defs>
                <path d="M60 40 Q130 40 130 90" stroke="url(#g1)" stroke-width="1.5" fill="none" stroke-dasharray="5 3"/>
                <path d="M130 90 Q130 140 200 140" stroke="url(#g2)" stroke-width="1.5" fill="none" stroke-dasharray="5 3"/>
              </svg>
              <div class="smc-node smc-n2">
                <div class="smc-avatar" style="background:var(--violet)">A</div>
                <span>Analysis</span>
              </div>
              <div class="smc-node smc-n3">
                <div class="smc-avatar" style="background:var(--red)">W</div>
                <span>Writer</span>
              </div>
              <div class="smc-badge">Sequential</div>
            </div>
          </div>

          <!-- Panel 1: Agent config -->
          <div class="sm-panel sm-panel--agent" data-panel="1">
            <div class="smp-header">
              <span class="smp-dot" style="background:#FF5F57"></span>
              <span class="smp-dot" style="background:#FEBC2E"></span>
              <span class="smp-dot" style="background:#28C840"></span>
              <span class="smp-title">Agent Studio — Research Agent</span>
            </div>
            <div class="smp-agent">
              <div class="spa-top">
                <div class="spa-icon">🔍</div>
                <div>
                  <div class="spa-name">Research Agent</div>
                  <div class="spa-model">gpt-4o · web_search, summarise</div>
                </div>
              </div>
              <div class="spa-field">
                <div class="spa-label">Role</div>
                <div class="spa-val">Find the top 5 competitor news items this week. Summarise each in 3 bullet points.</div>
              </div>
              <div class="spa-field">
                <div class="spa-label">Tools</div>
                <div class="spa-tags">
                  <span class="spa-tag" style="color:var(--cyan);border-color:rgba(0,207,255,.3);background:rgba(0,207,255,.08)">Web search</span>
                  <span class="spa-tag" style="color:var(--violet-l);border-color:rgba(109,0,245,.3);background:rgba(109,0,245,.08)">Summariser</span>
                </div>
              </div>
              <div class="spa-field">
                <div class="spa-label">Reports to</div>
                <div class="spa-val" style="color:var(--violet-l)">Analysis Agent →</div>
              </div>
              <div class="spa-field">
                <div class="spa-label">Model</div>
                <div class="spa-val" style="font-family:'JetBrains Mono',monospace;font-size:12px;color:var(--cyan)">gpt-4o</div>
              </div>
            </div>
          </div>

          <!-- Panel 2: Topologies -->
          <div class="sm-panel sm-panel--topo" data-panel="2">
            <div class="smp-header">
              <span class="smp-dot" style="background:#FF5F57"></span>
              <span class="smp-dot" style="background:#FEBC2E"></span>
              <span class="smp-dot" style="background:#28C840"></span>
              <span class="smp-title">Choose topology</span>
            </div>
            <div class="smp-topos">
              <div class="spt-item spt-active">
                <div class="spt-badge" style="color:var(--cyan)">Sequential</div>
                <div class="spt-flow">
                  <span class="spt-node">A</span>
                  <span class="spt-arr">→</span>
                  <span class="spt-node">B</span>
                  <span class="spt-arr">→</span>
                  <span class="spt-node">C</span>
                </div>
              </div>
              <div class="spt-item">
                <div class="spt-badge" style="color:var(--violet-l)">Group Chat</div>
                <div class="spt-flow">
                  <span class="spt-node spt-mgr">M</span>
                  <span class="spt-arr">↔</span>
                  <span class="spt-node">A</span>
                  <span class="spt-arr">↔</span>
                  <span class="spt-node">B</span>
                </div>
              </div>
              <div class="spt-item">
                <div class="spt-badge" style="color:var(--mint)">Concurrent</div>
                <div class="spt-flow">
                  <div style="display:flex;flex-direction:column;gap:4px">
                    <span class="spt-node">A</span>
                    <span class="spt-node">B</span>
                  </div>
                  <span class="spt-arr">→</span>
                  <span class="spt-node spt-merge">✓</span>
                </div>
              </div>
            </div>
          </div>

        </div>
      </div>

    </div>
  </section>

  <!-- ══════════════════════════════════════════════════════
       BENTO GRID — Agentic + Deterministic
  ══════════════════════════════════════════════════════ -->
  <section class="s-violet bento-section">
    <div class="wrap">
      <div class="bento-header">
