  background:
    radial-gradient(ellipse 60% 80% at 50% 120%, rgba(255,10,48,.2) 0%, transparent 70%),
    radial-gradient(ellipse 50% 50% at 20% -10%, rgba(0,207,255,.1) 0%, transparent 60%);
  pointer-events: none;
}
.uc-cta-inner {
  position: relative; z-index: 1;
  text-align: center;
  display: flex; flex-direction: column; align-items: center;
}
.uc-cta-h2 { font-size: clamp(40px, 6vw, 80px); color: #fff; margin-bottom: 16px; }
.uc-cta-sub { font-size: clamp(15px, 1.3vw, 17px); color: rgba(255,255,255,.45); margin-bottom: 36px; max-width: 40ch; line-height: 1.6; }
