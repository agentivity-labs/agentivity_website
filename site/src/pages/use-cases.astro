---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const lang = 'en';

const schema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": "AI Agent Use Cases for Business",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Finance Team", "description": "6-agent sequential team that automates competitor research, financial modelling and executive briefings." },
    { "@type": "ListItem", "position": 2, "name": "HR Team", "description": "7-agent sequential team that writes job descriptions, screens applications and prepares interview packs." },
    { "@type": "ListItem", "position": 3, "name": "Marketing Team", "description": "6-agent group-chat team that delivers a weekly content plan with first drafts, ready to publish." },
    { "@type": "ListItem", "position": 4, "name": "Personal Assistant Team", "description": "5-agent sequential team that prepares a daily brief every morning at 7am." }
  ]
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    { "@type": "Question", "name": "Do I need technical knowledge to use these teams?", "acceptedAnswer": { "@type": "Answer", "text": "If you're using a pre-built Synergi template, no. You customise the instructions in plain language and run. Building from scratch requires more care — see How it works." } },
    { "@type": "Question", "name": "Can AI screen job applications automatically?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. The HR team uses a Screening Agent to read applications, match against your criteria, and surface the top candidates with summaries and suggested interview angles." } },
    { "@type": "Question", "name": "How do I automate my weekly business report?", "acceptedAnswer": { "@type": "Answer", "text": "The Finance team runs a 6-agent sequential pipeline every Monday. Each agent hands off to the next — data collection, sentiment analysis, modelling, risk flagging, writing, formatting. The report lands in your inbox, sourced and ready to share." } }
  ]
};

interface Agent {
  name: string;
  role: string;
  tools?: string;
  parallel?: boolean;
}

interface UseCase {
  id: string;
  emoji: string;
  label: string;
  h2: string;
  subtitle: string;
  topology: string;
  topologyNote: string;
  agents: Agent[];
  before: string;
  after: string;
  stat: string;
  statLabel: string;
  story: string[];
  deliverable: string;
  accentColor: string;
}

const cases: UseCase[] = [
  {
    id: 'finance',
    emoji: '💹',
    label: 'Finance',
    h2: 'Finance Team',
    subtitle: 'From raw data to executive briefing — overnight, every Monday.',
    topology: 'Sequential',
    topologyNote: 'Each agent hands off its output to the next. No prompt needed.',
    agents: [
      { name: 'Market Data Collector', role: 'Scrapes competitor pricing, news, and financial filings in real time.', tools: 'web_search · scraper' },
      { name: 'Sentiment Analyst', role: 'Reads social mentions, press releases and news tone. Flags what matters.', tools: 'summarise · classify' },
      { name: 'Financial Modeller', role: 'Builds comparison tables: margins, headcount, product positioning.', tools: 'code_exec · spreadsheet' },
      { name: 'Risk Assessor', role: 'Scans for anomalies, regulatory flags, and market risks. Adds a risk score.', tools: 'analyse · flag' },
      { name: 'Report Writer', role: 'Synthesises everything into a clean executive brief with sections and callouts.', tools: 'write · format' },
      { name: 'Email Formatter', role: 'Packages the report, adds branding, and sends to your distribution list.', tools: 'email · schedule' },
    ],
    before: 'Monday mornings: 3 hours of manual research, copy-pasting, formatting.',
    after: 'Monday mornings: a briefing in the inbox. She reads it over coffee.',
    stat: '8h',
    statLabel: '→ 4 min',
    story: [
      'Sarah runs a 12-person accounting firm. She used to spend Monday mornings pulling competitor news, formatting updates, preparing briefs for client meetings.',
      'Now her Finance team runs at 5am while she sleeps. By 7am, a fully sourced, risk-scored competitive briefing is in her inbox — formatted, branded, ready to share. Her clients think she has a research department.'
    ],
    deliverable: 'A weekly competitor briefing. Sourced, risk-scored, formatted. Ready to share.',
    accentColor: 'var(--mint)',
  },
  {
    id: 'hr',
    emoji: '👥',
    label: 'HR',
    h2: 'HR Team',
    subtitle: 'From job requirements to interview-ready shortlist — automatically.',
    topology: 'Sequential',
    topologyNote: '7 specialised agents. Each one does one thing, perfectly.',
    agents: [
      { name: 'Job Description Writer', role: 'Turns your bullet-point requirements into a polished, SEO-optimised job post.', tools: 'write · optimise' },
      { name: 'Job Board Publisher', role: 'Posts to LinkedIn, Indeed, and your careers page simultaneously.', tools: 'api · publish' },
      { name: 'Application Parser', role: 'Extracts structured data from every CV: skills, experience, gaps, red flags.', tools: 'parse · extract' },
      { name: 'Skills Matcher', role: 'Scores each application against your requirements. Returns a 0-100 fit score.', tools: 'classify · score' },
      { name: 'Culture Fit Assessor', role: 'Analyses writing style, values signals, and communication patterns.', tools: 'analyse · classify' },
      { name: 'Interview Question Generator', role: 'Writes 8 tailored interview questions per shortlisted candidate.', tools: 'write · personalise' },
      { name: 'Shortlist Formatter', role: 'Packages the top 3 into a clean PDF: score, summary, questions, CV link.', tools: 'format · export' },
    ],
    before: 'Tuesday: posts a role. Spends 3 days reading CVs.',
    after: 'Wednesday morning: 3 interview-ready packs. Done in 20 minutes.',
    stat: '40 CVs',
    statLabel: 'screened overnight',
    story: [
      'Marcus posted a senior developer role on a Tuesday. By Wednesday morning, his HR team had screened 40 applications and surfaced 3 shortlisted profiles.',
      'Each profile came with a skills match score, a culture fit assessment, and 8 tailored interview questions. He spent 20 minutes reviewing. Not 3 days.'
    ],
    deliverable: '3 shortlisted candidates. Score, summary, tailored interview questions. Ready to call.',
    accentColor: 'var(--cyan)',
  },
  {
    id: 'marketing',
    emoji: '📣',
    label: 'Marketing',
    h2: 'Marketing Team',
    subtitle: 'A full content week — researched, written, optimised. Every Friday.',
    topology: 'Group Chat',
    topologyNote: 'Agents collaborate in parallel, then converge on a final output.',
    agents: [
      { name: 'Trend Scout', role: 'Scans industry news, social, Google Trends, and competitor content for the week.', tools: 'web_search · monitor', parallel: true },
      { name: 'Competitor Analyst', role: 'Tracks what competitors published this week and what performed best.', tools: 'scraper · analyse', parallel: true },
      { name: 'Audience Researcher', role: 'Pulls engagement data and comment sentiment from your own channels.', tools: 'api · classify', parallel: true },
      { name: 'Content Strategist', role: 'Receives all three reports. Picks 5 content angles aligned with brand positioning.', tools: 'synthesise · plan' },
      { name: 'Copywriter', role: 'Writes a full first draft for each angle: headline, body, hook, CTA.', tools: 'write · draft' },
      { name: 'SEO Optimiser', role: 'Adds target keywords, meta descriptions, and internal link suggestions to each draft.', tools: 'optimise · keyword' },
    ],
    before: 'Friday: "what should we write about this week?"',
    after: 'Friday: 5 drafts in the folder, ready to pick and edit.',
    stat: '0',
    statLabel: 'blank pages on Monday',
    story: [
      'Every Friday, the Marketing team delivers 5 content ideas — each with a source, a competitive angle, a first draft, and SEO metadata. The content manager picks two, edits lightly, schedules for the week.',
      'No blank page. No "what should we write about?" Just decisions.'
    ],
    deliverable: 'A weekly content plan with first drafts, SEO-optimised. 15 minutes of editing, not 3 hours of writing.',
    accentColor: 'var(--red)',
  },
  {
    id: 'assistant',
    emoji: '🌅',
    label: 'Personal',
    h2: 'Personal Assistant Team',
    subtitle: 'One brief. Every morning. Before you open your laptop.',
    topology: 'Sequential',
    topologyNote: 'Runs overnight. Delivered at 7am, every day.',
    agents: [
      { name: 'News Monitor', role: 'Scans your industry feeds, newsletters, and saved sources for overnight developments.', tools: 'web_search · filter' },
      { name: 'Email Summariser', role: 'Reads your inbox. Flags what needs a reply, what can wait, what to ignore.', tools: 'email · classify' },
      { name: 'Calendar Analyst', role: 'Maps your day: meetings, prep time needed, travel, conflicts.', tools: 'calendar · plan' },
      { name: 'Priority Ranker', role: 'Cross-references news, emails and calendar. Surfaces the 3 things that need action today.', tools: 'analyse · rank' },
      { name: 'Brief Writer', role: 'Formats everything into a clean, scannable morning brief. One read, full picture.', tools: 'write · format' },
    ],
    before: 'Mornings: 45 minutes catching up before you can start.',
    after: 'Mornings: 3-minute read, then you start.',
    stat: '7am',
    statLabel: 'brief ready every day',
    story: [
      'Every morning at 7am, the brief is ready. What happened overnight, what\'s flagged in your inbox, what\'s on your calendar, what the team completed while you slept.',
      'One read. Full picture. Start the day running.'
    ],
    deliverable: 'A daily brief — what happened, what\'s next, what needs you today.',
    accentColor: 'var(--violet-l)',
  }
];

const industries = [
  'Legal', 'Finance', 'HR', 'Marketing', 'Sales',
  'Operations', 'Customer Support', 'Research', 'Compliance', 'Logistics',
  'Real Estate', 'Healthcare', 'Education', 'Recruiting', 'PR & Comms',
  'Product', 'Engineering', 'Procurement', 'Accounting', 'E-commerce',
];
---
<Base
  title="AI Agent Use Cases — Finance, HR & Marketing | Agentivity"
  description="See how small businesses use Agentivity to automate competitor briefings, screen job applications, and run content teams overnight. Real teams, real results."
  schema={[schema, faqSchema]}
>
  <Nav lang={lang} />

  <!-- ══════════════════════════════════════════════════════
       HERO
  ══════════════════════════════════════════════════════ -->
  <section class="s-black uc-hero">
    <div class="hero-grid-bg" aria-hidden="true"></div>
    <div class="wrap uc-hero-inner">
      <span class="eyebrow" style="color:var(--mint)">Use Cases</span>
      <h1 class="h1 uc-h1">
        What will your<br /><span class="grad-text">team do?</span>
      </h1>
      <p class="uc-sub">
        AI agent use cases for business — finance, HR, marketing, and beyond.<br class="br-md" />
        Real workflows. Specialised agents. Tangible results.
      </p>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════════════
       INTRO — Any team, any workflow
  ══════════════════════════════════════════════════════ -->
  <section class="s-pearl intro-section">
    <div class="wrap intro-wrap">

      <div class="intro-text">
        <h2 class="h2 intro-h2">
          Any team.<br />Any workflow.<br /><span style="color:var(--violet)">For any industry.</span>
        </h2>
        <p class="intro-body">
          You're not limited to templates. Every business has workflows that shouldn't need a human — repetitive, time-consuming, rule-based steps that happen every day, week, or month.
        </p>
        <p class="intro-body">
          Agentivity lets you build exactly the team you need. A team of 2 agents or 20. Sequential handoffs or parallel collaboration. Running on demand, on a schedule, or triggered by an event.
        </p>
        <div class="intro-pills">
          <div class="intro-pill" style="--c:var(--mint)">
            <svg viewBox="0 0 20 20" fill="currentColor" width="14" height="14"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
            Unlimited agents per team
          </div>
          <div class="intro-pill" style="--c:var(--cyan)">
            <svg viewBox="0 0 20 20" fill="currentColor" width="14" height="14"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
            Sequential, concurrent, or group chat
          </div>
          <div class="intro-pill" style="--c:var(--violet-l)">
            <svg viewBox="0 0 20 20" fill="currentColor" width="14" height="14"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
            Any trigger — schedule, webhook, manual
          </div>
          <div class="intro-pill" style="--c:var(--red)">
            <svg viewBox="0 0 20 20" fill="currentColor" width="14" height="14"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
            No code required
          </div>
        </div>
      </div>

      <div class="intro-industries">
        <p class="intro-ind-label">Works for every industry</p>
        <div class="ind-grid">
          {industries.map((ind, i) => (
            <span class="ind-tag" style={`animation-delay:${i * 0.04}s`}>{ind}</span>
          ))}
          <span class="ind-tag ind-tag--more">+ anything else</span>
        </div>
        <p class="intro-ind-note">
          Not sure what to build?
          <a href="https://synergi.agentivity.io" target="_blank" rel="noopener noreferrer" class="intro-link">Browse Synergi templates →</a>
        </p>
      </div>

    </div>
  </section>

  <!-- ══════════════════════════════════════════════════════
       USE CASES — sticky left nav + scrolling panels
  ══════════════════════════════════════════════════════ -->
  <section class="s-black uc-section">
    <div class="wrap uc-layout">

      <!-- Left: sticky tab nav -->
      <aside class="uc-nav" aria-label="Use cases navigation">
        <p class="uc-nav-label">Examples</p>
        {cases.map((c, i) => (
          <a href={`#case-${c.id}`} class="uc-tab" data-case={c.id} style={`--accent:${c.accentColor}`}>
            <span class="uc-tab-num">{String(i + 1).padStart(2, '0')}</span>
            <span class="uc-tab-icon">{c.emoji}</span>
            <span class="uc-tab-label">{c.label}</span>
          </a>
        ))}
        <div class="uc-nav-divider"></div>
        <a href="https://synergi.agentivity.io" class="uc-nav-synergi" target="_blank" rel="noopener noreferrer">
          All templates in Synergi →
        </a>
      </aside>

      <!-- Right: scrolling use case panels -->
      <div class="uc-panels">
        {cases.map((c) => (
          <article class="uc-panel" id={`case-${c.id}`} data-case={c.id}>

            <!-- Stat + header row -->
            <div class="ucp-top">
              <div class="ucp-stat-block" style={`--ac:${c.accentColor}`}>
                <div class="ucp-stat">{c.stat}</div>
                <div class="ucp-stat-label">{c.statLabel}</div>
              </div>
              <div class="ucp-head">
                <div class="ucp-topology">
                  <span class="topo-dot" style={`background:${c.accentColor}`}></span>
                  {c.topology} topology
                </div>
                <h2 class="h2 ucp-h2">{c.h2}</h2>
                <p class="ucp-subtitle">{c.subtitle}</p>
              </div>
            </div>

            <!-- Before / After -->
            <div class="ucp-contrast">
              <div class="ucp-before">
                <span class="ucp-contrast-label">Before</span>
                <p>{c.before}</p>
              </div>
              <div class="ucp-arrow-sep">→</div>
              <div class="ucp-after" style={`--ac:${c.accentColor}`}>
                <span class="ucp-contrast-label">After</span>
                <p>{c.after}</p>
              </div>
            </div>

            <!-- Agent pipeline -->
            <div class="ucp-pipeline" style={`--ac:${c.accentColor}`}>
              <div class="ucp-pipeline-header">
                <span class="ucp-pipeline-title">
                  {c.agents.length} specialised agents · {c.topologyNote}
                </span>
              </div>
              <div class="ucp-steps">
                {c.agents.map((agent, i) => (
                  <div class={`ucp-step${agent.parallel ? ' ucp-step--parallel' : ''}`} style={`--delay:${i * 0.08}s`}>
                    <div class="ucp-step-connector">
                      <div class="ucp-step-dot"></div>
                      {i < c.agents.length - 1 && <div class="ucp-step-line"></div>}
                    </div>
                    <div class="ucp-step-body">
                      <div class="ucp-step-head">
                        <span class="ucp-step-name">{agent.name}</span>
                        {agent.parallel && <span class="ucp-parallel-badge">parallel</span>}
                        {agent.tools && <span class="ucp-step-tools">{agent.tools}</span>}
                      </div>
                      <p class="ucp-step-desc">{agent.role}</p>
                    </div>
                  </div>
                ))}
              </div>
            </div>

            <!-- Story -->
            <div class="ucp-story">
              {c.story.map(p => <p>{p}</p>)}
            </div>

            <!-- Deliverable -->
            <div class="ucp-deliverable" style={`--ac:${c.accentColor}`}>
              <div class="ucp-del-label">
                <svg viewBox="0 0 20 20" fill="currentColor" width="14" height="14">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                </svg>
                You get
              </div>
              <blockquote class="ucp-del-text">{c.deliverable}</blockquote>
            </div>

            <!-- CTAs -->
            <div class="ucp-ctas">
              <a href="/#cta" class="btn btn-primary">Join the waitlist</a>
              <a href="https://synergi.agentivity.io" target="_blank" rel="noopener noreferrer" class="ucp-link">
                Browse in Synergi
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><path d="M5 12h14m-7-7 7 7-7 7"/></svg>
              </a>
            </div>

          </article>
        ))}
      </div>

    </div>
  </section>

  <!-- ══════════════════════════════════════════════════════
       TESTIMONIALS
  ══════════════════════════════════════════════════════ -->
  <section class="s-navy testi-section">
    <div class="wrap">
      <span class="eyebrow" style="color:var(--cyan);margin-bottom:48px;display:inline-flex">Early feedback</span>
      <div class="testi-grid">

        <figure class="testi-card">
          <div class="testi-stars">★★★★★</div>
          <blockquote class="testi-quote">
            "I set up a Finance team in an afternoon. The next Monday, the briefing was there.
            I've used it every week since."
          </blockquote>
          <figcaption class="testi-author">
            <div class="testi-avatar" style="--c:var(--mint)">A</div>
            <div>
              <div class="testi-name">Alex R.</div>
              <div class="testi-role">Independent financial consultant</div>
            </div>
          </figcaption>
        </figure>

        <figure class="testi-card">
          <div class="testi-stars">★★★★★</div>
          <blockquote class="testi-quote">
            "We're a team of 8. I built an HR team on Agentivity and it handles our first
            screening round. We only talk to candidates worth talking to."
          </blockquote>
          <figcaption class="testi-author">
            <div class="testi-avatar" style="--c:var(--cyan)">J</div>
            <div>
              <div class="testi-name">Julie M.</div>
              <div class="testi-role">Operations Manager, 45-person tech company</div>
            </div>
          </figcaption>
        </figure>

      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════════════
       FAQ
  ══════════════════════════════════════════════════════ -->
  <section class="s-black faq-section">
    <div class="wrap faq-wrap">
      <h2 class="h2" style="color:#fff;margin-bottom:8px">Common questions</h2>
      <p class="faq-intro">Used by consultants, ops leads, and small business owners to automate the work that shouldn't need a human.</p>

      <div class="faq-list">
        <details class="faq-item" open>
          <summary class="faq-q">Do I need technical knowledge to use these teams?</summary>
          <div class="faq-a">
            If you're using a pre-built Synergi template, no. You customise the instructions in plain language and run.
            Building from scratch requires more care — see <a href="/how-it-works" class="faq-link">How it works →</a>
          </div>
        </details>
        <details class="faq-item">
          <summary class="faq-q">Can AI screen job applications automatically?</summary>
          <div class="faq-a">
            Yes. The HR team uses a 7-agent pipeline: parsing CVs, scoring skills, assessing culture fit, and generating interview questions — all before you open your laptop.
          </div>
        </details>
        <details class="faq-item">
          <summary class="faq-q">How do I automate my weekly business report?</summary>
          <div class="faq-a">
            The Finance team runs a 6-agent sequential pipeline every Monday at 5am. Each agent hands off to the next — data collection, sentiment analysis, modelling, risk flagging, writing, formatting. The report lands in your inbox, sourced and ready to share.
          </div>
        </details>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════════════
       CTA FINAL
  ══════════════════════════════════════════════════════ -->
  <section class="s-violet uc-cta" id="uc-cta">
    <div class="uc-cta-glow" aria-hidden="true"></div>
    <div class="wrap uc-cta-inner">
      <h2 class="h2 uc-cta-h2">
        Your team<br /><span class="grad-text">is waiting.</span>
      </h2>
      <p class="uc-cta-sub">
        The cloud version is on its way. Join the list — you'll be first in, at launch pricing.
      </p>
      <div class="uc-cta-btns">
        <a href="/#cta" class="btn btn-primary lg">Join the waitlist</a>
        <a href="https://github.com/agentivity-labs/agentivity" target="_blank" rel="noopener noreferrer" class="btn btn-ghost lg">
          <svg viewBox="0 0 24 24" fill="currentColor" width="18" height="18"><path d="M12 .3a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2c-3.3.7-4-1.6-4-1.6-.6-1.4-1.4-1.8-1.4-1.8-1-.7.1-.7.1-.7 1.2 0 1.8 1.2 1.8 1.2 1 1.8 2.8 1.3 3.5 1 0-.8.4-1.3.7-1.6-2.7-.3-5.5-1.3-5.5-5.9 0-1.3.5-2.4 1.2-3.2 0-.4-.5-1.6.2-3.2 0 0 1-.3 3.3 1.2a11.5 11.5 0 0 1 6 0c2.3-1.5 3.3-1.2 3.3-1.2.7 1.6.2 2.8.1 3.2.8.8 1.2 1.9 1.2 3.2 0 4.6-2.8 5.6-5.5 5.9.5.4.9 1 .9 2.2v3.3c0 .3.2.7.8.6A12 12 0 0 0 12 .3"/></svg>
          Star on GitHub
        </a>
      </div>
      <p class="uc-cta-note">No spam. Just the important updates.</p>
    </div>
  </section>

  <Footer lang={lang} />

</Base>

<script>
  // Active tab on scroll
  const tabs = document.querySelectorAll<HTMLElement>('.uc-tab');
  const panels = document.querySelectorAll<HTMLElement>('.uc-panel');

  if (tabs.length && panels.length) {
    const activate = (id: string) => {
      tabs.forEach(t => t.classList.toggle('uc-tab--active', t.dataset.case === id));
    };
    activate(panels[0]?.dataset.case || '');

    const obs = new IntersectionObserver(entries => {
      entries.forEach(e => {
        if (e.isIntersecting) activate((e.target as HTMLElement).dataset.case || '');
      });
    }, { threshold: 0.3, rootMargin: '-10% 0px -50% 0px' });

    panels.forEach(p => obs.observe(p));
  }

  // FAQ accordion
  document.querySelectorAll<HTMLDetailsElement>('.faq-item').forEach(detail => {
    detail.addEventListener('toggle', () => {
      if (detail.open) {
        document.querySelectorAll<HTMLDetailsElement>('.faq-item').forEach(other => {
          if (other !== detail) other.open = false;
        });
      }
    });
  });
</script>

<style>
/* ════════════════════════════════════════════════════
   HERO
════════════════════════════════════════════════════ */
.uc-hero {
  padding: 120px 0 80px;
  position: relative;
  overflow: hidden;
}
.hero-grid-bg {
  position: absolute;
  inset: 0;
  background-image:
    linear-gradient(rgba(255,255,255,.025) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255,255,255,.025) 1px, transparent 1px);
  background-size: 48px 48px;
  mask-image: radial-gradient(ellipse 80% 80% at 50% 50%, black 20%, transparent 80%);
  pointer-events: none;
}
.uc-hero-inner {
  position: relative;
  z-index: 1;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.uc-h1 {
  margin-top: 20px;
  font-size: clamp(52px, 9vw, 120px);
}
.uc-sub {
  margin-top: 24px;
  font-size: clamp(16px, 1.5vw, 19px);
  color: rgba(255,255,255,.5);
  line-height: 1.7;
  max-width: 52ch;
}
.br-md { display: none; }
@media (min-width: 700px) { .br-md { display: initial; } }

/* ════════════════════════════════════════════════════
   INTRO SECTION
════════════════════════════════════════════════════ */
.intro-section { padding: 96px 0; }

.intro-wrap {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 80px;
  align-items: start;
}
@media (max-width: 860px) {
  .intro-wrap { grid-template-columns: 1fr; gap: 48px; }
}

.intro-h2 {
  font-size: clamp(32px, 4vw, 52px);
  color: var(--ink);
  margin-bottom: 28px;
}
.intro-body {
  font-size: clamp(15px, 1.3vw, 17px);
  color: var(--ink-2);
  line-height: 1.75;
  margin-bottom: 16px;
  max-width: 46ch;
}

.intro-pills {
  display: flex;
  flex-direction: column;
  gap: 10px;
  margin-top: 28px;
}
.intro-pill {
  display: inline-flex;
  align-items: center;
  gap: 9px;
  font-size: 14px;
  font-weight: 500;
  color: var(--ink-2);
  padding: 2px 0;
}
.intro-pill svg { color: var(--c); flex-shrink: 0; }

/* Industries grid */
.intro-industries { padding-top: 8px; }
.intro-ind-label {
  font-size: 10px;
  font-weight: 700;
  letter-spacing: .1em;
  text-transform: uppercase;
  color: var(--ink-3);
  margin-bottom: 16px;
}
.ind-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-bottom: 20px;
}
.ind-tag {
  padding: 6px 12px;
  border-radius: 999px;
  background: #fff;
  border: 1px solid var(--line);
  font-size: 13px;
  font-weight: 500;
  color: var(--ink-2);
  animation: tagIn .3s ease both;
  animation-delay: var(--delay, 0s);
  transition: background .15s, color .15s, border-color .15s;
}
.ind-tag:hover { background: var(--ink); color: #fff; border-color: var(--ink); }
.ind-tag--more {
  background: color-mix(in srgb, var(--violet) 10%, transparent);
  border-color: color-mix(in srgb, var(--violet) 30%, transparent);
  color: var(--violet);
  font-weight: 600;
}
@keyframes tagIn {
  from { opacity: 0; transform: scale(.92); }
  to   { opacity: 1; transform: scale(1); }
}
.intro-ind-note {
  font-size: 13px;
  color: var(--ink-3);
}
.intro-link {
  color: var(--violet);
  text-decoration: underline;
  text-underline-offset: 3px;
}

/* ════════════════════════════════════════════════════
   USE CASES LAYOUT
════════════════════════════════════════════════════ */
.uc-section { padding: 80px 0 100px; }

.uc-layout {
  display: grid;
  grid-template-columns: 200px 1fr;
  gap: 56px;
  align-items: start;
}
@media (max-width: 900px) {
  .uc-layout { grid-template-columns: 1fr; gap: 0; }
}

/* Left sticky nav */
.uc-nav {
  position: sticky;
  top: 96px;
  display: flex;
  flex-direction: column;
  gap: 4px;
}
@media (max-width: 900px) {
  .uc-nav {
    position: static;
    flex-direction: row;
    flex-wrap: wrap;
    gap: 8px;
    padding-bottom: 40px;
  }
  .uc-nav-label, .uc-nav-divider, .uc-nav-synergi { display: none; }
}
.uc-nav-label {
  font-size: 10px;
  font-weight: 700;
  letter-spacing: .1em;
  text-transform: uppercase;
  color: rgba(255,255,255,.25);
  margin-bottom: 8px;
  padding-left: 4px;
}
.uc-tab {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 10px 12px;
  border-radius: 8px;
  color: rgba(255,255,255,.35);
  font-size: 14px;
  font-weight: 500;
  text-decoration: none;
  transition: background .15s, color .15s, border-color .15s;
  border-left: 2px solid transparent;
}
.uc-tab:hover { background: rgba(255,255,255,.05); color: rgba(255,255,255,.7); }
.uc-tab--active {
  background: rgba(255,255,255,.06);
  color: #fff;
  border-left-color: var(--accent);
  font-weight: 600;
}
.uc-tab-num {
  font-family: "JetBrains Mono", monospace;
  font-size: 10px;
  color: rgba(255,255,255,.2);
  flex-shrink: 0;
}
.uc-tab-icon { font-size: 16px; flex-shrink: 0; }
.uc-tab-label { flex: 1; }

.uc-nav-divider { height: 1px; background: rgba(255,255,255,.07); margin: 12px 0; }
.uc-nav-synergi {
  font-size: 12px;
  color: rgba(255,255,255,.25);
  padding: 4px;
  text-decoration: none;
  transition: color .15s;
}
.uc-nav-synergi:hover { color: rgba(255,255,255,.6); }

/* ════════════════════════════════════════════════════
   PANELS
════════════════════════════════════════════════════ */
.uc-panels { display: flex; flex-direction: column; gap: 64px; }

.uc-panel {
  scroll-margin-top: 112px;
  padding: 40px 44px;
  background: rgba(255,255,255,.03);
  border: 1px solid rgba(255,255,255,.07);
  border-radius: var(--r-xl);
}
@media (max-width: 600px) { .uc-panel { padding: 24px 20px; } }

/* Stat + header */
.ucp-top {
  display: flex;
  gap: 24px;
  align-items: flex-start;
  margin-bottom: 28px;
}
.ucp-stat-block {
  flex-shrink: 0;
  text-align: center;
  padding: 16px 20px;
  background: color-mix(in srgb, var(--ac) 10%, transparent);
  border: 1px solid color-mix(in srgb, var(--ac) 25%, transparent);
  border-radius: var(--r-lg);
  min-width: 80px;
}
.ucp-stat {
  font-size: clamp(24px, 3vw, 36px);
  font-weight: 900;
  color: var(--ac);
  line-height: 1;
  letter-spacing: -.04em;
}
.ucp-stat-label {
  font-size: 11px;
  font-weight: 600;
  color: var(--ac);
  opacity: .65;
  margin-top: 4px;
  white-space: nowrap;
}
.ucp-topology {
  font-size: 11px;
  font-weight: 700;
  letter-spacing: .1em;
  text-transform: uppercase;
  color: rgba(255,255,255,.3);
  display: flex;
  align-items: center;
  gap: 7px;
  margin-bottom: 8px;
}
.topo-dot { width: 6px; height: 6px; border-radius: 50%; flex-shrink: 0; }
.ucp-h2 {
  font-size: clamp(26px, 3vw, 40px);
  color: #fff;
  margin-bottom: 6px;
}
.ucp-subtitle { font-size: 15px; color: rgba(255,255,255,.5); line-height: 1.5; }

/* Before/After contrast */
.ucp-contrast {
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  gap: 16px;
  align-items: center;
  margin-bottom: 28px;
  padding: 20px;
  background: rgba(0,0,0,.2);
  border-radius: var(--r-lg);
}
@media (max-width: 600px) {
  .ucp-contrast { grid-template-columns: 1fr; }
  .ucp-arrow-sep { display: none; }
}
.ucp-contrast-label {
  display: block;
  font-size: 9px;
  font-weight: 700;
  letter-spacing: .12em;
  text-transform: uppercase;
  color: rgba(255,255,255,.25);
  margin-bottom: 6px;
}
.ucp-before p { font-size: 14px; color: rgba(255,255,255,.4); line-height: 1.5; }
.ucp-after { }
.ucp-after p { font-size: 14px; color: var(--ac); font-weight: 500; line-height: 1.5; }
.ucp-arrow-sep {
  font-size: 20px;
  color: rgba(255,255,255,.15);
  text-align: center;
}

/* Agent pipeline — vertical timeline */
.ucp-pipeline {
  margin-bottom: 28px;
  padding: 24px;
  background: rgba(0,0,0,.25);
  border-radius: var(--r-lg);
  border: 1px solid rgba(255,255,255,.05);
}
.ucp-pipeline-header {
  margin-bottom: 20px;
}
.ucp-pipeline-title {
  font-size: 11px;
  font-weight: 700;
  letter-spacing: .08em;
  text-transform: uppercase;
  color: rgba(255,255,255,.3);
}

.ucp-steps { display: flex; flex-direction: column; }

.ucp-step {
  display: grid;
  grid-template-columns: 24px 1fr;
  gap: 14px;
  animation: stepIn .35s ease both;
  animation-delay: var(--delay, 0s);
}
.ucp-step--parallel .ucp-step-dot {
  border-style: dashed;
  opacity: .7;
}

.ucp-step-connector {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex-shrink: 0;
}
.ucp-step-dot {
  width: 12px;
  height: 12px;
  border-radius: 50%;
  border: 2px solid var(--ac);
  background: color-mix(in srgb, var(--ac) 20%, transparent);
  flex-shrink: 0;
  margin-top: 4px;
}
.ucp-step-line {
  width: 2px;
  flex: 1;
  min-height: 20px;
  background: linear-gradient(to bottom, var(--ac), color-mix(in srgb, var(--ac) 15%, transparent));
  opacity: .3;
  margin: 4px 0;
}

.ucp-step-body { padding-bottom: 16px; }
.ucp-step-head {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8px;
  margin-bottom: 4px;
}
.ucp-step-name {
  font-size: 14px;
  font-weight: 700;
  color: #fff;
  letter-spacing: -.01em;
}
.ucp-parallel-badge {
  font-size: 9px;
  font-weight: 700;
  letter-spacing: .08em;
  text-transform: uppercase;
  padding: 2px 7px;
  border-radius: 999px;
  background: color-mix(in srgb, var(--ac) 15%, transparent);
  color: var(--ac);
  border: 1px solid color-mix(in srgb, var(--ac) 30%, transparent);
}
.ucp-step-tools {
  font-family: "JetBrains Mono", monospace;
  font-size: 10px;
  color: rgba(255,255,255,.25);
}
.ucp-step-desc {
  font-size: 13px;
  color: rgba(255,255,255,.45);
  line-height: 1.6;
}

@keyframes stepIn {
  from { opacity: 0; transform: translateX(-8px); }
  to   { opacity: 1; transform: translateX(0); }
}

/* Story */
.ucp-story {
  display: flex;
  flex-direction: column;
  gap: 14px;
  margin-bottom: 24px;
}
.ucp-story p {
  font-size: clamp(15px, 1.3vw, 16px);
  color: rgba(255,255,255,.5);
  line-height: 1.75;
}

/* Deliverable */
.ucp-deliverable {
  margin-bottom: 28px;
  padding: 18px 22px;
  background: color-mix(in srgb, var(--ac) 7%, transparent);
  border-left: 3px solid var(--ac);
  border-radius: 0 var(--r-md) var(--r-md) 0;
}
.ucp-del-label {
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: .1em;
  text-transform: uppercase;
  color: var(--ac);
  margin-bottom: 8px;
}
.ucp-del-text {
  font-size: clamp(15px, 1.3vw, 17px);
  font-weight: 600;
  color: #fff;
  line-height: 1.5;
  font-style: normal;
}

/* CTAs */
.ucp-ctas { display: flex; align-items: center; gap: 20px; flex-wrap: wrap; }
.ucp-link {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  font-size: 14px;
  font-weight: 600;
  color: rgba(255,255,255,.4);
  text-decoration: none;
  transition: color .15s;
}
.ucp-link:hover { color: rgba(255,255,255,.8); }

/* ════════════════════════════════════════════════════
   TESTIMONIALS
════════════════════════════════════════════════════ */
.testi-section { padding: 80px 0; }
.testi-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; }
@media (max-width: 700px) { .testi-grid { grid-template-columns: 1fr; } }

.testi-card {
  padding: 36px;
  background: rgba(255,255,255,.04);
  border: 1px solid rgba(255,255,255,.07);
  border-radius: var(--r-xl);
  display: flex;
  flex-direction: column;
  gap: 16px;
}
.testi-stars { color: var(--mint); font-size: 14px; letter-spacing: 2px; }
.testi-quote {
  font-size: clamp(15px, 1.3vw, 16px);
  color: rgba(255,255,255,.65);
