---
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

const lang = 'en';
---
<Base look="editorial"
  title="You're on the list — Agentivity"
  description="Thanks for joining the Agentivity waitlist. We'll reach out when the cloud launches."
>
  <SiteHeader lang={lang} />
<main class="ed-page ty-page">

  <section class="s-black ty-section">
    <div class="ty-glow" aria-hidden="true"></div>
    <div class="wrap ty-inner">

      <div class="ty-icon" aria-hidden="true">
        <svg viewBox="0 0 64 64" fill="none" width="64" height="64">
          <circle cx="32" cy="32" r="31" stroke="rgba(0,200,150,.25)" stroke-width="1.5"/>
          <circle cx="32" cy="32" r="31" stroke="url(#ty-ring)" stroke-width="1.5" stroke-dasharray="195" stroke-dashoffset="195" class="ty-ring-fill"/>
          <polyline points="20,33 28,41 44,25" stroke="var(--mint)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="ty-check"/>
          <defs>
            <linearGradient id="ty-ring" x1="0" y1="0" x2="64" y2="64" gradientUnits="userSpaceOnUse">
              <stop offset="0%" stop-color="var(--mint)"/>
              <stop offset="100%" stop-color="var(--cyan)"/>
            </linearGradient>
          </defs>
        </svg>
      </div>

      <span class="eyebrow" style="color:var(--mint)">You're in</span>
      <h1 class="h1 ty-h1">You're on the list.</h1>
      <p class="ty-sub">
        We'll reach out when the cloud launches — first in, launch pricing.<br class="br-md" />
        No spam. Just the signal.
      </p>

      <div class="ty-actions">
        <a href="https://github.com/agentivity-labs/agentivity" target="_blank" rel="noopener noreferrer" class="btn btn-primary lg">
          <svg viewBox="0 0 24 24" fill="currentColor" width="18" height="18"><path d="M12 .3a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2c-3.3.7-4-1.6-4-1.6-.6-1.4-1.4-1.8-1.4-1.8-1-.7.1-.7.1-.7 1.2 0 1.8 1.2 1.8 1.2 1 1.8 2.8 1.3 3.5 1 0-.8.4-1.3.7-1.6-2.7-.3-5.5-1.3-5.5-5.9 0-1.3.5-2.4 1.2-3.2 0-.4-.5-1.6.2-3.2 0 0 1-.3 3.3 1.2a11.5 11.5 0 0 1 6 0c2.3-1.5 3.3-1.2 3.3-1.2.7 1.6.2 2.8.1 3.2.8.8 1.2 1.9 1.2 3.2 0 4.6-2.8 5.6-5.5 5.9.5.4.9 1 .9 2.2v3.3c0 .3.2.7.8.6A12 12 0 0 0 12 .3"/></svg>
          Star on GitHub
        </a>
        <a href="/use-cases" class="btn btn-ghost">See what teams build →</a>
      </div>

      <div class="ty-divider" aria-hidden="true"></div>

      <div class="ty-while-wait">
        <p class="ty-while-label">In the meantime —</p>
        <div class="ty-links">
          <a href="/how-it-works" class="ty-link">
            <span class="ty-link-icon">⚡</span>
            <span>
              <strong>How it works</strong>
              <span>Compose agents, structure teams, run workflows</span>
            </span>
          </a>
          <a href="/use-cases" class="ty-link">
            <span class="ty-link-icon">🔬</span>
            <span>
              <strong>Use cases</strong>
              <span>Finance, HR, Marketing, Personal — real workflows</span>
            </span>
          </a>
          <a href="https://github.com/agentivity-labs/agentivity" target="_blank" rel="noopener noreferrer" class="ty-link">
            <span class="ty-link-icon">🛠</span>
            <span>
              <strong>Self-host now</strong>
              <span>Docker · Free · No waiting</span>
            </span>
          </a>
        </div>
      </div>

    </div>
  </section>

  </main>
<SiteFooter lang={lang} />

</Base>
