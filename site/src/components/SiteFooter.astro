---
// Footer of the pages in the editorial look.
import type { Lang } from '../i18n/utils';
import { useTranslations } from '../i18n/utils';
import GitHubIcon from './GitHubIcon.astro';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<footer class="sf">
  <div class="ed-wrap">
    <div class="sf-grid">
      <div class="sf-brand">
        <a href={lang === 'fr' ? '/fr/' : '/'} aria-label="Agentivity">
          <img src="/agentivity-wordmark-navy.svg" alt="Agentivity" width="94" height="26" loading="lazy" />
        </a>
        <p>{t.site.footer_tagline}</p>
        <!-- Where to follow Agentivity: GitHub and the LinkedIn Page (2026-11-19, KB-0334). -->
        <p class="sf-social">
          <a href={t.site.github_href} target="_blank" rel="noopener" aria-label={t.site.github_label}><GitHubIcon size={20} /></a>
          <a href={t.site.linkedin_href} target="_blank" rel="noopener" aria-label={t.site.linkedin_label}><svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" /></svg></a>
        </p>
      </div>

      {t.footer.cols.map((col) => (
        <div class="sf-col">
          <h4>{col.title}</h4>
          {col.links.map((link) => (
            link.external
              ? <a href={link.href} target="_blank" rel="noopener noreferrer">{link.label}</a>
              : <a href={link.href}>{link.label}</a>
          ))}
        </div>
      ))}
    </div>

    <div class="sf-bottom">
      <span>{t.footer.legal}</span>
      <button type="button" class="sf-cookie" data-cookie-settings>{t.footer.cookies}</button>
    </div>
  </div>
</footer>

<style>
.sf { background: #fff; border-top: 1px solid var(--ed-line); padding-block: clamp(48px, 6vw, 80px) 32px; color: var(--ed-ink-3); }
.sf-grid { display: grid; grid-template-columns: 1.7fr 1fr 1fr 1fr; gap: 40px; }
.sf-brand img { height: 26px; width: auto; display: block; }
.sf-brand p { margin-top: 16px; font-size: 15px; max-width: 30ch; }
.sf-social { display: flex; gap: 6px; margin-top: 14px; }
.sf-social a { display: grid; place-items: center; width: 40px; height: 40px; border-radius: 10px; color: var(--ed-ink-3); transition: color .15s ease, background .15s ease; }
.sf-social a:hover { color: var(--ed-ink); background: var(--ed-mist); }
.sf-col h4 {
  font-family: var(--ed-sans); font-size: 13px; font-weight: 600; letter-spacing: .08em; text-transform: uppercase;
  color: var(--ed-ink); margin-bottom: 14px;
}
.sf-col a { display: block; font-size: 15px; padding: 6px 0; transition: color .15s ease; }
.sf-col a:hover { color: var(--ed-ink); }
.sf-bottom { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 4px 24px; margin-top: clamp(36px, 5vw, 56px); padding-top: 22px; border-top: 1px solid var(--ed-line); font-size: 14px; }
.sf-cookie { min-height: 44px; padding: 0; border: 0; background: none; font: inherit; color: inherit; text-decoration: underline; text-underline-offset: 3px; cursor: pointer; transition: color .15s ease; }
.sf-cookie:hover { color: var(--ed-ink); }

@media (max-width: 1080px) { .sf-grid { grid-template-columns: 1fr 1fr; gap: 32px; } }
@media (max-width: 560px) { .sf-grid { grid-template-columns: 1fr; } }
</style>
