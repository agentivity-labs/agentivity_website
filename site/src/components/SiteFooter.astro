---
// Footer of the pages in the editorial look. Pages still on the first design use Footer.astro.
import type { Lang } from '../i18n/utils';
import { useTranslations } from '../i18n/utils';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<footer class="sf">
  <div class="ed-wrap">
    <div class="sf-grid">
      <div class="sf-brand">
        <a href={lang === 'fr' ? '/fr/' : '/'} aria-label="Agentivity">
          <img src="/agentivity-wordmark-navy.svg" alt="Agentivity" width="94" height="26" loading="lazy" />
        </a>
        <p>{t.site.footer_tagline}</p>
      </div>

      {t.footer.cols.map((col) => (
        <div class="sf-col">
          <h4>{col.title}</h4>
          {col.links.map((link) => (
            link.external
              ? <a href={link.href} target="_blank" rel="noopener noreferrer">{link.label}</a>
              : <a href={link.href}>{link.label}</a>
          ))}
        </div>
      ))}
    </div>

    <div class="sf-bottom">
      <span>{t.footer.legal}</span>
      <button type="button" class="sf-cookie" data-cookie-settings>{t.footer.cookies}</button>
    </div>
  </div>
</footer>

<style>
.sf { background: #fff; border-top: 1px solid var(--ed-line); padding-block: clamp(48px, 6vw, 80px) 32px; color: var(--ed-ink-3); }
.sf-grid { display: grid; grid-template-columns: 1.7fr 1fr 1fr 1fr; gap: 40px; }
.sf-brand img { height: 26px; width: auto; display: block; }
.sf-brand p { margin-top: 16px; font-size: 15px; max-width: 30ch; }
.sf-col h4 {
  font-family: var(--ed-sans); font-size: 13px; font-weight: 600; letter-spacing: .08em; text-transform: uppercase;
  color: var(--ed-ink); margin-bottom: 14px;
}
.sf-col a { display: block; font-size: 15px; padding: 6px 0; transition: color .15s ease; }
.sf-col a:hover { color: var(--ed-ink); }
.sf-bottom { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 4px 24px; margin-top: clamp(36px, 5vw, 56px); padding-top: 22px; border-top: 1px solid var(--ed-line); font-size: 14px; }
.sf-cookie { min-height: 44px; padding: 0; border: 0; background: none; font: inherit; color: inherit; text-decoration: underline; text-underline-offset: 3px; cursor: pointer; transition: color .15s ease; }
.sf-cookie:hover { color: var(--ed-ink); }

@media (max-width: 1080px) { .sf-grid { grid-template-columns: 1fr 1fr; gap: 32px; } }
@media (max-width: 560px) { .sf-grid { grid-template-columns: 1fr; } }
</style>
