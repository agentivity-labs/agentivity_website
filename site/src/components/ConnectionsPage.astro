---
// The Connections page (/connections and /fr/connections), refounded on value (2026-11-19): the promise with an AI agent at work
// among the apps, what changes for each team, every integration in rows that slide past with "and many more", three plain
// steps and one line of trust. No feature explanation here (step or tool, AI models): that belongs to the docs. Adding an
// integration to src/data/connections.ts is all it takes for it to show; the page never counts them. Texts from the
// "connections_page" block of en.json / fr.json, the marks from src/data/brand-logos.ts (an app without one shows its initial).
import Base from '../layouts/Base.astro';
import SiteHeader from './SiteHeader.astro';
import SiteFooter from './SiteFooter.astro';
import StartFree from './StartFree.astro';
import TrialNote from './TrialNote.astro';
import AppHubLoop from './AppHubLoop.astro';
import { useTranslations, type Lang } from '../i18n/utils';
import { connections, nameOf } from '../data/connections';
import { brandLogos, brandFiles } from '../data/brand-logos';

// English by default; the French pages pass lang="fr".
const lang: Lang = (Astro.props as { lang?: Lang }).lang ?? 'en';
const t = useTranslations(lang);
const p = t.connections_page as any;
const mark = (id?: string) => (id ? brandLogos[id] : undefined);
const file = (id?: string) => (id ? brandFiles[id] : undefined);
// Every integration (the apps and the AI models), in rows that slide past, as on the home.
const all = connections.filter((item) => item.group !== 'build');
const ROWS = 6;
const rows = Array.from({ length: ROWS }, (_, r) => all.filter((_, i) => i % ROWS === r));
---
<Base title={p.meta.title} description={p.meta.description} lang={lang} look="editorial">

<SiteHeader lang={lang} ctaHref={p.hero.cta_href} />

<main class="cn ed-page">

  <!-- 1. The promise, and an agent at work among the apps -->
  <section class="ed-wrap cn-hero">
    <p class="ed-eyebrow">{p.hero.eyebrow}</p>
    <h1>{p.hero.h1} <em>{p.hero.h1_accent}</em></h1>
    <p class="cn-lead">{p.hero.sub}</p>
    <div class="cn-act">
      <a class="ed-btn ed-btn--navy" href={p.hero.cta_href}>{p.hero.cta}</a>
      <TrialNote lang={lang} />
      <a class="ed-link" href={p.hero.secondary_href}>{p.hero.secondary}</a>
    </div>
    <div class="cn-hub"><AppHubLoop d={p.hero.loop} /></div>
  </section>

  <!-- 2. What changes for each team -->
  <section class="ed-band--mist">
    <div class="ed-wrap ed-sec">
      <header class="ed-sec-head">
        <h2 class="ed-h2 ed-h2--md">{p.teams.h2}</h2>
        <p class="ed-sec-sub">{p.teams.sub}</p>
      </header>
      <ul class="cn-teams">
        {p.teams.items.map((item: any) => (
          <li>
            <span class="cn-teams-logos">{item.logos.map((id: string) => mark(id) && <svg viewBox="0 0 24 24" aria-hidden="true"><path d={mark(id)!.d} /></svg>)}</span>
            <span class="cn-teams-team">{item.team}</span>
            <strong>{item.title}</strong>
            <span>{item.body}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 3. Every integration, sliding past, and many more -->
  <section class="ed-wrap ed-sec" id="apps">
    <header class="ed-sec-head">
      <h2 class="ed-h2 ed-h2--md">{p.apps.h2}</h2>
      <p class="ed-sec-sub">{p.apps.sub}</p>
    </header>
    <div class="cn-marquee" aria-label={p.apps.h2}>
      {rows.map((row) => (
        <div class="cn-marquee-row">
          <ul class="cn-marquee-track">
            {[...row, ...row].map((item, i) => (
              <li aria-hidden={i >= row.length ? 'true' : undefined}>
                {mark(item.logo) ? <svg viewBox="0 0 24 24" aria-hidden="true"><path d={mark(item.logo)!.d} /></svg> : file(item.logo) ? <img class="cn-file" src={file(item.logo)} alt="" width="22" height="22" loading="lazy" /> : <b aria-hidden="true">{nameOf(item, lang).charAt(0)}</b>}
                <span>{nameOf(item, lang)}</span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
    <p class="cn-more-line"><span>{p.apps.more}</span></p>
    <div class="cn-ask">
      <div>
        <strong>{p.ask.h2}</strong>
        <span>{p.ask.body}</span>
      </div>
      <a class="ed-btn ed-btn--sm ed-btn--line" href="mailto:hello@agentivity.io?subject=Connection">{p.ask.cta}</a>
    </div>
  </section>

  <!-- 4. Three plain steps, and one line of trust -->
  <section class="ed-band--mist">
    <div class="ed-wrap ed-sec">
      <header class="ed-sec-head">
        <h2 class="ed-h2 ed-h2--md">{p.steps.h2}</h2>
      </header>
      <ol class="cn-steps">
        {p.steps.items.map((step: any, i: number) => (
          <li>
            <p class="cn-step-n"><span>{i + 1}</span></p>
            <strong>{step.title}</strong>
            <span>{step.body}</span>
          </li>
        ))}
      </ol>
      <p class="cn-note">
        <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="11" width="14" height="10" rx="2" /><path d="M8 11V8a4 4 0 0 1 8 0v3" /></svg>
        <span>{p.trust.body} <a class="ed-link" href={p.trust.href}>{p.trust.link}</a></span>
      </p>
    </div>
  </section>

  <!-- 5. The last call -->
  <section class="ed-band--yellow">
    <div class="ed-wrap ed-final">
      <h2>{p.cta.h2}</h2>
      <p class="ed-final-sub">{p.cta.sub}</p>
      <StartFree lang={lang} label={p.cta.button} plan="pro" />
    </div>
  </section>

</main>

<SiteFooter lang={lang} />

</Base>

<style>
.cn-hero { display: flex; flex-direction: column; align-items: center; gap: 20px; text-align: center; padding-block: clamp(48px, 7vw, 96px) clamp(48px, 6vw, 80px); }
.cn-hero h1 { font-family: var(--ed-serif); font-size: clamp(42px, 6vw, 88px); line-height: 1; letter-spacing: -.02em; max-width: 14em; text-wrap: balance; }
.cn-hero h1 em { display: block; font-style: italic; }
.cn-lead { font-size: clamp(18px, 1.6vw, 21px); line-height: 1.5; color: var(--ed-ink-2); max-width: 40em; text-wrap: balance; }
.cn-act { display: flex; flex-direction: column; align-items: center; gap: 10px; }

/* The hero: the agent among the apps, played on the Studio's dark canvas. */
.cn-hub { width: 100%; margin-top: 12px; aspect-ratio: 1400 / 600; border-radius: 18px; overflow: hidden; box-shadow: 0 30px 60px -36px rgba(16, 26, 46, .6); }
@media (max-width: 640px) { .cn-hub { aspect-ratio: 600 / 860; } }

/* What changes for each team. */
.cn-teams { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
.cn-teams li { display: flex; flex-direction: column; gap: 10px; padding: 24px; border-radius: 18px; background: #fff; border: 1px solid var(--ed-line); font-size: 16px; line-height: 1.55; color: var(--ed-ink-2); }
.cn-teams strong { font-family: var(--ed-serif); font-weight: 400; font-size: 28px; line-height: 1.1; color: var(--ed-ink); }
.cn-teams-logos { display: flex; gap: 10px; }
.cn-teams-logos svg { width: 22px; height: 22px; fill: var(--ed-ink-3); }
.cn-teams-team { font-size: 12.5px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: var(--ed-ink-3); }

/* The integrations, in rows that slide past (paused under the mouse; standing still, wrapped, for less motion). */
.cn-marquee { display: flex; flex-direction: column; gap: 10px; }
.cn-marquee-row { overflow: hidden; -webkit-mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent); mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent); }
.cn-marquee-track { display: flex; gap: 10px; width: max-content; margin: 0; padding: 0 10px 0 0; list-style: none; animation: cn-slide 90s linear infinite; }
.cn-marquee-row:nth-child(even) .cn-marquee-track { animation-direction: reverse; }
.cn-marquee:hover .cn-marquee-track { animation-play-state: paused; }
.cn-marquee-track li { flex: none; display: flex; align-items: center; gap: 10px; width: 200px; min-height: 56px; padding: 10px 14px; border-radius: 14px; background: #fff; border: 1px solid var(--ed-line); font-size: 15.5px; font-weight: 600; color: var(--ed-ink-2); }
.cn-marquee-track svg { flex: none; width: 22px; height: 22px; fill: var(--ed-ink-3); }
.cn-marquee-track b { flex: none; display: grid; place-items: center; width: 22px; height: 22px; border-radius: 6px; background: var(--ed-mist); font-size: 13px; color: var(--ed-ink-3); }
.cn-file { flex: none; display: block; width: 22px; height: 22px; object-fit: contain; }
.cn-more-line { margin-top: clamp(24px, 3vw, 36px); text-align: center; }
.cn-more-line span { display: inline-block; padding: .05em .35em; background: var(--ed-yellow); color: var(--ed-ink); font-family: var(--ed-serif); font-style: italic; font-size: clamp(36px, 5vw, 64px); line-height: 1.1; }
@keyframes cn-slide { to { transform: translateX(-50%); } }
@media (prefers-reduced-motion: reduce) {
  .cn-marquee-track { animation: none; flex-wrap: wrap; width: auto; }
  .cn-marquee-track li[aria-hidden] { display: none; }
  .cn-marquee-row { -webkit-mask-image: none; mask-image: none; }
}
.cn-ask { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px 32px; margin-top: 40px; padding: 24px 28px; border-radius: 20px; background: #fff; border: 1px solid var(--ed-line); }
.cn-ask div { display: flex; flex-direction: column; gap: 4px; font-size: 16px; color: var(--ed-ink-2); }
.cn-ask strong { font-size: 19px; color: var(--ed-ink); }

/* Three plain steps, and the line of trust. */
.cn-steps { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 28px; }
.cn-steps li { display: flex; flex-direction: column; align-items: flex-start; gap: 10px; font-size: 16.5px; line-height: 1.5; color: var(--ed-ink-2); }
.cn-steps strong { font-family: var(--ed-serif); font-weight: 400; font-size: 28px; line-height: 1.1; color: var(--ed-ink); }
.cn-step-n span { display: grid; place-items: center; width: 28px; height: 28px; border-radius: 999px; background: var(--ed-navy); color: #fff; font-size: 13px; font-weight: 700; }
.cn-note { display: flex; align-items: flex-start; gap: 12px; margin-top: 32px; font-size: 16.5px; line-height: 1.55; color: var(--ed-ink-2); }
.cn-note svg { flex: none; width: 22px; height: 22px; margin-top: 1px; fill: none; stroke: var(--ed-navy); stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }

@media (max-width: 900px) {
  .cn-teams, .cn-steps { grid-template-columns: minmax(0, 1fr); }
}
</style>
