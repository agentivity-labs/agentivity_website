---
// "Get the new solutions by email": the sign-up at the end of each article and on the use cases page.
// It goes through the subscription relay (/api/subscribe, source "newsletter"): Brevo sends the confirmation email
// (double opt-in), and nobody is on the list before they click its link. Nothing is sent from here.
import type { Lang } from '../i18n/utils';
import { useTranslations } from '../i18n/utils';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const text = useTranslations(lang).solutions_signup;

const privacyHref = lang === 'fr' ? '/fr/legal/privacy' : '/legal/privacy';
const [consentBefore, consentAfter] = text.consent.split('{privacy}');
const messages = {
  submit: text.submit,
  submitting: text.submitting,
  success: text.success,
  successDetail: text.success_detail,
  already: text.already,
  alreadyDetail: text.already_detail,
  errorGeneric: text.error_generic,
  errorEmail: text.error_email,
  errorConsent: text.error_consent,
  errorRate: text.error_rate,
};
---
<section class="ss" aria-labelledby="ss-title">
  <div class="ss-text">
    <h2 id="ss-title">{text.title}</h2>
    <p>{text.body}</p>
  </div>
  <form class="ss-form" data-solutions-signup data-lang={lang} data-messages={JSON.stringify(messages)}>
    <div class="ss-fields">
      <div class="ss-row">
        <input type="email" name="email" placeholder={text.email_placeholder} aria-label={text.email_label} maxlength="254" required autocomplete="email" />
        <button type="submit">{text.submit}</button>
      </div>
      <label class="ss-consent">
        <input type="checkbox" name="consent" required />
        <span>{consentBefore}<a href={privacyHref} target="_blank" rel="noopener">{text.privacy_link}</a>{consentAfter}</span>
      </label>
      <div class="ss-trap" aria-hidden="true">
        <label>Website <input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
      </div>
    </div>
    <p class="ss-status" role="status" aria-live="polite" hidden></p>
  </form>
</section>

<script>
  const ENDPOINT = '/api/subscribe';
  const SOURCE = 'newsletter';

  function show(status: HTMLElement, kind: 'success' | 'error', title: string, detail?: string) {
    status.replaceChildren();
    status.dataset.kind = kind;
    const strong = document.createElement('strong');
    strong.textContent = title;
    status.append(strong);
    if (detail) {
      const span = document.createElement('span');
      span.textContent = detail;
      status.append(' ', span);
    }
    status.hidden = false;
  }

  document.querySelectorAll<HTMLFormElement>('form[data-solutions-signup]').forEach((form) => {
    const messages: Record<string, string> = JSON.parse(form.dataset.messages ?? '{}');
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const status = form.querySelector<HTMLElement>('.ss-status')!;

    const setLoading = (loading: boolean) => {
      button.disabled = loading;
      button.textContent = loading ? messages.submitting : messages.submit;
      form.setAttribute('aria-busy', String(loading));
    };

    const errorMessage = (code: unknown) => {
      switch (code) {
        case 'invalid_email': return messages.errorEmail;
        case 'consent_required': return messages.errorConsent;
        case 'rate_limited': return messages.errorRate;
        default: return messages.errorGeneric;
      }
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (button.disabled) return;
      const data = new FormData(form);
      status.hidden = true;
      setLoading(true);
      try {
        const response = await fetch(ENDPOINT, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            email: String(data.get('email') ?? '').trim(),
            source: SOURCE,
            language: form.dataset.lang,
            consent: data.get('consent') === 'on',
            website: String(data.get('website') ?? ''),
          }),
        });
        const payload = await response.json().catch(() => ({}));
        if (response.ok) {
          const already = payload.status === 'already_subscribed';
          // Counted by Tag Manager only when the visitor accepted the cookies (it is not loaded otherwise).
          const w = window as any;
          (w.dataLayer = w.dataLayer || []).push({ event: 'sign_up', signup_source: SOURCE, landing: '', campaign: '', already_subscribed: already });
          form.classList.add('is-done');
          show(status, 'success', already ? messages.already : messages.success, already ? messages.alreadyDetail : messages.successDetail);
          return;
        }
        show(status, 'error', errorMessage(payload.error));
      } catch {
        show(status, 'error', messages.errorGeneric);
      } finally {
        setLoading(false);
      }
    });
  });
</script>

<style>
.ss { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr); gap: 20px clamp(24px, 4vw, 56px); align-items: start; padding: clamp(24px, 3.4vw, 40px); border-radius: 28px; background: var(--ed-mist); color: var(--ed-ink); }
.ss h2 { font-family: var(--ed-serif); font-weight: 400; font-size: clamp(28px, 2.8vw, 36px); line-height: 1.08; }
.ss-text p { margin-top: 10px; font-size: 16.5px; line-height: 1.55; color: var(--ed-ink-2); }
.ss-fields { display: flex; flex-direction: column; gap: 14px; }
.ss-form.is-done .ss-fields { display: none; }
.ss-row { display: flex; flex-wrap: wrap; gap: 10px; }
.ss-row input[type="email"] { flex: 1; min-width: min(240px, 100%); min-height: 52px; padding: 0 20px; border-radius: 999px; border: 1.5px solid var(--ed-ink); background: #fff; color: var(--ed-ink); font: inherit; font-size: 16.5px; outline: none; }
.ss-row input[type="email"]::placeholder { color: var(--ed-ink-3); }
.ss-row input[type="email"]:focus { border-color: var(--ed-navy); box-shadow: 0 0 0 3px rgba(21, 40, 68, .25); }
.ss-row button { min-height: 52px; padding: 0 26px; border: 0; border-radius: 999px; background: var(--ed-navy); color: #fff; font: inherit; font-size: 16.5px; font-weight: 600; cursor: pointer; }
.ss-row button:hover { background: #0E1D33; }
.ss-row button:disabled { opacity: .6; cursor: progress; }
.ss-consent { display: flex; align-items: flex-start; gap: 10px; font-size: 14px; line-height: 1.5; color: var(--ed-ink-2); cursor: pointer; }
.ss-consent input { flex: none; margin-top: 3px; width: 16px; height: 16px; accent-color: var(--ed-navy); cursor: pointer; }
.ss-consent a { color: var(--ed-ink); text-decoration: underline; text-underline-offset: 2px; }
.ss-trap { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
.ss-status { margin: 0; font-size: 15.5px; line-height: 1.5; color: var(--ed-ink); }
.ss-status[data-kind="error"] { margin-top: 12px; color: #8C1D18; font-weight: 600; }
.ss-form.is-done .ss-status { font-size: 16.5px; }
@media (max-width: 900px) {
  .ss { grid-template-columns: minmax(0, 1fr); }
}
</style>
