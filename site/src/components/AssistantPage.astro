---
// The Assistant page, shared by /assistant and /fr/assistant. Texts come from the "assistant_page" block of the translation files.
// The page follows what someone does with the Assistant: create, modify, challenge, take it by hand, and what stays in their control.
import Base from '../layouts/Base.astro';
import SiteHeader from './SiteHeader.astro';
import SiteFooter from './SiteFooter.astro';
import VideoAutoplay from './VideoAutoplay.astro';
import GitHubIcon from './GitHubIcon.astro';
import type { Lang } from '../i18n/utils';
import { useTranslations } from '../i18n/utils';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = useTranslations(lang);
const p = t.assistant_page;
const prefix = lang === 'fr' ? '/fr' : '';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: p.faq.items.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};
---
<Base title={p.meta.title} description={p.meta.description} lang={lang} schema={schema} ogImage={`/og/assistant-${lang}.png`} look="editorial">

<SiteHeader lang={lang} />

<main class="ed-page">

  <!-- Hero: the sentence, then the Assistant itself -->
  <section class="ed-wrap as-hero">
    <p class="ed-eyebrow">{p.hero.eyebrow}</p>
    <h1>{p.hero.h1} <em class="ed-mark">{p.hero.h1_accent}</em></h1>
    <p class="as-hero-sub">{p.hero.sub}</p>
    <div class="as-hero-cta">
      <a class="ed-btn ed-btn--navy" href={t.site.install_href}>{p.hero.cta}</a>
      <a class="ed-btn ed-btn--line" href={prefix + '/how-it-works'}>{p.hero.cta_secondary}</a>
    </div>
    <p class="as-hero-note">{p.hero.note}</p>
    <figure class="ed-shot as-hero-shot">
      <div class="ed-shot-frame ed-shot-frame--lift">
        <img src="/media/assistant-change.jpg" alt={p.hero.alt} width="1418" height="770" />
      </div>
      <figcaption>{p.hero.caption}</figcaption>
    </figure>
  </section>

  <!-- Create, modify, challenge: one recording each -->
  <section class="ed-wrap as-asks-head" id="asks">
    <header class="ed-sec-head">
      <p class="ed-eyebrow">{p.asks.eyebrow}</p>
      <h2 class="ed-h2">{p.asks.h2} <em>{p.asks.h2_accent}</em></h2>
      <p class="ed-sec-sub">{p.asks.sub}</p>
    </header>
  </section>

  {p.asks.items.map((item, i) => (
    <section class:list={[{ 'ed-band--mist': i % 2 === 1 }]} id={'ask-' + (i + 1)}>
      <div class="ed-wrap as-ask">
        <header class="as-ask-head">
          <span class="as-n" aria-hidden="true">{i + 1}</span>
          <div class="as-ask-intro">
            <h3 class="ed-h2 ed-h2--md">{item.title}</h3>
            <p class="ed-sec-sub">{item.lead}</p>
            <blockquote class="as-say">
              <span class="as-say-label">{p.asks.you_say}</span>
              <p lang="en">{item.say}</p>
            </blockquote>
          </div>
          <ol class="as-beats">
            {item.beats.map((beat: string) => <li>{beat}</li>)}
          </ol>
        </header>
        <figure class="ed-shot">
          <div class="ed-shot-frame ed-shot-frame--lift">
            <video muted loop playsinline controls preload="none" poster={'/media/' + item.clip + '.jpg'} width="1418" height="770" aria-label={item.alt} data-autoplay>
              <source src={'/media/' + item.clip + '.mp4'} type="video/mp4" />
            </video>
          </div>
          <figcaption>{p.asks.recorded}{p.asks.says_note ? ' ' + p.asks.says_note : ''}</figcaption>
        </figure>
      </div>
    </section>
  ))}

  <!-- Then by hand -->
  <section class:list={[{ 'ed-band--mist': p.asks.items.length % 2 === 0 }]} id="by-hand">
    <div class="ed-wrap as-ask">
      <header class="as-ask-head">
        <span class="as-n as-n--yellow" aria-hidden="true">✦</span>
        <div class="as-ask-intro">
          <p class="ed-eyebrow">{p.hand.eyebrow}</p>
          <h2 class="ed-h2 ed-h2--md">{p.hand.h2} <em>{p.hand.h2_accent}</em></h2>
          <p class="ed-sec-sub">{p.hand.lead}</p>
          <a class="as-link" href={prefix + '/how-it-works#by-hand'}>{p.hand.link} →</a>
        </div>
        <ol class="as-beats">
          {p.hand.steps.map((step: string) => <li>{step}</li>)}
        </ol>
      </header>
      <figure class="ed-shot">
        <div class="ed-shot-frame ed-shot-frame--lift">
          <video muted loop playsinline controls preload="none" poster="/media/assistant-hand.jpg" width="1418" height="770" aria-label={p.hand.alt} data-autoplay>
            <source src="/media/assistant-hand.mp4" type="video/mp4" />
          </video>
        </div>
        <figcaption>{p.hand.caption}</figcaption>
      </figure>
    </div>
  </section>

  <!-- What stays in the user's hands -->
  <section class="ed-band--navy" id="control">
    <div class="ed-wrap ed-sec">
      <header class="ed-sec-head">
        <p class="ed-eyebrow as-on-navy-eyebrow">{p.control.eyebrow}</p>
        <h2 class="ed-h2">{p.control.h2} <em>{p.control.h2_accent}</em></h2>
      </header>
      <ul class="as-control">
        {p.control.points.map((point: any) => (
          <li>
            <strong>{point.title}</strong>
            <span>{point.body}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Honest limits -->
  <section class="ed-wrap ed-sec" id="know">
    <header class="ed-sec-head">
      <p class="ed-eyebrow">{p.know.eyebrow}</p>
      <h2 class="ed-h2">{p.know.h2} <em>{p.know.h2_accent}</em></h2>
    </header>
    <dl class="as-know">
      {p.know.items.map((item: any) => (
        <div>
          <dt>{item.title}</dt>
          <dd>{item.body}</dd>
        </div>
      ))}
    </dl>
  </section>

  <!-- Questions -->
  <section class="ed-band--mist" id="faq">
    <div class="ed-wrap ed-sec">
      <header class="ed-sec-head">
        <p class="ed-eyebrow">{p.faq.eyebrow}</p>
        <h2 class="ed-h2">{p.faq.h2} <em>{p.faq.h2_accent}</em></h2>
      </header>
      <div class="as-faq">
        {p.faq.items.map((item) => (
          <details>
            <summary>{item.q}</summary>
            <p>{item.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- Final call -->
  <section class="ed-band--yellow" id="cta">
    <div class="ed-wrap ed-final">
      <h2>{p.cta.h2} <em>{p.cta.h2_accent}</em></h2>
      <p class="ed-final-sub">{p.cta.sub}</p>
      <div class="as-final-actions">
        <a class="ed-btn ed-btn--navy" href={t.site.install_href}>{p.cta.primary}</a>
        <a class="ed-btn ed-btn--line" href={prefix + '/use-cases'}>{p.cta.secondary}</a>
      </div>
      <p class="ed-final-fine">{p.cta.cloud} <a class="as-fine-link" href={prefix + '/start'}>{p.cta.cloud_link}</a></p>
    </div>
  </section>

</main>

<SiteFooter lang={lang} />

<VideoAutoplay />

</Base>

<style>
/* ---------- hero ---------- */
.as-hero { display: flex; flex-direction: column; align-items: center; gap: 24px; text-align: center; padding-block: clamp(56px, 8vw, 96px) clamp(48px, 6vw, 80px); }
.as-hero h1 { font-family: var(--ed-serif); font-size: clamp(46px, 7.4vw, 112px); line-height: .98; letter-spacing: -.02em; text-wrap: balance; }
.as-hero-sub { font-size: clamp(18px, 1.6vw, 21px); line-height: 1.5; color: var(--ed-ink-2); max-width: 36em; }
.as-hero-cta { display: flex; flex-wrap: wrap; gap: 14px 16px; align-items: center; justify-content: center; }
.as-hero-note { font-size: 15.5px; color: var(--ed-ink-3); margin-top: -8px; }
.as-hero-shot { width: 100%; margin-top: 18px; text-align: left; }
.as-hero-shot img { display: block; width: 100%; height: auto; }

/* ---------- create / modify / challenge ---------- */
.as-asks-head { padding-block: clamp(40px, 5vw, 64px) clamp(8px, 2vw, 16px); }
.as-ask { display: flex; flex-direction: column; gap: clamp(28px, 4vw, 44px); padding-block: clamp(48px, 6vw, 80px); }
.as-ask-head { display: grid; grid-template-columns: auto minmax(0, 1.25fr) minmax(0, 1fr); gap: 20px clamp(20px, 3vw, 40px); align-items: start; }
.as-n { width: clamp(52px, 5vw, 72px); height: clamp(52px, 5vw, 72px); border-radius: 999px; background: var(--ed-navy); color: #fff; display: grid; place-items: center; font-family: var(--ed-serif); font-size: clamp(30px, 3vw, 42px); line-height: 1; }
.as-n--yellow { background: var(--ed-yellow); color: var(--ed-ink); }
.as-ask-intro { display: flex; flex-direction: column; gap: 14px; align-items: flex-start; }
.as-say { margin: 6px 0 0; padding: 14px 18px; border-left: 5px solid var(--ed-yellow); background: var(--ed-mist); border-radius: 0 14px 14px 0; display: flex; flex-direction: column; gap: 4px; }
.as-say-label { font-size: 13px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; color: var(--ed-ink-3); }
.as-say p { font-size: 18px; line-height: 1.45; font-weight: 600; color: var(--ed-ink); }
.ed-band--mist .as-say { background: #fff; }

.as-beats { counter-reset: beat; display: flex; flex-direction: column; }
.as-beats li { counter-increment: beat; display: flex; gap: 14px; align-items: baseline; padding-block: 12px; border-top: 1px solid var(--ed-line-2); font-weight: 600; }
.as-beats li:last-child { border-bottom: 1px solid var(--ed-line-2); }
.as-beats li::before { content: counter(beat); flex: none; font-family: var(--ed-serif); font-size: 24px; line-height: 1; color: var(--ed-ink-3); min-width: 1ch; }
.as-link { display: inline-flex; align-items: center; min-height: 44px; font-weight: 700; border-bottom: 1.5px solid currentColor; }
.as-link:hover { opacity: .7; }
.as-ask video { display: block; width: 100%; height: auto; aspect-ratio: 1418 / 770; background: #F4F4F4; }

/* ---------- what stays in the user's hands ---------- */
.as-on-navy-eyebrow { color: var(--ed-yellow); }
.as-control { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(240px, 100%), 1fr)); gap: 20px; }
.as-control li { display: flex; flex-direction: column; gap: 8px; padding: 22px 22px 24px; border-radius: 20px; border: 1px solid var(--ed-navy-line); background: var(--ed-navy-2); color: var(--ed-on-navy-2); }
.as-control strong { font-size: 19px; line-height: 1.25; color: #fff; }
.as-control span { font-size: 16.5px; line-height: 1.5; }

/* ---------- honest limits ---------- */
.as-know { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(420px, 100%), 1fr)); gap: 0 clamp(24px, 4vw, 56px); border-top: 2px solid var(--ed-ink); }
.as-know > div { padding-block: 22px; border-bottom: 1px solid var(--ed-line-2); }
.as-know dt { font-family: var(--ed-serif); font-size: clamp(26px, 2.4vw, 32px); line-height: 1.1; color: var(--ed-ink); padding-bottom: 8px; }
.as-know dd { margin: 0; color: var(--ed-ink-2); max-width: 36em; }

/* ---------- questions ---------- */
.as-faq { max-width: 900px; border-top: 2px solid var(--ed-ink); }
.as-faq details { border-bottom: 1px solid var(--ed-line-2); }
.as-faq summary { list-style: none; cursor: pointer; display: flex; align-items: center; justify-content: space-between; gap: 20px; padding-block: 20px; font-size: 21px; font-weight: 700; color: var(--ed-ink); }
.as-faq summary::-webkit-details-marker { display: none; }
.as-faq summary::after { content: "+"; flex: none; font-family: var(--ed-serif); font-size: 34px; line-height: 1; font-weight: 400; }
.as-faq details[open] summary::after { content: "–"; }
.as-faq details p { padding-bottom: 22px; max-width: 46em; color: var(--ed-ink-2); }

/* ---------- final call ---------- */
.as-final-actions { display: flex; flex-wrap: wrap; gap: 14px 16px; align-items: center; justify-content: center; }
.as-fine-link { font-weight: 700; border-bottom: 1.5px solid currentColor; }

#cta, #asks, #by-hand, #control, #know, #faq, #ask-1, #ask-2, #ask-3 { scroll-margin-top: 78px; }

@media (max-width: 900px) {
  .as-ask-head { grid-template-columns: auto minmax(0, 1fr); }
  .as-beats { grid-column: 1 / -1; }
}
@media (max-width: 560px) {
  .as-faq summary { font-size: 19px; }
}
</style>
