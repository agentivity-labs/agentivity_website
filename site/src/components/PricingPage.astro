---
// Pricing, shared by /pricing and /fr/pricing. Texts come from the "pricing_page" block of the translation files.
// The prices and limits of the hosted plans come from src/data/plans.json, the only place of the site that holds them;
// the texts take them through markers ({from}, {trial_days}, {trial_executions}, {price}, {n}, {d}).
// A switch shows the hosted plans billed yearly (the default, also without JavaScript) or monthly.
import Base from '../layouts/Base.astro';
import SiteHeader from './SiteHeader.astro';
import SiteFooter from './SiteFooter.astro';
import GitHubIcon from './GitHubIcon.astro';
import StartFree from './StartFree.astro';
import TrialNote from './TrialNote.astro';
import data from '../data/plans.json';
import type { Lang } from '../i18n/utils';
import { useTranslations } from '../i18n/utils';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = useTranslations(lang);
const p = t.pricing_page;
const home = lang === 'fr' ? '/fr/' : '/';
const community = p.editions.community;
const billing = p.editions.billing;
const limits = p.editions.limits;
const compare = p.editions.compare;
const seats = p.seats;
const packs = p.packs;
// The Desk seats a plan with extra seats already includes: the tiers start after them.
const deskIncluded = Math.max(...data.plans.filter((plan) => plan.extraSeats).map((plan) => plan.deskSeats));

// Numbers and prices in the reader's language: "€40.83" and "1,000" in English, "40,83 €" and "1 000" in French.
const locale = lang === 'fr' ? 'fr-FR' : 'en-IE';
const money = (v: number) => new Intl.NumberFormat(locale, { style: 'currency', currency: data.currency, minimumFractionDigits: Number.isInteger(v) ? 0 : 2, maximumFractionDigits: 2 }).format(v);
const num = (v: number) => new Intl.NumberFormat(locale).format(v);
const perMonthYearly = (plan: { yearly: number }) => Math.round(plan.yearly / 12 * 100) / 100;
const from = money(Math.min(...data.plans.map(perMonthYearly)));
const planBy = (code: string) => data.plans.find((one) => one.code === code)!;
// The seats the texts name: those of Pro and Business, and the most one can add before Enterprise.
const seatCounts = {
  pro_studio: num(planBy('pro').studioSeats), pro_desk: num(planBy('pro').deskSeats),
  business_studio: num(planBy('business').studioSeats), business_desk: num(planBy('business').deskSeats),
  studio_max: num(data.seats.studio.max), desk_max: num(data.seats.desk.max),
};
const fill = (text: string, values: Record<string, string> = {}) =>
  Object.entries({ from, trial_days: String(data.trial.days), trial_executions: num(data.trial.executions), ...seatCounts, ...values })
    .reduce((s, [k, v]) => s.split('{' + k + '}').join(v), text);
const plural = (forms: string[], n: number) => fill(forms[n === 1 ? 0 : 1], { n: num(n) });
const duration = (minutes: number) => minutes < 60 ? fill(limits.minutes, { n: num(minutes) }) : fill(limits.hours, { n: num(minutes / 60) });

// The cards: the three hosted plans take their figures from plans.json, Enterprise keeps its text price.
const hosted = new Map(data.plans.map((plan) => [plan.name, plan]));
const cards = p.editions.plans.map((plan: any) => ({ ...plan, data: hosted.get(plan.name) }));

const schema = [
  ...data.plans.map((plan) => ({
    '@context': 'https://schema.org',
    '@type': 'Offer',
    name: 'Agentivity ' + plan.name,
    price: String(plan.monthly),
    priceCurrency: data.currency,
    description: cards.find((c: any) => c.name === plan.name)?.for,
    priceSpecification: {
      '@type': 'UnitPriceSpecification',
      price: plan.monthly,
      priceCurrency: data.currency,
      unitText: 'MONTH',
      billingDuration: 'P1M',
      valueAddedTaxIncluded: false,
    },
  })),
  {
    '@context': 'https://schema.org',
    '@type': 'Offer',
    name: 'Agentivity ' + community.name,
    price: '0',
    priceCurrency: 'EUR',
    description: community.desc,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: p.faq.items.map((item: any) => ({
      '@type': 'Question',
      name: fill(item.q),
      acceptedAnswer: { '@type': 'Answer', text: fill(item.a) },
    })),
  },
];
---
<Base title={p.meta.title} description={fill(p.meta.description)} lang={lang} schema={schema} look="editorial">

<SiteHeader lang={lang} />

<main class="ed-page">

  <section class="ed-wrap pr-hero">
    <p class="ed-eyebrow">{p.hero.eyebrow}</p>
    <h1><span class="ed-mark">{fill(p.hero.price)}</span> <em>{p.hero.rest}</em></h1>
    <p class="pr-hero-sub">{fill(p.hero.sub)}</p>
    <div class="pr-actions">
      <a class="ed-btn ed-btn--navy" href={p.hero.primary_href}>{p.hero.primary}</a>
      <a class="ed-btn ed-btn--line" href={p.hero.secondary_href}>{p.hero.secondary}</a>
    </div>
    <TrialNote lang={lang} />
  </section>

  <!-- Editions: the hosted plans first, then Community, for whoever runs a server -->
  <section class="ed-band--mist" id="editions">
    <div class="ed-wrap ed-sec">
      <header class="ed-sec-head">
        <p class="ed-eyebrow">{p.editions.eyebrow}</p>
        <h2 class="ed-h2">{p.editions.h2} <em>{p.editions.h2_accent}</em></h2>
        <p class="ed-sec-sub">{p.editions.sub}</p>
      </header>

      <div class="pr-hosted">
        <!-- Yearly or monthly: two radio buttons, so that the switch works without JavaScript (yearly when nothing is chosen) -->
        <fieldset class="pr-billing">
          <legend class="pr-sr">{billing.label}</legend>
          <input type="radio" name="billing" id={'billing-yearly-' + lang} value="yearly" checked />
          <label for={'billing-yearly-' + lang}>{billing.yearly} <span class="pr-billing-badge">{billing.yearly_badge}</span></label>
          <input type="radio" name="billing" id={'billing-monthly-' + lang} value="monthly" />
          <label for={'billing-monthly-' + lang}>{billing.monthly}</label>
        </fieldset>

        <ul class="pr-plans">
          {cards.map((plan: any) => (
            <li class:list={['pr-plan', { 'pr-plan--hosted': plan.data }]}>
              <span class="pr-status">{fill(plan.status)}</span>
              <h3>{plan.name}</h3>
              {plan.data ? (
                <div class="pr-plan-price">
                  <p class="pr-amount is-yearly"><strong>{money(perMonthYearly(plan.data))}</strong> <span>{billing.per_month}</span></p>
                  <p class="pr-billed is-yearly">{fill(billing.billed_yearly, { price: money(plan.data.yearly) })}</p>
                  <p class="pr-amount is-monthly"><strong>{money(plan.data.monthly)}</strong> <span>{billing.per_month}</span></p>
                  <p class="pr-billed is-monthly">{billing.billed_monthly}</p>
                </div>
              ) : (
                <p class="pr-plan-quote">{plan.price}</p>
              )}
              <p class="pr-for"><span>{p.editions.for_label}</span> {plan.for}</p>
              <p class="pr-desc">{fill(plan.desc)}</p>
              {plan.data && (
                <ul class="pr-limits">
                  <li>{plural(limits.studio, plan.data.studioSeats)}</li>
                  {plan.data.deskSeats > 0 && <li>{plural(limits.desk, plan.data.deskSeats)}</li>}
                  <li>{fill(limits.executions, { n: num(plan.data.executionsPerMonth) })}</li>
                  <li>{plan.data.schedules == null ? limits.schedules_unlimited : plural(limits.schedules, plan.data.schedules)}</li>
                  <li>{fill(limits.duration, { d: duration(plan.data.maxExecutionMinutes) })}</li>
                  <li>{fill(limits.disk, { n: num(plan.data.diskGb) })}</li>
                </ul>
              )}
              <a class:list={[plan.data ? 'ed-btn ed-btn--navy ed-btn--sm pr-plan-start' : 'pr-plan-cta']} href={plan.href}>{plan.cta}</a>
            </li>
          ))}
        </ul>
        <p class="pr-seats-note">{p.editions.seats_note}</p>
        <p class="pr-notes">{billing.vat} {fill(billing.trial)}</p>
        <p class="pr-sale">{billing.sale_before} <a href={billing.sale_href}>{billing.sale_link}</a></p>
        <p class="pr-sale">{billing.climate} <a href={billing.climate_href}>{billing.climate_link}</a></p>

        <!-- Every limit of the hosted plans, side by side -->
        <div class="pr-compare">
          <h3>{compare.h3}</h3>
          <div class="pr-compare-scroll">
            <table>
              <thead>
                <tr>
                  <th scope="col"><span class="pr-sr">{compare.plan}</span></th>
                  {data.plans.map((plan) => <th scope="col">{plan.name}</th>)}
                </tr>
              </thead>
              <tbody>
                <tr><th scope="row">{compare.rows.yearly}</th>{data.plans.map((plan) => <td>{fill(compare.per_year, { price: money(plan.yearly) })}</td>)}</tr>
                <tr><th scope="row">{compare.rows.monthly}</th>{data.plans.map((plan) => <td>{fill(compare.per_month, { price: money(plan.monthly) })}</td>)}</tr>
                <tr><th scope="row">{compare.rows.studio}</th>{data.plans.map((plan) => <td>{num(plan.studioSeats)}</td>)}</tr>
                <tr><th scope="row">{compare.rows.desk}</th>{data.plans.map((plan) => <td>{plan.deskSeats ? num(plan.deskSeats) : compare.none}</td>)}</tr>
                <tr><th scope="row">{compare.rows.more_seats}</th>{data.plans.map((plan) => <td class="pr-wrap">{plan.extraSeats ? compare.more_seats : compare.none}</td>)}</tr>
                <tr><th scope="row">{compare.rows.spaces}</th>{data.plans.map((plan) => <td>{num(plan.spaces)}</td>)}</tr>
                <tr><th scope="row">{compare.rows.executions}</th>{data.plans.map((plan) => <td>{num(plan.executionsPerMonth)}</td>)}</tr>
                <tr><th scope="row">{compare.rows.schedules}</th>{data.plans.map((plan) => <td>{plan.schedules == null ? compare.unlimited : num(plan.schedules)}</td>)}</tr>
                <tr><th scope="row">{compare.rows.webhooks}</th>{data.plans.map(() => <td>{compare.unlimited}</td>)}</tr>
                <tr><th scope="row">{compare.rows.parallel}</th>{data.plans.map((plan) => <td>{num(plan.parallelExecutions)}</td>)}</tr>
                <tr><th scope="row">{compare.rows.duration}</th>{data.plans.map((plan) => <td>{duration(plan.maxExecutionMinutes)}</td>)}</tr>
                <tr><th scope="row">{compare.rows.disk}</th>{data.plans.map((plan) => <td>{fill(limits.gb, { n: num(plan.diskGb) })}</td>)}</tr>
                <tr><th scope="row">{compare.rows.backups}</th>{data.plans.map((plan) => <td>{fill(limits.backups, { n: num(plan.backupDays) })}</td>)}</tr>
                <tr><th scope="row">{compare.rows.support}</th>{data.plans.map((plan) => <td class="pr-wrap">{compare.support[plan.support as keyof typeof compare.support]}</td>)}</tr>
                <tr><th scope="row">{compare.rows.extras}</th>{data.plans.map((plan) => <td class="pr-wrap">{plan.extras.length ? plan.extras.map((e) => compare.extras[e as keyof typeof compare.extras]).join(', ') : compare.none}</td>)}</tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>
      <p class="pr-cloud-note">{p.editions.cloud_note}</p>

      <article class="pr-community">
        <div class="pr-community-main">
          <span class="pr-status">{community.status}</span>
          <h3>{community.name} <span class="pr-price"><strong>{community.price}</strong> <span>{community.price_note}</span></span></h3>
          <p class="pr-for"><span>{p.editions.for_label}</span> {community.for}</p>
          <p class="pr-desc">{community.desc}</p>
          <div class="pr-actions pr-actions--start">
            <a class="ed-btn ed-btn--line ed-btn--sm" href={t.site.install_href}>{community.cta}</a>
            <a class="pr-github" href={t.site.github_href} target="_blank" rel="noopener noreferrer"><GitHubIcon />{community.github}</a>
          </div>
        </div>
        <ul class="pr-community-points">
          {community.points.map((point: string) => <li>{point}</li>)}
        </ul>
      </article>
    </div>
  </section>

  <!-- Seats added to Business: the Studio seat, then the Desk seat by tiers -->
  <section class="ed-wrap ed-sec" id="seats">
    <header class="ed-sec-head">
      <p class="ed-eyebrow">{seats.eyebrow}</p>
      <h2 class="ed-h2">{seats.h2} <em>{seats.h2_accent}</em></h2>
      <p class="ed-sec-sub">{fill(seats.sub)}</p>
    </header>
    <div class="pr-seats">
      <article class="pr-seat">
        <h3>{seats.studio.title}</h3>
        <p class="pr-amount"><strong>{money(data.seats.studio.monthly)}</strong> <span>{seats.studio.per_month}</span></p>
        <p class="pr-billed">{fill(seats.studio.per_year, { price: money(data.seats.studio.yearly) })}</p>
        <ul class="pr-limits">
          {seats.studio.points.map((point: string) => <li>{fill(point, { n: num(data.seats.studio.executions), max: num(data.seats.studio.max) })}</li>)}
        </ul>
      </article>
      <article class="pr-seat">
        <h3>{seats.desk.title}</h3>
        <p class="pr-seat-sub">{seats.desk.sub}</p>
        {'link' in seats.desk && <a class="pr-seat-link" href={seats.desk.link_href}>{seats.desk.link} →</a>}
        <table class="pr-tiers">
          <thead>
            <tr><th scope="col">{seats.desk.col_seats}</th><th scope="col">{seats.desk.col_month}</th><th scope="col">{seats.desk.col_year}</th></tr>
          </thead>
          <tbody>
            <tr><th scope="row">{fill(seats.desk.included_range, { n: num(deskIncluded) })}</th><td colspan="2">{seats.desk.included}</td></tr>
            {data.seats.desk.tiers.map((tier) => (
              <tr><th scope="row">{fill(seats.desk.range, { from: num(tier.from), to: num(tier.to) })}</th><td>{money(tier.monthly)}</td><td>{money(tier.yearly)}</td></tr>
            ))}
          </tbody>
        </table>
        <ul class="pr-limits">
          {seats.desk.points.map((point: string) => <li>{fill(point, { n: num(data.seats.desk.executions), max: num(data.seats.desk.max) })}</li>)}
        </ul>
      </article>
    </div>
    <p class="pr-notes">{seats.where}</p>
    <p class="pr-sale">{fill(seats.enterprise)} <a href={seats.enterprise_href}>{seats.enterprise_link}</a></p>
  </section>

  <!-- Execution packs, for a month that needs more -->
  <section class="ed-band--mist" id="packs">
    <div class="ed-wrap ed-sec">
      <header class="ed-sec-head">
        <p class="ed-eyebrow">{packs.eyebrow}</p>
        <h2 class="ed-h2">{packs.h2} <em>{packs.h2_accent}</em></h2>
        <p class="ed-sec-sub">{packs.sub}</p>
      </header>
      <ul class="pr-packs">
        {data.packs.map((pack) => (
          <li>
            <p class="pr-pack-n">{fill(packs.item, { n: num(pack.executions) })}</p>
            <p class="pr-amount"><strong>{money(pack.price)}</strong></p>
          </li>
        ))}
      </ul>
      <ul class="pr-packs-points">
        {packs.points.map((point: string) => <li>{point}</li>)}
      </ul>
    </div>
  </section>

  <!-- What you actually pay -->
  <section class="ed-wrap ed-sec" id="costs">
    <header class="ed-sec-head">
      <p class="ed-eyebrow">{p.costs.eyebrow}</p>
      <h2 class="ed-h2">{p.costs.h2} <em>{p.costs.h2_accent}</em></h2>
    </header>
    <ol class="pr-costs">
      {p.costs.items.map((item: any, i: number) => (
        <li>
          <span class="pr-costs-n" aria-hidden="true">{i + 1}</span>
          <h3>{item.title}</h3>
          <p>{item.body}</p>
        </li>
      ))}
    </ol>
  </section>

  <!-- The figure a price is compared with -->
  <section class="ed-band--navy" id="hours">
    <div class="ed-wrap ed-sec pr-hours">
      <h2><span class="pr-hours-big">{p.hours.big}</span> <em>{p.hours.h2}</em></h2>
      <div class="pr-hours-side">
        <p>{p.hours.sub}</p>
        <a class="pr-hours-link" href={home + '#hours'}>{p.hours.link}</a>
      </div>
    </div>
  </section>

  <!-- Licence -->
  <section class="ed-wrap ed-sec pr-licence" id="licence">
    <div class="pr-licence-head">
      <p class="ed-eyebrow">{p.licence.eyebrow}</p>
      <h2 class="ed-h2 ed-h2--md">{p.licence.h2} <em>{p.licence.h2_accent}</em></h2>
    </div>
    <div class="pr-licence-body">
      <p>{p.licence.body}</p>
      <a class="ed-link" href={p.licence.href} target="_blank" rel="noopener noreferrer">{p.licence.link}</a>
    </div>
  </section>

  <!-- Questions -->
  <section class="ed-band--mist" id="faq">
    <div class="ed-wrap ed-sec">
      <header class="ed-sec-head">
        <p class="ed-eyebrow">{p.faq.eyebrow}</p>
        <h2 class="ed-h2">{p.faq.h2} <em>{p.faq.h2_accent}</em></h2>
      </header>
      <div class="pr-faq">
        {p.faq.items.map((item: any) => (
          <details>
            <summary>{fill(item.q)}</summary>
            <p>{fill(item.a)} {item.link && <a href={item.href}>{item.link}</a>}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- Final call -->
  <section class="ed-band--yellow" id="cta">
    <div class="ed-wrap ed-final">
      <h2>{p.cta.h2} <em>{p.cta.h2_accent}</em></h2>
      <p class="ed-final-sub">{p.cta.sub}</p>
      <StartFree lang={lang} />
      <p class="pr-final-github">
        <span>{p.cta.github_line}</span>
        <a class="ed-link" href={t.site.install_href}>{t.site.install}</a>
        <a class="ed-link" href={t.site.github_href} target="_blank" rel="noopener noreferrer">{t.site.github}</a>
      </p>
    </div>
  </section>

</main>

<SiteFooter lang={lang} />

</Base>

<style>
/* ---------- hero ---------- */
.pr-hero { display: flex; flex-direction: column; align-items: center; gap: 26px; text-align: center; padding-block: clamp(56px, 8vw, 104px) clamp(56px, 7vw, 88px); }
.pr-hero h1 { font-family: var(--ed-serif); font-size: clamp(56px, 9vw, 136px); line-height: .92; letter-spacing: -.02em; }
.pr-hero h1 .ed-mark { background-image: linear-gradient(transparent 62%, var(--ed-yellow) 62%, var(--ed-yellow) 90%, transparent 90%); }
.pr-hero-sub { font-size: clamp(18px, 1.6vw, 21px); line-height: 1.5; color: var(--ed-ink-2); max-width: 34em; }
.pr-actions { display: flex; flex-wrap: wrap; gap: 14px 16px; align-items: center; justify-content: center; }
.pr-actions--start { justify-content: flex-start; margin-top: 8px; }

/* ---------- editions ---------- */
.pr-status { align-self: flex-start; padding: 4px 11px; border-radius: 999px; background: var(--ed-mist); font-size: 12.5px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; color: var(--ed-ink); }
.pr-for { font-size: 16px; font-weight: 600; }
.pr-for span { font-weight: 700; letter-spacing: .06em; text-transform: uppercase; font-size: 12.5px; margin-right: 4px; }
.pr-desc { font-size: 16.5px; }

/* Community, after the hosted plans: a plain card for whoever would rather run a server */
.pr-community { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); gap: clamp(20px, 3vw, 44px); align-items: center; margin-top: 36px; background: #fff; color: var(--ed-ink-2); border-radius: 24px; padding: clamp(22px, 3vw, 34px); }
.pr-community-main { display: flex; flex-direction: column; gap: 10px; }
.pr-community h3 { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 16px; font-family: var(--ed-serif); font-weight: 400; font-size: 36px; line-height: 1.05; color: var(--ed-ink); }
.pr-price { display: inline-flex; align-items: baseline; gap: 8px; }
.pr-price strong { font-weight: 400; font-size: 36px; }
.pr-price span { font-family: var(--ed-sans); font-size: 16px; font-weight: 600; color: var(--ed-ink-3); }
.pr-community .pr-for { color: var(--ed-ink); }
.pr-community .pr-for span { color: var(--ed-ink-3); }
.pr-github { display: inline-flex; align-items: center; gap: 8px; min-height: 44px; font-weight: 600; color: var(--ed-ink); border-bottom: 1.5px solid currentColor; }
.pr-github :global(svg) { width: 18px; height: 18px; }
.pr-github:hover { opacity: .75; }
.pr-community-points li { padding-block: 10px; border-top: 1px solid var(--ed-line); font-size: 15.5px; font-weight: 600; color: var(--ed-ink); }
.pr-community-points li:last-child { border-bottom: 1px solid var(--ed-line); }

.pr-plans { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; margin-top: 16px; }
.pr-plan { display: flex; flex-direction: column; gap: 12px; background: #fff; border-radius: 24px; padding: 26px 24px; color: var(--ed-ink-2); }
.pr-plan h3 { font-family: var(--ed-serif); font-size: 36px; line-height: 1.05; color: var(--ed-ink); }
.pr-plan-quote { font-family: var(--ed-serif); font-style: italic; font-size: 22px; line-height: 1.1; color: var(--ed-ink); padding-bottom: 12px; border-bottom: 1px solid var(--ed-line-2); }

/* the yearly / monthly switch: two radio buttons drawn as one control; yearly is checked in the page itself */
.pr-sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
.pr-hosted { display: flex; flex-direction: column; margin-top: 36px; }
.pr-billing { align-self: center; display: inline-flex; gap: 4px; margin: 0; padding: 5px; border: 1px solid var(--ed-line-2); border-radius: 999px; background: #fff; }
.pr-billing input { position: absolute; opacity: 0; pointer-events: none; }
.pr-billing label { display: inline-flex; align-items: center; gap: 10px; min-height: 44px; padding: 0 20px; border-radius: 999px; font-size: 16px; font-weight: 700; color: var(--ed-ink-2); cursor: pointer; transition: background .15s ease, color .15s ease; }
.pr-billing input:checked + label { background: var(--ed-navy); color: #fff; }
.pr-billing input:focus-visible + label { outline: 2px solid var(--ed-navy); outline-offset: 2px; }
.pr-billing-badge { padding: 3px 9px; border-radius: 999px; background: var(--ed-yellow); color: var(--ed-ink); font-size: 12px; letter-spacing: .04em; text-transform: uppercase; }
