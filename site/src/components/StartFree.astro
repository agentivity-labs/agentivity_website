---
// The call to start the trial: a button to the sign-up page, and the terms of the trial in small under it.
// Used at the end of most pages and in the landing pages.
import type { Lang } from '../i18n/utils';
import { useTranslations } from '../i18n/utils';
import TrialNote from './TrialNote.astro';

interface Props {
  lang: Lang;
  /** Replaces the label of the button. */
  label?: string;
  /** 'start' to align on the left (a landing page's hero); centred by default. */
  align?: 'center' | 'start';
  /** The plan the trial opens on (start?plan=…); none by default. */
  plan?: string;
}
const { lang, label, align = 'center', plan } = Astro.props;
const t = useTranslations(lang);
const href = (lang === 'fr' ? '/fr/start' : '/start') + (plan ? '?plan=' + plan : '');
---
<div class:list={['start-free', { 'start-free--start': align === 'start' }]}>
  <a class="ed-btn ed-btn--navy" href={href}>{label ?? t.start_cta.label}</a>
  <TrialNote lang={lang} />
</div>

<style>
.start-free { display: flex; flex-direction: column; align-items: center; gap: 10px; }
.start-free--start { align-items: flex-start; }
</style>
