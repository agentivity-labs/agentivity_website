---
// Header of the pages in the editorial look.
import type { Lang } from '../i18n/utils';
import { useTranslations } from '../i18n/utils';
import GitHubIcon from './GitHubIcon.astro';

interface Props {
  lang: Lang;
  /** Where the main button goes. Defaults to the sign-up page (the trial). */
  ctaHref?: string;
  /** Replaces the label of that button, for a page whose main action is not the trial. */
  ctaLabel?: string;
  /** Where the language switch goes, for a page whose two versions are not at / and /fr/ (the documentation). */
  hrefEn?: string;
  hrefFr?: string;
  /** A landing page: the logo, GitHub and the button only, so that the page keeps the visitor on its own action. */
  minimal?: boolean;
}
const { lang, ctaHref, ctaLabel, hrefEn = '/', hrefFr = '/fr/', minimal = false } = Astro.props;
const t = useTranslations(lang);
const home = lang === 'fr' ? '/fr/' : '/';
const cta = ctaHref ?? (lang === 'fr' ? '/fr/start' : '/start');
const ctaText = ctaLabel ?? t.nav.cta;
const menuLabel = lang === 'fr' ? 'Ouvrir le menu' : 'Open menu';
const navLabel = lang === 'fr' ? 'Navigation principale' : 'Main navigation';
const product = t.nav.product;
// The Solutions menu, English only for now (KB-0147): solutions by department, and who they are built for. A group shows once one
// of its solutions is live in the trial (display rule A, 2026-11-11); a solution links only once its page exists, the others say
// "coming soon".
const solutions = 'solutions' in t.nav ? (t.nav as typeof import('../i18n/en.json')['nav']).solutions : undefined;
const groups = solutions?.groups.filter((group) => group.items.some((item: any) => item.live)) ?? [];
const here = Astro.url.pathname.replace(/\/$/, '');
const isHere = (href: string) => !href.includes('#') && href.replace(/\/$/, '') === here;
const productHere = product.groups.some((group) => group.items.some((item) => isHere(item.href))) || isHere(product.intro.href);
const solutionsHere = here === '/solutions' || groups.some((group) => group.items.some((item: any) => item.href && isHere(item.href)))
  || (solutions?.built_for.items.some((item) => isHere(item.href)) ?? false);
// Line icons of the Product menu, drawn on a 24px grid with the current colour.
const icons: Record<string, string> = {
  team: '<circle cx="12" cy="5" r="2.6"/><circle cx="5" cy="18" r="2.6"/><circle cx="12" cy="18" r="2.6"/><circle cx="19" cy="18" r="2.6"/><path d="M12 7.6v7.8M10.3 7l-4 8.6M13.7 7l4 8.6"/>',
  agent: '<circle cx="12" cy="8" r="3.6"/><path d="M5 20c.8-3.6 3.6-5.6 7-5.6s6.2 2 7 5.6"/>',
  workflow: '<rect x="3" y="4" width="6" height="5" rx="1.4"/><rect x="15" y="4" width="6" height="5" rx="1.4"/><rect x="9" y="15" width="6" height="5" rx="1.4"/><path d="M9 6.5h6M6 9v3.5h6V15M18 9v3.5h-6"/>',
  prompt: '<path d="M4 6h10M4 12h7M4 18h10"/><path d="m16 11 2.2 2.2L22 9.4"/>',
  data: '<ellipse cx="12" cy="5.5" rx="7" ry="2.6"/><path d="M5 5.5v13c0 1.4 3.1 2.6 7 2.6s7-1.2 7-2.6v-13M5 12c0 1.4 3.1 2.6 7 2.6s7-1.2 7-2.6"/>',
  app: '<rect x="3" y="4" width="18" height="14" rx="2.4"/><path d="M8 21h8M7.5 9.5h9M7.5 13h5"/>',
  assistant: '<path d="M12 3.5 13.8 9l5.7.2-4.5 3.4 1.6 5.4L12 14.8 7.4 18l1.6-5.4L4.5 9.2 10.2 9z"/>',
  desk: '<rect x="3" y="4" width="18" height="16" rx="2.4"/><path d="M9 4v16M12.5 9h5M12.5 13h3.5"/>',
  plug: '<path d="M9 3v5M15 3v5M6 8h12v3a6 6 0 0 1-12 0zM12 17v4"/>',
  maker: '<path d="M14.5 5.5a4 4 0 0 0-5.3 5.3L3.5 16.5l4 4 5.7-5.7a4 4 0 0 0 5.3-5.3l-2.6 2.6-2.8-.6-.6-2.8z"/>',
  agency: '<rect x="3" y="7" width="18" height="13" rx="2.4"/><path d="M9 7V5a1.5 1.5 0 0 1 1.5-1.5h3A1.5 1.5 0 0 1 15 5v2M3 13h18"/>',
};
---

<header class:list={['sh', { 'sh--long': lang === 'fr', 'sh--minimal': minimal }]}>
  <div class="ed-wrap sh-inner">
    <a class="sh-brand" href={home} aria-label="Agentivity">
      <img src="/agentivity-wordmark-navy.svg" alt="Agentivity" width="108" height="30" />
    </a>

    {!minimal && (
      <nav class="sh-links" aria-label={navLabel}>
        <button class:list={['pm-trigger', { 'is-current': productHere }]} type="button" aria-expanded="false" aria-controls="pm-panel">
          {product.label}
          <svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><path d="M2.5 4.5 6 8l3.5-3.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
        </button>
        {solutions && (
          <button class:list={['pm-trigger', { 'is-current': solutionsHere }]} type="button" aria-expanded="false" aria-controls="sm-panel">
            {solutions.label}
            <svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><path d="M2.5 4.5 6 8l3.5-3.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
          </button>
        )}
        {t.nav.links.map((link) => <a href={link.href}>{link.label}</a>)}
      </nav>
    )}

    <div class="sh-actions">
      <slot />
      <a class="sh-github" href={t.site.github_href} target="_blank" rel="noopener noreferrer"><GitHubIcon size={17} /><span class="sh-github-text">{t.site.github}</span></a>
      <a class="ed-btn ed-btn--sm ed-btn--navy" href={cta}>{ctaText}</a>
      {!minimal && (
        <div class="sh-lang" role="group" aria-label="Language">
          <a href={hrefEn} class:list={[{ active: lang === 'en' }]} aria-label="English" hreflang="en">EN</a>
          <a href={hrefFr} class:list={[{ active: lang === 'fr' }]} aria-label="Français" hreflang="fr">FR</a>
        </div>
      )}
      {!minimal && <button class="sh-burger" type="button" aria-label={menuLabel} aria-expanded="false" aria-controls="sh-menu">
        <span></span><span></span><span></span>
      </button>}
    </div>
  </div>

  {!minimal && solutions && (
    <div class="pm-panel sm-panel" id="sm-panel">
      <div class="ed-wrap">
        <div class="sm-grid">
          <div class="sm-depts">
            <p class="pm-col-title">{solutions.by_department}</p>
            <div class="sm-groups">
              {groups.map((group) => (
                <div class="sm-group">
                  <p class="sm-group-title">{group.title}</p>
                  <ul>
                    {group.items.map((item: any) => (
                      <li>
                        {item.href
                          ? <a class:list={['sm-sol', { 'is-current': isHere(item.href) }]} href={item.href} aria-current={isHere(item.href) ? 'page' : undefined}>{item.label}</a>
                          : <span class="sm-sol sm-sol--soon">{item.label} <span class="sm-soon">{solutions.soon}</span></span>}
                      </li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>
            <a class="sm-all" href={solutions.all.href}>{solutions.all.label} →</a>
          </div>
          <div class="sm-built">
            <p class="sm-built-title">{solutions.built_for.title}</p>
            {solutions.built_for.items.map((item) => (
              <a class:list={['sm-built-item', { 'is-current': isHere(item.href) }]} href={item.href} aria-current={isHere(item.href) ? 'page' : undefined}>
                <span class="sm-built-ico"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons[item.icon]} /></span>
                <span class="pm-txt"><b>{item.label}</b><span>{item.body}</span></span>
              </a>
            ))}
            <p class="sm-company"><b>{solutions.built_for.company.label}</b><span>{solutions.built_for.company.body}</span><span class="sm-soon">{solutions.soon}</span></p>
          </div>
        </div>
      </div>
    </div>
  )}

  {!minimal && (
    <div class="pm-panel" id="pm-panel">
      <div class="ed-wrap">
        <div class="pm-grid">
          <a class="pm-intro" href={product.intro.href}>
            <strong>{product.intro.title}</strong>
            <span>{product.intro.body}</span>
            <span class="pm-intro-link">{product.intro.link} →</span>
          </a>
          {product.groups.map((group) => (
            <div class="pm-col">
              <p class="pm-col-title">{group.title}</p>
              {group.items.map((item) => (
                <a class:list={['pm-item', { 'is-current': isHere(item.href) }]} href={item.href} aria-current={isHere(item.href) ? 'page' : undefined}>
                  <span class="pm-ico"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons[item.icon]} /></span>
                  <span class="pm-txt"><b>{item.label}</b><span>{item.body}</span></span>
                </a>
              ))}
            </div>
          ))}
        </div>
        <div class="pm-foot">
          {product.foot.map((link) => <a href={link.href}>{link.label} →</a>)}
        </div>
      </div>
    </div>
  )}

  <div class="sh-menu" id="sh-menu">
    <nav aria-label={navLabel}>
      <details class="sh-menu-product" open={productHere}>
        <summary>{product.label}</summary>
        <div class="sh-menu-group">
          <a href={product.intro.href}>{product.intro.title}</a>
          {product.groups.map((group) => (
            <>
              <p>{group.title}</p>
              {group.items.map((item) => <a href={item.href}>{item.label}</a>)}
            </>
          ))}
        </div>
      </details>
      {solutions && (
        <details class="sh-menu-product" open={solutionsHere}>
          <summary>{solutions.label}</summary>
          <div class="sh-menu-group">
            {groups.map((group) => (
              <>
                <p>{group.title}</p>
                {group.items.map((item: any) => item.href
                  ? <a href={item.href}>{item.label}</a>
                  : <span class="sh-menu-soon">{item.label} <span class="sm-soon">{solutions.soon}</span></span>)}
              </>
            ))}
            <p>{solutions.built_for.title}</p>
            {solutions.built_for.items.map((item) => <a href={item.href}>{item.label}</a>)}
            <a href={solutions.all.href}>{solutions.all.label}</a>
          </div>
        </details>
      )}
      {t.nav.links.map((link) => <a href={link.href}>{link.label}</a>)}
      <a href={t.site.install_href}>{t.site.install}</a>
      <a href={t.site.github_href} target="_blank" rel="noopener noreferrer">{t.site.github}</a>
    </nav>
    <a class="ed-btn ed-btn--navy sh-menu-cta" href={cta}>{ctaText}</a>
    <div class="sh-lang" role="group" aria-label="Language">
      <a href={hrefEn} class:list={[{ active: lang === 'en' }]} aria-label="English" hreflang="en">EN</a>
      <a href={hrefFr} class:list={[{ active: lang === 'fr' }]} aria-label="Français" hreflang="fr">FR</a>
    </div>
  </div>
</header>

<script>
  const header = document.querySelector('.sh') as HTMLElement | null;
  const burger = header?.querySelector('.sh-burger') as HTMLButtonElement | null;

  if (header && burger) {
    const close = () => { header.classList.remove('is-open'); burger.setAttribute('aria-expanded', 'false'); };
    burger.addEventListener('click', () => {
      const open = header.classList.toggle('is-open');
      burger.setAttribute('aria-expanded', String(open));
    });
    header.querySelectorAll('.sh-menu a').forEach((a) => a.addEventListener('click', close));
    addEventListener('keydown', (e) => { if (e.key === 'Escape') close(); });
  }

  // Solutions and Product menus: one open at a time; each opens on click, and on hover with a mouse; closes on Escape, on a
  // click outside, or when the focus leaves it.
  const triggers = Array.from(header?.querySelectorAll('.pm-trigger') ?? []) as HTMLButtonElement[];
  if (header && triggers.length) {
    const hover = matchMedia('(hover: hover)');
    let timer: ReturnType<typeof setTimeout> | undefined;
    let current: HTMLButtonElement | null = null;
    const set = (trigger: HTMLButtonElement | null) => {
      triggers.forEach((t) => {
        const open = t === trigger;
        t.setAttribute('aria-expanded', String(open));
        document.getElementById(t.getAttribute('aria-controls')!)?.classList.toggle('is-open', open);
      });
      header.classList.toggle('pm-open', Boolean(trigger));
      current = trigger;
    };
    triggers.forEach((trigger) => {
      const panel = document.getElementById(trigger.getAttribute('aria-controls')!);
      if (!panel) return;
      trigger.addEventListener('click', () => set(current === trigger ? null : trigger));
      [trigger, panel].forEach((el) => {
        el.addEventListener('mouseenter', () => { if (!hover.matches) return; clearTimeout(timer); set(trigger); });
        el.addEventListener('mouseleave', () => { if (!hover.matches) return; timer = setTimeout(() => set(null), 180); });
      });
      panel.addEventListener('focusout', (e) => { if (!header.contains(e.relatedTarget as Node)) set(null); });
    });
    addEventListener('keydown', (e) => { if (e.key === 'Escape' && current) { const t = current; set(null); t.focus(); } });
    addEventListener('click', (e) => { if (!header.contains(e.target as Node)) set(null); });
  }
</script>

<style>
.sh {
  position: sticky; top: 0; z-index: 80;
  background: rgba(255, 255, 255, .92); backdrop-filter: blur(12px);
  border-bottom: 1px solid var(--ed-line);
}
.sh-inner { display: flex; align-items: center; gap: 28px; min-height: 78px; }
.sh-brand { display: flex; align-items: center; flex: none; }
.sh-brand img { height: 30px; width: auto; display: block; }

.sh-links { display: flex; align-items: center; gap: 24px; font-size: 15.5px; font-weight: 500; color: var(--ed-ink-2); }
.sh-links a { white-space: nowrap; transition: color .15s ease; }
.sh-links a:hover { color: var(--ed-ink); }

/* Product menu */
.pm-trigger { display: inline-flex; align-items: center; gap: 6px; min-height: 44px; padding: 0; background: none; border: 0; font: inherit; color: inherit; cursor: pointer; white-space: nowrap; transition: color .15s ease; }
.pm-trigger:hover, .pm-trigger.is-current, .pm-trigger[aria-expanded="true"] { color: var(--ed-ink); }
.pm-trigger svg { transition: transform .2s ease; }
.pm-trigger[aria-expanded="true"] svg { transform: rotate(180deg); }
.pm-panel {
  position: absolute; left: 0; right: 0; top: 100%;
  background: #fff; border-bottom: 1px solid var(--ed-line); box-shadow: 0 30px 50px -34px rgba(16, 26, 46, .45);
  opacity: 0; visibility: hidden; transform: translateY(-6px); transition: opacity .16s ease, transform .16s ease, visibility .16s;
}
.pm-panel.is-open { opacity: 1; visibility: visible; transform: none; }
/* Solutions menu: the groups by department, and the "Built for" column */
.sm-grid { display: grid; grid-template-columns: minmax(0, 1fr) 300px; gap: 12px 36px; padding-block: 26px 24px; }
.sm-groups { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 18px 24px; padding: 0 12px; }
.sm-group-title { font-size: 15px; font-weight: 700; color: var(--ed-ink); padding-bottom: 6px; border-bottom: 1px solid var(--ed-line); margin-bottom: 4px; }
.sm-sol { display: block; padding: 5px 0; font-size: 14.5px; line-height: 1.35; color: var(--ed-ink-2); }
.sm-group ul { list-style: none; margin: 0; padding: 0; }
a.sm-sol { font-weight: 600; color: var(--ed-ink); }
a.sm-sol:hover, a.sm-sol.is-current { color: var(--ed-ink); text-decoration: underline; text-underline-offset: 3px; }
.sm-sol--soon { color: var(--ed-ink-3); }
.sm-soon { display: inline-block; margin-left: 4px; padding: 1px 7px; border-radius: 999px; background: var(--ed-mist); font-size: 10.5px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; color: var(--ed-ink-3); vertical-align: 1px; }
.sm-all { display: inline-block; margin: 16px 12px 0; font-size: 15px; font-weight: 600; color: var(--ed-ink-2); }
.sm-all:hover { color: var(--ed-ink); }
.sm-built { display: flex; flex-direction: column; gap: 4px; padding: 18px; border-radius: 18px; background: var(--ed-navy); color: var(--ed-on-navy); }
.sm-built-title { font-size: 12.5px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: var(--ed-yellow); padding: 2px 8px 8px; }
.sm-built-item { display: flex; gap: 12px; padding: 10px 8px; border-radius: 12px; transition: background .12s ease; }
.sm-built-item:hover, .sm-built-item.is-current { background: rgba(255, 255, 255, .08); }
.sm-built-ico { flex: none; width: 34px; height: 34px; border-radius: 10px; display: grid; place-items: center; background: rgba(255, 255, 255, .1); color: #fff; }
.sm-built .pm-txt b { color: #fff; }
.sm-built .pm-txt span { color: var(--ed-on-navy); }
.sm-company { display: flex; flex-direction: column; align-items: flex-start; gap: 2px; margin-top: 6px; padding: 12px 8px 4px; border-top: 1px solid var(--ed-navy-line); font-size: 14px; line-height: 1.4; }
.sm-company b { font-size: 16px; color: #fff; }
.sm-company .sm-soon { margin: 6px 0 0; background: rgba(255, 255, 255, .12); color: var(--ed-yellow); }
.pm-grid { display: grid; grid-template-columns: 290px repeat(3, minmax(0, 1fr)); gap: 12px 32px; padding-block: 28px 24px; }
.pm-intro { display: flex; flex-direction: column; gap: 10px; padding: 24px 24px 22px; border-radius: 18px; background: var(--ed-navy); color: var(--ed-on-navy); font-size: 15.5px; line-height: 1.5; }
.pm-intro strong { font-family: var(--ed-serif); font-weight: 400; font-size: 32px; line-height: 1; color: #fff; }
.pm-intro-link { margin-top: auto; padding-top: 8px; color: var(--ed-yellow); font-weight: 700; }
.pm-intro:hover .pm-intro-link { text-decoration: underline; text-underline-offset: 3px; }
.pm-col-title { font-size: 12.5px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: var(--ed-ink-3); padding: 4px 12px 8px; }
.pm-item { display: flex; gap: 12px; padding: 11px 12px; border-radius: 12px; transition: background .12s ease; }
.pm-item:hover, .pm-item.is-current { background: var(--ed-mist); }
.pm-ico { flex: none; width: 36px; height: 36px; border-radius: 10px; display: grid; place-items: center; background: var(--ed-mist); color: var(--ed-navy); }
.pm-item:hover .pm-ico, .pm-item.is-current .pm-ico { background: #fff; }
.pm-txt { display: flex; flex-direction: column; gap: 2px; white-space: normal; }
.pm-txt b { font-size: 16px; font-weight: 700; color: var(--ed-ink); }
.pm-txt span { font-size: 14px; line-height: 1.4; color: var(--ed-ink-3); }
.pm-foot { display: flex; flex-wrap: wrap; gap: 10px 28px; padding-block: 16px 20px; border-top: 1px solid var(--ed-line); font-size: 15px; font-weight: 600; }
.pm-foot a { color: var(--ed-ink-2); }
.pm-foot a:hover { color: var(--ed-ink); }

/* Product menu, inside the phone menu */
.sh-menu-product { border-bottom: 1px solid var(--ed-line); }
.sh-menu-product summary { list-style: none; display: flex; align-items: center; justify-content: space-between; padding: 14px 0; font-size: 17px; font-weight: 500; color: var(--ed-ink); cursor: pointer; }
.sh-menu-product summary::-webkit-details-marker { display: none; }
.sh-menu-product summary::after { content: "+"; font-family: var(--ed-serif); font-size: 28px; line-height: 1; }
.sh-menu-product[open] summary::after { content: "–"; }
.sh-menu-group { padding-bottom: 10px; }
.sh-menu-group p { padding: 10px 0 2px; font-size: 12px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: var(--ed-ink-3); }
.sh-menu .sh-menu-group a { padding: 8px 0 8px 14px; font-size: 16px; border-bottom: 0; }
.sh-menu-soon { display: block; padding: 8px 0 8px 14px; font-size: 16px; color: var(--ed-ink-3); }

.sh-actions { display: flex; align-items: center; gap: 20px; margin-left: auto; }
.sh-github {
  display: inline-flex; align-items: center; gap: 8px; min-height: 44px; padding: 0 16px; border-radius: 999px;
  border: 1.5px solid var(--ed-line-2); font-size: 15.5px; font-weight: 600; white-space: nowrap;
  transition: border-color .15s ease;
}
.sh-github:hover { border-color: var(--ed-ink); }
/* The French labels are longer: with seven links the GitHub button keeps its icon only (its name stays readable by screen readers). */
.sh--long .sh-links { gap: 21px; }
.sh--long .sh-github { width: 44px; padding: 0; justify-content: center; }
.sh--long .sh-github-text { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }

.sh-lang { display: flex; gap: 2px; padding: 3px; border-radius: 8px; background: var(--ed-mist); flex: none; }
.sh-lang a {
  font-size: 12px; font-weight: 700; letter-spacing: .06em; color: var(--ed-ink-3);
  padding: 5px 9px; border-radius: 6px;
}
.sh-lang a:hover { color: var(--ed-ink); }
.sh-lang a.active { background: #fff; color: var(--ed-ink); box-shadow: 0 1px 2px rgba(16, 26, 46, .14); }

.sh-burger {
  display: none; flex-direction: column; justify-content: center; gap: 5px;
  width: 44px; height: 44px; padding: 0 11px; margin-right: -11px;
  background: none; border: 0; cursor: pointer; flex: none;
}
.sh-burger span { display: block; width: 22px; height: 2px; border-radius: 2px; background: var(--ed-ink); transition: transform .2s, opacity .2s; }
.sh.is-open .sh-burger span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
.sh.is-open .sh-burger span:nth-child(2) { opacity: 0; }
.sh.is-open .sh-burger span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

.sh-menu {
  display: none; position: absolute; top: 100%; left: 0; right: 0;
  background: #fff; border-bottom: 1px solid var(--ed-line);
  padding: 6px var(--ed-pad) 22px; box-shadow: 0 24px 40px -28px rgba(16, 26, 46, .45);
}
.sh.is-open .sh-menu { display: block; }
.sh-menu nav a {
  display: block; padding: 14px 0; font-size: 17px; font-weight: 500; color: var(--ed-ink);
  border-bottom: 1px solid var(--ed-line);
}
.sh-menu-cta { display: none; margin-top: 20px; width: 100%; }
.sh-menu .sh-lang { margin-top: 18px; width: max-content; }

