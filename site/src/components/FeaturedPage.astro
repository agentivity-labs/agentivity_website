---
// The directories and lists that feature Agentivity, shared by /featured and /fr/featured. Texts come from the
// "featured_page" block of the translation files; the badges come from src/data/featured.ts and are rendered as given.
import Base from '../layouts/Base.astro';
import SiteHeader from './SiteHeader.astro';
import SiteFooter from './SiteFooter.astro';
import { featuredBadges } from '../data/featured';
import type { Lang } from '../i18n/utils';
import { useTranslations } from '../i18n/utils';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = useTranslations(lang);
const p = t.featured_page;
---
<!-- Not for search (a list of badges), but the links stay followed: the directories check their link. -->
<Base title={p.meta.title} description={p.meta.description} lang={lang} look="editorial" noindex="follow">

<SiteHeader lang={lang} />

<main class="ed-page">

  <section class="ed-wrap fe-hero">
    <h1>{p.hero.h1}</h1>
    <p class="fe-hero-sub">{p.hero.sub}</p>
  </section>

  <section class="ed-wrap fe-sec">
    <ul class="fe-grid">
      {featuredBadges.map((badge) => (
        <li aria-label={badge.name} set:html={badge.html} />
      ))}
    </ul>
  </section>

</main>

<SiteFooter lang={lang} />

</Base>

<style>
.fe-hero { display: flex; flex-direction: column; align-items: center; gap: 20px; text-align: center; padding-block: clamp(56px, 8vw, 104px) clamp(32px, 4vw, 48px); }
.fe-hero h1 { font-family: var(--ed-serif); font-size: clamp(46px, 7.4vw, 112px); line-height: .98; letter-spacing: -.02em; text-wrap: balance; }
.fe-hero-sub { font-size: clamp(18px, 1.6vw, 21px); line-height: 1.5; color: var(--ed-ink-2); max-width: 34em; }

.fe-sec { padding-block: 0 clamp(64px, 8vw, 112px); }
.fe-grid { display: grid; grid-template-columns: repeat(auto-fit, min(260px, 100%)); justify-content: center; gap: 20px; max-width: 1040px; margin-inline: auto; }
.fe-grid li { display: flex; align-items: center; justify-content: center; min-height: 112px; padding: 24px; border: 1px solid var(--ed-line-2); border-radius: 20px; background: #fff; }
.fe-grid li :global(img) { display: block; max-width: 100%; height: auto; }
</style>
