---
// A team drawn as the Studio draws it, and played in a loop (home, "Build it without code" > Teams, 2026-11-19): the
// manager's hexagon on top, its specialists below in their coloured groups, joined by the Studio's square lines. A
// request comes in; the manager decides as it goes which specialists the trip needs, in no set order, and may go back
// to one: the line to each turns yellow, the specialist lights, and the brief it was given shows underneath. Then the
// answer goes back to the traveller. Every pass is different. Same dark canvas as the Automations card, the Studio's own. Two drawings: wide,
// and tall for a phone. Stands still, fully lit, when the visitor asks for less motion. Texts: en.json
// (home_v3.build.views[].diagram, kind "team").
interface Props { d: any }
const { d } = Astro.props;

const ICON: Record<string, string> = {
  manager: 'M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z',
  flight: 'M21 16v-2l-8-5V3.5c0-.83-.67-1.5-1.5-1.5S10 2.67 10 3.5V9l-8 5v2l8-2.5V19l-2 1.5V22l3.5-1 3.5 1v-1.5L13 19v-5.5l8 2.5z',
  hotel: 'M7 13c1.66 0 3-1.34 3-3S8.66 7 7 7s-3 1.34-3 3 1.34 3 3 3zm12-6h-8v7H3V5H1v15h2v-3h18v3h2v-9c0-2.21-1.79-4-4-4z',
  restaurant: 'M11 9H9V2H7v7H5V2H3v7c0 2.12 1.66 3.84 3.75 3.97V22h2.5v-9.03C11.34 12.84 13 11.12 13 9V2h-2v7zm5-3v8h2.5v8H21V2c-2.76 0-5 2.24-5 4z',
  transport: 'M4 16c0 .88.39 1.67 1 2.22V20c0 .55.45 1 1 1h1c.55 0 1-.45 1-1v-1h8v1c0 .55.45 1 1 1h1c.55 0 1-.45 1-1v-1.78c.61-.55 1-1.34 1-2.22V6c0-3.5-3.58-4-8-4s-8 .5-8 4v10zm3.5 1c-.83 0-1.5-.67-1.5-1.5S6.67 14 7.5 14s1.5.67 1.5 1.5S8.33 17 7.5 17zm9 0c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5zm1.5-6H6V6h12v5z',
  activity: 'M20.5 3l-.16.03L15 5.1 9 3 3.36 4.9c-.21.07-.36.25-.36.48V20.5c0 .28.22.5.5.5l.16-.03L9 18.9l6 2.1 5.64-1.9c.21-.07.36-.25.36-.48V3.5c0-.28-.22-.5-.5-.5zM15 19l-6-2.11V5l6 2.11V19z',
  visa: 'M19 3h-4.18C14.4 1.84 13.3 1 12 1c-1.3 0-2.4.84-2.82 2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-7 0c.55 0 1 .45 1 1s-.45 1-1 1-1-.45-1-1 .45-1 1-1zm0 4c1.66 0 3 1.34 3 3s-1.34 3-3 3-3-1.34-3-3 1.34-3 3-3zm6 12H6v-1.4c0-2 4-3.1 6-3.1s6 1.1 6 3.1V19z',
  budget: 'M11.8 10.9c-2.27-.59-3-1.2-3-2.15 0-1.09 1.01-1.85 2.7-1.85 1.78 0 2.44.85 2.5 2.1h2.21c-.07-1.72-1.12-3.3-3.21-3.81V3h-3v2.16c-1.94.42-3.5 1.68-3.5 3.61 0 2.31 1.91 3.46 4.7 4.13 2.5.6 3 1.48 3 2.41 0 .69-.49 1.79-2.7 1.79-2.06 0-2.87-.92-2.98-2.1h-2.2c.12 2.19 1.76 3.42 3.68 3.83V21h3v-2.15c1.95-.37 3.5-1.5 3.5-3.55 0-2.84-2.43-3.81-4.7-4.4z',
};
const hex = (x: number, y: number, r: number) =>
  [[0, -r], [.866 * r, -.5 * r], [.866 * r, .5 * r], [0, r], [-.866 * r, .5 * r], [-.866 * r, -.5 * r]].map(([a, b]) => `${x + a},${y + b}`).join(' ');

const groups: any[] = d.groups;
const members: any[] = groups.flatMap((g: any, gi: number) => g.members.map((m: any) => ({ ...m, group: gi })));

// Wide: the manager in the middle on top, the groups side by side below.
const W = { mx: 600, my: 130, mr: 56, bus: 290, my2: 450, r: 44, step: 130, apart: 50 };
const wideX: number[] = [];
{
  let x = 600 - (members.length * W.step + (groups.length - 1) * W.apart) / 2 + W.step / 2;
  groups.forEach((g: any) => { g.members.forEach(() => { wideX.push(x); x += W.step; }); x += W.apart; });
}
const wideGroupRect = groups.map((g: any, gi: number) => {
  const xs = members.map((m, i) => (m.group === gi ? wideX[i] : null)).filter((v) => v !== null) as number[];
  return { x: xs[0] - 65, w: xs[xs.length - 1] - xs[0] + 130 };
});
const widePath = (x: number) => {
  const s = x < W.mx ? -1 : 1, top = W.my2 - W.r;
  return `M${W.mx} ${W.my + W.mr} L${W.mx} ${W.bus - 12} Q${W.mx} ${W.bus} ${W.mx + 12 * s} ${W.bus} L${x - 12 * s} ${W.bus} Q${x} ${W.bus} ${x} ${W.bus + 12} L${x} ${top}`;
};

// Tall: the manager top left, a line down the left, each specialist on its own row, its name on the right.
const T = { mx: 80, my: 82, mr: 46, r: 36, x: 190 };
const tallY: number[] = [];
const tallGroupRect: { y: number; h: number }[] = [];
{
  let y = 190;
  groups.forEach((g: any) => {
    const top = y;
    y += 84;
    g.members.forEach(() => { tallY.push(y); y += 100; });
    tallGroupRect.push({ y: top, h: y - top - 36 });
    y += 4;
  });
}
const tallH = tallY[tallY.length - 1] + 330;
const tallPath = (y: number) => `M${T.mx} ${T.my + T.mr} L${T.mx} ${y - 12} Q${T.mx} ${y} ${T.mx + 12} ${y} L${T.x - .866 * T.r} ${y}`;
const tagW = 52, tagT = 44;
---
<div class="tm" data-tm data-runs={JSON.stringify(d.requests)} data-manager={d.manager.title} role="img" aria-label={d.alt}>
  {[{ kind: 'wide' }, { kind: 'tall' }].map(({ kind }) => {
    const wide = kind === 'wide';
    return (
      <svg class={`tm-svg tm-${kind}`} viewBox={wide ? '30 6 1140 712' : `0 0 600 ${tallH}`} aria-hidden="true">
        <defs>
          <pattern id={`tm-dots-${kind}`} width="24" height="24" patternUnits="userSpaceOnUse"><circle cx="2" cy="2" r="1.4" fill="rgba(255,255,255,.07)" /></pattern>
          <filter id={`tm-glow-${kind}`} x="-50%" y="-50%" width="200%" height="200%"><feGaussianBlur stdDeviation="10" /></filter>
        </defs>
        <rect x="-50" y="-50" width="1300" height={wide ? 850 : tallH + 100} fill={`url(#tm-dots-${kind})`} />

        <g class="tm-tag" data-tag transform={wide ? `translate(${tagW} ${tagT})` : `translate(40 ${tallH - 250})`}>
          <circle cx="10" cy="0" r="6" /><text x="26" y="6"></text>
        </g>

        {groups.map((g: any, gi: number) => wide
          ? <g class={`tm-group tm-g${gi}`}>
              <rect x={wideGroupRect[gi].x} y="352" width={wideGroupRect[gi].w} height="228" rx="14" />
              <text x={wideGroupRect[gi].x + 16} y="376">{g.title}</text>
            </g>
          : <g class={`tm-group tm-g${gi}`}>
              <rect x="130" y={tallGroupRect[gi].y} width="455" height={tallGroupRect[gi].h} rx="14" />
              <text x="148" y={tallGroupRect[gi].y + 28}>{g.title}</text>
            </g>)}

        {members.map((m, i) => <path class="tm-link" d={wide ? widePath(wideX[i]) : tallPath(tallY[i])} />)}
        {members.map((m, i) => <path class="tm-trail" data-link={m.id} d={wide ? widePath(wideX[i]) : tallPath(tallY[i])} />)}

        <g class="tm-manager" data-manager-node>
          <polygon class="tm-halo" points={wide ? hex(W.mx, W.my, W.mr) : hex(T.mx, T.my, T.mr)} filter={`url(#tm-glow-${kind})`} />
          <polygon class="tm-hex" points={wide ? hex(W.mx, W.my, W.mr) : hex(T.mx, T.my, T.mr)} />
          <svg x={(wide ? W.mx : T.mx) - 20} y={(wide ? W.my : T.my) - 20} width="40" height="40" viewBox="0 0 24 24"><path class="tm-icon" d={ICON.manager} /></svg>
          {wide
            ? <><text class="tm-title" x={W.mx + 78} y={W.my - 4}>{d.manager.title}</text><text class="tm-type" x={W.mx + 78} y={W.my + 22}>{d.manager.type}</text></>
            : <><text class="tm-title" x={T.mx + 66} y={T.my - 4}>{d.manager.title}</text><text class="tm-type" x={T.mx + 66} y={T.my + 22}>{d.manager.type}</text></>}
        </g>

        {members.map((m, i) => {
          const x = wide ? wideX[i] : T.x, y = wide ? W.my2 : tallY[i], r = wide ? W.r : T.r;
          return (
            <g class={`tm-member tm-g${m.group}`} data-member={m.id}>
              <polygon class="tm-halo" points={hex(x, y, r)} filter={`url(#tm-glow-${kind})`} />
              <polygon class="tm-hex" points={hex(x, y, r)} />
              <svg x={x - r * .42} y={y - r * .42} width={r * .84} height={r * .84} viewBox="0 0 24 24"><path class="tm-icon" d={ICON[m.icon]} /></svg>
              {wide
                ? m.lines.map((line: string, j: number) => <text class="tm-name" x={x} y={y + r + 30 + j * 22} text-anchor="middle">{line}</text>)
                : <text class="tm-name" x={x + r + 20} y={y + 7}>{m.lines.join(' ')}</text>}
            </g>
          );
        })}

        <g class="tm-brief" data-brief transform={wide ? 'translate(115 606)' : `translate(30 ${tallH - 216})`}>
          <rect width={wide ? 970 : 540} height={wide ? 104 : 180} rx="16" />
          <path class="tm-brief-head" d={wide ? 'M0 16 a16 16 0 0 1 16 -16 h938 a16 16 0 0 1 16 16 v28 h-970 z' : 'M0 16 a16 16 0 0 1 16 -16 h508 a16 16 0 0 1 16 16 v32 h-540 z'} />
          <text class="tm-brief-title" x="22" y={wide ? 28 : 31}></text>
          <text class="tm-brief-text" x="22" y={wide ? 80 : 92}></text>
          {!wide && <text class="tm-brief-text" data-line2 x="22" y="126"></text>}
        </g>

        <g class="tm-token" data-token>
          <circle class="tm-token-glow" r="16" filter={`url(#tm-glow-${kind})`} /><circle r="7.5" />
        </g>
      </svg>
    );
  })}
</div>

<style>
.tm { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; background: #151A23; }
.tm-svg { display: block; width: 100%; height: 100%; font-family: var(--ed-sans); }
.tm-tall { display: none; }
@media (max-width: 640px) { .tm-wide { display: none; } .tm-tall { display: block; } }

/* The Studio's group colours, dimmed for the dark canvas. */
.tm-g0 { --g: #2DD4BF; }
.tm-g1 { --g: #F5B445; }
.tm-g2 { --g: #A78BFA; }
.tm-group rect { fill: color-mix(in srgb, var(--g) 7%, transparent); stroke: color-mix(in srgb, var(--g) 28%, transparent); stroke-width: 1.5; }
.tm-group text { font-size: 13px; font-weight: 700; letter-spacing: .1em; fill: color-mix(in srgb, var(--g) 80%, transparent); }
.tm-tall .tm-group text { font-size: 15px; }

.tm-link { fill: none; stroke: rgba(255, 255, 255, .16); stroke-width: 2; }
.tm-trail { fill: none; stroke: var(--ed-yellow); stroke-width: 3; stroke-linecap: round; opacity: 0; transition: opacity .5s ease; }
.tm-trail.is-on { opacity: 1; }

.tm-hex { stroke-linejoin: round; stroke-width: 2.5; transition: fill .4s ease, stroke .4s ease; }
.tm-halo { fill: var(--ed-yellow); opacity: 0; transition: opacity .4s ease; }
.tm-manager .tm-hex { fill: #0B0F15; stroke: rgba(255, 255, 255, .35); }
.tm-manager .tm-icon { fill: rgba(255, 255, 255, .8); transition: fill .4s ease; }
.tm-manager.is-on .tm-hex { fill: #fff; stroke: #fff; }
.tm-manager.is-on .tm-icon { fill: var(--ed-navy); }
.tm-manager.is-on .tm-halo { opacity: .22; }
.tm-title { font-size: 21px; font-weight: 700; fill: #fff; }
.tm-type { font-family: ui-monospace, 'SFMono-Regular', Menlo, Consolas, monospace; font-size: 15px; fill: rgba(255, 255, 255, .5); }
.tm-tall .tm-title { font-size: 25px; }
.tm-tall .tm-type { font-size: 18px; }

.tm-member { opacity: .55; transition: opacity .4s ease; }
.tm-member .tm-hex { fill: #1F2530; stroke: color-mix(in srgb, var(--g) 70%, transparent); }
.tm-member .tm-icon { fill: var(--g); transition: fill .4s ease; }
.tm-name { font-size: 16px; font-weight: 600; fill: rgba(255, 255, 255, .8); }
.tm-tall .tm-name { font-size: 22px; }
.tm-member.is-on { opacity: 1; }
.tm-member.is-on .tm-hex { fill: var(--ed-yellow); stroke: var(--ed-yellow); }
.tm-member.is-on .tm-icon { fill: var(--ed-navy); }
.tm-member.is-on .tm-halo { opacity: .3; }
.tm-member.is-on .tm-name { fill: #fff; }

.tm-brief rect { fill: rgba(255, 255, 255, .06); stroke: rgba(255, 255, 255, .22); stroke-width: 1.5; }
.tm-brief-head { fill: rgba(255, 255, 255, .1); }
.tm-brief-title { font-family: ui-monospace, 'SFMono-Regular', Menlo, Consolas, monospace; font-size: 15px; letter-spacing: .06em; fill: #fff; }
.tm-brief-text { font-size: 21px; fill: rgba(255, 255, 255, .92); }
.tm-tall .tm-brief-title { font-size: 17px; }
.tm-tall .tm-brief-text { font-size: 23px; }
.tm-brief text { transition: opacity .3s ease; }
.tm-brief.is-swapping text { opacity: 0; }

.tm-tag { opacity: 0; transition: opacity .4s ease; }
.tm-tag.is-on { opacity: 1; }
.tm-tag circle { fill: var(--ed-yellow); }
.tm-tag text { font-family: ui-monospace, 'SFMono-Regular', Menlo, Consolas, monospace; font-size: 17px; fill: rgba(255, 255, 255, .85); }
.tm-tall .tm-tag text { font-size: 19px; }
.tm-token { opacity: 0; }
.tm-token circle { fill: var(--ed-yellow); }
.tm-token-glow { opacity: .55; }
</style>

<script>
  type Follow = { after: string; to: string; brief: string };
  type Run = { request: string; briefs: Record<string, string>; follow?: Follow[]; answer: { to: string; text: string } };
  const MOVE = 750, HOLD = 1400, REST = 2200;
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  document.querySelectorAll<HTMLElement>('[data-tm]').forEach((root) => {
    const runs: Run[] = JSON.parse(root.dataset.runs || '[]');
    const manager = root.dataset.manager || '';
    let visible = false, running = false;

    const svgNow = () => [...root.querySelectorAll<SVGSVGElement>('.tm-svg')].find((s) => s.getBoundingClientRect().width > 0);
    const wait = (ms: number) => new Promise((r) => setTimeout(r, ms));
    const until = async () => { while (!visible) await wait(300); };
    const nameOf = (svg: SVGSVGElement, id: string) =>
      [...svg.querySelectorAll(`[data-member="${id}"] .tm-name`)].map((t) => t.textContent).join(' ');

    // The brief under the team: who hands what to whom. On a phone, a long line goes on two.
    async function brief(svg: SVGSVGElement, title: string, text: string) {
      const box = svg.querySelector<SVGGElement>('[data-brief]')!;
      box.classList.add('is-swapping');
      await wait(250);
      box.querySelector('.tm-brief-title')!.textContent = title.toUpperCase();
      const lines = box.querySelectorAll<SVGTextElement>('.tm-brief-text');
      if (lines.length > 1) {
        const words = text.split(' '), cut = Math.ceil(words.length / 2);
        let a = words.slice(0, cut).join(' '), b = words.slice(cut).join(' ');
        if (text.length <= 34) { a = text; b = ''; }
        lines[0].textContent = a; lines[1].textContent = b;
      } else lines[0].textContent = text;
      box.classList.remove('is-swapping');
    }
    function travel(svg: SVGSVGElement, link: SVGPathElement, back = false) {
      const token = svg.querySelector<SVGGElement>('[data-token]')!;
      const len = link.getTotalLength();
      if (!back) { link.classList.add('is-on'); link.style.strokeDasharray = `${len}`; link.style.strokeDashoffset = `${len}`; }
      token.style.opacity = '1';
      return new Promise<void>((done) => {
        const t0 = performance.now();
        const step = (now: number) => {
          const k = Math.min(1, (now - t0) / MOVE), e = k < .5 ? 2 * k * k : 1 - Math.pow(-2 * k + 2, 2) / 2;
          const at = back ? len * (1 - e) : len * e;
          const pt = link.getPointAtLength(at);
          token.setAttribute('transform', `translate(${pt.x} ${pt.y})`);
          if (!back) link.style.strokeDashoffset = `${len * (1 - e)}`;
          if (k < 1) requestAnimationFrame(step); else { token.style.opacity = '0'; done(); }
        };
        requestAnimationFrame(step);
      });
    }

    // No set order: the manager decides as it goes. Each pass picks the request, which specialists it needs and in
    // which order, and sometimes goes back to one of them when another changes the picture (a budget too tight).
    const shuffle = <T,>(xs: T[]) => xs.map((x) => [Math.random(), x] as const).sort((a, b) => a[0] - b[0]).map(([, x]) => x);
    function plan(run: Run) {
      const ids = Object.keys(run.briefs);
      const n = Math.min(ids.length, 3 + Math.floor(Math.random() * 3));
      const calls = shuffle(ids).slice(0, n).map((to) => ({ to, brief: run.briefs[to] }));
      for (const f of run.follow ?? []) {
        const at = calls.findIndex((c) => c.to === f.after), before = calls.findIndex((c) => c.to === f.to);
        if (at >= 0 && before >= 0 && before < at) calls.splice(at + 1, 0, { to: f.to, brief: f.brief });
      }
      return calls;
    }

    async function loop() {
      if (running) return;
      running = true;
      let last = -1;
      for (;;) {
        await until();
        const svg = svgNow();
        if (!svg) { await wait(500); continue; }
        let i = Math.floor(Math.random() * runs.length);
        if (runs.length > 1 && i === last) i = (i + 1) % runs.length;
        last = i;
        const run = runs[i];
        svg.querySelectorAll('.is-on').forEach((el) => el.classList.remove('is-on'));
        const tag = svg.querySelector<SVGGElement>('[data-tag]')!;
        tag.querySelector('text')!.textContent = run.request;
        tag.classList.add('is-on');
        svg.querySelector('[data-manager-node]')!.classList.add('is-on');
        await brief(svg, `${run.answer.to} → ${manager}`, run.request.replace(/[“”"«»]/g, '').trim());
        await wait(HOLD);
        for (const s of plan(run)) {
          const link = svg.querySelector<SVGPathElement>(`[data-link="${s.to}"]`)!;
          const member = svg.querySelector(`[data-member="${s.to}"]`)!;
          await wait(250 + Math.random() * 700);
          await brief(svg, `${manager} → ${nameOf(svg, s.to)}`, s.brief);
          await travel(svg, link);
          member.classList.add('is-on');
          await wait(HOLD * (.7 + Math.random() * .6));
          await travel(svg, link, true);
          member.classList.remove('is-on');
          link.classList.remove('is-on');
        }
        await brief(svg, `${manager} → ${run.answer.to}`, run.answer.text);
        await wait(REST);
      }
    }

    if (reduce) {
      root.querySelectorAll('.tm-member, .tm-manager, .tm-tag').forEach((el) => el.classList.add('is-on'));
      root.querySelectorAll('[data-tag] text').forEach((t) => { t.textContent = runs[0]?.request ?? ''; });
      root.querySelectorAll('.tm-brief-title').forEach((t) => { t.textContent = `${manager} → ${runs[0]?.answer.to ?? ''}`.toUpperCase(); });
      root.querySelectorAll('.tm-brief-text:not([data-line2])').forEach((t) => { t.textContent = runs[0]?.answer.text ?? ''; });
      return;
    }
    new IntersectionObserver(([entry]) => { visible = entry.isIntersecting; if (visible) loop(); }, { threshold: .25 }).observe(root);
  });
</script>
