---
// Our climate commitment, shared by /climate and /fr/climate. Texts come from the "climate_page" block of the translation
// files. The page says what we fund (1% of revenue for carbon removal, a first step), what the product already does to
// keep AI work lean, and what we do not claim: no "carbon neutral", no figure we cannot back.
import Base from '../layouts/Base.astro';
import SiteHeader from './SiteHeader.astro';
import SiteFooter from './SiteFooter.astro';
import type { Lang } from '../i18n/utils';
import { useTranslations } from '../i18n/utils';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = useTranslations(lang);
const p = t.climate_page;
---
<Base title={p.meta.title} description={p.meta.description} lang={lang} look="editorial">

<SiteHeader lang={lang} />

<main class="ed-page">

  <!-- The commitment -->
  <section class="ed-wrap cl-hero">
    <p class="ed-eyebrow">{p.hero.eyebrow}</p>
    <h1>{p.hero.h1} <em class="ed-mark">{p.hero.h1_accent}</em></h1>
    <p class="cl-hero-sub">{p.hero.sub}</p>
  </section>

  <!-- What the product already does -->
  <section class="ed-band--mist" id="already">
    <div class="ed-wrap ed-sec">
      <header class="ed-sec-head">
        <p class="ed-eyebrow">{p.already.eyebrow}</p>
        <h2 class="ed-h2">{p.already.h2} <em>{p.already.h2_accent}</em></h2>
      </header>
      <ul class="cl-cards">
        {p.already.items.map((item) => (
          <li>
            <strong>{item.title}</strong>
            <span>{item.body}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- What we do not claim -->
  <section class="ed-band--navy" id="claim">
    <div class="ed-wrap ed-sec">
      <header class="ed-sec-head">
        <p class="ed-eyebrow cl-on-navy">{p.claim.eyebrow}</p>
        <h2 class="ed-h2">{p.claim.h2} <em>{p.claim.h2_accent}</em></h2>
      </header>
      <ul class="cl-band">
        {p.claim.points.map((point) => (
          <li>
            <strong>{point.title}</strong>
            <span>{point.body}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- The practical guide -->
  <section class="ed-wrap ed-sec" id="guide">
    <a class="cl-guide" href={p.guide.href}>
      <span class="ed-eyebrow">{p.guide.eyebrow}</span>
      <strong>{p.guide.title}</strong>
      <span class="cl-guide-body">{p.guide.body}</span>
      <span class="cl-guide-link">{p.guide.link} →</span>
    </a>
  </section>

  <!-- Final call -->
  <section class="ed-band--yellow">
    <div class="ed-wrap ed-final">
      <h2>{p.cta.h2} <em>{p.cta.h2_accent}</em></h2>
      <div class="cl-actions">
        <a class="ed-btn ed-btn--navy" href={p.cta.primary_href}>{p.cta.primary}</a>
        <a class="ed-btn ed-btn--line" href={t.site.install_href}>{p.cta.secondary}</a>
      </div>
    </div>
  </section>

</main>

<SiteFooter lang={lang} />

</Base>

<style>
.cl-hero { display: flex; flex-direction: column; align-items: center; gap: 24px; text-align: center; padding-block: clamp(56px, 8vw, 104px) clamp(56px, 7vw, 96px); }
.cl-hero h1 { font-family: var(--ed-serif); font-size: clamp(46px, 7.4vw, 112px); line-height: .98; letter-spacing: -.02em; text-wrap: balance; }
.cl-hero h1 em { display: block; }
.cl-hero-sub { font-size: clamp(18px, 1.6vw, 21px); line-height: 1.5; color: var(--ed-ink-2); max-width: 34em; }

.cl-cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(250px, 100%), 1fr)); gap: 20px; }
.cl-cards li { display: flex; flex-direction: column; gap: 8px; padding: 24px; border: 1px solid var(--ed-line-2); border-radius: 20px; background: #fff; }
.cl-cards strong { font-size: 19px; line-height: 1.25; color: var(--ed-ink); }
.cl-cards span { color: var(--ed-ink-2); }

.cl-on-navy { color: var(--ed-yellow); }
.cl-band { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(260px, 100%), 1fr)); gap: 20px; }
.cl-band li { display: flex; flex-direction: column; gap: 8px; padding: 22px 22px 24px; border: 1px solid var(--ed-navy-line); border-radius: 20px; background: var(--ed-navy-2); color: var(--ed-on-navy-2); }
.cl-band strong { font-size: 19px; line-height: 1.25; color: #fff; }
.cl-band span { font-size: 16.5px; line-height: 1.5; }

.cl-guide { display: flex; flex-direction: column; gap: 12px; max-width: 820px; padding: clamp(24px, 3vw, 36px); border: 1px solid var(--ed-line-2); border-radius: 24px; transition: border-color .15s ease, transform .15s ease; }
.cl-guide:hover { border-color: var(--ed-ink); transform: translateY(-2px); }
.cl-guide strong { font-family: var(--ed-serif); font-weight: 400; font-size: clamp(30px, 3.2vw, 42px); line-height: 1.05; color: var(--ed-ink); }
.cl-guide-body { color: var(--ed-ink-2); font-size: 17.5px; }
.cl-guide-link { align-self: flex-start; font-weight: 700; border-bottom: 1.5px solid currentColor; }

.cl-actions { display: flex; flex-wrap: wrap; gap: 14px 16px; justify-content: center; }
</style>
