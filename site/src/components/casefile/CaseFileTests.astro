---
// What was tested and what came out, then what the solution is not.
interface Props {
  tests: { title: string; lead?: string; items: { case: string; result: string }[]; limits_title?: string; limits: string[] };
}
const { tests } = Astro.props;
---
<section class="ed-band--mist">
  <div class="ed-wrap ed-sec">
    <header class="ed-sec-head">
      <h2 class="ed-h2 ed-h2--md">{tests.title}</h2>
      {tests.lead && <p class="ed-sec-sub">{tests.lead}</p>}
    </header>
    <ol class="ts-list">
      {tests.items.map((item) => (
        <li>
          <p class="ts-case">{item.case}</p>
          <p class="ts-result"><strong>Passed</strong> {item.result}</p>
        </li>
      ))}
    </ol>
    {tests.limits.length > 0 && (
      <div class="ts-limits">
        {tests.limits_title && <h3>{tests.limits_title}</h3>}
        <ul>{tests.limits.map((limit) => <li>{limit}</li>)}</ul>
      </div>
    )}
  </div>
</section>

<style>
.ts-list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
.ts-list li { display: flex; flex-direction: column; gap: 14px; padding: 24px; border-radius: 22px; background: #fff; }
.ts-case { font-family: var(--ed-serif); font-size: clamp(22px, 2vw, 26px); line-height: 1.2; color: var(--ed-ink); }
.ts-result { font-size: 16.5px; line-height: 1.5; color: var(--ed-ink-2); }
.ts-result strong { display: block; margin-bottom: 4px; font-size: 12.5px; letter-spacing: .06em; text-transform: uppercase; color: #1F6B4A; }
.ts-limits { display: flex; flex-direction: column; gap: 12px; margin-top: clamp(32px, 4vw, 48px); }
.ts-limits h3 { font-size: 13px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; color: var(--ed-ink-3); }
.ts-limits ul { display: flex; flex-wrap: wrap; gap: 10px; }
.ts-limits li { padding: 8px 16px; border-radius: 999px; border: 1.5px solid var(--ed-line-2); background: #fff; font-size: 15.5px; color: var(--ed-ink-2); }
@media (max-width: 860px) { .ts-list { grid-template-columns: minmax(0, 1fr); } }
</style>
