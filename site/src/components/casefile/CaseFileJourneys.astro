---
// The kinds of step (modes) and the decisions that follow, the home screen by moment, and the journey map: one lane per journey,
// its steps left to right as cards tinted by their mode, each with the screen it happens on, and what was tested.
type Titled = { title: string; lead?: string };
interface Props {
  journeys: Titled & { items: { name: string; when: string; steps: { mode: string; text: string; screen?: string }[]; tested?: string }[] };
  modes?: Titled & { items: { label: string; meaning: string; ink: string; tint: string }[]; decisions_title?: string; decisions: { title: string; text: string; mode?: string }[] };
  moments?: Titled & { cards_title?: string; cards: { title: string; text: string }[]; head: [string, string]; rows: [string, string][] };
  screens?: { id: string; name: string }[];
}
const { journeys, modes, moments, screens = [] } = Astro.props;
const colour = new Map((modes?.items ?? []).map((mode) => [mode.label, `--jm-ink: ${mode.ink}; --jm-tint: ${mode.tint}`]));
const screenName = new Map(screens.map((screen) => [screen.id, screen.name]));
---
{modes && (
  <section class="ed-band--mist">
    <div class="ed-wrap ed-sec jm">
      <header class="ed-sec-head">
        <h2 class="ed-h2 ed-h2--md">{modes.title}</h2>
        {modes.lead && <p class="ed-sec-sub">{modes.lead}</p>}
      </header>
      <ul class="jm-modes">
        {modes.items.map((mode) => (
          <li style={colour.get(mode.label)}><strong>{mode.label}</strong><span>{mode.meaning}</span></li>
        ))}
      </ul>
      {modes.decisions_title && modes.decisions.length > 0 && <h3 class="jm-decisions-title">{modes.decisions_title}</h3>}
      {modes.decisions.length > 0 && (
        <dl class="jm-decisions">
          {modes.decisions.map((decision) => (
            <div style={decision.mode ? colour.get(decision.mode) : undefined}>
              {decision.mode && <span class="jm-decision-mode">{decision.mode}</span>}
              <dt>{decision.title}</dt>
              <dd>{decision.text}</dd>
            </div>
          ))}
        </dl>
      )}
      {moments && (
        <div class="jm-moments">
          <h3>{moments.title}</h3>
          {moments.lead && <p>{moments.lead}</p>}
          {moments.cards.length > 0 && (
            <>
              {moments.cards_title && <h4>{moments.cards_title}</h4>}
              <ul class="jm-cards">{moments.cards.map((card) => <li><strong>{card.title}</strong><span>{card.text}</span></li>)}</ul>
            </>
          )}
          <table>
            <thead><tr><th scope="col">{moments.head[0]}</th><th scope="col">{moments.head[1]}</th></tr></thead>
            <tbody>{moments.rows.map(([moment, leads]) => <tr><th scope="row">{moment}</th><td>{leads}</td></tr>)}</tbody>
          </table>
        </div>
      )}
    </div>
  </section>
)}

<section class="ed-wrap ed-sec">
  <header class="ed-sec-head">
    <h2 class="ed-h2 ed-h2--md">{journeys.title}</h2>
    {journeys.lead && <p class="ed-sec-sub">{journeys.lead}</p>}
  </header>
  {modes && (
    <p class="jm-key">{modes.items.map((mode) => <span class="jm-chip" style={colour.get(mode.label)}>{mode.label}</span>)}</p>
  )}
  <ol class="jm-lanes">
    {journeys.items.map((journey, i) => (
      <li class="jm-lane">
        <header class="jm-lane-head">
          <h3><span>{i + 1}.</span> {journey.name}</h3>
          <p class="jm-when">{journey.when}</p>
        </header>
        <ol class="jm-flow">
          {journey.steps.map((step) => (
            <li style={colour.get(step.mode)}>
              <b>{step.mode}</b>
              <span>{step.text}</span>
              {step.screen && screenName.has(step.screen) && <small>{screenName.get(step.screen)}</small>}
            </li>
          ))}
        </ol>
        {journey.tested && <p class="jm-tested"><strong>Tested</strong> {journey.tested}</p>}
      </li>
    ))}
  </ol>
</section>

<style>
.jm-chip { flex: none; align-self: flex-start; padding: 3px 10px; border-radius: 999px; background: var(--jm-tint, var(--ed-mist)); color: var(--jm-ink, var(--ed-ink)); font-size: 12.5px; font-weight: 700; letter-spacing: .04em; text-transform: uppercase; }
.jm-modes { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
.jm-modes li { display: flex; flex-direction: column; gap: 6px; padding: 20px 22px; border-radius: 22px; background: var(--jm-tint, #fff); font-size: 16px; line-height: 1.5; color: var(--ed-ink-2); }
.jm-modes strong { font-size: 18px; color: var(--jm-ink, var(--ed-ink)); }
.jm-decisions-title { margin-top: 32px; font-size: 13px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; color: var(--ed-ink-3); }
.jm-decisions { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 10px; margin-top: 12px; }
.jm-decisions div { display: flex; flex-direction: column; gap: 4px; padding: 14px 16px; border-radius: 16px; background: var(--jm-tint, #fff); }
.jm-decision-mode { font-size: 11px; font-weight: 700; letter-spacing: .05em; text-transform: uppercase; color: var(--jm-ink, var(--ed-ink-3)); }
.jm-decisions dt { font-size: 16px; font-weight: 700; color: var(--ed-ink); }
.jm-decisions dd { font-size: 14.5px; line-height: 1.45; color: var(--ed-ink-2); }
@media (max-width: 960px) { .jm-decisions { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
@media (max-width: 480px) { .jm-decisions { grid-template-columns: minmax(0, 1fr); } }
.jm-moments { display: flex; flex-direction: column; gap: 10px; margin-top: clamp(40px, 5vw, 64px); }
.jm-moments h3 { font-family: var(--ed-serif); font-weight: 400; font-size: clamp(28px, 2.6vw, 36px); line-height: 1.05; color: var(--ed-ink); }
.jm-moments h4 { margin-top: 10px; font-size: 13px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; color: var(--ed-ink-3); }
.jm-moments > p { font-size: 17px; color: var(--ed-ink-2); }
.jm-cards { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px; max-width: 860px; }
@media (max-width: 720px) { .jm-cards { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
@media (max-width: 440px) { .jm-cards { grid-template-columns: minmax(0, 1fr); } }
.jm-cards li { display: flex; flex-direction: column; gap: 4px; padding: 16px; border-radius: 16px; background: #fff; font-size: 15px; line-height: 1.45; color: var(--ed-ink-2); }
.jm-cards strong { font-size: 16px; color: var(--ed-ink); }
.jm-moments table { width: 100%; max-width: 860px; margin-top: 8px; border-collapse: collapse; font-size: 16px; }
.jm-moments th, .jm-moments td { padding: 12px 14px; border-bottom: 1px solid var(--ed-line-2); text-align: left; vertical-align: top; }
.jm-moments thead th { font-size: 12.5px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; color: var(--ed-ink-3); border-bottom: 2px solid var(--ed-ink); }
.jm-moments tbody th { font-weight: 700; color: var(--ed-ink); width: 38%; }
.jm-moments td { color: var(--ed-ink-2); }

.jm-key { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 16px; }
.jm-key .jm-chip { background: var(--jm-ink, var(--ed-ink)); color: #fff; }
.jm-lanes { display: flex; flex-direction: column; gap: 14px; }
.jm-lane { display: flex; flex-direction: column; gap: 12px; padding: 18px 20px; border-radius: 18px; border: 1px solid var(--ed-line-2); background: #fff; }
.jm-lane-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 4px 16px; }
.jm-lane-head h3 { font-size: 18px; font-weight: 700; line-height: 1.3; color: var(--ed-navy); }
.jm-lane-head h3 span { color: var(--ed-ink-3); }
.jm-when { font-size: 14px; color: var(--ed-ink-3); }
.jm-flow { display: flex; flex-wrap: wrap; gap: 6px; align-items: stretch; }
.jm-flow li { flex: 1 1 150px; min-width: 140px; display: flex; flex-direction: column; gap: 3px; padding: 10px 12px; border-radius: 13px; background: var(--jm-tint, var(--ed-mist)); font-size: 14.5px; line-height: 1.35; color: var(--ed-ink); }
.jm-flow b { font-size: 11px; font-weight: 700; letter-spacing: .05em; text-transform: uppercase; color: var(--jm-ink, var(--ed-ink)); }
.jm-flow small { margin-top: auto; padding-top: 4px; font-size: 12px; color: var(--ed-ink-3); }
.jm-tested { font-size: 14.5px; line-height: 1.5; color: var(--ed-ink-2); }
.jm-tested strong { margin-right: 6px; font-size: 12px; letter-spacing: .06em; text-transform: uppercase; color: #1F6B4A; }
@media (max-width: 860px) { .jm-modes { grid-template-columns: minmax(0, 1fr); } }
/* On a phone a lane stacks its steps, one under the other, joined by a thin line. */
@media (max-width: 600px) {
  .jm-flow { flex-direction: column; gap: 14px; }
  .jm-flow li { flex: none; min-width: 0; position: relative; }
  .jm-flow li + li::before { content: ""; position: absolute; left: 22px; top: -14px; width: 2px; height: 14px; background: var(--ed-line-2); }
}
@media (max-width: 520px) { .jm-moments tbody th { width: auto; } }
</style>
