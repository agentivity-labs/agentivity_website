---
// Desk by Agentivity (/desk), for the leader who does not build. English only (KB-0147). Texts come from the "desk_page"
// block of en.json (v6). The page says at once why the Desk exists, lists the six gains, then the problem, the answer, what a
// colleague does, each gain in detail beside a real screen of the Desk, the plans and the questions. No price, seat number
// or tier on this page: the seats link to /pricing.
import Base from '../layouts/Base.astro';
import SiteHeader from './SiteHeader.astro';
import SiteFooter from './SiteFooter.astro';
import TrialNote from './TrialNote.astro';
import { useTranslations } from '../i18n/utils';

const t = useTranslations('en');
const d = t.desk_page as any;
const g = d.gains;
const n2 = (i: number) => String(i).padStart(2, '0');

// The FAQ links to the contact address and to the seats; the schema gets the same answers as plain text.
const email = 'hello@agentivity.io';
const fill = (text: string, values: Record<string, string>) =>
  Object.entries(values).reduce((s, [k, v]) => s.split('{' + k + '}').join(v), text);
const escape = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
const answerHtml = (text: string) => fill(escape(text), {
  email: `<a href="mailto:${email}">${email}</a>`,
  seats_link: `<a href="${d.seats.href}">${escape(d.seats.link)} →</a>`,
});
const answerText = (text: string) => fill(text, { email, seats_link: d.seats.link + ': ' + new URL(d.seats.href, Astro.site).href });

const pageUrl = new URL('/desk/', Astro.site).href;
const schema = [
  { '@context': 'https://schema.org', '@type': 'WebPage', name: d.meta.title, description: d.meta.description, url: pageUrl },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: d.faq.items.map((item: any) => ({ '@type': 'Question', name: item.q, acceptedAnswer: { '@type': 'Answer', text: answerText(item.a) } })),
  },
];

// The first three gains share one shape: text beside a screen, the sides alternating.
const shots = [['time', g.time], ['best', g.best], ['flow', g.flow]];
---
<Base title={d.meta.title} description={d.meta.description} lang="en" schema={schema} alternates={false} look="editorial">

<SiteHeader lang="en" ctaHref={d.trial.href} />

<main class="desk ed-page">

  <!-- 1. What it is, and why -->
  <section class="ed-wrap desk-hero">
    <div class="desk-hero-copy">
      <div>
        <p class="ed-eyebrow">{d.hero.eyebrow}</p>
        <h1>{d.hero.h1}</h1>
      </div>
      <div class="desk-hero-side">
        <p class="desk-hero-sub">{d.hero.sub}</p>
        <p class="desk-kicker">{d.hero.kicker}</p>
        <div class="desk-act">
          <a class="ed-btn ed-btn--navy" href={d.trial.href}>{d.trial.label}</a>
          <TrialNote lang="en" />
          <a class="ed-link desk-small-link" href={d.hero.article_href}>{d.hero.article} →</a>
        </div>
      </div>
    </div>
    <figure class="desk-shot">
      <img src="/media/desk/desk-hero.webp" width="2400" height="1030" alt={d.hero.image_alt} fetchpriority="high" />
      <figcaption>{d.hero.caption}</figcaption>
    </figure>
  </section>

  <!-- 2. The six gains at a glance, each a link to its detail -->
  <section class="ed-band--navy">
    <div class="ed-wrap ed-sec">
      <header class="ed-sec-head">
        <p class="ed-eyebrow desk-on-navy">{d.overview.eyebrow}</p>
        <h2 class="ed-h2 ed-h2--md desk-white">{d.overview.h2}</h2>
      </header>
      <ol class="desk-six">
        {d.overview.items.map((item: any, i: number) => (
          <li><a href={item.href}>
            <span class="desk-six-n">{n2(i + 1)}</span>
            <strong>{item.title}</strong>
            <span>{item.body}</span>
            <span class="desk-six-go" aria-hidden="true">→</span>
          </a></li>
        ))}
      </ol>
    </div>
  </section>

  <!-- 3. The problem -->
  <section class="ed-band--mist">
    <div class="ed-wrap ed-sec">
      <header class="ed-sec-head">
        <p class="ed-eyebrow">{d.problem.eyebrow}</p>
        <h2 class="ed-h2 ed-h2--md">{d.problem.h2}</h2>
      </header>
      <div class="desk-problem-body">
        {d.problem.body.map((para: string) => <p>{para}</p>)}
      </div>
      <ul class="desk-cards">
        {d.problem.cards.map((card: any) => <li><strong>{card.title}</strong><span>{card.body}</span></li>)}
      </ul>
      <p class="desk-line">{d.problem.line}</p>
    </div>
  </section>

  <!-- 4. The answer: one Desk -->
  <section class="ed-wrap ed-sec">
    <header class="ed-sec-head">
      <p class="ed-eyebrow">{d.answer.eyebrow}</p>
      <h2 class="ed-h2 ed-h2--md">{d.answer.h2}</h2>
      <p class="ed-sec-sub">{d.answer.body}</p>
    </header>
    <table class="desk-versus">
      <thead>
        <tr><th scope="col">{d.answer.columns[0]}</th><th scope="col" class="desk-versus-us">{d.answer.columns[1]}</th></tr>
      </thead>
      <tbody>
        {d.answer.rows.map(([personal, desk]: string[]) => (
          <tr><td>{personal}</td><td class="desk-versus-us">{desk}</td></tr>
        ))}
      </tbody>
    </table>
  </section>

  <!-- 5. What a colleague does on it -->
  <section class="ed-band--mist" id="people">
    <div class="ed-wrap ed-sec">
      <header class="ed-sec-head">
        <p class="ed-eyebrow">{d.people.eyebrow}</p>
        <h2 class="ed-h2 ed-h2--md">{d.people.h2}</h2>
        <p class="ed-sec-sub">{d.people.body}</p>
      </header>
      <div class="desk-people">
        <ol class="desk-steps">
          {d.people.steps.map((step: any, i: number) => (
            <li><span class="desk-step-n">{i + 1}</span><div><strong>{step.title}</strong><span>{step.body}</span></div></li>
          ))}
        </ol>
        <figure class="ed-shot">
          <div class="ed-shot-frame ed-shot-frame--lift">
            <img src="/media/home/home-desk-result.png" width="1600" height="1342" alt={d.people.result_alt} loading="lazy" />
          </div>
          <figcaption>{d.people.result_caption}</figcaption>
        </figure>
      </div>
      <p class="desk-line">{d.people.line}</p>
    </div>
  </section>

  <!-- 6. The six gains in detail: text beside a real screen of the Desk -->
  <section class="ed-wrap ed-sec" id="gains">
    <header class="ed-sec-head">
      <p class="ed-eyebrow">{g.eyebrow}</p>
      <h2 class="ed-h2 ed-h2--md">{g.h2}</h2>
    </header>

    {shots.map(([id, gain]: any, i: number) => (
      <article class={'desk-row' + (i % 2 ? ' desk-row--flip' : '')} id={id}>
        <div class="desk-row-text">
          <span class="desk-gain-n">{n2(i + 1)}</span>
          <h3>{gain.h3}</h3>
          {gain.body.map((para: string) => <p>{para}</p>)}
        </div>
        <figure class="desk-shot">
          <img src={gain.image} width={gain.width} height={gain.height} alt={gain.image_alt} loading="lazy" />
          <figcaption>{gain.caption}</figcaption>
        </figure>
      </article>
    ))}

    <article class="desk-row desk-row--flip" id="spend">
      <div class="desk-row-text">
        <span class="desk-gain-n">04</span>
        <h3>{g.spend.h3}</h3>
        {g.spend.body.map((para: string) => <p>{para}</p>)}
        <div class="desk-bill">
          <h4>{g.spend.bill.h3}</h4>
          <p>{g.spend.bill.body}</p>
          <p class="desk-bill-line">{g.spend.bill.line}</p>
          <ul class="desk-figures">
            {g.spend.bill.figures.map(([who, range]: string[]) => <li><span>{who}</span><strong>{range}</strong></li>)}
          </ul>
          <p class="desk-small">{g.spend.bill.small}</p>
          <a class="ed-link" href={g.spend.bill.href}>{g.spend.bill.link} →</a>
        </div>
      </div>
      <figure class="desk-shot desk-shot--chart">
        <picture>
          <source media="(max-width: 640px)" srcset="/media/blog/desk/token-savings-ranges-narrow.svg" width="480" height="600" />
          <img src="/media/blog/desk/token-savings-ranges.svg" width="960" height="560" alt={g.spend.bill.chart_alt} loading="lazy" />
        </picture>
        <figcaption>{g.spend.bill.chart_caption}</figcaption>
      </figure>
    </article>

    <article class="desk-row" id="teams">
      <div class="desk-row-text">
        <span class="desk-gain-n">05</span>
        <h3>{g.teams.h3}</h3>
        {g.teams.body.map((para: string) => <p>{para}</p>)}
      </div>
      <figure class="desk-shot">
        <img src={g.teams.image} width={g.teams.width} height={g.teams.height} alt={g.teams.image_alt} loading="lazy" />
        <figcaption>{g.teams.caption}</figcaption>
      </figure>
    </article>

    <article class="desk-control" id="control">
      <div class="desk-row-text">
        <span class="desk-gain-n">06</span>
        <h3>{g.control.h3}</h3>
        {g.control.body.map((para: string) => <p>{para}</p>)}
      </div>
      <ul class="desk-access">
        {g.control.items.map((item: any) => <li><strong>{item.title}</strong> <span>{item.body}</span></li>)}
      </ul>
      <figure class="desk-access-shot">
        <img src="/media/desk/desk-governance.webp" width="1820" height="340" alt={g.control.image_alt} loading="lazy" />
      </figure>
    </article>
  </section>

  <!-- 7. Who it is for, and on which plans -->
  <section class="ed-band--mist">
    <div class="ed-wrap ed-sec">
      <header class="ed-sec-head desk-seats">
        <p class="ed-eyebrow">{d.seats.eyebrow}</p>
        <h2 class="ed-h2 ed-h2--md">{d.seats.h2}</h2>
        <p class="ed-sec-sub">{d.seats.body}</p>
        <a class="ed-link" href={d.seats.href}>{d.seats.link} →</a>
      </header>
    </div>
  </section>

  <!-- 8. Questions -->
  <section class="ed-wrap ed-sec">
    <header class="ed-sec-head">
      <h2 class="ed-h2 ed-h2--md">{d.faq.h2}</h2>
    </header>
    <div class="desk-faq">
      {d.faq.items.map((item: any) => (
        <details>
          <summary>{item.q}</summary>
          <p set:html={answerHtml(item.a)} />
        </details>
      ))}
    </div>
    <a class="ed-link desk-docs" href={d.faq.docs_href}>{d.faq.docs} →</a>
  </section>

  <!-- 9. The last call -->
  <section class="ed-band--navy">
    <div class="ed-wrap ed-final desk-final">
      <h2>{d.final.h2}</h2>
      <p class="ed-final-sub">{d.final.sub}</p>
      <a class="ed-btn ed-btn--yellow" href={d.trial.href}>{d.trial.label}</a>
      <TrialNote lang="en" class="desk-final-note" />
    </div>
  </section>

</main>

<SiteFooter lang="en" />

</Base>

<style>
.desk-hero { display: flex; flex-direction: column; gap: clamp(36px, 4.5vw, 56px); padding-block: clamp(40px, 5vw, 72px) clamp(56px, 7vw, 96px); }
.desk-hero-copy { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, .9fr); gap: 20px clamp(32px, 4.5vw, 72px); align-items: end; }
.desk-hero h1 { margin-top: 12px; font-family: var(--ed-serif); font-size: clamp(44px, 5.4vw, 80px); line-height: .98; letter-spacing: -.02em; text-wrap: balance; }
.desk-hero-side { display: flex; flex-direction: column; gap: 18px; }
.desk-hero-sub { font-size: clamp(17px, 1.5vw, 20px); line-height: 1.5; color: var(--ed-ink-2); }
.desk-kicker { font-family: var(--ed-serif); font-size: clamp(22px, 2vw, 27px); line-height: 1.15; color: var(--ed-ink); padding-left: 14px; border-left: 3px solid var(--ed-yellow); }
.desk-act { display: flex; flex-direction: column; align-items: flex-start; gap: 10px; margin-top: 4px; }
.desk-small-link { font-size: 15.5px; }
.ed-shot img { display: block; width: 100%; height: auto; }

/* A screen of the Desk, composed on its own navy ground; the chart is drawn bare. */
.desk-shot img { display: block; width: 100%; height: auto; border-radius: 20px; box-shadow: 0 30px 64px -30px rgba(21, 40, 68, .5); }
.desk-shot figcaption { margin-top: 12px; font-size: 14.5px; line-height: 1.45; color: var(--ed-ink-3); }
.desk-shot--chart img { border-radius: 0; box-shadow: none; }

/* The six gains at a glance: numbered tiles on navy, each a link to its detail. */
.desk-white { color: #fff; }
.desk-on-navy { color: var(--ed-yellow); }
.desk-six { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px; }
.desk-six a { position: relative; display: flex; flex-direction: column; gap: 8px; height: 100%; padding: 24px 26px 26px; border-radius: 20px; background: var(--ed-navy-2); border: 1px solid var(--ed-navy-line); color: var(--ed-on-navy); font-size: 16px; line-height: 1.5; text-decoration: none; transition: background .2s, border-color .2s, transform .2s; }
.desk-six a:hover { background: #22406B; border-color: var(--ed-yellow); transform: translateY(-2px); }
.desk-six-n { font-family: var(--ed-serif); font-size: 44px; line-height: 1; color: var(--ed-yellow); }
.desk-six strong { font-family: var(--ed-serif); font-weight: 400; font-size: clamp(25px, 2.2vw, 30px); line-height: 1.08; color: #fff; }
.desk-six-go { position: absolute; top: 24px; right: 24px; font-size: 20px; color: var(--ed-on-navy-2); transition: color .2s, transform .2s; }
.desk-six a:hover .desk-six-go { color: var(--ed-yellow); transform: translateX(3px); }

.desk-problem-body { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px 40px; font-size: 18px; line-height: 1.6; color: var(--ed-ink-2); }
.desk-cards { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; margin-top: 32px; }
.desk-cards li { display: flex; flex-direction: column; gap: 8px; padding: 22px; border-radius: 18px; background: #fff; border: 1px solid var(--ed-line); font-size: 16px; line-height: 1.5; color: var(--ed-ink-2); }
.desk-cards strong { font-family: var(--ed-serif); font-weight: 400; font-size: 28px; line-height: 1.05; color: var(--ed-ink); }
.desk-line { margin-top: 28px; font-size: 18px; line-height: 1.55; color: var(--ed-ink-2); max-width: 46em; }

/* The contrast: two columns, the Desk's one lit in navy. */
.desk-versus { width: 100%; max-width: 1040px; border-collapse: separate; border-spacing: 0; font-size: clamp(16.5px, 1.4vw, 19px); }
.desk-versus th, .desk-versus td { width: 50%; text-align: left; padding: 17px 22px; border-top: 1px solid var(--ed-line); color: var(--ed-ink-3); }
.desk-versus thead th { border-top: 0; font-size: 14px; font-weight: 600; letter-spacing: .04em; text-transform: uppercase; }
.desk-versus .desk-versus-us { color: #fff; font-weight: 600; background: var(--ed-navy); border-top-color: var(--ed-navy-line); }
.desk-versus thead .desk-versus-us { color: var(--ed-yellow); border-radius: 18px 18px 0 0; }
.desk-versus tbody tr:last-child .desk-versus-us { border-radius: 0 0 18px 18px; }
@media (max-width: 640px) {
  .desk-versus th, .desk-versus td { padding: 14px 12px; font-size: 15.5px; }
  .desk-versus thead th { font-size: 12.5px; }
}

.desk-people { display: grid; grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr); gap: clamp(28px, 4vw, 64px); align-items: center; }
.desk-steps { display: flex; flex-direction: column; gap: 22px; }
.desk-steps li { display: grid; grid-template-columns: 30px minmax(0, 1fr); gap: 14px; font-size: 16px; line-height: 1.5; color: var(--ed-ink-2); }
.desk-steps li div { display: flex; flex-direction: column; gap: 4px; }
.desk-steps strong { font-size: 18px; color: var(--ed-ink); }
.desk-step-n { display: grid; place-items: center; width: 30px; height: 30px; border-radius: 999px; background: var(--ed-navy); color: #fff; font-size: 13.5px; font-weight: 700; }

/* The gains in detail: text beside a screen, alternating sides. */
#people, #gains, #time, #best, #flow, #spend, #teams, #control { scroll-margin-top: 72px; }
.desk-row { display: grid; grid-template-columns: minmax(0, .85fr) minmax(0, 1.15fr); gap: clamp(28px, 4.5vw, 72px); align-items: center; padding-block: clamp(36px, 4.5vw, 64px); border-top: 1px solid var(--ed-line); }
.desk-row--flip .desk-row-text { order: 2; }
.desk-row-text { display: flex; flex-direction: column; gap: 12px; font-size: 17px; line-height: 1.6; color: var(--ed-ink-2); }
.desk-gain-n { font-family: var(--ed-serif); font-size: 40px; line-height: 1; color: var(--ed-ink-3); }
.desk-row h3, .desk-control h3 { font-family: var(--ed-serif); font-weight: 400; font-size: clamp(30px, 3vw, 42px); line-height: 1.04; letter-spacing: -.01em; color: var(--ed-ink); text-wrap: balance; }
.desk-bill { display: flex; flex-direction: column; gap: 10px; align-items: flex-start; margin-top: 10px; padding: 22px; border-radius: 18px; background: var(--ed-mist); font-size: 16px; }
.desk-bill h4 { font-size: 18px; color: var(--ed-ink); }
.desk-bill-line { font-weight: 600; color: var(--ed-ink); }
.desk-figures { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; width: 100%; }
.desk-figures li { display: flex; flex-direction: column; gap: 2px; padding: 12px 14px; border-radius: 12px; background: #fff; font-size: 14px; color: var(--ed-ink-3); }
.desk-figures strong { font-family: var(--ed-serif); font-weight: 400; font-size: 28px; line-height: 1.05; color: var(--ed-ink); }
.desk-small { font-size: 14px; line-height: 1.5; color: var(--ed-ink-3); }

.desk-control { display: grid; grid-template-columns: minmax(0, .85fr) minmax(0, 1.15fr); gap: 12px clamp(28px, 4.5vw, 72px); padding-top: clamp(36px, 4.5vw, 64px); border-top: 1px solid var(--ed-line); }
.desk-access { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 32px; align-content: start; }
.desk-access li { padding-block: 14px; border-top: 1px solid var(--ed-line-2); font-size: 16px; line-height: 1.5; color: var(--ed-ink-2); }
.desk-access strong { font-weight: 700; color: var(--ed-ink); }
.desk-access-shot { grid-column: 1 / -1; margin-top: 20px; padding: clamp(10px, 1.6vw, 18px); border-radius: 16px; background: var(--ed-mist); }
.desk-access-shot img { display: block; width: 100%; height: auto; }

.desk-seats { margin-bottom: 0; }
.desk-seats .ed-link { align-self: flex-start; }

.desk-faq { display: flex; flex-direction: column; max-width: 860px; }
.desk-faq details { border-top: 1px solid var(--ed-line-2); }
.desk-faq details:last-child { border-bottom: 1px solid var(--ed-line-2); }
.desk-faq summary { cursor: pointer; padding-block: 20px; font-size: 19px; font-weight: 700; list-style: none; display: flex; justify-content: space-between; gap: 20px; }
.desk-faq summary::-webkit-details-marker { display: none; }
.desk-faq summary::after { content: '+'; font-weight: 400; font-size: 24px; line-height: 1; }
.desk-faq details[open] summary::after { content: '–'; }
.desk-faq details p { padding-bottom: 22px; color: var(--ed-ink-2); max-width: 46em; }
.desk-faq details p :global(a) { color: var(--ed-ink); text-decoration: underline; }
.desk-docs { margin-top: 28px; }

.desk-final h2 { color: #fff; }
.desk-final .ed-final-sub { color: var(--ed-on-navy); }
.desk-final :global(.desk-final-note) { color: var(--ed-on-navy); }

@media (max-width: 960px) {
  .desk-hero-copy, .desk-problem-body, .desk-cards, .desk-people, .desk-row, .desk-control { grid-template-columns: minmax(0, 1fr); }
  .desk-six { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .desk-row--flip .desk-row-text { order: 0; }
}
@media (max-width: 600px) { .desk-six, .desk-access { grid-template-columns: minmax(0, 1fr); } }
</style>
