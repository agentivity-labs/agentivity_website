---
// Blog index, shared by /blog and /fr/blog. Texts come from the "blog_page" block of the translation files.
// The articles are Markdown files: English in src/content/blog, French in src/content/blog/fr (same file name). The French
// index lists the French version of each article, and the English one while an article is not translated yet.
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import SiteHeader from './SiteHeader.astro';
import SiteFooter from './SiteFooter.astro';
import type { Lang } from '../i18n/utils';
import { useTranslations } from '../i18n/utils';
import { BLOG_TAGS, blogSlug, isLang } from '../lib/blog';

// The first articles to read, whatever their date.
const START_HERE = ['chatbot-agent-team-or-workflow', 'how-ai-agents-work-together', 'what-is-a-vibeapp'];

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = useTranslations(lang);
const p = t.blog_page;

const all = await getCollection('blog', ({ data }) => !data.draft);
type Post = (typeof all)[number];
const translated = (post: Post) => all.find((other) => isLang(other, lang) && blogSlug(other.id) === blogSlug(post.id));
const posts = all
  .filter((post) => isLang(post, 'en'))
  .map((post) => (lang === 'en' ? post : translated(post) ?? post))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const href = (post: Post) => (isLang(post, 'fr') ? '/fr/blog/' : '/blog/') + blogSlug(post.id);
const thumb = (post: Post) => post.data.thumb ?? post.data.image ?? '/og-default.png';
const startHere = START_HERE.map((slug) => posts.find((post) => blogSlug(post.id) === slug)).filter((post) => post !== undefined);
const topics = BLOG_TAGS.filter((tag) => posts.some((post) => post.data.tags.includes(tag)));
// "The articles are in English for now" only while some still are.
const showLangNote = lang !== 'en' && posts.some((post) => !isLang(post, lang));
const formatDate = (date: Date) => date.toLocaleDateString(lang === 'fr' ? 'fr-FR' : 'en-US', { year: 'numeric', month: 'long', day: 'numeric' });

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: 'Agentivity Blog',
  description: p.meta.description,
  url: 'https://www.agentivity.io' + (lang === 'fr' ? '/fr/blog' : '/blog'),
};
---
<Base title={p.meta.title} description={p.meta.description} lang={lang} schema={schema} look="editorial">

<SiteHeader lang={lang} />

<main class="ed-page">

  <section class="ed-wrap bl-hero">
    <p class="ed-eyebrow">{p.hero.eyebrow}</p>
    <h1>{p.hero.h1} <em class="ed-mark">{p.hero.h1_accent}</em></h1>
    <p class="bl-hero-sub">{p.hero.sub}</p>
    {showLangNote && p.lang_note && <p class="bl-lang-note">{p.lang_note}</p>}
  </section>

  {startHere.length > 0 && (
    <section class="ed-wrap bl-start" data-blog-start>
      <h2>{p.start_here}</h2>
      <ul>
        {startHere.map((post) => (
          <li>
            <a href={href(post)}>
              <img src={thumb(post)} alt="" width="800" height="500" loading="lazy" decoding="async" />
              <strong>{post.data.title}</strong>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  <section class="ed-wrap bl-list">
    {posts.length === 0 ? (
      <p class="bl-empty">{p.empty}</p>
    ) : (
      <>
        <div class="bl-tools">
          <div class="bl-filter" role="group" aria-label={p.filter_label} data-blog-filter hidden>
            <button type="button" aria-pressed="true" data-tag="">{p.all_topics}</button>
            {topics.map((tag) => <button type="button" aria-pressed="false" data-tag={tag}>{p.tags[tag]}</button>)}
          </div>
          <a class="bl-rss" href="/rss.xml">{p.rss}</a>
        </div>
        <ul class="bl-posts">
          {posts.map((post) => (
            <li data-tags={post.data.tags.join(' ')}>
              <a class="bl-post" href={href(post)}>
                <div class="bl-post-text">
                  <p class="bl-post-meta">
                    <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
                    {post.data.tags.map((tag) => <span class="bl-tag">{p.tags[tag]}</span>)}
                  </p>
                  <h2>{post.data.title}</h2>
                  <p class="bl-post-desc">{post.data.description}</p>
                  <span class="bl-post-more">{p.read}</span>
                </div>
                <img class="bl-thumb" src={thumb(post)} alt="" width="800" height="500" loading="lazy" decoding="async" />
              </a>
            </li>
          ))}
        </ul>
      </>
    )}
  </section>

</main>

<SiteFooter lang={lang} />

</Base>

<script>
  // The filter shows the articles of one topic, and keeps it in the address: an article's topics link here with ?tag=<topic>.
  // Without JavaScript the filter stays hidden and every article is listed.
  const filter = document.querySelector<HTMLElement>('[data-blog-filter]');
  if (filter) {
    const buttons = [...filter.querySelectorAll<HTMLButtonElement>('button')];
    const posts = [...document.querySelectorAll<HTMLElement>('.bl-posts li')];
    const start = document.querySelector<HTMLElement>('[data-blog-start]');
    const show = (tag: string) => {
      buttons.forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.tag === tag)));
      posts.forEach((post) => { post.hidden = tag !== '' && !(post.dataset.tags ?? '').split(' ').includes(tag); });
      if (start) start.hidden = tag !== '';
    };
    buttons.forEach((button) => button.addEventListener('click', () => {
      const tag = button.dataset.tag ?? '';
      show(tag);
      const url = new URL(location.href);
      if (tag) url.searchParams.set('tag', tag); else url.searchParams.delete('tag');
      history.replaceState(null, '', url);
    }));
    const asked = new URLSearchParams(location.search).get('tag') ?? '';
    show(buttons.some((button) => button.dataset.tag === asked) ? asked : '');
    filter.hidden = false;
  }
</script>

<style>
.bl-hero { display: flex; flex-direction: column; align-items: center; gap: 26px; text-align: center; padding-block: clamp(56px, 8vw, 104px) clamp(40px, 5vw, 64px); }
.bl-hero h1 { font-family: var(--ed-serif); font-size: clamp(46px, 7.4vw, 112px); line-height: .98; letter-spacing: -.02em; text-wrap: balance; }
.bl-hero-sub { font-size: clamp(18px, 1.6vw, 21px); line-height: 1.5; color: var(--ed-ink-2); max-width: 32em; }
.bl-lang-note { padding: 8px 16px; border-radius: 999px; background: var(--ed-mist); font-size: 15px; font-weight: 600; color: var(--ed-ink); }

.bl-start { max-width: 980px; padding-bottom: clamp(40px, 5vw, 64px); }
.bl-start h2 { margin-bottom: 18px; font-size: 12.5px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; color: var(--ed-ink); }
.bl-start ul { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
.bl-start a { display: flex; flex-direction: column; gap: 12px; height: 100%; color: var(--ed-ink); }
.bl-start img { display: block; width: 100%; height: auto; border-radius: 16px; border: 1px solid var(--ed-line-2); background: var(--ed-mist); }
.bl-start strong { font-family: var(--ed-serif); font-weight: 400; font-size: 23px; line-height: 1.12; text-wrap: balance; }
.bl-start a:hover strong { text-decoration: underline; text-decoration-thickness: 1.5px; text-underline-offset: 4px; }

.bl-list { padding-bottom: clamp(72px, 9vw, 120px); }
.bl-empty { text-align: center; font-size: 18px; color: var(--ed-ink-3); }
.bl-tools { display: flex; align-items: flex-start; justify-content: space-between; gap: 16px 24px; max-width: 980px; margin: 0 auto 20px; }
.bl-filter { display: flex; flex-wrap: wrap; gap: 8px; }
.bl-filter[hidden] { display: none; }
.bl-filter button { min-height: 40px; padding: 0 16px; border: 1.5px solid var(--ed-line-2); border-radius: 999px; background: none; color: var(--ed-ink); font: inherit; font-size: 15px; font-weight: 600; cursor: pointer; }
.bl-filter button:hover { border-color: var(--ed-ink); }
.bl-filter button[aria-pressed="true"] { border-color: var(--ed-navy); background: var(--ed-navy); color: #fff; }
.bl-rss { flex: none; margin-left: auto; padding-top: 9px; font-size: 15px; font-weight: 600; color: var(--ed-ink-2); border-bottom: 1.5px solid currentColor; }
.bl-rss:hover { color: var(--ed-ink); }
.bl-posts { max-width: 980px; margin-inline: auto; border-top: 2px solid var(--ed-ink); }
.bl-posts li { border-bottom: 1px solid var(--ed-line-2); }
.bl-posts li[hidden] { display: none; }
.bl-post { display: grid; grid-template-columns: minmax(0, 1fr) clamp(200px, 26vw, 280px); gap: clamp(20px, 3vw, 40px); align-items: start; padding-block: clamp(26px, 3vw, 38px); color: var(--ed-ink-2); }
.bl-post-text { display: flex; flex-direction: column; align-items: flex-start; gap: 12px; min-width: 0; }
.bl-thumb { display: block; width: 100%; height: auto; border-radius: 16px; border: 1px solid var(--ed-line-2); background: var(--ed-mist); }
.bl-post-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 12px; font-size: 14.5px; font-weight: 600; color: var(--ed-ink-3); }
.bl-tag { padding: 3px 10px; border-radius: 999px; background: var(--ed-mist); font-size: 12.5px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; color: var(--ed-ink); }
.bl-post h2 { font-family: var(--ed-serif); font-size: clamp(30px, 3.4vw, 46px); line-height: 1.06; color: var(--ed-ink); text-wrap: balance; }
.bl-post-desc { font-size: 18px; max-width: 46em; }
.bl-post-more { font-size: 16px; font-weight: 700; color: var(--ed-ink); border-bottom: 1.5px solid currentColor; padding-bottom: 2px; }
.bl-post-more::after { content: " →"; }
.bl-post:hover h2 { text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 6px; }

@media (max-width: 720px) {
  .bl-start ul { grid-template-columns: minmax(0, 1fr); }
  .bl-start a { flex-direction: row; align-items: center; }
  .bl-start img { flex: none; width: 112px; border-radius: 12px; }
  .bl-start strong { font-size: 20px; }
  .bl-tools { flex-direction: column; }
  .bl-rss { margin-left: 0; padding-top: 0; }
  .bl-post { grid-template-columns: minmax(0, 1fr); }
  .bl-thumb { order: -1; }
}
</style>
