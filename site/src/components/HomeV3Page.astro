---
// The English home, v3 (Content & CRO, 2026-11-11), on the section list the founder approved: what it is, what it does for me,
// how I build it, how far it goes, is it for me, how much. Texts come from the "home_v3" block of en.json; the pricing block is
// the live home's, unchanged. Message first: the layout uses the editorial components, the design comes later. The product
// images stay large enough to read as product.
import Base from '../layouts/Base.astro';
import SiteHeader from './SiteHeader.astro';
import SiteFooter from './SiteFooter.astro';
import TrialNote from './TrialNote.astro';
import VideoAutoplay from './VideoAutoplay.astro';
import plans from '../data/plans.json';
import { useTranslations } from '../i18n/utils';
import { connections } from '../data/connections';
import { brandLogos } from '../data/brand-logos';

const t = useTranslations('en');
const h = t.home_v3;
const steps = h.ladder.steps;
const company = steps[steps.length - 1];
// The connections strip: the apps, best-known first as connections.ts lists them, then the AI models.
const onHome = connections.filter((item) => item.home);
const apps = onHome.filter((item) => item.group === 'apps');
const models = onHome.filter((item) => item.group === 'models');

const schema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: h.faq.items.map((item) => ({ '@type': 'Question', name: item.q, acceptedAnswer: { '@type': 'Answer', text: item.a } })),
};
---
<Base title={h.meta.title} ogTitle={h.meta.og_title} description={h.meta.description} lang="en" schema={schema} look="editorial">

<SiteHeader lang="en" ctaHref={h.trial.href} />

<main class="h3 ed-page">

  <!-- 1. Hero: the promise, then the product film, full width -->
  <section class="ed-wrap h3-hero" id="top">
    <h1>{h.hero.h1} <em>{h.hero.h1_accent}</em></h1>
    <p class="h3-lead">{h.hero.sub}</p>
    <div class="h3-act h3-act--center">
      <a class="ed-btn ed-btn--navy" href={h.trial.href}>{h.trial.label}</a>
      <p class="trial-note">{h.hero.trial_note.replace('{trial_days}', String(plans.trial.days))}</p>
    </div>
    <figure class="h3-film">
      <!-- The current film from 12.5 s on: it opens on a title card the home no longer uses. -->
      <video id="h3-film" muted loop playsinline autoplay preload="auto" poster="/media/home/hero-film-en-teams.jpg" width="1600" height="900" aria-label={h.hero.video_alt}>
        <source src="/media/home/hero-film-en-teams.mp4" type="video/mp4" />
      </video>
    </figure>
  </section>

  <!-- 2. From one helper to an AI company -->
  <section class="ed-band--mist" id="ladder">
    <div class="ed-wrap ed-sec">
      <header class="ed-sec-head">
        <p class="ed-eyebrow">{h.ladder.eyebrow}</p>
        <h2 class="ed-h2">{h.ladder.title} <em>{h.ladder.title_accent}</em></h2>
        <p class="ed-sec-sub">{h.ladder.sub}</p>
      </header>
      <ol class="h3-steps">
        {steps.slice(0, -1).map((step, i) => (
          <li>
            <figure class="h3-shot">
              <div class="ed-shot-frame"><img src={step.image} alt={step.caption} width={step.width} height={step.height} loading="lazy" /></div>
            </figure>
            <p class="h3-step-tag"><span>{i + 1}</span> {step.tag}</p>
            <h3>{step.title}</h3>
            <p>{step.body}</p>
            <p class="h3-caption">{step.caption}</p>
          </li>
        ))}
      </ol>
      <div class="h3-step-company">
        <div>
          <p class="h3-step-tag"><span>{steps.length}</span> {company.tag}</p>
          <h3>{company.title}</h3>
          <p>{company.body}</p>
        </div>
        <figure class="h3-shot">
          <div class="ed-shot-frame"><img src={company.image} alt={company.caption} width={company.width} height={company.height} loading="lazy" /></div>
          <figcaption>{company.caption}</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <!-- 3. Ready-made solutions -->
  <section class="ed-wrap ed-sec" id="solutions">
    <header class="ed-sec-head">
      <p class="ed-eyebrow">{h.solutions.eyebrow}</p>
      <h2 class="ed-h2 ed-h2--md">{h.solutions.title}</h2>
      <p class="ed-sec-sub">{h.solutions.sub}</p>
    </header>
    <ul class="h3-cards">
      {h.solutions.cards.map((card: any) => (
        <li>
          <a class="h3-card" href={card.href}>
            {card.image && <img src={card.image} alt="" width="1024" height="768" loading="lazy" />}
            <span class="h3-card-text">
              <strong>{card.name}</strong>
              <em>{card.gain}</em>
              <span>{card.body}</span>
              <span class="h3-card-meta">{card.meta}</span>
              <span class="h3-more">{h.solutions.more} →</span>
            </span>
          </a>
        </li>
      ))}
    </ul>
    <div class="h3-under">
      <div class="h3-act">
        <a class="ed-btn ed-btn--navy" href={h.trial.href}>{h.trial.label}</a>
        <TrialNote lang="en" />
      </div>
      <a class="ed-link" href={h.solutions.all.href}>{h.solutions.all.label}</a>
    </div>
  </section>

  <!-- 4. Build it without code: four real views of the product -->
  <section class="ed-band--mist" id="build">
    <div class="ed-wrap ed-sec">
      <header class="ed-sec-head">
        <p class="ed-eyebrow">{h.build.eyebrow}</p>
        <h2 class="ed-h2 ed-h2--md">{h.build.title}</h2>
        <p class="ed-sec-sub">{h.build.sub}</p>
      </header>
      <ul class="h3-views">
        {h.build.views.map((view) => (
          <li>
            <h3>{view.title}</h3>
            <p>{view.body}</p>
            <figure class="h3-shot">
              <div class="ed-shot-frame h3-view-frame">
                <video muted loop playsinline preload="none" poster={view.poster} width={view.width} height={view.height} aria-label={view.caption} data-autoplay>
                  <source src={view.video} type="video/mp4" />
                </video>
              </div>
              <figcaption>{view.caption}</figcaption>
            </figure>
          </li>
        ))}
      </ul>
      <p class="h3-links"><a class="ed-link" href={h.build.link.href}>{h.build.link.label}</a></p>
    </div>
  </section>

  <!-- 5. The whole AI company at work, large, on a dark background -->
  <section class="ed-band--navy h3-observation" id="observation">
    <div class="ed-wrap ed-sec">
      <header class="ed-sec-head">
        <p class="ed-eyebrow">{h.observation.eyebrow}</p>
        <h2 class="ed-h2 ed-h2--md">{h.observation.title}</h2>
        <p class="h3-body">{h.observation.body}</p>
      </header>
      <figure class="h3-shot">
        <div class="ed-shot-frame"><img src="/media/home/northmoor-observation.webp" alt={h.observation.alt} width="1400" height="900" loading="lazy" /></div>
        <figcaption>{h.observation.caption}</figcaption>
      </figure>
      <p class="h3-line">{h.observation.line}</p>
      <p class="h3-links"><a class="ed-link h3-link-navy" href={h.observation.link.href}>{h.observation.link.label}</a></p>
    </div>
  </section>

  <!-- 6. Everyone works with the same AI teams, on one Desk: what the company gains, the real product, then the AI bill -->
  <section class="ed-wrap ed-sec" id="desk">
    <div class="h3-desk-top">
      <div>
        <p class="ed-eyebrow">{h.desk.eyebrow}</p>
        <h2 class="ed-h2 ed-h2--md">{h.desk.title}</h2>
        <p class="h3-desk-body">{h.desk.body}</p>
        <p class="h3-desk-plan">{h.desk.plan}</p>
      </div>
      <figure class="h3-shot">
        <div class="ed-shot-frame"><img src="/media/home/home-desk-result.png" alt={h.desk.shot_alt} width="1600" height="1342" loading="lazy" /></div>
        <figcaption>{h.desk.shot_caption}</figcaption>
      </figure>
    </div>
    <h3 class="h3-compare-title">{h.desk.compare.title}</h3>
    <div class="h3-compare">
      {h.desk.compare.columns.map((column, i) => (
        <div class:list={['h3-compare-col', { 'h3-compare-col--desk': i === 1 }]}>
          <p class="h3-compare-head">{column.title}</p>
          <ul>{column.items.map((item) => <li>{item}</li>)}</ul>
        </div>
      ))}
    </div>
    <div class="h3-tokens">
      <p>{h.desk.tokens.line}</p>
      <figure class="h3-shot">
        <picture>
          <source media="(max-width: 640px)" srcset="/media/blog/desk/token-savings-ranges-narrow.svg" width="480" height="600" />
          <img src="/media/blog/desk/token-savings-ranges.svg" alt={h.desk.tokens.alt} width="960" height="560" loading="lazy" />
        </picture>
        <figcaption>{h.desk.tokens.caption}</figcaption>
      </figure>
    </div>
    <p class="h3-links">{h.desk.links.map((link) => <a class="ed-link" href={link.href}>{link.label}</a>)}</p>
  </section>

  <!-- 7. Connections: the apps, best-known first, monochrome and with no badge; then the AI models, smaller -->
  <section class="ed-band--mist">
    <div class="ed-wrap ed-sec">
      <header class="ed-sec-head">
        <h2 class="ed-h2 ed-h2--md">{h.connections.title}</h2>
        <p class="ed-sec-sub">{h.connections.body}</p>
      </header>
      <ul class="h3-apps">
        {apps.map((item) => {
          const logo = item.logo ? brandLogos[item.logo] : undefined;
          return (
            <li>
              {logo && <svg viewBox="0 0 24 24" aria-hidden="true"><path d={logo.d} /></svg>}
              <span>{item.name}</span>
            </li>
          );
        })}
        <li class="h3-apps-more">{h.connections.more}</li>
      </ul>
      <div class="h3-models">
        <p class="h3-conn-label">{h.connections.models_label}</p>
        <ul>{models.map((item) => <li>{item.name}</li>)}</ul>
      </div>
      <p class="h3-links"><a class="ed-link" href={h.connections.link.href}>{h.connections.link.label}</a></p>
    </div>
  </section>

  <!-- 8. Built for -->
  <section class="ed-wrap ed-sec">
    <header class="ed-sec-head">
      <p class="ed-eyebrow">{h.built_for.eyebrow}</p>
      <h2 class="ed-h2 ed-h2--md">{h.built_for.title}</h2>
    </header>
    <ul class="h3-doors-cards">
      {h.built_for.cards.map((card) => (
        <li>
          <a href={card.href}>
            <img src={card.photo} alt={card.photo_alt} width="800" height="450" loading="lazy" />
            <span class="h3-doors-card-text">
              <strong>{card.title}</strong>
              <span>{card.body}</span>
              <span class="h3-more">{card.link} →</span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <!-- 9. Pricing: the live home's block, unchanged -->
  <section class="ed-band--mist">
    <div class="ed-wrap ed-sec" id="pricing">
      <header class="ed-sec-head ed-sec-head--row">
        <div>
          <p class="ed-eyebrow">{h.pricing.eyebrow}</p>
          <h2 class="h3-price-title"><span class="ed-mark">{h.pricing.price}</span> <em>{h.pricing.rest}</em></h2>
          <p class="ed-sec-sub">{h.pricing.sub}</p>
        </div>
        <a class="ed-link" href="/pricing">{h.pricing.link}</a>
      </header>
      <ul class="h3-tiers">
        {h.pricing.tiers.map((tier: any) => (
          <li class:list={['h3-tier', { 'h3-tier--featured': tier.featured }]}>
            <h3>{tier.name}</h3>
            <span class="h3-tier-badge">{tier.badge}</span>
            <p>{tier.desc}</p>
            <a class="h3-tier-cta" href={tier.href}>{tier.cta}</a>
          </li>
        ))}
      </ul>
      <div class="h3-whitelabel">
        <strong>{h.pricing.whitelabel}</strong>
        <a class="ed-btn ed-btn--sm ed-btn--line" href="mailto:hello@agentivity.io">{h.pricing.whitelabel_cta}</a>
      </div>
    </div>
  </section>

  <!-- 10. Questions, then the last call -->
  <section class="ed-wrap ed-sec h3-faq">
    <h2 class="ed-h2 ed-h2--md">{h.faq.title}</h2>
    {h.faq.items.map((item) => (
      <details>
        <summary>{item.q}</summary>
        <p>{item.a}</p>
      </details>
    ))}
  </section>

  <!-- The last call, on a darkened photo of a quiet room at sunset (decorative) -->
  <section class="h3-final" id="cta">
    <div class="ed-wrap ed-final">
      <h2>{h.final.title} <em>{h.final.title_accent}</em></h2>
      <p class="ed-final-sub">{h.final.sub}</p>
      <a class="ed-btn ed-btn--yellow" href={h.trial.href}>{h.trial.label}</a>
      <TrialNote lang="en" class="h3-final-note" />
      <p class="h3-final-links">{h.final.links.map((link) => <a class="ed-link" href={link.href}>{link.label}</a>)}</p>
    </div>
  </section>

</main>

<SiteFooter lang="en" />
<VideoAutoplay />

</Base>

<script>
  // The hero film stands still for people who asked their system for less motion (the poster stays).
  const film = document.getElementById('h3-film') as HTMLVideoElement | null;
  if (film && matchMedia('(prefers-reduced-motion: reduce)').matches) { film.removeAttribute('autoplay'); film.pause(); }

  const moving = !matchMedia('(prefers-reduced-motion: reduce)').matches;
  const wide = matchMedia('(min-width: 901px)').matches;

  // Connections: the tiles slide slowly in three rows, in turns to the left and to the right; "And many more…" stays as a
  // line under them. The static grid stays in the page, hidden, for people who asked for less motion.
  const appsGrid = document.querySelector('.h3-apps') as HTMLElement | null;
  if (moving && appsGrid) {
    const tiles = Array.from(appsGrid.children).filter((li) => !li.classList.contains('h3-apps-more'));
    const more = appsGrid.querySelector('.h3-apps-more');
    const marquee = document.createElement('div');
    marquee.className = 'h3-marquee';
    const rows = 3;
    for (let r = 0; r < rows; r++) {
      const row = document.createElement('div');
      row.className = 'h3-marquee-row';
      const track = document.createElement('ul');
      track.className = 'h3-marquee-track';
      const own = tiles.filter((_, i) => i % rows === r);
      own.forEach((li) => track.appendChild(li.cloneNode(true)));
      own.forEach((li) => { const copy = li.cloneNode(true) as HTMLElement; copy.setAttribute('aria-hidden', 'true'); track.appendChild(copy); });
      row.appendChild(track);
      marquee.appendChild(row);
    }
    if (more) {
      const line = document.createElement('p');
      line.className = 'h3-marquee-more';
      line.textContent = more.textContent;
      marquee.appendChild(line);
    }
    appsGrid.hidden = true;
    appsGrid.after(marquee);
  }

  // Build it without code: on a wide screen, the section holds still while the page scrolls through its four views, so that
  // scrolling down goes through all four. The titles stay on the left, numbered; the active one opens its text, and a thin
  // line beside it fills as the scroll moves on. Its clip plays on the right from its start, in full, for as long as the
  // reader stays. A click on a title scrolls to it. After the fourth view, the page scrolls on.
  const views = document.querySelector('.h3-views') as HTMLElement | null;
  if (moving && wide && views) {
    const items = Array.from(views.children) as HTMLElement[];
    const head = views.closest('section')?.querySelector('.ed-sec-head') as HTMLElement;
    const track = document.createElement('div');
    const pin = document.createElement('div');
    const player = document.createElement('div');
    const stage = document.createElement('div');
    track.className = 'h3-track';
    pin.className = 'h3-pin';
    player.className = 'h3-player';
    stage.className = 'h3-stage';
    views.before(track);
    track.append(pin);
    pin.append(head, player);
    player.append(views, stage);
    const figures = items.map((li) => { const figure = li.querySelector('figure') as HTMLElement; stage.append(figure); return figure; });
    const videos = figures.map((figure) => figure.querySelector('video') as HTMLVideoElement);
    views.classList.add('is-player');
    views.setAttribute('role', 'tablist');

    let active = -1, start = 0, step = 0, seen = false;
    const show = (index: number) => {
      if (index === active) return;
      active = index;
      items.forEach((li, i) => {
        const on = i === index;
        li.classList.toggle('is-active', on);
        li.querySelector('h3')?.setAttribute('aria-selected', String(on));
        figures[i].classList.toggle('is-active', on);
        if (!on) videos[i].pause();
      });
      videos[index].currentTime = 0;
      if (seen) videos[index].play().catch(() => {});
    };
    // The page's other clips start when they come on screen: here, only the active one plays, and only while it is seen.
    videos.forEach((video, i) => video.addEventListener('play', () => { if (i !== active || !seen) video.pause(); }));

    // The title of the section stays held with the views; on a short screen it slides up out of sight, the views do not.
    const measure = () => {
      const height = pin.offsetHeight;
      const room = innerHeight - 72;
      const top = height <= room ? 72 + Math.round((room - height) / 2) : innerHeight - height - 20;
      step = Math.round(innerHeight * 0.75);
      pin.style.top = top + 'px';
      track.style.height = height + step * items.length + 'px';
      // From the layout itself: the pieces still rising into place would shift a measured box.
      let y = 0;
      for (let e: HTMLElement | null = track; e; e = e.offsetParent as HTMLElement | null) y += e.offsetTop;
      start = y - top;
    };
    const update = () => {
      const at = Math.min(Math.max((scrollY - start) / step, 0), items.length - 0.001);
      const index = Math.floor(at);
      show(index);
      items.forEach((li, i) => li.style.setProperty('--p', String(i < index ? 1 : i === index ? at - index : 0)));
    };
    let frame = 0;
    const onScroll = () => { if (!frame) frame = requestAnimationFrame(() => { frame = 0; update(); }); };
    items.forEach((li, i) => {
      const tab = li.querySelector('h3') as HTMLElement;
      tab.setAttribute('role', 'tab');
      tab.tabIndex = 0;
      const go = () => scrollTo({ top: start + i * step + 2, behavior: 'smooth' });
      li.addEventListener('click', go);
      tab.addEventListener('keydown', (e) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); go(); } });
    });
    new IntersectionObserver(([entry]) => {
      seen = entry.isIntersecting;
      if (seen) videos[active]?.play().catch(() => {}); else videos.forEach((video) => video.pause());
    }, { threshold: 0.3 }).observe(stage);
    measure();
    update();
    addEventListener('scroll', onScroll, { passive: true });
    addEventListener('resize', () => { measure(); update(); });
    addEventListener('load', () => { measure(); update(); });
  }

  // Start with one helper: on a wide screen, a thin line runs through the four step numbers and fills with yellow as the
  // section scrolls by; each number lights up when the fill reaches it.
  const ladder = document.querySelector('#ladder .ed-wrap') as HTMLElement | null;
  if (moving && ladder) {
    const markers = Array.from(ladder.querySelectorAll('.h3-step-tag span')) as HTMLElement[];
    const steps = ladder.querySelector('.h3-steps') as HTMLElement;
    const company = ladder.querySelector('.h3-step-company') as HTMLElement;
    const ns = 'http://www.w3.org/2000/svg';
    const svg = document.createElementNS(ns, 'svg');
    svg.setAttribute('class', 'h3-rail');
    svg.setAttribute('aria-hidden', 'true');
    const base = document.createElementNS(ns, 'path');
    const fill = document.createElementNS(ns, 'path');
    base.setAttribute('class', 'h3-rail-base');
    fill.setAttribute('class', 'h3-rail-fill');
    svg.append(base, fill);
    ladder.prepend(svg);
    // Positions from the layout itself, so that the pieces still rising into place do not shift the line.
    const at = (el: HTMLElement) => {
      let x = 0, y = 0, e: HTMLElement | null = el;
      while (e && e !== ladder) { x += e.offsetLeft; y += e.offsetTop; e = e.offsetParent as HTMLElement | null; }
      return { x: x + el.offsetWidth / 2, y: y + el.offsetHeight / 2 };
    };
    let total = 0, stops: number[] = [];
    const draw = () => {
      const on = matchMedia('(min-width: 901px)').matches;
      ladder.classList.toggle('has-rail', on);
      if (!on) return;
      const m = markers.map(at);
      const right = at(steps).x + steps.offsetWidth / 2 + 18;
      const sep = at(company).y - company.offsetHeight / 2;
      const last = m[m.length - 1];
      // From one number to the next along the row, stepping up or down in the gap between two steps when their numbers
      // are not level; then round the right side and along the line above the last step, down to its number.
      const items = Array.from(steps.children) as HTMLElement[];
      const points = [m[0]];
      for (let i = 1; i < 3; i++) {
        if (Math.abs(m[i].y - m[i - 1].y) > 1) {
          const gap = at(items[i]).x - items[i].offsetWidth / 2 - 14;
          points.push({ x: gap, y: m[i - 1].y }, { x: gap, y: m[i].y });
        }
        points.push(m[i]);
      }
      points.push({ x: right, y: m[2].y }, { x: right, y: sep }, { x: last.x, y: sep }, last);
      const d = points.map((p, i) => (i ? 'L' : 'M') + p.x.toFixed(1) + ' ' + p.y.toFixed(1)).join(' ');
      base.setAttribute('d', d);
      fill.setAttribute('d', d);
      svg.setAttribute('width', String(ladder.offsetWidth));
      svg.setAttribute('height', String(ladder.offsetHeight));
      total = fill.getTotalLength();
      fill.style.strokeDasharray = String(total);
      let run = 0;
      const along = points.map((p, i) => (i ? (run += Math.hypot(p.x - points[i - 1].x, p.y - points[i - 1].y)) : 0));
      stops = m.map((marker) => along[points.indexOf(marker)]);
      update();
    };
    const update = () => {
      if (!total) return;
      const first = markers[0].getBoundingClientRect(), end = markers[markers.length - 1].getBoundingClientRect();
      const line = innerHeight * 0.6;
      const progress = Math.min(1, Math.max(0, (line - first.top) / Math.max(1, end.top - first.top)));
      const length = progress * total;
      fill.style.strokeDashoffset = String(total - length);
      markers.forEach((marker, i) => marker.classList.toggle('is-lit', length >= stops[i] - 1 && progress > 0));
    };
    let frame = 0;
    addEventListener('scroll', () => { cancelAnimationFrame(frame); frame = requestAnimationFrame(update); }, { passive: true });
    new ResizeObserver(draw).observe(ladder);
    draw();
  }

  // The content of each section after the hero comes in the first time it reaches the screen: it fades in and rises, piece
  // by piece (the title, then the text, then the image or the cards one after another). Only what is still below the screen
  // is hidden, and only here: without the script, or for people who asked for less motion, all stays in place.
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
    const groups = 'header, .h3-desk-top, .h3-step-company, .h3-tokens';
    const pieces: HTMLElement[] = [];
    const add = (el: Element) => {
      if ((el as HTMLElement).hidden || el.matches('svg')) return;
      if ((el.tagName === 'UL' || el.tagName === 'OL') && el.children.length <= 12 && !el.classList.contains('is-player')) pieces.push(...(Array.from(el.children) as HTMLElement[]));
      else pieces.push(el as HTMLElement);
    };
    document.querySelectorAll('.h3 > section:not(.h3-hero)').forEach((section) => {
      const inner = section.classList.contains('ed-wrap') ? section : section.querySelector('.ed-wrap') ?? section;
      Array.from(inner.children).forEach((child) => {
        if (!child.matches(groups)) return add(child);
        Array.from(child.children).forEach((part) => (part.tagName === 'DIV' ? Array.from(part.children).forEach(add) : add(part)));
      });
    });
    const reveal = new IntersectionObserver((entries) => {
      const shown = entries.filter((entry) => entry.isIntersecting).map((entry) => entry.target as HTMLElement);
      shown.sort((a, b) => a.getBoundingClientRect().top - b.getBoundingClientRect().top || a.getBoundingClientRect().left - b.getBoundingClientRect().left);
      shown.forEach((el, i) => {
        el.style.transitionDelay = Math.min(i, 6) * 120 + 'ms';
        el.classList.add('is-in');
        reveal.unobserve(el);
        // Once in place, the piece gets its own styles back (its hover transitions, without the delay).
        el.addEventListener('transitionend', () => { el.classList.remove('h3-reveal', 'is-in'); el.style.transitionDelay = ''; }, { once: true });
      });
    }, { rootMargin: '0px 0px -4% 0px' });
    pieces.forEach((el) => {
      if (el.getBoundingClientRect().top < innerHeight) return;
      el.classList.add('h3-reveal');
      reveal.observe(el);
    });
  }
</script>

