# ── Agentivity — environment variables ──────────────────────────
# Copy to .env and fill in your values.
# All PUBLIC_ variables are embedded at build time (visible in HTML).

# Google Tag Manager container ID (e.g. GTM-XXXXXXX)
# Create at https://tagmanager.google.com
# Add GA4, LinkedIn Insight, etc. as tags inside GTM — no code changes needed.
PUBLIC_GTM_ID=

# IndexNow key — must match the filename in /public/<key>.txt
# Submit at https://www.bing.com/indexnow or https://search.google.com/search-console
PUBLIC_INDEXNOW_KEY=a3f8c2e1d4b7950f6a2c8e3d1b4f7a09

# Formspree form ID — create the form at https://formspree.io (e.g. xpzvwkqr)
# Services enquiry form — used on /services (EN & FR)
PUBLIC_FORMSPREE_SERVICES=

# ── Mailing list (Brevo) ────────────────────────────────────────
# The waitlist form posts to the serverless relay /api/subscribe (api/subscribe.js),
# which calls Brevo. The relay needs one secret:
#
#   BREVO_API_KEY
#
# Set it ONLY in the Vercel project settings (Settings → Environment Variables).
# Never put it in this repository, in a committed .env file, in a PUBLIC_ variable,
# or anywhere that reaches the browser. It is deliberately not listed as a line below
# so that copying this file to .env can never put a key in a file you might commit
# (.env and .env.* are git-ignored, but keep the key out of them anyway).
# Without it the relay answers 503 "not_configured".
#
# To try the relay locally: `vercel dev` (it uses the variables of the Vercel project).
